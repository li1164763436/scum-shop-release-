.monitor-grid .monitor-details { min-height: calc(100% - 56px); display: flex; flex-direction: column; justify-content: space-evenly; }


.monitor-wide { grid-column: 1 / -1; }


.monitor-section { margin-top: 20px; }


.monitor-stat-grid { gap: 10px; margin-bottom: 10px; }


.monitor-ok { color: #16856b !important; }


.log-filter { display: flex; align-items: center; gap: 10px; }


.log-filter select { width: auto; min-width: 126px; }


.log-view { color:#344158; background:#fff; }


.chat-audit-table { min-width: 1260px; }


.audit-type.gameplay-blue-pill { color:#246bd6; background:#edf5ff; border-color:#c6ddff; }


.audit-type.gameplay-risk-pill { color:#b44a53; background:#ffedef; border-color:#f2cbd0; }


.structured-audit:has(.gameplay-summary-chips) .structured-audit-head h3 span { color:#b46b16; background:#fff3df; border-color:#f0d09f; }


.audit-table-pagination { margin: 0 18px 16px; border: 1px solid var(--line); border-radius: 8px; }



.audit-type.loot-cat { color:#7c3aed; background:#f3effd; border-color:#d3c4f8; }


.audit-type.raid-cat { color:#0891b2; background:#e0f6fc; border-color:#a5dff0; }

