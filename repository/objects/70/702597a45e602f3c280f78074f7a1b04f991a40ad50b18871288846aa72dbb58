function runProcess(file, args) { return new Promise((resolve, reject) => { const child = spawn(file, args, { windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] }); let output = ''; child.stdout.on('data', (chunk) => { output += chunk; }); child.stderr.on('data', (chunk) => { output += chunk; }); child.once('error', reject); child.once('close', (code) => code === 0 ? resolve(output) : reject(new Error(output.trim() || `进程退出码 ${code}`))); }); }
async function scheduleStoreRestart(root) {
  if (process.platform !== 'win32') throw new Error('当前系统不支持商城服务重启');
  const script = path.join(root, 'scripts', 'restart-store.ps1');
  if (!fsSync.existsSync(script)) throw new Error('缺少商城服务控制脚本');
  const systemRoot = process.env.SystemRoot || 'C:\\Windows';
  const powershell = path.join(systemRoot, 'System32', 'WindowsPowerShell', 'v1.0', 'powershell.exe');
  const schtasks = path.join(systemRoot, 'System32', 'schtasks.exe');
  const taskName = 'ScumRconManualRestart';
  const quote = (value) => `"${String(value).replaceAll('\"', '\"\"')}"`;
  const command = [quote(powershell), '-NoLogo', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', quote(script), '-AppRoot', quote(root)].join(' ');
  await runProcess(schtasks, ['/Create', '/TN', taskName, '/TR', command, '/SC', 'ONCE', '/ST', '00:00', '/RU', 'SYSTEM', '/RL', 'HIGHEST', '/F']);
  await runProcess(schtasks, ['/Run', '/TN', taskName]);
}

