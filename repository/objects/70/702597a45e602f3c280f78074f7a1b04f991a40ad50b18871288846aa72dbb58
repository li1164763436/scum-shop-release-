function modifyScumPlayer(payload) { return new Promise((resolve, reject) => { const script = path.join(import.meta.dirname, '..', 'scripts', 'modify-scum-player.py'); const bundledPython = path.join(import.meta.dirname, '..', 'scripts', 'python', 'python.exe'); const executable = fsSync.existsSync(bundledPython) ? bundledPython : (process.platform === 'win32' ? 'python.exe' : 'python3'); const child = spawn(executable, ['-X', 'utf8', script], { env: { ...process.env, PYTHONIOENCODING: 'utf-8' }, windowsHide: true }); const stdout = new StringDecoder('utf8'); const stderr = new StringDecoder('utf8'); let out = '', err = ''; const readonly = payload?.action === 'read'; const timer = setTimeout(() => { child.kill(); reject(new ServiceError(readonly ? 'SCUM玩家档案读取超时' : 'SCUM玩家属性操作超时', 504, readonly ? 'SCUM_PROFILE_TIMEOUT' : 'SCUM_MODIFY_TIMEOUT')); }, 15000); child.stdout.on('data', (d) => { out += stdout.write(d); }); child.stderr.on('data', (d) => { err += stderr.write(d); }); child.on('error', (e) => { clearTimeout(timer); reject(new ServiceError(`无法启动SCUM属性脚本：${e.message}`, 503, 'SCUM_MODIFY_START_FAILED')); }); child.on('close', (code) => { clearTimeout(timer); out += stdout.end(); err += stderr.end(); clearTimeout(timer); try { const result = JSON.parse(out.trim()); if (result.error) return reject(new ServiceError(result.error, readonly ? 404 : 409, readonly ? 'SCUM_PROFILE_UNAVAILABLE' : 'SCUM_MODIFY_FAILED')); if (code) return reject(new ServiceError(result.error || err.trim() || (readonly ? '读取SCUM玩家档案失败' : '修改SCUM玩家失败'), readonly ? 404 : 409, readonly ? 'SCUM_PROFILE_UNAVAILABLE' : 'SCUM_MODIFY_FAILED')); resolve(result); } catch { reject(new ServiceError(err.trim() || 'SCUM属性脚本返回无效数据', code ? (readonly ? 404 : 409) : 502, readonly ? 'SCUM_PROFILE_INVALID_RESPONSE' : 'SCUM_MODIFY_INVALID_RESPONSE')); } }); child.stdin.end(JSON.stringify(payload)); }); }

