  app.get('/api/memberships/policy', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().membershipPolicy() })));
  app.put('/api/memberships/policy', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().saveMembershipPolicy(req.body || {}) })));
  app.post('/api/memberships/strategies', admin(async (req, res) => res.status(201).json({ success: true, data: await requireCommerce().saveMembershipStrategy(req.body || {}) })));
  app.put('/api/memberships/strategies/:level', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().saveMembershipStrategy(req.body || {}, req.params.level) })));
  app.delete('/api/memberships/strategies/:level', admin(async (req, res) => { await requireCommerce().deleteMembershipStrategy(req.params.level); res.json({ success: true }); }));
  app.get('/api/memberships', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().listMemberships(req.query) })));
  app.get('/api/memberships/stats', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().membershipStats() })));
  app.get('/api/memberships/consumption/:steamId', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().membershipConsumption(req.params.steamId) })));
  app.get('/api/memberships/logs', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().membershipLogs(req.query) })));
  app.put('/api/memberships/:steamId', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().setMembership(req.params.steamId, req.body || {}, adminActor(req)) })));
  app.delete('/api/memberships/:steamId', admin(async (req, res) => res.json({ success: true, data: await requireCommerce().setMembership(req.params.steamId, req.body || {}, adminActor(req), true) })));
  const accountGameAdmins = async () => readGameAdminUsers((await store.read()).ggcon?.serverDirectory);
  app.get('/api/accounts', admin(async (req, res) => {
    const [accounts, admins] = await Promise.all([commerce.listAccounts(req.query.limit || 100, req.query.search), accountGameAdmins()]);
    res.json({ success: true, data: accounts.map(account => ({ ...account, isAdmin: admins.has(String(account.steamId)) })) });
  }));
  app.get('/api/accounts/:steamId', admin(async (req, res) => {
    const [account, admins] = await Promise.all([commerce.getAccount(req.params.steamId), accountGameAdmins()]);
    res.json({ success: true, data: { ...account, isAdmin: admins.has(String(req.params.steamId)) } });
  }));
  app.post('/api/accounts/:steamId/adjust', admin(async (req, res) => res.json({ success: true, data: await commerce.adjustBalance(req.params.steamId, req.body?.amount, req.body?.note) })));
  app.post('/api/orders', admin(async (req, res) => res.status(201).json({ success: true, data: await commerce.createOrder({ ...(req.body || {}), source: 'manual' }) })));
  app.post('/api/fulfillment/manual', admin(async (req, res) => res.status(201).json({ success: true, data: await commerce.createManualFulfillment(req.body || {}, req.user?.id) })));
  app.get('/api/orders', admin(async (req, res) => res.json({ success: true, data: await commerce.listOrders(req.query.limit || 100) })));
  app.get('/api/order-logs', admin(async (req, res) => res.json({ success: true, data: await commerce.listShopOrderLogs(req.query.limit || 300) })));
