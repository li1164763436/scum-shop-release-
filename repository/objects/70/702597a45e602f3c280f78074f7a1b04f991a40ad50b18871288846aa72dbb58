function cookies(req) {
  return Object.fromEntries(String(req.headers.cookie || '').split(';').map((part) => part.trim().split('=').map(decodeURIComponent)).filter((part) => part.length === 2));
}

function metadata(req) {
  return { ip: req.ip, userAgent: req.get('user-agent') };
}

function limiter({ windowMs, max }) {
  const entries = new Map();
  return (req, res, next) => {
    const key = `${req.ip}:${req.path}:${String(req.body?.username || req.body?.steamId || '').toLowerCase()}`;
    const now = Date.now();
    const item = entries.get(key);
    if (!item || item.until <= now) entries.set(key, { count: 1, until: now + windowMs });
    else if (++item.count > max) return res.status(429).json({ success: false, message: '请求过于频繁，请稍后再试', code: 'RATE_LIMITED' });
    if (entries.size > 5000) for (const [entryKey, value] of entries) if (value.until <= now) entries.delete(entryKey);
    next();
  };
}

export function adminPermissionFor(url) {
  if (/^\/api\/(?:dashboard|monitor)(?:\/|\?|$)/.test(url)) return 'overview';
  if (/^\/api\/(?:products|product-|website|gifts|gift-|redeem|reward|activities|lottery|stock|cloud)/.test(url)) return 'commerce';
  if (/^\/api\/(?:accounts|memberships|vehicles|players|player-admin|teleport-management|admin\/users|admin\/players|character-growth-purchases|account-exchanges|player-checkins)(?:\/|\?|$)/.test(url)) return 'players';
  if (/^\/api\/(?:orders|order-logs|tasks|fulfillment|game-claims|announcements)(?:\/|\?|$)/.test(url)) return 'fulfillment';
  if (/^\/api\/(?:logs|scum-logs|chat-logs|maintenance|gateway|commands|ggcon)(?:\/|\?|$)/.test(url)) return 'operations';
  if (/^\/api\/(?:config|connections|instances|bridge|rcon|license|gsm3|admin\/version-update|admin\/system)(?:\/|\?|$)/.test(url)) return 'system';
  if (/^\/api\/(?:admin\/auth|health|shop|callback)(?:\/|\?|$)/.test(url)) return null;
  return 'system';
}

