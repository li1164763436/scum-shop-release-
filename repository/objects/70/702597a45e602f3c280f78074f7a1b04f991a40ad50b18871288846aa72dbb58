  app.get('/api/fulfillment/lottery-logs', admin(async (req, res) => {
    const page = req.query.page === undefined ? 1 : req.query.page;
    const limit = req.query.limit === undefined ? 50 : req.query.limit;
    res.json({ success: true, data: await commerce.listLotteryFulfillmentLogs({ page, limit }) });
  }));
  app.post('/api/fulfillment/tasks/:id/replacements', admin(async (req, res) => {
    const requestKey = String(req.get('Idempotency-Key') || '').trim();
    if (!requestKey) throw new ServiceError('Idempotency-Key 必填');
    const data = await commerce.createReplacementTask(req.params.id, { requestKey, userId: req.user?.id, reason: req.body?.reason, confirmUnknownDeliveryRisk: req.body?.confirmUnknownDeliveryRisk });
    res.status(data.idempotent ? 200 : 201).json({ success: true, data });
  }));
  app.post('/api/fulfillment/tasks/:id/retry', admin(async (req, res) => { await commerce.retryTask(req.params.id); res.json({ success: true }); }));
  app.get('/api/announcements/config', admin(async (req, res) => {
    const config = await store.read();
    res.json({ success: true, data: config.announcements });
  }));
  app.put('/api/announcements/config', admin(async (req, res) => {
    const saved = await store.save({ announcements: req.body || {} });
    await announcementWorker?.reconfigure();
    res.json({ success: true, data: saved.announcements });
  }));
  app.post('/api/announcements/:id/send-now', admin(async (req, res) => {
    if (!announcementWorker) throw new ServiceError('公告服务未就绪', 503, 'NOT_READY');
    try { res.json({ success: true, data: await announcementWorker.sendNow(req.params.id) }); }
    catch (error) { throw new ServiceError(error.message, /不存在/.test(error.message) ? 404 : 502, /不存在/.test(error.message) ? 'NOT_FOUND' : 'ANNOUNCEMENT_FAILED'); }
  }));
  app.get('/api/fulfillment/attempts', admin(async (req, res) => res.json({ success: true, data: await commerce.listAttempts(req.query.limit || 100) })));
  app.post('/api/callback/orders', service(async (req, res) => {
    const config = await store.read();
    verifyCallback({ rawBody: req.rawBody, timestamp: req.get('X-Timestamp'), signature: req.get('X-Signature'), sharedSecret: config.fulfillment.sharedSecret });
    const orderId = String(req.body?.orderId || '').trim();
    if (!orderId) throw new ServiceError('orderId 不能为空');
    const data = await commerce.createOrder({ steamId: req.body?.steamId, items: req.body?.items, source: 'hmac', externalOrderId: orderId });
    res.status(data.idempotent ? 200 : 201).json({ success: true, data });
  }));
  app.use('/api', (req, res) => res.status(404).json({ success: false, message: '接口不存在', code: 'NOT_FOUND' }));
  app.use((req, res, next) => {
    const acceptsHtml = String(req.get('accept') || '').includes('text/html');
    if (['GET', 'HEAD'].includes(req.method) && acceptsHtml) {
      res.set('Cache-Control', 'no-store');
      return res.status(404).sendFile(notFoundPage);
    }
    next();
  });
  app.use((error, req, res, next) => {
    if (error?.type === 'entity.too.large') return res.status(413).json({ success: false, message: '请求内容过大', code: 'PAYLOAD_TOO_LARGE' });
    logger.error('服务内部错误', redact({ component: 'http', event: 'unhandled_request_error', error: error.message }));
    res.status(500).json({ success: false, message: '服务内部错误' });
  });
  app.closeClients = () => cachedClients?.ggcon.close();
  return app;
}
