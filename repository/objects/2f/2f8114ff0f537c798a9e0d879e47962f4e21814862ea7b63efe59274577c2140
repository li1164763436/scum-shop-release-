const announcementWeekdays = ['周一','周二','周三','周四','周五','周六','周日'];
const announcementLineCount = (value) => String(value || '').split(/\r?\n/).map((line) => line.trim()).filter(Boolean).length;
function announcementWeekText(days = []) { return days.length === 7 ? '每天' : days.map((day) => announcementWeekdays[Number(day) - 1]).filter(Boolean).join('、'); }
function renderAnnouncementRows(items) {
  state.announcementItems = items || [];
  $('#announcementRows').innerHTML = state.announcementItems.length ? state.announcementItems.map((item) => '<tr><td><strong>'+esc(item.name)+'</strong></td><td><span class="announcement-message" title="'+esc(item.message)+'">'+esc(item.message)+'</span><small>'+announcementLineCount(item.message)+' 行</small></td><td>'+esc(item.executionTime)+'</td><td>'+esc(announcementWeekText(item.weekdays))+'</td><td>'+(Number(item.intervalMinutes)===0?'仅计划时间':'每 '+number(item.intervalMinutes)+' 分钟')+'</td><td><span class="badge '+(item.enabled?'completed':'inactive')+'">'+(item.enabled?'启用':'禁用')+'</span></td><td><div class="announcement-row-actions"><button class="row-btn" type="button" data-edit-announcement="'+esc(item.id)+'">编辑</button><button class="row-btn" type="button" data-send-announcement="'+esc(item.id)+'">发送测试</button><button class="row-btn danger" type="button" data-remove-announcement="'+esc(item.id)+'">删除</button></div></td></tr>').join('') : empty(7, '暂无公告');
}
function announcementFormValue(form) {
  const weekdays=$$('input[name="weekday"]:checked',form).map((input)=>Number(input.value));if(!weekdays.length)throw new Error('请至少选择一个执行星期');
  const hour=Number(form.elements.executionHour.value),minute=Number(form.elements.executionMinute.value);if(!Number.isInteger(hour)||hour<0||hour>23||!Number.isInteger(minute)||minute<0||minute>59)throw new Error('执行时间必须为 00:00-23:59');
  const message=form.elements.message.value.trim();if(!announcementLineCount(message))throw new Error('请至少填写一行公告代码或内容');
  return{id:form.elements.id.value,name:form.elements.name.value.trim(),message,executionTime:String(hour).padStart(2,'0')+':'+String(minute).padStart(2,'0'),weekdays,intervalMinutes:Number(form.elements.intervalMinutes.value),enabled:$('#announcementModalEnabled').checked};
}
async function saveAnnouncementItems(items) { const form=$('#announcementsForm').elements,saved=await api('/api/announcements/config',{method:'PUT',body:JSON.stringify({enabled:form.enabled.checked,pollIntervalMs:Number(form.pollIntervalMs.value),items})});state.announcementItems=saved.items||items;renderAnnouncementRows(state.announcementItems); }
function openAnnouncementModal(item = {}) {
  const days=Array.isArray(item.weekdays)&&item.weekdays.length?item.weekdays:[1,2,3,4,5,6,7],weekdayFields=announcementWeekdays.map((name,index)=>'<label><input name="weekday" type="checkbox" value="'+(index+1)+'" '+(days.includes(index+1)?'checked':'')+'><span>'+name+'</span></label>').join(''),timeParts=String(item.executionTime||'23:58').split(':'),internalId=item.id||('notice_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7));
  const body='<section class="modal-section full announcement-task-modal-form"><div class="modal-section-grid announcement-main-grid"><input name="id" type="hidden" value="'+esc(internalId)+'"><label>公告名称<input name="name" maxlength="100" value="'+esc(item.name||'')+'" placeholder="例如：测试公告" required></label><label>执行时间<span class="announcement-time-fields"><span class="announcement-input-suffix"><input name="executionHour" type="number" min="0" max="23" step="1" value="'+Number(timeParts[0]||0)+'" required><i>时</i></span><span class="announcement-input-suffix"><input name="executionMinute" type="number" min="0" max="59" step="1" value="'+Number(timeParts[1]||0)+'" required><i>分</i></span></span></label><label>间隔<span class="announcement-input-suffix"><input name="intervalMinutes" type="number" min="0" max="10080" value="'+Number(item.intervalMinutes||0)+'" required><i>分钟</i></span><span class="field-hint">0 表示只在计划时间执行</span></label><label class="full">公告代码/内容<textarea name="message" maxlength="500" placeholder="每行一条：普通文字或 #管理命令" required>'+esc(item.message||'')+'</textarea><span class="field-hint">每个非空行独立执行；当前 <b id="announcementLineCount">'+announcementLineCount(item.message)+'</b> 行。</span></label><fieldset class="announcement-weekdays full"><legend>执行星期</legend>'+weekdayFields+'</fieldset></div></section>';
  openModal({title:item.id?'编辑公告':'添加公告',description:'每个非空行独立执行：普通文字发送公告，以 # 开头时执行安全管理命令。',submitText:item.id?'保存公告':'添加公告',body,onSubmit:async(form)=>{const value=announcementFormValue(form),items=[...(state.announcementItems||[])],index=items.findIndex((candidate)=>candidate.id===value.id);if(index>=0)items[index]=value;else items.push(value);await saveAnnouncementItems(items);toast(item.id?'公告已更新':'公告已添加');closeModal();}});
  $('#modalBackdrop').classList.add('centered-modal','announcement-task-modal');const messageInput=$('#modalForm').elements.message,lineCount=$('#announcementLineCount');messageInput.addEventListener('input',()=>{lineCount.textContent=announcementLineCount(messageInput.value);});const head=$('#modalTitle').closest('.modal-head'),tools=document.createElement('div');tools.className='announcement-task-title-tools';tools.innerHTML='<label class="switch"><input id="announcementModalEnabled" type="checkbox" '+(item.enabled===false?'':'checked')+'><span></span>启用公告</label>';head.insertBefore(tools,$('#closeModal'));$('#closeModal').hidden=true;
}
async function loadAnnouncements(){const value=await api('/api/announcements/config'),form=$('#announcementsForm').elements;form.enabled.checked=value.enabled===true;form.pollIntervalMs.value=value.pollIntervalMs||5000;renderAnnouncementRows(Array.isArray(value.items)?value.items:[]);}
$('#addAnnouncement').addEventListener('click',()=>openAnnouncementModal());
$('#announcementsForm').addEventListener('submit',async(event)=>{event.preventDefault();await withBusy(event.submitter,async()=>{await saveAnnouncementItems(state.announcementItems||[]);toast('公告调度已保存');});});
$('#announcementRows').addEventListener('click',async(event)=>{const edit=event.target.closest('[data-edit-announcement]'),send=event.target.closest('[data-send-announcement]'),remove=event.target.closest('[data-remove-announcement]'),id=edit?.dataset.editAnnouncement||send?.dataset.sendAnnouncement||remove?.dataset.removeAnnouncement;if(!id)return;const item=(state.announcementItems||[]).find((candidate)=>candidate.id===id);if(!item)return;if(edit){openAnnouncementModal(item);return;}if(remove){if(!confirm('确认删除该公告？'))return;await withBusy(remove,async()=>{await saveAnnouncementItems(state.announcementItems.filter((candidate)=>candidate.id!==id));toast('公告已删除');});return;}await withBusy(send,async()=>{const result=await api('/api/announcements/'+encodeURIComponent(id)+'/send-now',{method:'POST',body:'{}'});toast('测试执行完成：成功 '+number(result.sent||0)+'，失败 '+number(result.failed||0));});});
