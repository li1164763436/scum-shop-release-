function requestAdminLogin() {
  if (!adminLoginPromise) {
    const flow = Promise.resolve().then(async () => {
      try {
        state.currentUser = await api('/api/admin/auth/exchange', { method: 'POST', body: '{}' }, false);
      } catch (exchangeError) {
        const username = window.prompt('首次进入后台，请输入管理员用户名');
        if (!username) throw exchangeError;
        const password = window.prompt('请输入管理员密码');
        if (password === null) throw exchangeError;
        state.currentUser = await api('/api/admin/auth/login', { method: 'POST', body: JSON.stringify({ username, password }) }, false);
      }
    });
    const lockedFlow = flow.finally(() => {
      if (adminLoginPromise === lockedFlow) adminLoginPromise = null;
    });
    adminLoginPromise = lockedFlow;
  }
  return adminLoginPromise;
}
async function api(url, options = {}, retryAuth = true) {
  const response = await fetch(url, {
    ...options,
    headers: { 'Content-Type': 'application/json', ...(options.headers || {}) }
  });
  let body;
  try { body = await response.json(); } catch { body = null; }
  if (response.status === 401 && retryAuth && !url.startsWith('/api/admin/auth/')) {
    await requestAdminLogin();
    return api(url, options, false);
  }
  if (!response.ok || body?.success === false) {
    const error = new Error(body?.message || `请求失败（${response.status}）`);
    error.status = response.status;
    error.code = body?.code || null;
    error.body = body;
    throw error;
  }
  return body && Object.prototype.hasOwnProperty.call(body, 'data') ? body.data : body;
}

