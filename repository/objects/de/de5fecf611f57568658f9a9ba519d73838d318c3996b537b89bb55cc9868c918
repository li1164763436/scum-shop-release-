    const tableTargets = new Set();
    const recordTargets = new Set();
    mutations.forEach((mutation) => {
      if (mutation.target.matches?.('tbody')) tableTargets.add(mutation.target);
      if (mutation.target.id === 'starterGiftList' || mutation.target.id === 'logOutput') recordTargets.add(mutation.target);
