  const maxSize = endpoint === '/api/website/background' ? 8 * 1024 * 1024 : 2 * 1024 * 1024;
  if (file.size > maxSize) throw new Error(`图片大小不能超过 ${maxSize / 1024 / 1024}MB`);
  const data = await api(endpoint, { method: 'POST', headers: { 'Content-Type': file.type }, body: file });
  return data?.imagePath || data?.path || data;
}



