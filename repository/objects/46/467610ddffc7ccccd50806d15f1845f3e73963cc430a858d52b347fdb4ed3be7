const adminAssetVersion = '202611250800';
const cacheUrl = (url, version) => url + (url.includes('?') ? '&' : '?') + 'v=' + version;
async function loadAdminScriptsInOrder() {
  const sources = adminScripts.map((url) => cacheUrl(url, adminAssetVersion));
  const preloads = sources.map((source) => {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'script';
    link.href = source;
    document.head.append(link);
    return link;
  });
  try {
    for (const [index, source] of sources.entries()) {
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.async = false;
        script.src = source;
        script.onload = resolve;
        script.onerror = () => reject(new Error('脚本加载失败：' + adminScripts[index]));
        document.body.append(script);
      });
    }
  } finally {
    preloads.forEach((link) => link.remove());
  }
}
async function loadPageFragments() {
  const mount = document.getElementById('pageMount');
  mount.hidden = true;
  try {
    const responses = await Promise.all(pageFragments.map((url) => fetch(cacheUrl(url, adminAssetVersion))));
    const failed = responses.find((response) => !response.ok);
    if (failed) throw new Error(failed.url + '（HTTP ' + failed.status + '）');
    mount.innerHTML = (await Promise.all(responses.map((response) => response.text()))).join('');
    await loadAdminScriptsInOrder();
  } catch (error) {
    mount.hidden = false;
    mount.innerHTML = '<section class="card"><h2>页面加载失败</h2><p>后台文件加载失败，请刷新页面。</p></section>'; console.error(error);
  }
}
loadPageFragments();











































