function numeric(value) {
  if (value === undefined || value === null || value === '') return null;
  const number = Number(String(value).replace(/,/g, ''));
  return Number.isFinite(number) ? number : null;
}

function itemParts(blob) {
  const quantity = numeric(blob.match(/\(x\s*(-?[\d,.]+)\)\s*$/i)?.[1]);
  const itemName = blob.replace(/\s*\((?:x\s*-?[\d,.]+|health:[\s\S]*)\)\s*$/i, '').trim();
  return { itemName: itemName || null, quantity };
}

