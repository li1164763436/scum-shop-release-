function physicalCategory(source, filename) {
  if (source === 'shop') {
    if (/mysql/i.test(filename)) return 'mysql';
    if (/error/i.test(filename)) return 'error';
    return 'application';
  }
  if (source === 'ue4ss') return 'ue4ss';
  return filename.replace(/\.log$/i, '').replace(/_\d{8,14}$/i, '').replace(/^SCUMServerBot_/i, 'bot_').toLowerCase();
}

function classifyGameLog(physical, line) {
  const value = line.replace(/^\d{4}\.\d{2}\.\d{2}-\d{2}\.\d{2}\.\d{2}:\s*/, '');
  if (/^Game version:/i.test(value) || /^-{10,}$/.test(value.trim())) return '';
  if (physical === 'admin') {
    if (/\b(kicked|kick(?:ed)? player|removed from server|disconnected by admin|auto-?kick|#kick)\b/i.test(value)) return 'kick';
    return 'admin_command';
  }
  if (physical === 'kill') return 'field_kill';
  if (physical === 'event_kill') return 'event_kill';
  if (physical === 'chat') return 'chat';
  if (physical === 'login') return 'presence';
  if (physical === 'chest_ownership') return /ownership changed/i.test(value) ? 'teammate_claim' : 'chest';
  if (physical === 'economy') {
    if (/^\[Bank\].*\b(purchased|renewed|destroyed|lost|blocked|unblocked|activated|deactivated)\b.*\bcard\b/i.test(value)) return 'bank_card';
    if (/^\[Currency Conversion\].*\b(purchased|bought|converted)\b.*\b(gold|gold bars?)\b/i.test(value)) return 'gold';
    if (/^\[Bank\].*\b(deposited|withdr(?:aw|ew|awn)|transferred|transfer(?:red)?|sent|received)\b/i.test(value)) return 'bank_transfer';
    if (/^\[Trade-Mechanic\].*\bpurchased by\b/i.test(value) || /^\[Trade\].*\b(purchased|bought)\s+by\b/i.test(value)) return 'purchase';
    if (/^\[Trade\].*\bsold by\b/i.test(value)) return 'sale';
    if (/\bBefore\s+(buying|selling)|\bAfter\s+(buying|selling)/i.test(value)) return 'balance';
    return 'balance';
  }
  if (physical === 'vehicle_destruction') return 'vehicle';
  if (physical === 'gameplay') {
    if (/^\[LogBunkerLock\].*\bBunker (?:Activated|Deactivated)\b/i.test(value)) return 'bunker_unlock';
    if (/^\[LogBunkerLock\].*(Bunker activations:|Locked bunkers:|Bunker is (Active|Locked))/i.test(value)) return 'bunker_status';
    if (/\[LogLockpick(?:ing)?\]|\[LockpickingMinigame_C\]|\blockpick(?:ing|ed)?\b|\bpicked\s+(a\s+)?lock\b/i.test(value)) return 'lockpick';
    if (/\b(cut(?:ting)?\s+(the\s+)?wire|wire\s+(cut|cutting|cutter)|barbed\s+wire.*cut)\b/i.test(value)) return 'wire_cut';
    if (/\b(trap|mine|claymore)\b.*\b(placed|armed|triggered|activated|disarmed|defused|destroyed|detonated|crafted)\b|\b(placed|armed|triggered|activated|disarmed|defused|destroyed|detonated|crafted)\b.*\b(trap|mine|claymore)\b/i.test(value)) return 'trap';
    return 'gameplay';
  }
  if (physical === 'armor_absorption' || physical === 'server_notifications') {
    if (/\b(kicked|auto-?kick|removed from server)\b/i.test(value)) return 'kick';
    return 'gameplay';
  }
  if (physical === 'famepoints') {
    return 'fame_removed';
  }
  if (physical === 'raid_protection') return /\b(flag|territory|base|squad)\b.*\b(unprotected|vulnerable|vulnerability|risk|warning|expires|ended)\b|\bRaidProtection\b.*\b(activated|deactivated|started|ended|expired)\b/i.test(value) ? 'territory_risk' : 'raid_diagnostic';
  if (physical === 'quests') return 'quest';
  if (physical === 'sentry') return 'sentry';
  if (physical === 'base_building_destruction') return 'base_destruction';
  if (physical === 'bot_killevents') return 'rcon_stats';
  if (physical === 'violations') {
    if (/\b(kicked|auto-?kick|removed from server)\b/i.test(value)) return 'kick';
    if (/^\[OutOfInteractionRange\]|InteractionRange|OutOfRange|TooFar/i.test(value)) return 'distance';
    if (/^\[(Ammo|AmmoCountMismatch|InvalidAmmo|MagazineAmmoMismatch|InfiniteAmmo)\]|\b(ammo|ammunition|magazine)\b.*\b(mismatch|invalid|illegal|infinite|violation)\b/i.test(value)) return 'ammo';
    if (/^\[(Projectile|Ballistics|InvalidProjectile|ProjectileMismatch|Trajectory|HitValidation|ImpossibleHit)\]|\b(projectile|trajectory|ballistic|hit location|shot)\b.*\b(mismatch|invalid|impossible|violation|validation failed)\b/i.test(value)) return 'ballistics';
    return 'other_violation';
  }
  if (physical === 'loot') return 'loot_diagnostic';
  return 'gameplay';
}

