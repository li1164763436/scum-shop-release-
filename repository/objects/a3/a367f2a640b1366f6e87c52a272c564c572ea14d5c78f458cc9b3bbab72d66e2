function messageOf(line) {
  return line.replace(/^\d{4}\.\d{2}\.\d{2}-\d{2}\.\d{2}\.\d{2}:\s*/, '').trim();
}

function locationOf(x, y, z) {
  const values = [x, y, z].map(Number);
  return values.every(Number.isFinite) ? { x: values[0], y: values[1], z: values[2] } : null;
}

function prefixedJsonOf(line) {
  const value = messageOf(line);
  if (!value.startsWith('{')) return null;
  try { return JSON.parse(value); } catch { return null; }
}

function killAuditOf(line, parsed = prefixedJsonOf(line), allowUnknown = false) {
  const timestamp = timestampOf(line, parsed);
  const message = messageOf(line);
  if (parsed?.Killer && parsed?.Victim) {
    const killerLocation = locationOf(parsed.Killer.ServerLocation?.X, parsed.Killer.ServerLocation?.Y, parsed.Killer.ServerLocation?.Z);
    const victimLocation = locationOf(parsed.Victim.ServerLocation?.X, parsed.Victim.ServerLocation?.Y, parsed.Victim.ServerLocation?.Z);
    const distance = killerLocation && victimLocation ? Math.sqrt((killerLocation.x - victimLocation.x) ** 2 + (killerLocation.y - victimLocation.y) ** 2 + (killerLocation.z - victimLocation.z) ** 2) / 100 : null;
    return { timestamp, killerName: parsed.Killer.ProfileName || null, killerSteamId: parsed.Killer.UserId || null, victimName: parsed.Victim.ProfileName || null, victimSteamId: parsed.Victim.UserId || null, weapon: parsed.Weapon || null, distance, killerLocation, victimLocation, eventType: 'kill', raw: line };
  }
  let match = message.match(/^Died:\s*(.*?)\s*\((\d{15,20}|NPC)\),\s*Killer:\s*(.*?)\s*\((\d{15,20}|NPC)\)\s*Weapon:\s*(.*?)\s*S:\[KillerLoc\s*:\s*([^,]+),\s*([^,]+),\s*([^\s]+)\s+VictimLoc:\s*([^,]+),\s*([^,]+),\s*([^,]+),\s*Distance:\s*([\d.]+)\s*m\]$/i);
  if (match) return { timestamp, killerName: match[3], killerSteamId: match[4], victimName: match[1], victimSteamId: match[2], weapon: match[5], distance: Number(match[12]), killerLocation: locationOf(match[6], match[7], match[8]), victimLocation: locationOf(match[9], match[10], match[11]), eventType: 'kill', raw: line };
  match = message.match(/^Comm?itted suicide\.\s*User:\s*(.*?)\s*\((\d+),\s*(\d{15,20})\),\s*\[(.*?)\]\.\s*Location:\s*X=([^\s]+)\s+Y=([^\s]+)\s+Z=([^\.]+(?:\.\d+)?)\.?$/i);
  if (match) return { timestamp, killerName: match[1], killerSteamId: match[3], victimName: match[1], victimSteamId: match[3], weapon: '自杀', distance: 0, killerLocation: locationOf(match[5], match[6], match[7]), victimLocation: locationOf(match[5], match[6], match[7]), eventType: 'suicide', raw: line };
