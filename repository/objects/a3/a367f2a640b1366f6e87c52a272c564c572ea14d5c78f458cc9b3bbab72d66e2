  if (category === 'ballistics') return ballisticsAuditOf(line);
  if (category === 'loot_diagnostic') return lootDiagnosticAuditOf(line, parsed);
  if (category === 'raid_diagnostic') return raidDiagnosticAuditOf(line, parsed);
  if (category === 'other_violation') return otherViolationAuditOf(line);
  return null;
}

function killDuplicateKey(audit) {
  if (!audit || audit.eventType !== 'kill') return '';
  return [audit.timestamp, audit.killerSteamId, audit.victimSteamId, audit.killerName, audit.victimName].join('|').toLowerCase();
}

function levelOf(line, parsed) {
  const level = String(parsed?.level || '').toLowerCase();
  if (['error', 'warn', 'info', 'debug'].includes(level)) return level;
  if (/\b(error|fatal|failed|failure|exception|crash)\b/i.test(line)) return 'error';
  if (/\b(warn|warning)\b/i.test(line)) return 'warn';
  if (/\b(debug|trace)\b/i.test(line)) return 'debug';
  return 'info';
}

function shopCategoryOf(level) {
  if (level === 'error') return 'error';
  if (level === 'warn') return 'warning';
  return 'application';
}

function shopModuleOf({ component, message, parsed, fileCategory }) {
  const normalized = String(component || '').toLowerCase();
  const code = String(parsed?.code || parsed?.errorCode || '').toUpperCase();
  const event = String(parsed?.event || '').toLowerCase();
  const text = String(message || '');
  if (normalized === 'rcon' || event === 'rcon_access' || parsed?.command || /\bRCON\b/i.test(text)) return 'rcon';
  if (fileCategory === 'mysql' || ['mysql', 'database', 'db'].includes(normalized) || /^(?:ER_|MYSQL|DB_)/.test(code) || /(?:MySQL|数据库|SQL)/i.test(text)) return 'mysql';
  return 'application';
}

function timestampOf(line, parsed) {
  if (parsed?.timestamp || parsed?.time) return parsed.timestamp || parsed.time;
  return line.match(/^\[([^\]]+)\]/)?.[1] || line.match(/^(\d{4}-\d{2}-\d{2}T[^\s]+)/)?.[1] || line.match(/^(\d{4}\.\d{2}\.\d{2}-\d{2}\.\d{2}\.\d{2})/)?.[1] || '';
}

function browserDuplicateKey(entry) {
  const details = entry.details || {};
  const identity = ['code', 'statusCode', 'path', 'command', 'status', 'errorCode', 'errorMessage', 'rconErrorCode', 'rconErrorMessage', 'error', 'eventId', 'announcementId', 'taskId', 'orderId', 'steamId', 'file'].map((key) => [key, details[key] ?? null]);
  return JSON.stringify([entry.level, entry.component, entry.message, identity]);
}

function repeatRecord(entry) {
  const suppressedCount = Number(entry.repeatCount) || 0;
  return {
    timestamp: entry.timestamp,
    file: entry.file,
    fileType: entry.fileType,
    details: entry.details || null,
    suppressedCount,
    occurrenceCount: 1 + suppressedCount,
    repeatWindowMs: Number(entry.repeatWindowMs) || 0
  };
}

function collapseShopEntries(entries) {
  const result = [];
  const indexes = new Map();
  for (const entry of entries) {
    const key = browserDuplicateKey(entry);
    const existingIndex = indexes.get(key);
    if (existingIndex === undefined) {
      indexes.set(key, result.length);
      result.push({ ...entry, repeatCount: Number(entry.repeatCount) || 0, repeatRecords: [repeatRecord(entry)] });
      continue;
    }
    result[existingIndex].repeatCount += 1 + (Number(entry.repeatCount) || 0);
    result[existingIndex].repeatRecords.push(repeatRecord(entry));
  }
  return result.map((entry) => {
    if (entry.repeatCount > 0) return entry;
    const { repeatRecords, ...single } = entry;
    return single;
  });
}

function logTimestamp(entry) {
  const timestamp = String(entry.audit?.timestamp || entry.timestamp || '').replace(/^(\d{4})\.(\d{2})\.(\d{2})-(\d{2})\.(\d{2})\.(\d{2})(?::(\d+))?/, (match, year, month, day, hour, minute, second, fraction) => `${year}-${month}-${day}T${hour}:${minute}:${second}${fraction ? '.' + fraction : ''}`);
  return Date.parse(timestamp) || 0;
}

function decode(buffer) {
  if (!buffer.length) return '';
  const utf16 = (buffer[0] === 0xff && buffer[1] === 0xfe) || buffer.subarray(0, Math.min(buffer.length, 200)).filter((value) => value === 0).length > 20;
  if (utf16) return buffer.subarray(buffer.length % 2 ? 1 : 0).toString('utf16le').replace(/^\uFEFF/, '');
  return buffer.toString('utf8').replace(/^\uFEFF/, '');
}

async function tail(file, maxBytes = MAX_TAIL_BYTES) {
  if (!Number.isFinite(maxBytes)) return fs.readFile(file).then(decode);
  const handle = await fs.open(file, 'r');
  try {
    const stat = await handle.stat();
    const size = Math.min(stat.size, maxBytes);
    const buffer = Buffer.alloc(size);
    await handle.read(buffer, 0, size, stat.size - size);
    let text = decode(buffer);
    if (stat.size > size) text = text.slice(text.search(/\r?\n/) + 1);
    return text;
  } finally { await handle.close(); }
}

function fameAuditsOf(text) {
  const entries = []; let blockTimestamp = ''; let current = null;
  const finish = () => { if (current) entries.push(current); current = null; };
  for (const sourceLine of text.split(/\r?\n/)) {
    const raw = sourceLine.trim(); if (!raw) continue;
    const timestamped = raw.match(/^(\d{4}\.\d{2}\.\d{2}-\d{2}\.\d{2}\.\d{2}):\s*([\s\S]*)$/);
    const timestamp = timestamped?.[1] || ''; const message = (timestamped?.[2] ?? raw).trim();
    if (/^-{10,}$/.test(message)) { finish(); if (timestamp) blockTimestamp = timestamp; continue; }
    let match = message.match(/^Player ([\s\S]+)\((\d{15,20})\) was awarded (-?\d+(?:\.\d+)?) fame points in (\d+) minutes for a total of (-?\d+(?:\.\d+)?)\s*$/i);
    if (match) { finish(); current = { timestamp: timestamp || blockTimestamp, type: 'period_summary', typeLabel: '阶段统计', playerName: match[1].trim(), steamId: match[2], famePoints: numeric(match[3]), reason: '10分钟统计', periodMinutes: numeric(match[4]), totalFame: numeric(match[5]), raw, details: [] }; continue; }
    match = message.match(/^Player ([\s\S]+)\((\d{15,20})\) was awarded (-?\d+(?:\.\d+)?) fame points for ([\s\S]+?)\s*$/i);
    if (match) { finish(); const audit = { timestamp: timestamp || blockTimestamp, type: 'instant', typeLabel: '即时声望', playerName: match[1].trim(), steamId: match[2], famePoints: numeric(match[3]), reason: match[4].trim(), periodMinutes: null, totalFame: null, raw, details: [] }; audit.details.push({ timestamp: audit.timestamp, reason: audit.reason, famePoints: audit.famePoints, playerName: audit.playerName, steamId: audit.steamId, raw }); entries.push(audit); continue; }
    const detail = message.match(/^([^:]+):\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (current && detail) current.details.push({ timestamp: current.timestamp, reason: detail[1].trim(), famePoints: numeric(detail[2]), playerName: current.playerName, steamId: current.steamId, raw });
  }
  finish(); return entries;
}

async function filesIn(directory, source, matcher = () => true) {
  try {
    const entries = (await fs.readdir(directory, { withFileTypes: true })).filter((entry) => entry.isFile() && matcher(entry.name));
    const files = [];
    for (let index = 0; index < entries.length; index += 16) {
      const batch = await Promise.all(entries.slice(index, index + 16).map(async (entry) => {
        const filePath = path.join(directory, entry.name);
        const stat = await fs.stat(filePath);
        return { source, sourceLabel: SOURCE_LABELS[source], category: physicalCategory(source, entry.name), name: entry.name, path: filePath, size: stat.size, modifiedAt: stat.mtime.toISOString() };
      }));
      files.push(...batch);
    }
    return files;
  } catch (error) {
    if (['ENOENT', 'ENOTDIR'].includes(error.code)) return [];
    throw error;
  }
}

function ue4ssPath(config) {
  const root = String(config.ggcon?.serverDirectory || '').trim();
  if (root) return path.join(root, 'Binaries', 'Win64', 'ue4ss', 'UE4SS.log');
  const logs = String(config.scumLogs?.directory || '').trim();
  const marker = `${path.sep}Saved${path.sep}SaveFiles${path.sep}Logs`;
  const index = logs.toLowerCase().lastIndexOf(marker.toLowerCase());
  return index >= 0 ? path.join(logs.slice(0, index), 'Binaries', 'Win64', 'ue4ss', 'UE4SS.log') : '';
}

export { GAME_CATEGORIES, physicalCategory, classifyGameLog, auditOf, fameAuditsOf, timestampOf, levelOf, prefixedJsonOf, messageOf };

export class LogBrowserService {
  constructor({ root, store }) { this.root = root; this.store = store; }

  async list({ source = '', category = '', file = '', level = '', search = '', limit = 300 } = {}) {
    const unlimited = source === 'shop' && String(limit) === '0';
    const config = await this.store.read();
    const ue4ss = ue4ssPath(config);
    const gameDefinition = source === 'scum' && category ? GAME_CATEGORIES.find((item) => item.id === category) : null;
    const matchesRequestedFile = (name) => !file || name === file;
    const [shopFiles, scumFiles, ue4ssFiles] = await Promise.all([
      !source || source === 'shop' ? filesIn(path.join(this.root, 'logs'), 'shop', (name) => /\.log$/i.test(name) && matchesRequestedFile(name) && (category === 'error' ? physicalCategory('shop', name) === 'error' : physicalCategory('shop', name) !== 'error')) : [],
      !source || source === 'scum' ? filesIn(String(config.scumLogs?.directory || ''), 'scum', (name) => /\.log$/i.test(name) && matchesRequestedFile(name) && (!category || category === 'all' || gameDefinition?.physical.includes(physicalCategory('scum', name)))) : [],
      (!source || source === 'ue4ss') && ue4ss ? filesIn(path.dirname(ue4ss), 'ue4ss', (name) => name.toLowerCase() === path.basename(ue4ss).toLowerCase() && matchesRequestedFile(name)) : []
    ]);
    const allFiles = [...shopFiles, ...scumFiles, ...ue4ssFiles].sort((a, b) => b.modifiedAt.localeCompare(a.modifiedAt));
    const selected = allFiles.filter((item) => {
      if (source && item.source !== source) return false;
      if (file && item.name !== file) return false;
      if (item.source === 'shop') {
        if (category === 'error') return item.category === 'error';
        return item.category !== 'error';
      }
      if (!category || category === 'all') return true;
      return item.source === 'scum' ? gameDefinition?.physical.includes(item.category) : item.category === category;
    });
    const normalizedSearch = String(search || '').trim().toLowerCase();
    const exhaustiveSearch = Boolean(normalizedSearch);
    const readFiles = unlimited || exhaustiveSearch ? selected : selected.slice(0, file ? 1 : category === 'event_kill' ? selected.length : source || category ? 30 : 40);
    const entries = [];
    const killKeys = new Set();
    const kickKeys = new Set();
    const readFailures = [];
    const fameMode = source === 'scum' && category === 'fame';
    for (const item of readFiles) {
      let text = '';
      try {
        text = fameMode ? decode(await fs.readFile(item.path)) : await tail(item.path, unlimited || exhaustiveSearch ? Number.POSITIVE_INFINITY : MAX_TAIL_BYTES);
      } catch (error) {
        readFailures.push({ file: item.name, code: error.code || 'READ_FAILED', message: error.message });
        continue;
      }
      if (fameMode) {
        for (const audit of fameAuditsOf(text)) {
          if (level && level !== 'info') continue;
          const haystack = item.name + ' ' + audit.raw + ' ' + JSON.stringify(audit);
          if (normalizedSearch && !haystack.toLowerCase().includes(normalizedSearch)) continue;
          entries.push({ timestamp: audit.timestamp, level: 'info', source: item.source, sourceLabel: item.sourceLabel, category: 'fame', categoryLabel: '声望', file: item.name, message: audit.raw, audit, details: null });
        }
        continue;
      }
      for (const raw of text.split(/\r?\n/).filter(Boolean)) {
        let parsed = null;
        try { parsed = JSON.parse(raw); } catch { parsed = prefixedJsonOf(raw); }
        if (!parsed) parsed = {};
        if (!parsed._file) parsed._file = { name: item.name, category: item.category, source: item.source };
        let message = parsed?.message ? String(parsed.message) : raw.replace(/^\[[^\]]+\]\s*/, '');
        if (item.source === 'shop' && parsed?.command && (parsed?.event === 'rcon_access' || parsed?.component === 'rcon')) {
          const accessStatus = parsed.status || (/成功/.test(message) ? 'success' : 'failed');
          message = formatRconAccessMessage(parsed.command, accessStatus);
        }
        const entryLevel = levelOf(raw, parsed);
        const virtualCategory = item.source === 'scum' ? classifyGameLog(item.category, raw) : (item.source === 'shop' ? shopCategoryOf(entryLevel) : item.category);
        if (!virtualCategory || (category && category !== 'all' && virtualCategory !== category)) continue;
        const definition = GAME_CATEGORIES.find((entry) => entry.id === virtualCategory);
        if (level && entryLevel !== level) continue;
        const audit = item.source === 'scum' ? auditOf(virtualCategory, raw, parsed) : null;
        if (normalizedSearch && !`${item.name} ${message} ${audit ? JSON.stringify(audit) : ''}`.toLowerCase().includes(normalizedSearch)) continue;
        const duplicateKey = ['field_kill', 'event_kill'].includes(virtualCategory) ? killDuplicateKey(audit) : '';
        if (duplicateKey && killKeys.has(duplicateKey)) {
          const existingIndex = entries.findIndex((entry) => killDuplicateKey(entry.audit) === duplicateKey);
          if (existingIndex >= 0 && parsed?.Killer && parsed?.Victim) entries.splice(existingIndex, 1);
          else continue;
        }
        if (duplicateKey) killKeys.add(duplicateKey);
        const kickKey = virtualCategory === 'kick' && audit?._dedupKey ? audit._dedupKey : '';
        if (kickKey && kickKeys.has(kickKey)) continue;
        if (kickKey) kickKeys.add(kickKey);
        const rawComponent = String(parsed?.component || (item.source === 'shop' ? 'application' : item.source));
        const component = item.source === 'shop' ? shopModuleOf({ component: rawComponent, message, parsed, fileCategory: item.category }) : rawComponent;
        const module = item.source === 'shop' ? SHOP_MODULES[component] : null;
        entries.push({ timestamp: timestampOf(raw, parsed), level: entryLevel, source: item.source, sourceLabel: item.sourceLabel, category: virtualCategory, categoryLabel: definition?.label || CATEGORY_LABELS[virtualCategory] || virtualCategory, component, componentLabel: module?.label || rawComponent, componentDescription: module?.description || '', file: item.name, fileType: item.source === 'shop' && (item.category === 'error' || entryLevel === 'error') ? '错误日志' : '运行日志', message, audit, repeatCount: Number(parsed?.repeatCount) || 0, repeatWindowMs: Number(parsed?.repeatWindowMs) || 0, details: parsed && typeof parsed === 'object' ? Object.fromEntries(Object.entries(parsed).filter(([key]) => !['timestamp', 'time', 'level', 'message', 'component', 'repeatCount', 'repeatWindowMs', '_file'].includes(key))) : null });
      }
    }
    entries.reverse();
    entries.sort((first, second) => logTimestamp(second) - logTimestamp(first));
    const visibleEntries = source === 'shop' ? collapseShopEntries(entries) : entries;
    const safeLimit = unlimited ? null : Math.min(Math.max(Number(limit) || 300, 1), 1000);
    const categories = source === 'scum'
      ? GAME_CATEGORIES.map((item) => ({ id: item.id, label: item.label, icon: item.icon, fileCount: allFiles.filter((fileItem) => fileItem.source === 'scum' && item.physical.includes(fileItem.category)).length }))
      : source === 'shop'
        ? SHOP_CATEGORIES.map((item) => ({ ...item, fileCount: item.id === 'error' ? shopFiles.filter((fileItem) => fileItem.category === 'error').length : shopFiles.filter((fileItem) => fileItem.category !== 'error').length }))
        : [...new Set(allFiles.filter((item) => !source || item.source === source).map((item) => item.category))].sort().map((id) => ({ id, label: CATEGORY_LABELS[id] || id, fileCount: allFiles.filter((item) => (!source || item.source === source) && item.category === id).length }));
    return {
      entries: safeLimit === null ? visibleEntries : visibleEntries.slice(0, safeLimit),
      sources: Object.entries(SOURCE_LABELS).map(([id, label]) => ({ id, label, fileCount: allFiles.filter((item) => item.source === id).length })),
      categories,
      files: selected.map(({ source: fileSource, sourceLabel, category: fileCategory, name, size, modifiedAt }) => ({ source: fileSource, sourceLabel, category: fileCategory, name, size, modifiedAt })),
      totalFiles: allFiles.length,
      scannedFiles: readFiles.length - readFailures.length,
      readFailures,
      truncated: !unlimited && !exhaustiveSearch && (selected.length > readFiles.length || readFiles.some((item) => item.size > MAX_TAIL_BYTES))
    };
  }
}
