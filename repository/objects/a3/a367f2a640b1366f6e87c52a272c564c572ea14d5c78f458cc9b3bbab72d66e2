        } else {
          const spawnerFailMatch = content.match(/'([^']+)': Failed to find loot tree node '([^']+)'/);
          if (spawnerFailMatch) {
            errorDetail = { spawnerRef: spawnerFailMatch[1], lootNode: spawnerFailMatch[2] };
          } else {
            errorDetail = { message: content };
          }
        }
      }
    }
  }
  return { timestamp, level, levelLabel, category, content, fileType, errorDetail, raw: line };
}

function raidDiagnosticAuditOf(line, parsed) {
  const match = line.match(/^(\d{4}\.\d{2}\.\d{2}-\d{2}\.\d{2}\.\d{2}):\s*(Game version|Log):\s*([\s\S]*)$/);
  if (!match) return null;
  const timestamp = match[1];
  const level = match[2];
  const content = match[3];
  const levelLabels = { 'Game version': '版本', Log: '普通' };
  const levelLabel = levelLabels[level] || '普通';
  const category = level === 'Game version' ? '版本' : '通用';
  return { timestamp, level, levelLabel, category, content, fileType: 'raid_protection', raw: line };
}

function auditOf(category, line, parsed) {
  if (category === 'admin_command') return adminAuditOf(line);
  if (category === 'field_kill') return killAuditOf(line, parsed, false);
  if (category === 'event_kill') return killAuditOf(line, parsed, true);
  if (category === 'chat') return chatAuditOf(line);
  if (category === 'presence') return presenceAuditOf(line);
  if (category === 'teammate_claim') return teammateClaimAuditOf(line);
  if (category === 'purchase') return purchaseAuditOf(line);
  if (category === 'sale') return saleAuditOf(line);
  if (category === 'balance') return balanceAuditOf(line);
  if (category === 'bank_transfer') return bankTransferAuditOf(line);
  if (category === 'gold') return goldAuditOf(line);
  if (category === 'bank_card') return bankCardAuditOf(line);
  if (category === 'vehicle') return vehicleAuditOf(line);
  if (category === 'chest') return chestAuditOf(line);
  if (category === 'lockpick' || category === 'wire_cut') return behaviorAuditOf(line);
  if (category === 'trap') return trapAuditOf(line);
  if (category === 'gameplay') return gameplayAuditOf(line);
  if (category === 'territory_risk') return territoryRiskAuditOf(line);
