:0;overflow:hidden}.vehicle-subpage-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid var(--border)}.vehicle-subpage-heading h3{margin:0 0 5px}.vehicle-subpage-heading p{margin:0;color:var(--text-muted)}.vehicle-subpage-heading>span{color:var(--text-muted);white-space:nowrap}.vehicle-restrictions>.empty{padding:70px 20px}.vehicle-insurance-strategy-block+.vehicle-insurance-record-block{border-top:1px solid var(--border)}.vehicle-block-title{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px;background:rgba(148,163,184,.055);border-bottom:1px solid var(--border)}.vehicle-block-title>div{display:grid;gap:3px}.vehicle-block-title small,.vehicle-block-title>span{color:var(--text-muted)}.vehicle-insurance-strategy-editor{display:grid;gap:16px}.vehicle-switch{display:flex!important;grid-template-columns:auto 1fr!important;align-items:center;justify-content:flex-start;gap:10px!important;padding:12px;border:1px solid var(--border);border-radius:10px}.vehicle-switch input{width:18px;height:18px}.vehicle-strategy-hint{padding:12px 14px;border-radius:10px;background:rgba(37,99,235,.08);color:var(--text-muted);line-height:1.6}.vehicle-insurance-strategy-editor input[readonly]{background:rgba(148,163,184,.08);color:var(--text-muted);cursor:default}#modalBackdrop:has(.vehicle-insurance-strategy-editor){align-items:center!important;justify-content:center!important;padding:24px!important}#modalBackdrop:has(.vehicle-insurance-strategy-editor) .modal{width:min(720px,calc(100vw - 32px));max-width:720px;margin:auto!important}.vehicle-toolbar{align-items:flex-end}.vehicle-toolbar h2{margin:4px 0}.vehicle-toolbar p{margin:0;color:var(--text-muted)}.vehicle-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.vehicle-summary-grid article{padding:18px 20px;border:1px solid var(--border);border-radius:14px;background:var(--panel);display:grid;gap:7px}.veh