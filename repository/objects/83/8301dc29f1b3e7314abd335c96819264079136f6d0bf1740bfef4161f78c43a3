document.addEventListener('click', (event) => {
  const button = event.target.closest('[data-config-tab]');
  if (!button) return;
  const page = button.closest('#page-config');
  if (!page) return;
  $$('.tab', page).forEach((item) => item.classList.toggle('active', item === button));
  $$('.tab-panel', page).forEach((panel) => panel.classList.toggle('active', panel.id === `config-${button.dataset.configTab}`));
});
$$('[data-test]').forEach((button) => button.addEventListener('click', () => testConnection(button.dataset.test, button)));

$('#reloadVersionUpdate')?.addEventListener('click', (event) => withBusy(event.currentTarget, () => Promise.all([loadVersionUpdateManifest(), loadVersionUpdate()])));



