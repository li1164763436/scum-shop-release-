  $('#checkRconPlugins').addEventListener('click', (event) => withBusy(event.currentTarget, inspectRconPlugins));
  $('#downloadRconPlugins').addEventListener('click', (event) => withBusy(event.currentTarget, () => updateRconPlugins('download')));
  $('#replaceRconPlugins').addEventListener('click', (event) => {
    if (window.confirm('确认备份并替换游戏目录中的 RCON 插件文件？')) withBusy(event.currentTarget, () => updateRconPlugins('replace'));
  });
