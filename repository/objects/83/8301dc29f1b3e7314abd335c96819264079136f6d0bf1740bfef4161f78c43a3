function rconPluginDirectory() {
  return $('#scumRconConfigForm').elements.scumGameDirectory.value.trim();
}
function renderRconPlugins(data) {
  const current = data.files.filter((file) => file.matches).length;
  const downloaded = data.files.filter((file) => file.downloaded).length;
  $('#rconPluginDirectory').textContent = data.directory;
  $('#rconPluginSummary').textContent = `线上版本 ${data.version} · ${current}/${data.files.length} 个文件一致`;
  $('#replaceRconPlugins').disabled = downloaded !== data.files.length;
  $('#rconPluginFiles').innerHTML = data.files.map((file) => {
    const state = !file.installed ? '缺失' : file.matches ? '正常' : '需替换';
    const cache = file.downloaded ? '已下载' : '未下载';
    return `<article class='plugin-file ${file.matches ? 'ok' : 'bad'}'><strong>${esc(file.name)}</strong><span>${state}</span><small>${cache} · 本地 ${formatBytes(file.size)} / 线上 ${formatBytes(file.expectedSize)}</small><small>本地 SHA256：${esc(file.sha256 || '无')}</small><small>线上 SHA256：${esc(file.expectedSha256)}</small></article>`;
  }).join('');
}
async function inspectRconPlugins() {
  const query = new URLSearchParams({ directory: rconPluginDirectory() });
  const data = await api(`/api/rcon/plugins?${query}`);
  renderRconPlugins(data);
  return data;
}
async function updateRconPlugins(action) {
  const data = await api(`/api/rcon/plugins/${action}`, { method: 'POST', body: JSON.stringify({ directory: rconPluginDirectory() }) });
  renderRconPlugins(data);
  if (action === 'download') toast('插件文件已下载并校验');
  else if (data.sync?.status === 'completed') toast('插件文件已备份、替换并校验');
  else toast(data.sync?.message || '插件同步任务保持待处理状态');
}
setupRconPluginPanel();

async function loadVersionUpdate() {
  const data = await api('/api/admin/version-update/status');
  const card = $('#versionUpdateStatusCard');
  card.dataset.status = data.status || 'idle';
  state.versionUpdateStatus = data.status || 'idle';
  const progress = Math.max(0, Math.min(100, Number(data.progress || 0)));
  const downloading = data.status === 'downloading';
  const statusMessage = String(data.message || '');
  let message = data.message || '检查完成';
  let badge = '已检查';
  let mode = 'checked';
  let bar = 100;
  if (downloading) { const reusing = statusMessage.startsWith('已复用'); message = reusing ? '正在复用已存在的更新文件' : '正在下载更新文件'; badge = reusing ? '复用中' : '下载中'; mode = 'downloading'; bar = progress; }
  else if (data.status === 'preparing') { message = '正在准备下载文件'; badge = '准备中'; mode = 'downloading'; bar = progress; }
  else if (!data.status || data.status === 'idle') { const changed = Number(state.versionUpdateManifest?.changedFileCount || 0); message = changed > 0 ? `检查完成，有 ${changed} 个文件更新` : '检查完成，当前已是最新版本'; }
  else if (data.status === 'ready') { message = '下载完成，等待安装替换'; badge = '可安装'; mode = 'ready'; bar = 100; }
  else if (['applying', 'staging', 'stopping', 'backing_up', 'installing', 'starting', 'rollback'].includes(data.status)) { message = data.message || '正在安装更新'; badge = '安装中'; mode = 'installing'; bar = progress; }
  else if (data.status === 'completed') { message = '更新完成'; badge = '已完成'; mode = 'checked'; bar = 100; }
  else if (data.status === 'failed') { message = data.message || '更新失败'; badge = '失败'; mode = 'failed'; bar = 100; }
  card.className = `version-update-current-status ${mode}`;
  card.dataset.status = data.status || 'idle';
  $('#versionUpdateStatus').textContent = badge;
  $('#versionUpdateMessage').textContent = message;
  $('#versionUpdateStatusBar').style.width = `${bar}%`;
  $('#versionUpdateCurrentFile').textContent = `下载进度：${progress}%`;
  $('#versionUpdateStatusDetail').hidden = !downloading;
  $('#versionUpdateTime').textContent = date(data.updatedAt);
  $('#installVersionUpdate').disabled = data.status !== 'ready';
  $('#downloadVersionUpdate').disabled = !state.versionUpdateManifest?.updateAvailable || ['preparing', 'downloading', 'ready', 'applying', 'staging', 'stopping', 'backing_up', 'installing', 'starting', 'rollback'].includes(data.status);
  renderVersionUpdateFiles();
  return data;
}
function renderVersionUpdateFiles() {
  const files = [...(state.versionUpdateManifest?.files || [])].sort((left, right) => Number(left.matches) - Number(right.matches) || String(left.path).localeCompare(String(right.path), 'zh-CN'));
  const pageSize = 5;
  const pageCount = Math.max(1, Math.ceil(files.length / pageSize));
  state.versionUpdateFilePage = Math.max(1, Math.min(pageCount, Number(state.versionUpdateFilePage || 1)));
  const start = (state.versionUpdateFilePage - 1) * pageSize;
  const page = files.slice(start, start + pageSize);
  $('#versionUpdateFileList').innerHTML = page.length ? page.map(file => {
    const name = file.path.split('/').pop();
    const currentSize = formatBytes(file.localSize);
    const targetSize = formatBytes(file.size);
    const downloaded = !file.matches && ['ready', 'applying', 'staging', 'stopping', 'backing_up', 'installing', 'starting'].includes(state.versionUpdateStatus);
    const installState = file.matches ? { className: 'installed', label: '已安装' } : downloaded ? { className: 'downloaded', label: '已下载' } : { className: 'pending', label: '需更新' };
    return `<article class="version-update-file"><span class="version-update-install-state ${installState.className}">${installState.label}</span><div class="version-update-file-name"><strong title="${esc(file.path)}">${esc(name)}</strong></div><span class="version-update-file-size" title="${esc(currentSize)}">${currentSize}</span><span class="version-update-file-size version-update-file-target-size" title="${esc(targetSize)}">${targetSize}</span><code title="${esc(file.sha256)}">${esc(file.sha256)}</code></article>`;
  }).join('') : '<div class="empty">没有更新文件</div>';
  $('#versionUpdatePageInfo').textContent = `第 ${state.versionUpdateFilePage} / ${pageCount} 页 · 共 ${files.length} 个文件`;
  $('#versionUpdatePrevPage').disabled = state.versionUpdateFilePage <= 1;
  $('#versionUpdateNextPage').disabled = state.versionUpdateFilePage >= pageCount;
}
async function loadVersionUpdateManifest() {
  const data = await api('/api/admin/version-update/manifest');
  state.versionUpdateManifest = data;
  state.versionUpdateFilePage = 1;
  const releaseLabel = (version, revision) => `${version || '--'}${Number(revision) > 0 ? ` (r${revision})` : ''}`;
  $('#versionUpdateCurrentVersion').textContent = releaseLabel(data.currentVersion, data.currentReleaseRevision);
  $('#versionUpdateRemoteVersion').textContent = releaseLabel(data.latestVersion, data.latestReleaseRevision);
  $('#versionUpdateFileCount').textContent = `${data.changedFileCount || 0} / ${data.fileCount || 0}`;
  $('#versionUpdateCurrentChecksum').textContent = data.currentChecksum || '--';
  $('#versionUpdateRemoteChecksum').textContent = data.remoteChecksum || '--';
  $('#versionUpdateChangedCount').textContent = `${data.changedFileCount || 0} 个文件需要更新`;
  renderVersionUpdateFiles();
  if (['idle', 'completed', 'failed', undefined].includes($('#versionUpdateStatusCard')?.dataset.status)) {
    const changed = Number(data.changedFileCount || 0);
    $('#versionUpdateStatusCard').className = 'version-update-current-status checked';
    $('#versionUpdateStatus').textContent = '已检查';
    $('#versionUpdateMessage').textContent = changed > 0 ? `检查完成，有 ${changed} 个文件更新` : '检查完成，当前已是最新版本';
    $('#versionUpdateStatusBar').style.width = '100%';
    $('#versionUpdateStatusDetail').hidden = true;
  }
  $('#downloadVersionUpdate').disabled = !data.updateAvailable || ['preparing', 'downloading', 'ready', 'applying', 'staging', 'stopping', 'backing_up', 'installing', 'starting', 'rollback'].includes($('#versionUpdateStatusCard')?.dataset.status);
  return data;
}
async function openVersionUpdateConfig() {
  const modal = $('#versionUpdateConfigModal');
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  await withBusy($('#reloadVersionUpdate'), () => Promise.all([loadVersionUpdateManifest(), loadVersionUpdate()]));
}
function closeVersionUpdateConfig() {
  $('#versionUpdateConfigModal').classList.remove('open');
  $('#versionUpdateConfigModal').setAttribute('aria-hidden', 'true');
}
async function pollVersionUpdateCard() {
  try {
    const data = await loadVersionUpdate();
    if (data.status === 'completed') { await loadVersionUpdateManifest().catch(() => {}); return; }
    if (['ready', 'failed'].includes(data.status)) return;
  } catch {
    const installing = ['applying', 'staging', 'stopping', 'backing_up', 'installing', 'starting', 'rollback'].includes($('#versionUpdateStatusCard')?.dataset.status);
    $('#versionUpdateMessage').textContent = installing ? '商城服务正在重启，等待恢复连接' : '下载状态读取失败，正在重试';
  }
  state.versionUpdateTimer = setTimeout(pollVersionUpdateCard, 1000);
}
async function downloadVersionUpdate(button) {
  await withBusy(button, async () => {
    const manifest = state.versionUpdateManifest || await loadVersionUpdateManifest();
    if (!manifest.updateAvailable) {
      window.alert(`当前版本 ${manifest.currentVersion} 已是最新版本。`);
      return;
    }
    try {
      await api('/api/admin/version-update/download', { method: 'POST' });
      clearTimeout(state.versionUpdateTimer);
      await loadVersionUpdate();
      state.versionUpdateTimer = setTimeout(pollVersionUpdateCard, 300);
    } catch (error) {
      $('#versionUpdateMessage').textContent = error.message;
      throw error;
    }
  });
}
async function installVersionUpdate(button) {
  if (!window.confirm('安装更新将关闭启动器和商城服务，安装完成后自动重新打开启动器并启动商城。是否继续？')) return;
  await withBusy(button, async () => {
    try {
      await api('/api/admin/version-update/install', { method: 'POST' });
      clearTimeout(state.versionUpdateTimer);
      await loadVersionUpdate();
      state.versionUpdateTimer = setTimeout(pollVersionUpdateCard, 300);
    } catch (error) {
      $('#versionUpdateMessage').textContent = error.message;
      $('#versionUpdateStatusCard').className = 'version-update-current-status failed';
      $('#versionUpdateStatus').textContent = '失败';
      $('#versionUpdateStatusBar').style.width = '100%';
      throw error;
    }
  });
}

async function loadLicenseAccount() {
  let data;
  try { data = await api('/api/license/status'); }
  catch (error) {
    if (error.status !== 404) throw error;
    const dashboard = await api('/api/dashboard');
    data = dashboard?.license ? { activated: true, ...dashboard.license } : { activated: false };
  }
  const activated = data.activated === true;
  const expiresAt = activated && data.expiresAt ? new Date(data.expiresAt) : null;
  const expired = Boolean(expiresAt && expiresAt.getTime() <= Date.now());
  const statePanel = $('#licenseAccountState');
  statePanel.className = `license-account-state ${!activated ? 'inactive' : expired ? 'expired' : 'active'}`;
  $('.license-account-badge', statePanel).className = `license-account-badge ${!activated ? 'inactive' : expired ? 'expired' : 'active'}`;
  $('.license-account-badge', statePanel).textContent = !activated ? '未授权' : expired ? '已过期' : '授权有效';
  $('strong', statePanel).textContent = !activated ? '商城程序尚未激活授权' : data.username || '--';
  $('small', statePanel).textContent = !activated ? '请通过启动授权页面完成账号连接' : expired ? '授权已超过有效期' : '授权验证正常';
  $('#licenseAccountUsername').textContent = activated ? data.username || '--' : '--';
  $('#licenseAccountStatus').textContent = !activated ? '未授权' : expired ? '已过期' : '有效';
  $('#licenseAccountExpiresAt').textContent = activated ? date(data.expiresAt) : '--';
  $('#licenseAccountVerifiedAt').textContent = activated ? date(data.lastVerifiedAt) : '--';
  $('#licenseAccountCenter').textContent = activated ? data.baseUrl || '--' : 'https://sq.scum0.cn';
  return data;
}

