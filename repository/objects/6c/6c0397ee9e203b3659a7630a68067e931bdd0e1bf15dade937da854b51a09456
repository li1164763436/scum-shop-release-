function renderStockPriceHistory() {
  const pageCount = Math.max(1, Math.ceil(state.stockPriceHistory.length / state.stockPricePageSize));
  state.stockPricePage = Math.min(Math.max(1, state.stockPricePage), pageCount);
  const start = (state.stockPricePage - 1) * state.stockPricePageSize;
  const history = state.stockPriceHistory.slice(start, start + state.stockPricePageSize);
  if ($('#stockPricePageInfo')) $('#stockPricePageInfo').textContent = `第 ${state.stockPricePage} / ${pageCount} 页`;
  if ($('#stockPricePrev')) $('#stockPricePrev').disabled = state.stockPricePage <= 1;
  if ($('#stockPriceNext')) $('#stockPriceNext').disabled = state.stockPricePage >= pageCount;
  if ($('#stockPriceRows')) $('#stockPriceRows').innerHTML = history.length ? history.map((row) => `<tr><td>${row.source === 'manual' ? '人工' : '自动'}</td><td>${number(row.priceBefore)}</td><td>${number(row.priceAfter)}</td><td>${number(row.volumeQuantity)} / ${number(row.volumeAmount)}</td><td>真实 ${(Number(row.volumeChangeBps||0)/100).toFixed(2)}% · 自动 ${(Number(row.simulatedVolumeChangeBps||0)/100).toFixed(2)}% · 随机 ${(Number(row.randomChangeBps||0)/100).toFixed(2)}%</td><td>${esc(row.actorUsername || '—')} / ${esc(row.reason || '—')}</td><td>${date(row.pricedAt)}</td></tr>`).join('') : empty(7, stockCurrent() ? '暂无价格事件' : '请在股票标的下拉框中选择已有股票');
