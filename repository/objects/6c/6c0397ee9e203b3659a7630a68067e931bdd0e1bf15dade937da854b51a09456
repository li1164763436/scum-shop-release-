function stockCurrent() {
  const select = $('#stockSelect'), selectedId = state.selectedStockId;
  const selected = selectedId === null ? undefined : state.stocks.find((item) => String(item.id) === selectedId);
  if (selected) {
    if (select) {
      Array.from(select.options).forEach((option) => { option.selected = option.value === selectedId; });
      select.value = selectedId;
    }
    return selected;
  }
  const domId = select?.value || '', domSelected = domId ? state.stocks.find((item) => String(item.id) === domId) : undefined;
  if (selectedId === null && !state.stockCreateMode && domSelected) {
    state.selectedStockId = String(domSelected.id);
    state.stockCreateMode = false;
    return domSelected;
  }
  return undefined;
}
