  if (trades.status === 'fulfilled') {
    state.stockTrades = list(trades.value);
    $('#stockTradeRows').innerHTML = state.stockTrades.length ? state.stockTrades.map((item) => `<tr><td>${esc(item.steamId)}</td><td>${esc(item.code)}</td><td>${item.direction === 'buy' ? '买入' : '卖出'}</td><td>${number(item.quantity)}</td><td>${number(item.price)}</td><td>${number(item.fee)}</td><td>${number(item.netAmount)}</td></tr>`).join('') : empty(7, '暂无交易记录');
  } else $('#stockTradeRows').innerHTML = empty(7, showStockInterfaceWarning(trades.reason) ? '接口未加载，请重启服务' : trades.reason.message);
  }
  if (announcements.status === 'fulfilled') {
    state.stockAnnouncements = list(announcements.value);
    ensureStockAnnouncementUi();
    $('#stockAnnouncementRows').innerHTML = state.stockAnnouncements.length ? '<div class="stock-announcement-table-wrap"><table class="stock-announcement-table"><thead><tr><th>序号</th><th>公告名称</th><th>公告内容</th><th>发布时间</th><th>结束时间</th><th>操作</th></tr></thead><tbody>'+state.stockAnnouncements.map((item,index)=>{const preview=String(item.content||'').replace(/\s+/g,' ').slice(0,10)+(String(item.content||'').length>10?'…':'');return '<tr><td>'+(index+1)+'</td><td>'+esc(item.title)+'</td><td title="'+esc(item.content||'')+'">'+esc(preview)+'</td><td>'+date(item.startsAt||item.createdAt)+'</td><td>'+date(item.endsAt)+'</td><td><button type="button" class="btn secondary small" data-edit-stock-announcement="'+item.id+'">编辑</button> <button type="button" class="btn danger small" data-delete-stock-announcement="'+item.id+'">删除</button></td></tr>'}).join('')+'</tbody></table></div>' : '<div class="stock-record-empty">暂无公告</div>';
    resetStockAnnouncementForm();
  } else $('#stockAnnouncementRows').innerHTML = `<div class="stock-record-empty">${esc(showStockInterfaceWarning(announcements.reason) ? '接口未加载，请重启服务' : announcements.reason.message)}</div>`;
  return stockCurrent();
}

$('#stockForm').addEventListener('submit', async (event) => {
  event.preventDefault();
  await withBusy(event.submitter, async () => {
    const form = event.currentTarget, item = stockCurrent(), id = item?.id ? String(item.id) : '', data = Object.fromEntries(new FormData(form));
    const submittedCode = normalizeStockCode(data.code);
    for (const name of ['currentPrice', 'basePrice', 'minPrice', 'periodSeconds', 'baselineValue', 'autoVolumeMax', 'volumeSensitivityBps', 'volatilityBps', 'maxChangeBps', 'feeBps']) data[name] = Number(data[name]);
    if (id) delete data.currentPrice;
    data.enabled = form.elements.enabled.checked;
    data.paused = form.elements.paused.checked;
    try {
      const saved = await api(id ? `/api/stocks/${id}` : '/api/stocks', { method: id ? 'PUT' : 'POST', body: JSON.stringify(data) });
      await loadStockMarket(saved.id);
      toast('股票标的已保存');
    } catch (error) {
      if (!id && error.status === 409 && error.code === 'DUPLICATE_CODE') {
        const stocks = list(await api('/api/stocks'));
        state.stocks = stocks;
        const existing = stocks.find((item) => normalizeStockCode(item.code) === submittedCode);
        if (existing) {
          await loadStockMarket(existing.id);
          toast('该代码已存在，已切换到现有股票');
          return;
        }
      }
      throw error;
    }
  });
});

