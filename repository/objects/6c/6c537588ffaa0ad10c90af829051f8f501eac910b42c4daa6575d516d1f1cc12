#page-store-settings .store-settings-summary {
  margin-bottom: 16px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

#page-store-settings .store-settings-summary article {
  min-width: 0;
  min-height: 102px;
  padding: 15px 17px;
  display: grid;
  align-content: center;
  gap: 4px;
  background: #fff;
  border: 1px solid var(--admin-line);
  border-top: 3px solid #47725a;
  border-radius: 8px;
  box-shadow: var(--admin-shadow);
}

#page-store-settings .store-settings-summary article:nth-child(2) { border-top-color: #c59a39; }
#page-store-settings .store-settings-summary article:nth-child(3) { border-top-color: #2f6fed; }
#page-store-settings .store-settings-summary article:nth-child(4) { border-top-color: #7b68a8; }
#page-store-settings .store-settings-summary span,
#page-store-settings .store-settings-summary small { color: var(--admin-muted); font-size: 10px; }
#page-store-settings .store-settings-summary strong {
  min-width: 0;
  overflow: hidden;
  color: var(--admin-text);
  font-size: 19px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
#page-store-settings .store-settings-summary strong.is-enabled { color: #16856b; }

#page-store-settings .store-settings-form { display: grid; gap: 16px; }
#page-store-settings .store-settings-form > .card { margin: 0; }
#page-store-settings .store-website-fields { grid-template-columns: minmax(220px, 360px); }
#page-store-settings .store-settings-hidden { display: none !important; }
#page-store-settings .store-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  align-items: start;
}
#page-store-settings .store-service-card { position: relative; min-width: 0; }
#page-store-settings .store-service-card .card-head { padding-left: 62px; }
#page-store-settings .store-settings-index {
  position: absolute;
  left: 20px;
  top: 20px;
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  color: #fff;
  background: #315d49;
  border-radius: 7px;
  font: 800 10px/1 Consolas, monospace;
}
#page-store-settings .store-settings-grid .form-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
#page-store-settings .store-settings-grid .form-grid label { min-width: 0; }
#page-store-settings .store-settings-note {
  min-height: 42px;
  margin: 0;
  padding: 11px 20px;
  color: #69776f;
  background: #f7f9f7;
  border-top: 1px solid var(--admin-line);
  font-size: 10px;
}
#page-store-settings .store-settings-savebar {
  position: sticky;
  bottom: 14px;
  z-index: 5;
  min-height: 64px;
  padding: 12px 14px 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: rgba(255, 255, 255, .96);
  border: 1px solid #cfd8d2;
  border-left: 4px solid #315d49;
  border-radius: 8px;
  box-shadow: 0 10px 28px rgba(31, 49, 40, .12);
  backdrop-filter: blur(8px);
}
#page-store-settings .store-settings-savebar div { display: grid; gap: 2px; }
#page-store-settings .store-settings-savebar strong { color: var(--admin-text); font-size: 12px; }
#page-store-settings .store-settings-savebar span { color: var(--admin-muted); font-size: 10px; }
#page-store-settings .store-settings-savebar .btn { min-width: 112px; }

@media (max-width: 1100px) {
  #page-store-settings .store-settings-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #page-store-settings .store-settings-grid { grid-template-columns: 1fr; }
}

@media (max-width: 720px) {
  #page-store-settings .store-settings-summary { grid-template-columns: 1fr; }
  #page-store-settings .store-settings-summary article { min-height: 86px; }
  #page-store-settings .store-service-card .card-head { padding-left: 54px; }
  #page-store-settings .store-settings-index { left: 15px; top: 16px; }
  #page-store-settings .store-settings-grid .form-grid { grid-template-columns: 1fr; }
  #page-store-settings .store-settings-savebar { bottom: 8px; align-items: stretch; flex-direction: column; }
  #page-store-settings .store-settings-savebar .btn { width: 100%; }
}
