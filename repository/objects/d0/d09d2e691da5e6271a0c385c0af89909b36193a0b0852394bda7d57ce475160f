function vehicleInsuranceStrategyModal(strategy = null) {
  openModal({ title:strategy ? `编辑保险策略 · ${strategy.name}` : '新增载具保险销售策略', description:'配置适用载具类型、赔付次数、有效时长和商城币售价。', submitText:'保存策略', body:vehicleInsuranceStrategyBody(strategy || {}), onSubmit:async(form) => {
    const f = form.elements, payload = { name:f.name.value.trim(), productId:Number(f.productId.value), totalClaimLimit:Number(f.totalClaimLimit.value), dailyClaimLimit:Number(f.dailyClaimLimit.value), durationDays:Number(f.durationDays.value), purchaseCondition:f.purchaseCondition.value.trim(), price:Number(f.price.value), enabled:f.enabled.checked };
    await api(strategy ? `/api/vehicles/insurance-strategies/${strategy.id}` : '/api/vehicles/insurance-strategies', { method:strategy ? 'PUT' : 'POST', body:JSON.stringify(payload) });
    toast(strategy ? '保险策略已更新' : '保险策略已新增'); closeModal(); await loadVehicleManagement(); showVehicleSection('insurance');
  }});
  $('#modalBackdrop').classList.add('centered-modal');
  const form = $('#modalForm'), productSelect = form?.elements.productId, codeInput = form?.elements.vehicleCode;
  const syncVehicleCode = () => { if (codeInput && productSelect) codeInput.value = productSelect.selectedOptions[0]?.dataset.vehicleCode || ''; };
  productSelect?.addEventListener('change', syncVehicleCode); syncVehicleCode();
}

function bindVehicleManagementEvents(root) {
  if (root.dataset.eventsBound) return; root.dataset.eventsBound = '1';
  $$('[data-vehicle-panel]', root).forEach((button) => button.addEventListener('click', () => showVehicleSection(button.dataset.vehiclePanel)));
  $('#createVehicleInsuranceStrategy').addEventListener('click', () => vehicleInsuranceStrategyModal());
  $('#vehicleLimitSettingsForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const payload = { enabled:$('#vehicleLimitEnabled').checked, allowedCount:Number($('#vehicleLimitAllowedCount').value), graceMinutes:Number($('#vehicleLimitGraceMinutes').value), warningIntervalMinutes:Number($('#vehicleLimitWarningMinutes').value) };
    await api('/api/vehicles/limit-governance/settings', { method:'PUT', body:JSON.stringify(payload) });
    toast(payload.enabled ? '数量治理策略已启用' : '数量治理策略已保存并停用');
    await loadVehicleManagement(); showVehicleSection('restrictions');
  });
  const reloadFirstPage = () => { state.vehiclePage = 1; loadVehicleManagement(); };
  $('#searchVehicles').addEventListener('click', reloadFirstPage);
  $('#vehicleSearch').addEventListener('keydown', (event) => { if (event.key === 'Enter') reloadFirstPage(); });
  $('#vehicleStatusFilter').addEventListener('change', reloadFirstPage);
  $('#vehicleInsuranceFilter').addEventListener('change', reloadFirstPage);
  $('#vehiclePreviousPage').addEventListener('click', () => { if (state.vehiclePage > 1) { state.vehiclePage -= 1; loadVehicleManagement(); } });
  $('#vehicleNextPage').addEventListener('click', () => { state.vehiclePage += 1; loadVehicleManagement(); });
  root.addEventListener('click', async (event) => {
    const strategyEdit = event.target.closest('[data-insurance-strategy-edit]');
    if (strategyEdit) return vehicleInsuranceStrategyModal((state.vehicleInsuranceStrategies || []).find((item) => item.id === Number(strategyEdit.dataset.insuranceStrategyEdit)));
    const strategyDelete = event.target.closest('[data-insurance-strategy-delete]');
    if (strategyDelete) { const strategy = (state.vehicleInsuranceStrategies || []).find((item) => item.id === Number(strategyDelete.dataset.insuranceStrategyDelete)); if (!confirm(`确认删除保险销售策略“${strategy?.name || ''}”？删除后仅停止新销售，已有保单和索赔不受影响。`)) return; await api(`/api/vehicles/insurance-strategies/${strategyDelete.dataset.insuranceStrategyDelete}`, { method:'DELETE' }); toast('保险销售策略已删除'); await loadVehicleManagement(); showVehicleSection('insurance'); return; }
    const policyDelete = event.target.closest('[data-insurance-purchase-delete]');
    if (policyDelete) { const policy = (state.vehicleInsurancePurchases || []).find((item) => item.id === Number(policyDelete.dataset.insurancePurchaseDelete)); if (!confirm(`确认删除玩家保单“${policy?.policyNumber || ''}”？删除后该保单立即失效，销售策略不受影响。`)) return; await api(`/api/vehicles/insurance-purchases/${policyDelete.dataset.insurancePurchaseDelete}`, { method:'DELETE' }); toast('玩家保单已删除'); await loadVehicleManagement(); showVehicleSection('insurance'); return; }
    const edit = event.target.closest('[data-vehicle-edit]'); if (edit) return vehicleEditorModal(state.vehicles.find((item) => item.id === Number(edit.dataset.vehicleEdit)));
    const detail = event.target.closest('[data-vehicle-detail]'); if (detail) return vehicleDetailModal(detail.dataset.vehicleDetail);
  });
}

