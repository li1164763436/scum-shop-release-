const vehicleStatusNames = { active:'正常', stored:'停放', maintenance:'维修', lost:'丢失', destroyed:'损毁', retired:'退役', recovered:'已回收' };
const vehicleEditableStatusNames = { active:'正常', stored:'停放', maintenance:'维修', lost:'丢失', destroyed:'损毁', retired:'退役' };
const vehicleInsuranceNames = { none:'无保单', active:'已投保', expired:'已过期', suspended:'已暂停', claimed:'已索赔' };
const vehicleActionNames = { create:'创建档案', update:'更新档案', insurance_update:'更新保险', delete:'删除档案', sync_create:'同步创建', sync_update:'同步更新', sync_lost:'同步标记失联', sync_restore:'同步恢复' };
function vehicleDateInput(value) { if (!value) return ''; const dateValue = new Date(value); if (Number.isNaN(dateValue.getTime())) return ''; const local = new Date(dateValue.getTime() - dateValue.getTimezoneOffset() * 60000); return local.toISOString().slice(0,16); }
function vehiclePercent(value) { return value === null || value === undefined || value === '' ? '--' : `${Number(value).toFixed(0)}%`; }
function vehicleStatusBadge(status) { const tone = status === 'active' ? 'active' : status === 'lost' || status === 'destroyed' ? 'failed' : status === 'maintenance' ? 'pending' : 'inactive'; return `<span class="badge ${tone}">${esc(vehicleStatusNames[status] || status || '未知')}</span>`; }
function vehicleInsuranceBadge(status) { const value = status || 'none'; const tone = value === 'active' ? 'active' : value === 'expired' || value === 'suspended' ? 'failed' : value === 'claimed' ? 'pending' : 'inactive'; return `<span class="badge ${tone}">${esc(vehicleInsuranceNames[value] || value)}</span>`; }
function vehicleSyncBadge(vehicle) { const state = vehicle.sourceSyncState || 'manual'; const name = state === 'present' ? '已同步' : state === 'missing' ? '源中缺失' : '手动'; const tone = state === 'present' ? 'active' : state === 'missing' ? 'failed' : 'inactive'; return `<span class="badge ${tone}">${name}</span><small class="vehicle-sync-time">${esc(date(vehicle.sourceSynchronizedAt))}</small>`; }

async function loadVehicleManagement() {
  const root = $('#page-vehicle-management'); if (!root) return;
  bindVehicleManagementEvents(root);
  $('#vehicleRows').innerHTML = empty(9, '正在加载载具...', true);
  const strategyRows = $('#vehicleInsuranceStrategyRows'); if (strategyRows) strategyRows.innerHTML = empty(8, '正在加载保险策略...', true);
  try {
    state.vehiclePage = Math.max(Number(state.vehiclePage) || 1, 1);
    const params = new URLSearchParams({ search: $('#vehicleSearch').value.trim(), status: $('#vehicleStatusFilter').value, insuranceStatus: $('#vehicleInsuranceFilter').value, page:state.vehiclePage, pageSize:30 });
    const [vehicles, summary, strategies, insuranceProducts, insurancePurchases, syncStatus, limitGovernance] = await Promise.all([api(`/api/vehicles?${params}`), api('/api/vehicles/summary'), api('/api/vehicles/insurance-strategies'), api('/api/vehicles/insurance-products'), api('/api/vehicles/insurance-purchases?pageSize=100'), api('/api/vehicles/sync-status'), api('/api/vehicles/limit-governance').catch((error) => ({ error }))]);
    const automaticSync = syncStatus || { enabled:false, running:false, lastError:null };
    state.vehicles = list(vehicles, ['vehicles','items']);
    state.vehicleTotal = Number(vehicles?.total ?? state.vehicles.length);
    state.vehiclePage = Number(vehicles?.page ?? state.vehiclePage);
    state.vehiclePageSize = Number(vehicles?.pageSize ?? 30);
    state.vehicleInsuranceStrategies = list(strategies, ['strategies','items']);
    state.vehicleInsuranceProducts = list(insuranceProducts, ['products','items']);
    state.vehicleInsurancePurchases = list(insurancePurchases, ['purchases','items']);
    $('#vehicleTotalCount').textContent = number(summary.total);
    $('#vehicleActiveCount').textContent = number(summary.active);
    $('#vehicleInsuredCount').textContent = number(summary.insured);
    $('#vehicleAttentionCount').textContent = number(summary.attention);
    $('#vehicleSynchronizedCount').textContent = number(summary.synchronized);
    $('#vehicleLastSynchronizedAt').textContent = date(summary.lastSynchronizedAt || automaticSync.lastSuccessAt);
    const syncState = $('#vehicleSyncState');
    syncState.textContent = automaticSync.running ? '同步中' : automaticSync.lastError ? '同步异常' : automaticSync.enabled ? '运行中' : '已停止';
    syncState.className = automaticSync.lastError ? 'failed' : automaticSync.running ? 'pending' : automaticSync.enabled ? 'active' : 'inactive';
    syncState.title = automaticSync.lastError || '';
    $('#vehicleResultCount').textContent = `${number(state.vehicleTotal)} 辆载具`;
    const totalPages = Math.max(1, Math.ceil(state.vehicleTotal / state.vehiclePageSize));
    $('#vehiclePageStatus').textContent = `第 ${state.vehiclePage} / ${totalPages} 页`;
    $('#vehiclePreviousPage').disabled = state.vehiclePage <= 1;
    $('#vehicleNextPage').disabled = state.vehiclePage >= totalPages;
    renderVehicleInsuranceStrategies(state.vehicleInsuranceStrategies);
    renderVehicleInsuranceRows(state.vehicleInsurancePurchases, Number(insurancePurchases?.total ?? state.vehicleInsurancePurchases.length));
    if (limitGovernance?.error) renderVehicleLimitGovernanceError(limitGovernance.error);
    else renderVehicleLimitGovernance(limitGovernance || {});
    $('#vehicleRows').innerHTML = state.vehicles.length ? state.vehicles.map((vehicle) => {
      const position = vehicle.gridCode || (vehicle.worldX !== null && vehicle.worldY !== null ? `X ${number(vehicle.worldX)} / Y ${number(vehicle.worldY)}` : '未记录');
      const owner = vehicle.ownerName || vehicle.ownerSteamId || '未绑定车主';
      return `<tr><td><div class="row-actions"><button class="btn secondary small" type="button" data-vehicle-detail="${vehicle.id}">详情</button><button class="btn secondary small" type="button" data-vehicle-edit="${vehicle.id}">编辑</button></div></td><td>${vehicleStatusBadge(vehicle.status)}</td><td>${vehicleSyncBadge(vehicle)}</td><td><div class="vehicle-identity"><strong>${esc(vehicle.displayName || vehicle.modelName)}</strong><span>${esc(vehicle.vehicleCode)} · ${esc(vehicle.vehicleType)}</span><small>${esc(vehicle.sourceType ? `自动同步 · ${vehicle.sourceAssetId || vehicle.sourceVehicleAlias || vehicle.modelName}` : (vehicle.plateNumber || vehicle.modelName))}</small></div></td><td><strong>${esc(owner)}</strong><small class="vehicle-steam">${esc(vehicle.ownerSteamId || '')}</small></td><td>${vehicleInsuranceBadge(vehicle.insuranceStatus)}<small class="vehicle-policy">${esc(vehicle.policyNumber || '无保单号')}</small></td><td><span class="vehicle-location">${esc(position)}</span><small>${esc(vehicle.locationNote || '无位置说明')}</small></td><td><span>${vehiclePercent(vehicle.conditionPercent)} / ${vehiclePercent(vehicle.fuelPercent)}</span></td><td>${esc(date(vehicle.updatedAt))}</td></tr>`;
    }).join('') : empty(9, '暂无载具档案');
    bindVehicleManagementEvents(root);
  } catch (error) {
    $('#vehicleRows').innerHTML = empty(9, error.message);
    if ($('#vehicleInsuranceStrategyRows')) $('#vehicleInsuranceStrategyRows').innerHTML = empty(8, error.message);
    if ($('#vehicleLimitOwnerRows')) $('#vehicleLimitOwnerRows').innerHTML = empty(6, error.message);
    if ($('#vehicleLimitTaskRows')) $('#vehicleLimitTaskRows').innerHTML = empty(6, error.message);
    ['vehicleTotalCount','vehicleActiveCount','vehicleInsuredCount','vehicleAttentionCount'].forEach((id) => $(`#${id}`).textContent = '--');
  }
}

function showVehicleSection(name) {
  const root = $('#page-vehicle-management'); if (!root) return;
  $$('[data-vehicle-panel]', root).forEach((button) => button.classList.toggle('active', button.dataset.vehiclePanel === name));
  $$('[data-vehicle-section]', root).forEach((section) => { section.hidden = section.dataset.vehicleSection !== name; });
}

function vehicleLimitStatusBadge(status) {
  const names = { compliant:'合规', threshold:'达到上限', exceeded:'宽限期', pending:'待移除', removing:'执行中', removed:'已移除', cancelled:'已取消', review:'人工复核' };
  const tone = status === 'removed' || status === 'compliant' ? 'active' : status === 'review' ? 'failed' : status === 'threshold' ? 'inactive' : 'pending';
  return `<span class="badge ${tone}">${esc(names[status] || status || '未知')}</span>`;
}

function renderVehicleLimitGovernance(data) {
  const settings = data.settings || {}, summary = data.summary || {}, owners = data.owners || [], tasks = data.tasks || [], worker = data.worker || {};
  state.vehicleLimitGovernance = data;
  $('#vehicleLimitEnabled').checked = Boolean(settings.enabled);
  $('#vehicleLimitAllowedCount').value = settings.allowedCount ?? 3;
  $('#vehicleLimitGraceMinutes').value = settings.graceMinutes ?? 1440;
  $('#vehicleLimitWarningMinutes').value = settings.warningIntervalMinutes ?? 60;
  $('#vehicleLimitThresholdCount').textContent = number(summary.thresholdPlayers || 0);
  $('#vehicleLimitExceededCount').textContent = number(summary.exceededPlayers || 0);
  $('#vehicleLimitExcessCount').textContent = number(summary.excessVehicles || 0);
  $('#vehicleLimitReviewCount').textContent = number(summary.reviewPlayers || 0);
  const workerState = $('#vehicleLimitWorkerState');
  workerState.textContent = !settings.enabled ? '策略未启用' : worker.lastError ? '监测异常' : worker.running ? '正在监测' : worker.enabled ? '监测运行中' : 'Worker 已停止';
  workerState.className = `badge ${!settings.enabled || !worker.enabled ? 'inactive' : worker.lastError ? 'failed' : worker.running ? 'pending' : 'active'}`;
  workerState.title = worker.lastError || '';
  $('#vehicleLimitOwnerCount').textContent = `${number(owners.length)} 名玩家`;
  $('#vehicleLimitOwnerRows').innerHTML = owners.length ? owners.map((owner) => `<tr><td><strong>${esc(owner.playerName || owner.steamId)}</strong><small>${esc(owner.steamId)}</small></td><td><strong>${number(owner.lockedCount)} / ${number(owner.allowedCount)}</strong></td><td>${vehicleLimitStatusBadge(owner.status)}</td><td>${esc(date(owner.exceededAt))}</td><td>${esc(date(owner.removalDeadline))}</td><td>${esc(date(owner.lastWarnedAt))}</td></tr>`).join('') : empty(6, '当前没有达到上限或超限的玩家');
  $('#vehicleLimitTaskCount').textContent = `${number(tasks.length)} 条任务`;
  $('#vehicleLimitTaskRows').innerHTML = tasks.length ? tasks.map((task) => `<tr><td>${vehicleLimitStatusBadge(task.status)}</td><td><strong>${esc(task.steamId)}</strong></td><td><strong>${esc(task.vehicleName || `载具 #${task.sourceVehicleId}`)}</strong><small>实体 #${esc(task.sourceVehicleId)}</small></td><td>${esc(date(task.removalDeadline))}</td><td>${number(task.attempts)}</td><td><span>${esc(task.lastError || (task.status === 'removed' ? `完成于 ${date(task.completedAt)}` : '等待执行'))}</span></td></tr>`).join('') : empty(6, '当前没有移除任务');
}

function renderVehicleLimitGovernanceError(error) {
  $('#vehicleLimitWorkerState').textContent = '读取失败';
  $('#vehicleLimitWorkerState').className = 'badge failed';
  $('#vehicleLimitOwnerRows').innerHTML = empty(6, error.message);
  $('#vehicleLimitTaskRows').innerHTML = empty(6, error.message);
