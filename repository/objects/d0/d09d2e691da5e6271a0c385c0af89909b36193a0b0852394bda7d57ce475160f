    <div class="vehicle-form-grid"><label>保险状态<select name="insuranceStatus">${Object.entries(vehicleInsuranceNames).map(([key,label]) => `<option value="${key}"${insuranceStatus === key ? ' selected' : ''}>${label}</option>`).join('')}</select></label><label>保单编号<input name="policyNumber" maxlength="100" value="${esc(vehicle.policyNumber || '')}"></label><label>保险价值<input name="insuredValue" type="number" min="0" step="1" value="${esc(vehicle.insuredValue ?? '')}"></label><label>保费<input name="premiumAmount" type="number" min="0" step="1" value="${esc(vehicle.premiumAmount ?? '')}"></label><label>生效时间<input name="insuranceStartsAt" type="datetime-local" value="${vehicleDateInput(vehicle.insuranceStartsAt)}"></label><label>到期时间<input name="insuranceExpiresAt" type="datetime-local" value="${vehicleDateInput(vehicle.insuranceExpiresAt)}"></label><label class="full">保障范围<textarea name="coverageNote" maxlength="1000">${esc(vehicle.coverageNote || '')}</textarea></label><label class="full">保险备注<textarea name="insuranceNotes" maxlength="1000">${esc(vehicle.insuranceNotes || '')}</textarea></label><label class="full">载具备注<textarea name="notes" maxlength="2000">${esc(vehicle.notes || '')}</textarea></label></div>
    ${vehicle.id ? `<button class="btn danger vehicle-delete" type="button" data-delete-vehicle="${vehicle.id}">删除载具档案</button>` : ''}
  </section>`;
}

function optionalNumberInput(element) { return element.value === '' ? null : Number(element.value); }
function optionalDateInput(element) { return element.value ? new Date(element.value).toISOString() : null; }
function setupVehicleMapPicker() {
  const picker = $('#vehicleMapPicker'), marker = $('#vehicleMapMarker'), form = $('#modalForm'); if (!picker || !marker) return;
  const render = () => { const x = Number(form.elements.mapXPercent.value), y = Number(form.elements.mapYPercent.value); const visible = Number.isFinite(x) && Number.isFinite(y) && form.elements.mapXPercent.value !== '' && form.elements.mapYPercent.value !== ''; marker.hidden = !visible; if (visible) { marker.style.left = `${x}%`; marker.style.top = `${y}%`; } };
  picker.addEventListener('click', (event) => { const rect = picker.querySelector('img').getBoundingClientRect(); const x = Math.max(0, Math.min(100, (event.clientX - rect.left) / rect.width * 100)); const y = Math.max(0, Math.min(100, (event.clientY - rect.top) / rect.height * 100)); form.elements.mapXPercent.value = x.toFixed(4); form.elements.mapYPercent.value = y.toFixed(4); render(); });
  form.elements.mapXPercent.addEventListener('input', render); form.elements.mapYPercent.addEventListener('input', render); render();
}

function vehicleEditorModal(vehicle = null) {
  openModal({ title: vehicle ? `编辑载具 · ${vehicle.vehicleCode}` : '新增载具档案', description: '档案与保险均由管理员手动维护；地图点击仅记录标记百分比。', submitText: '保存载具', body: vehicleEditorBody(vehicle || {}), onSubmit: async (form) => {
    const f = form.elements;
    const payload = { vehicleCode:f.vehicleCode.value.trim(),status:f.status.value,vehicleType:f.vehicleType.value.trim(),modelName:f.modelName.value.trim(),displayName:f.displayName.value.trim(),plateNumber:f.plateNumber.value.trim(),ownerSteamId:f.ownerSteamId.value.trim(),ownerName:f.ownerName.value.trim(),conditionPercent:optionalNumberInput(f.conditionPercent),fuelPercent:optionalNumberInput(f.fuelPercent),gridCode:f.gridCode.value.trim(),worldX:optionalNumberInput(f.worldX),worldY:optionalNumberInput(f.worldY),worldZ:optionalNumberInput(f.worldZ),mapXPercent:optionalNumberInput(f.mapXPercent),mapYPercent:optionalNumberInput(f.mapYPercent),locationNote:f.locationNote.value.trim(),lastSeenAt:optionalDateInput(f.lastSeenAt),notes:f.notes.value.trim() };
    const saved = await api(vehicle ? `/api/vehicles/${vehicle.id}` : '/api/vehicles', { method: vehicle ? 'PUT' : 'POST', body: JSON.stringify(payload) });
    await api(`/api/vehicles/${saved.id}/insurance`, { method:'PUT', body:JSON.stringify({ status:f.insuranceStatus.value,policyNumber:f.policyNumber.value.trim(),insuredValue:optionalNumberInput(f.insuredValue),premiumAmount:optionalNumberInput(f.premiumAmount),startsAt:optionalDateInput(f.insuranceStartsAt),expiresAt:optionalDateInput(f.insuranceExpiresAt),coverageNote:f.coverageNote.value.trim(),notes:f.insuranceNotes.value.trim() }) });
    toast('载具档案已保存'); closeModal(); await loadVehicleManagement();
  }});
  setupVehicleMapPicker();
  $('[data-delete-vehicle]')?.addEventListener('click', async (event) => { if (!confirm('确认删除该载具档案？保险资料会一并删除，审计记录保留。')) return; await api(`/api/vehicles/${event.currentTarget.dataset.deleteVehicle}`, { method:'DELETE' }); toast('载具档案已删除'); closeModal(); await loadVehicleManagement(); });
}

async function vehicleDetailModal(id) {
  openModal({ title:'载具详情', description:'正在读取载具档案与审计记录', submitText:'关闭', body:'<div class="empty loading">正在加载...</div>', onSubmit:async()=>closeModal() });
  try {
    const data = await api(`/api/vehicles/${id}`), vehicle = data.vehicle, audits = data.audits || [];
    $('#modalTitle').textContent = vehicle.displayName || vehicle.modelName;
    $('#modalDescription').textContent = `${vehicle.vehicleCode} · ${vehicleStatusNames[vehicle.status] || vehicle.status}`;
    $('#modalBody').innerHTML = `<section class="vehicle-detail full"><div class="vehicle-detail-map"><img src="/shop/assets/teleport/scum-map-ultra.webp" alt="SCUM地图">${vehicle.mapXPercent !== null && vehicle.mapYPercent !== null ? `<span style="left:${vehicle.mapXPercent}%;top:${vehicle.mapYPercent}%"></span>` : ''}</div><dl><div><dt>车主</dt><dd>${esc(vehicle.ownerName || vehicle.ownerSteamId || '未绑定')}</dd></div><div><dt>类型 / 型号</dt><dd>${esc(vehicle.vehicleType)} / ${esc(vehicle.modelName)}</dd></div><div><dt>车牌</dt><dd>${esc(vehicle.plateNumber || '--')}</dd></div><div><dt>保险</dt><dd>${esc(vehicleInsuranceNames[vehicle.insuranceStatus || 'none'])} · ${esc(vehicle.policyNumber || '无保单号')}</dd></div><div><dt>坐标</dt><dd>${esc(vehicle.gridCode || '--')} · X ${esc(vehicle.worldX ?? '--')} / Y ${esc(vehicle.worldY ?? '--')} / Z ${esc(vehicle.worldZ ?? '--')}</dd></div><div><dt>最后发现</dt><dd>${esc(date(vehicle.lastSeenAt))}</dd></div><div><dt>档案来源</dt><dd>${esc(vehicle.sourceType ? `SCUM.db 上锁载具 #${vehicle.sourceVehicleId}` : '管理员手动维护')}</dd></div><div><dt>同步状态</dt><dd>${esc(vehicle.sourceSyncState === 'present' ? '已同步' : vehicle.sourceSyncState === 'missing' ? '源中缺失' : '手动')}</dd></div><div><dt>锁槽数量</dt><dd>${esc(vehicle.sourceLockSlots ?? '--')}</dd></div><div><dt>位置来源</dt><dd>${esc(vehicle.locationSource || '--')}</dd></div><div><dt>最后同步</dt><dd>${esc(date(vehicle.sourceSynchronizedAt))}</dd></div><div><dt>源缺失开始</dt><dd>${esc(date(vehicle.sourceMissingSince))}</dd></div><div class="wide"><dt>位置说明</dt><dd>${esc(vehicle.locationNote || '--')}</dd></div><div class="wide"><dt>备注</dt><dd>${esc(vehicle.notes || '--')}</dd></div></dl><h3>操作记录</h3><div class="vehicle-audit-list">${audits.length ? audits.map((audit) => `<article><strong>${esc(vehicleActionNames[audit.action] || audit.action)}</strong><span>${esc(audit.actorName || 'system')} · ${esc(date(audit.createdAt))}</span></article>`).join('') : '<div class="empty">暂无操作记录</div>'}</div></section>`;
  } catch (error) { $('#modalBody').innerHTML = `<div class="empty">${esc(error.message)}</div>`; }
}
