function customerFallback(status, fallback) {
  if (status === 400 || status === 422) return '填写的信息有误，请检查后重试';
  if (status === 401) return '登录状态已失效，请重新登录';
  if (status === 403) return '当前账户不能执行此操作';
  if (status === 404) return '没有找到相关内容，请刷新页面后重试';
  if (status === 409) return '当前状态已发生变化，请刷新后重试';
  if (status === 423) return '该操作暂时不可用，请稍后重试';
  if (status === 413) return '提交的内容过大，请精简后重试';
  if (status === 429) return '操作过于频繁，请稍后再试';
  if (status === 0 || status >= 500) return '商城服务暂时不可用，请稍后重试';
  return fallback;
}

function chineseErrorMessage(value, fallback = '操作失败，请稍后重试', details = {}) {
  const message = String(value || '').trim();
  const safeFallback = customerErrorByCode[details.code] || customerFallback(Number(details.status), fallback);
  if (!message) return safeFallback;
  if (/timeout|timed out/i.test(message)) return '请求超时，请稍后重试';
  if (/unauthorized|forbidden|access denied/i.test(message)) return '当前账户不能执行此操作';
  if (/network|connection|socket|fetch failed/i.test(message)) return '网络连接失败，请稍后重试';
  const internalDetail = /(?:命令|数据库|堆栈|字段|接口|后端|服务端|部署|重启|duplicate\s+entry|(?:primary|foreign)\s+key|for\s+key\s+['"`\w]|\b(?:rcon|sql|mysql|http|api|json|error|exception|traceback|stack|errno|econn\w*|etimedout|spawn|command|column|table|constraint|node_modules|idempotency[-_ ]?key|request_?id|payload_?json|steam_id|inventory_id|undefined|null)\b|https?:\/\/|#[a-z]\w*|\b(?:select|insert|update|delete|create|alter|drop)\b|(?:[a-z]:\\|\\\\|\/[^\s]+\/[^\s]+\.(?:js|ts|py):\d+))/i;
  const gameCommand = /\b(?:Give|Set|Spawn|Teleport|Change|Destroy|Remove|Add)[A-Z][A-Za-z0-9_]*\b/;
  const unexpectedEnglish = /[a-z]{3,}/i.test(message.replace(/\b(?:SCUM|SteamID)\b/gi, ''));
  if (internalDetail.test(message) || gameCommand.test(message) || unexpectedEnglish || /[\r\n\u0000-\u001f]/u.test(message) || message.length > 160) return safeFallback;
  if (/[\u3400-\u9fff]/u.test(message)) return message;
  if (/not found|does not exist/i.test(message)) return '没有找到相关内容，请刷新页面后重试';
  return safeFallback;
}

