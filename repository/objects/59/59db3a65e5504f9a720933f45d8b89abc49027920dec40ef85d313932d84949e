function showRoute(route, updateHash = true, options = {}) {
  const legacyActivityPanel = route === 'lottery' || route === 'market' ? route : null;
  const requested = legacyActivityPanel ? 'activity' : route;
  if (['account', 'orders'].includes(requested) && !state.user && options.pending !== true) {
    showRoute('store', false);
    openAuth('login');
    return;
  }
  const target = ['store', 'activity', 'account', 'orders', 'membership'].includes(requested) ? requested : 'store';
  $$('.page').forEach((page) => page.classList.toggle('active', page.id === `page-${target}`));
  $$('.nav-link').forEach((link) => link.classList.toggle('active', link.dataset.route === target));
  $('#mainNav').classList.remove('open');
  $('#menuToggle').setAttribute('aria-expanded', 'false');
  if (updateHash || legacyActivityPanel) history.replaceState(null, '', `#${target}`);
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (target === 'activity') showActivityPanel(legacyActivityPanel || state.activityPanel, options.pending !== true);
  else stopMarketAutoRefresh();
  if (options.pending === true) return;
  if (target === 'account') { showAccountSection(); Promise.allSettled([loadAccount(), loadRewardStatus(), loadExchangeConfig()]); }
  if (target === 'orders') loadOrders();
  if (target === 'membership') loadMembershipPage();
}

