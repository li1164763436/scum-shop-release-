function openCloudRecycleModal() {
  const input = $('#cloudRecycleItemId');
  const itemInfo = $('#cloudRecycleItemInfo');
  const hint = document.querySelector('.cloud-recycle-hint');
  const hintImage = hint?.querySelector('img[data-src]');
  if (hintImage && !hintImage.src) hintImage.src = hintImage.dataset.src;
  const layout = document.querySelector('.cloud-recycle-layout');
  if (itemInfo && layout && itemInfo.parentElement !== layout) layout.appendChild(itemInfo);
  const actions = document.querySelector('.cloud-recycle-content .modal-actions');
  if (actions && layout && actions.parentElement !== layout) layout.appendChild(actions);
