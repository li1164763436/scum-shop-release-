function showActivityPanel(panel, load = true) {
  const target = ['lottery', 'market', 'gifts', 'cloud', 'insurance', 'teleport'].includes(panel) ? panel : 'lottery';
  state.activityPanel = target;
  $$('.activity-panel').forEach((element) => {
    const panelId = target === 'cloud' ? 'cloudWarehouseSection' : target === 'teleport' ? 'page-teleport' : target === 'insurance' ? 'page-insurance' : `activity-panel-${target}`;
    const active = element.id === panelId;
    element.hidden = !active;
    element.classList.toggle('active', active);
  });
  $$('.activity-tab').forEach((button) => {
    const active = button.dataset.activityPanel === target;
    button.classList.toggle('active', active);
    button.setAttribute('aria-selected', String(active));
  });
  if (!state.user) {
    stopMarketAutoRefresh();
    if (target === 'gifts') renderGifts();
    return;
  }
  if (target === 'market') {
    stopMarketAutoRefresh({ invalidate: false });
    if (load) (target === 'market' ? loadMarket : loadLottery)();
  } else {
    stopMarketAutoRefresh();
  }
  if (target === 'cloud') {
    showCloudPage('warehouse');
    if (load) Promise.all([loadCloudWarehouse(), loadCloudMarket()]);
  }
  if (target === 'lottery' && load) loadLottery();
  if (target === 'insurance' && load) loadVehicleInsurance();
  if (target === 'teleport') {
    const mapImage = $('#teleportMapImage');
    if (mapImage?.dataset.src && !mapImage.src) mapImage.src = mapImage.dataset.src;
    if (load) loadTeleportMapData().catch(() => {});
  }
  if (target === 'gifts') {
    renderGifts();
    if (load) loadGifts();
  }
}

function showAccountSection(section = 'accountProfileSection') {
  const target = document.getElementById(section)?.classList.contains('account-panel') ? section : 'accountProfileSection';
  $$('.account-panel').forEach((panel) => { panel.hidden = panel.id !== target; });
  $$('[data-account-section]').forEach((button) => button.classList.toggle('active', button.dataset.accountSection === target));
