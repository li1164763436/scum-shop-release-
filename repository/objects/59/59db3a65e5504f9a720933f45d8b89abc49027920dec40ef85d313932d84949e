  }
  if (authenticated && !wasAuthenticated && $('#page-activity').classList.contains('active')) showActivityPanel(state.activityPanel);
}

function normalizedUser(data) {
  const source = data?.user && typeof data.user === 'object' ? { ...data, ...data.user } : data;
  return source && typeof source === 'object' ? source : null;
}

function accountUser(data) {
  const account = data?.account && typeof data.account === 'object' ? data.account : data;
  if (!account || typeof account !== 'object') return null;
  return {
    ...state.user,
    ...account,
    balance: pick(account, ['balance', 'coinBalance', 'coins'], pick(data, ['balance', 'coinBalance', 'coins'], state.user?.balance || 0))
  };
}

async function loadMe() {
  try {
    const user = normalizedUser(await api('/api/shop/auth/me'));
    setUser(user);
    if (user) {
      await Promise.all([
        (async () => {
          try {
            const account = await api('/api/shop/account');
            if (!state.user || String(pick(state.user, ['steamId', 'steamID', 'steam_id'], '')) !== String(pick(user, ['steamId', 'steamID', 'steam_id'], ''))) return;
            state.account = account || {};
            setUser(accountUser(account));
          } catch (error) { if (error.status !== 401) console.warn('账户余额读取失败:', error.message); }
        })(),
        loadGifts()
      ]);
    }
  } catch (error) { if (error.status !== 401) console.warn('身份状态读取失败:', error.message); }
}

