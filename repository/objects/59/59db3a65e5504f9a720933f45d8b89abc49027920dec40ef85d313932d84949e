  if (quota) quota.textContent = `今日剩余额度：${number(state.cloudWarehouse?.quota?.remaining ?? 0)}`;
  if (!input) return;
  resetCloudRecycleModal({ clearInput: false });
  openModal($('#cloudRecycleModal'));
}

async function queryCloudRecycleItem(button) {
  const itemId = $('#cloudRecycleItemId').value.trim();
  const feedback = $('#cloudRecycleFeedback');
  const itemInfo = $('#cloudRecycleItemInfo');
  const itemInfoValue = $('#cloudRecycleItemInfoValue');
  feedback.hidden = true;
  if (!itemId || itemId.length > 80) {
    feedback.textContent = '请输入有效的库存编号';
    feedback.hidden = false;
    $('#cloudRecycleItemId').focus();
    return;
  }
  await withBusy(button, async () => {
    $('#cloudRecycleModal').dataset.queried = 'true';
    if (itemInfoValue) itemInfoValue.textContent = itemId;
    try {
      const result = await api('/api/shop/cloud-warehouse/recycle/inspect', { method: 'POST', body: JSON.stringify({ itemId }) });
      const item = result?.data || result || {};
      result.data = item;
      if (itemInfoValue) itemInfoValue.textContent = item.itemName || item.itemCode || itemId;
      const image = $('#cloudRecycleItemImage');
      if (image) { image.src = item.imagePath || ''; image.hidden = !item.imagePath; }
      const details = $('#cloudRecycleItemDetails');
      if (details) details.textContent = `物品名称：${result.data.itemName}；物品代码：${result.data.itemCode}；耐久：${result.data.health ?? '-'} / ${result.data.maxHealth ?? '-'}；使用次数：${result.data.uses ?? '-'} / ${result.data.maxUses ?? '-'}；脏度：${result.data.dirtiness ?? '-'}；所在容器：${result.data.container || '-'}`;
      if (details) details.textContent = [
        `物品名称：${item.itemName || '-'}`, `物品代码：${item.itemCode || '-'}`, `耐久：${item.health ?? '-'}`,
        `使用次数：${item.uses ?? '-'} / ${item.maxUses ?? '-'}`, `脏度：${item.dirtiness ?? '-'}`, `所在容器：${item.container || '-'}`
      ].join('  |  ');
      if (details) {
        details.replaceChildren();
        const fields = [
          ['物品名称', item.itemName || '-'], ['物品代码', item.itemCode || '-'], ['库存编号', item.itemId || itemId],
          ['所在容器', item.container || '-'], ['耐久', item.health ?? '-'], ['使用次数', item.uses === null || item.uses === undefined ? '-' : item.maxUses === null || item.maxUses === undefined ? item.uses : `${item.uses} / ${item.maxUses}`],
          ['脏度', item.dirtiness ?? '-']
        ];
        for (const [label, value] of fields) {
          const field = document.createElement('div');
          field.className = 'cloud-recycle-detail-field';
          const name = document.createElement('span');
          const content = document.createElement('b');
          name.textContent = label;
          content.textContent = String(value);
          field.append(name, content);
          details.appendChild(field);
        }
      }
      if (itemInfo) itemInfo.hidden = false;
      return;
      closeModal($('#cloudRecycleModal'));
      toast('回收成功');
      await loadCloudWarehouse();
    } catch (error) {
      const message = error.status === 404 && error.code === 'NOT_FOUND'
        ? '当前暂不支持物品回收，请稍后再试'
        : chineseErrorMessage(error.message, '物品信息读取失败，请稍后重试');
      feedback.textContent = message;
      feedback.hidden = false;
      toast(message, 'error');
    }
  });
}

async function confirmCloudRecycle(button) {
  const itemId = $('#cloudRecycleItemId').value.trim();
  const feedback = $('#cloudRecycleFeedback');
  if (!itemId) {
    feedback.textContent = '请输入库存编号';
    feedback.hidden = false;
    return;
  }
  await withBusy(button, async () => {
    try {
      feedback.hidden = true;
      await api('/api/shop/cloud-warehouse/recycle', { method: 'POST', body: JSON.stringify({ itemId }) });
      closeModal($('#cloudRecycleModal'));
      toast('回收成功');
      await loadCloudWarehouse();
    } catch (error) {
      const message = chineseErrorMessage(error.message, '回收失败，请稍后重试');
      feedback.textContent = message;
      feedback.hidden = false;
      toast(message, 'error');
    }
  });
}

function resetStockChartModal() {
  const identity = $('#stockChartModalIdentity'), summary = $('#stockChartModalSummary'), canvas = $('#stockChartModalCanvas');
  if (identity) identity.textContent = '—';
  if (summary) summary.textContent = '选择股票后读取 K 线';
  if (canvas) canvas.innerHTML = emptyState('选择行情查看 K 线', '等待选择行情');
}

function closeModal(modal) {
  if (!modal) return;
  if (modal.id === 'cloudBulkConfirmModal' && pendingCloudBulkConfirm) {
    const resolve = pendingCloudBulkConfirm;
    pendingCloudBulkConfirm = null;
    resolve(false);
  }
  modal.hidden = true;
  if (modal.id === 'cloudRecycleModal') {
    resetCloudRecycleModal({ clearInput: modal.dataset.queried === 'true' });
    delete modal.dataset.queried;
  }
  if (modal.id === 'stockChartModal') resetStockChartModal();
  if ($$('.modal-backdrop:not([hidden])').length === 0) document.body.style.overflow = '';
}

function switchAuth(tab) {
  if (tab === 'change' && !state.user) tab = 'login';
  $('#authTabs').hidden = tab === 'change';
  $$('[data-auth-tab]').forEach((button) => button.classList.toggle('active', button.dataset.authTab === tab));
  for (const [mode, id] of Object.entries({ login: 'loginForm', register: 'registerForm', reset: 'resetPasswordForm', change: 'changePasswordForm' })) {
    const form = $(`#${id}`);
    form.hidden = mode !== tab;
    if (mode !== tab) form.reset();
  }
  $('#authTitle').textContent = { login: '幸存者登录', register: '建立幸存者档案', reset: '忘记密码', change: '修改密码' }[tab];
  $('#authDescription').textContent = { login: '输入档案凭据以访问账户与订单。', register: '绑定 SteamID，并通过游戏内验证码确认身份。', reset: '', change: '' }[tab];
}

function openAuth(tab = 'login') {
  setAccountMenu(false);
  switchAuth(tab);
  openModal($('#authModal'));
}

async function login(form, button) {
  await withBusy(button, async () => {
    const values = Object.fromEntries(new FormData(form));
    try {
      const data = await api('/api/shop/auth/login', { method: 'POST', body: JSON.stringify({ username: values.username.trim(), password: values.password }) });
      const loginUser = normalizedUser(data);
      setUser(loginUser);
      await loadMe();
      closeModal($('#authModal')); form.reset(); toast('身份验证通过，欢迎返回补给站');
    } catch (error) { toast(error.message, 'error'); }
  });
}

async function register(form, button) {
  const values = Object.fromEntries(new FormData(form));
  if (!validRegistrationPassword(values.password)) { toast(REGISTRATION_PASSWORD_ERROR, 'error'); form.elements.password.focus(); return; }
  if (!validRegistrationPassword(values.confirmPassword)) { toast(REGISTRATION_PASSWORD_ERROR, 'error'); form.elements.confirmPassword.focus(); return; }
  if (values.password !== values.confirmPassword) { toast('两次输入的密码不一致', 'error'); form.elements.confirmPassword.focus(); return; }
  await withBusy(button, async () => {
    try {
      const data = await api('/api/shop/auth/register', { method: 'POST', body: JSON.stringify({ username: values.username.trim(), password: values.password, steamId: values.steamId.trim(), verificationCode: values.verificationCode.trim() }) });
      setUser(normalizedUser(data));
      await loadMe();
      closeModal($('#authModal'));
      form.reset();
      toast('档案已建立，注册成功');
    } catch (error) { toast(error.message, 'error'); }
  });
}

async function logout(options = {}) {
  const automatic = options?.automatic === true;
  const action = async () => {
    try { await api('/api/shop/auth/logout', { method: 'POST', body: '{}' }); }
    catch (error) {
      if (error.status !== 401 && !automatic) { toast(error.message, 'error'); return; }
    }
    setUser(null); state.account = null; state.orders = []; state.gifts = []; state.rewards = null; state.quotes = []; state.portfolio = null; state.stockTrades = []; state.stockReceipt = null; state.pagination = { ledger: 0, orders: 0, rewards: 0, lottery: 0, holdings: 0, trades: 0 }; state.orderDetails.clear(); showRoute('store'); toast(automatic ? '页面 10 分钟无操作，已自动退出' : '已安全退出幸存者档案');
  };
  if (automatic) return action();
  return withBusy($('#logoutButton'), action);
}

async function savePassword(form, button, mode) {
  const values = Object.fromEntries(new FormData(form));
  if (!validRegistrationPassword(values.password)) { toast(REGISTRATION_PASSWORD_ERROR, 'error'); return; }
  if (values.password !== values.confirmPassword) { toast('两次输入的密码不一致', 'error'); return; }
  await withBusy(button, async () => {
    try {
      await api(`/api/shop/auth/${mode}-password`, { method: 'POST', body: JSON.stringify(values) });
      form.reset();
      setUser(null); state.account = null;
      showRoute('store');
      switchAuth('login');
      toast('密码已更新，请重新登录');
    } catch (error) { toast(error.message, 'error'); }
  });
}
