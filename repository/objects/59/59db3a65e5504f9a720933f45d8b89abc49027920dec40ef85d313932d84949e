function confirmCloudBulk({ title, description, danger = false, confirmLabel = '确认' }) {
  const modal = $('#cloudBulkConfirmModal');
  if (pendingCloudBulkConfirm) closeModal(modal);
  $('#cloudBulkConfirmTitle').textContent = title;
  $('#cloudBulkConfirmDescription').textContent = description;
  const confirm = $('#confirmCloudBulk');
  confirm.textContent = confirmLabel;
