    "scripts":  {
                    "start":  "node src/server.js",
                    "license:activate":  "node scripts/license-activate.js activate",
                    "license:connect":  "node scripts/license-activate.js connect",
                    "license:status":  "node scripts/license-activate.js status",
                    "admin:promote":  "node scripts/promote-super-admin.js",
                    "data:purge-players":  "node scripts/purge-player-data.js",
