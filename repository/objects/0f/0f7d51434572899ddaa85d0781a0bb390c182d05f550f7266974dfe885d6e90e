                    "database:migrate-schema":  "node scripts/migrate-schema.js",
                    "database:finalize-account-schema":  "node scripts/finalize-account-schema.js",
                    "check":  "node -e \"const fs=require(\u0027fs\u0027),path=require(\u0027path\u0027),cp=require(\u0027child_process\u0027);const dirs=[\u0027src\u0027,\u0027scripts\u0027,\u0027public\u0027,\u0027test\u0027];const files=[];for(const dir of dirs){if(!fs.existsSync(dir))continue;const walk=p=\u003e{for(const entry of fs.readdirSync(p,{withFileTypes:true})){const file=path.join(p,entry.name);if(entry.isDirectory())walk(file);else if(entry.name.endsWith(\u0027.js\u0027))files.push(file)}};walk(dir)}for(const file of files)cp.execFileSync(process.execPath,[\u0027--check\u0027,file],{stdio:\u0027inherit\u0027})\"",
                    "test":  "node --test --test-concurrency=1 test/*.test.js",
                    "build:binaries":  "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\launcher\\build.ps1 -OutputPath ..\\构建\\ScumShopLauncher.exe \u0026\u0026 powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\updater\\build-updater.ps1 -OutputPath ..\\构建\\ScumShopUpdater.exe \u0026\u0026 powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\native\\build.ps1 -OutputPath ..\\构建\\native",
                    "build:sync":  "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\sync-build-workspace.ps1 -Action Sync",
                    "installer:check":  "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\sync-build-workspace.ps1 -Action Check",
                    "installer:build":  "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\sync-build-workspace.ps1 -Action Build"
                },
    "dependencies":  {
                         "axios":  "^1.14.0",
