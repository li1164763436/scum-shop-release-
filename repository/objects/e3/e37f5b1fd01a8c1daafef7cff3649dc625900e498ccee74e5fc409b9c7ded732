[hidden] { display: none !important; }
html, body { margin: 0; min-height: 100%; }
body {
  color: var(--ink);
  background-color: var(--sand);
  background-image:
    linear-gradient(rgba(36, 79, 61, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(36, 79, 61, 0.035) 1px, transparent 1px);
  background-size: 28px 28px;
  font: 14px/1.5 "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", Arial, sans-serif;
}
button, input, select, textarea { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible {
  outline: 2px solid var(--amber);
  outline-offset: 2px;
}

.app-shell { min-height: 100vh; }
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 30;
  width: 248px;
  display: flex;
  flex-direction: column;
  color: #edf1e9;
  background: var(--green-deep);
  border-right: 1px solid #0d2a20;
  box-shadow: 7px 0 18px rgba(28, 43, 34, 0.12);
}
.sidebar::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px);
  background-size: 100% 32px;
}
.brand, .nav, .sidebar-foot { position: relative; z-index: 1; }
.brand {
  min-height: 76px;
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,.12);
}
.brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  color: var(--green-deep);
  background: var(--amber);
  border: 1px solid #e1aa55;
  font: 800 20px/1 Consolas, monospace;
  clip-path: polygon(0 0, 82% 0, 100% 18%, 100% 100%, 18% 100%, 0 82%);
}
.brand strong, .brand small { display: block; }
.brand strong { font-size: 14px; letter-spacing: .04em; }
.brand small { margin-top: 2px; color: #91a99c; font-size: 9px; letter-spacing: .17em; text-transform: uppercase; }
.nav { flex: 1; overflow: auto; padding: 15px 10px; }
.nav-group { margin-bottom: 14px; padding-bottom: 2px; border-bottom: 1px solid rgba(255,255,255,.045); }
.nav-group:last-child { margin-bottom: 0; border-bottom: 0; }
.nav-group > span {
  display: block;
  padding: 0 10px 6px;
  color: #91a99c;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .16em;
}
.nav-item {
  width: 100%;
  min-height: 38px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid transparent;
  border-radius: 2px;
  background: transparent;
  color: #aebdb5;
  text-align: left;
  cursor: pointer;
}
.nav-item[hidden], .nav-group[hidden] { display: none !important; }
.nav-item i {
  width: 25px;
  color: #71877b;
  font: 10px/1 Consolas, monospace;
  letter-spacing: .04em;
}
.nav-item b { font-size: 13px; font-weight: 500; }
.nav-item:hover { color: #fff; background: rgba(255,255,255,.055); border-color: rgba(255,255,255,.08); }
.nav-item.active {
  color: #fff;
  background: #2c5b47;
  border-color: #4d765f;
  box-shadow: inset 3px 0 0 var(--amber);
}
.nav-item.active i { color: #efbd68; }
.sidebar-foot {
  margin: 10px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(255,255,255,.11);
  background: rgba(255,255,255,.035);
}
.sidebar-foot strong, .sidebar-foot small { display: block; }
.sidebar-foot strong { font-size: 11px; }
.sidebar-foot small { margin-top: 1px; color: #80988c; font-size: 10px; }
.pulse { width: 8px; height: 8px; background: #7db88c; box-shadow: 0 0 0 4px rgba(125,184,140,.12); }

.workspace { min-height: 100vh; margin-left: 248px; }
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 64px;
  padding: 0 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 254, 249, .96);
  border-bottom: 1px solid var(--line-strong);
  backdrop-filter: blur(8px);
}
.page-heading p, .page-heading h1 { margin: 0; }
.page-heading p { color: var(--muted); font-size: 10px; letter-spacing: .05em; }
.page-heading h1 { font-size: 17px; font-weight: 700; }
.top-actions { display: flex; align-items: center; gap: 9px; }
.admin-identity { min-width: 118px; padding: 5px 9px; display: grid; gap: 1px; color: #44536b; background: #f4f7fc; border: 1px solid #dce4f0; border-radius: 7px; line-height: 1.2; }
.admin-identity strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.admin-identity small { color: #8190a6; font-size: 10px; }
.admin-logout { min-height: 32px; padding: 5px 9px; }
.connection-pill {
  padding: 6px 10px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #59645c;
  background: #f5f3e9;
  border: 1px solid var(--line);
  font-size: 11px;
}
.connection-pill i { width: 7px; height: 7px; background: #a6a99f; }
.connection-pill i.ok { background: #4d8a62; box-shadow: 0 0 0 3px rgba(77,138,98,.12); }
.connection-pill i.bad { background: var(--red); box-shadow: 0 0 0 3px rgba(168,68,56,.12); }
.icon-btn {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 2px;
  background: var(--paper);
  cursor: pointer;
  font-size: 17px;
}
.icon-btn:hover { border-color: var(--green); color: var(--green); background: var(--green-soft); }
.admin-avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid #a9782f;
  color: #fff9ed;
  background: var(--amber);
  font-weight: 700;
}
.mobile-menu { display: none; }
.content { max-width: 1600px; margin: auto; padding: 22px 26px 48px; }
.page { display: none; animation: fadeIn .15s ease; }
.page.active { display: block; }
@keyframes fadeIn { from { opacity: .4; transform: translateY(2px); } }

.welcome-card {
  min-height: 118px;
  padding: 20px 22px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 20px;
  color: #e9eee9;
  background: var(--green);
  border: 1px solid var(--green-deep);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}
.welcome-card::after {
  content: "+  +  +  +  +";
  position: absolute;
  right: 20px;
  bottom: 5px;
  color: rgba(255,255,255,.1);
  font: 14px Consolas, monospace;
  letter-spacing: 9px;
}
.summary-index {
  width: 64px;
  height: 68px;
  padding: 9px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #f5c374;
  border: 1px solid rgba(255,255,255,.24);
  border-left: 3px solid var(--amber);
}
.summary-index span { font: 9px Consolas, monospace; letter-spacing: .14em; }
.summary-index strong { font: 700 26px/1 Consolas, monospace; }
.welcome-card h2 { margin: 3px 0 2px; font-size: 22px; }
.welcome-card p { margin: 0; color: #b8c9bf; font-size: 12px; }
.eyebrow, .section-kicker { color: #d9a957; font: 10px Consolas, monospace; letter-spacing: .14em; }
.summary-actions { display: grid; justify-items: end; gap: 12px; position: relative; z-index: 1; }
.summary-signal { display: flex; align-items: center; gap: 7px; color: #a9c1b4; font-size: 10px; }
.summary-signal i { width: 7px; height: 7px; background: #78b88d; }

.btn {
  min-height: 36px;
  padding: 8px 14px;
  border: 1px solid transparent;
  border-radius: 2px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
}
.btn:hover { filter: brightness(.97); }
.btn:disabled { opacity: .55; cursor: wait; }
.btn.primary { color: #fff; background: var(--green); border-color: var(--green-deep); box-shadow: inset 0 -2px 0 rgba(0,0,0,.12); }
.btn.primary:hover { background: var(--green-deep); }
.welcome-card .btn.primary { color: #392a14; background: #efb85f; border-color: #f3cb8a; }
.btn.secondary { color: #47534b; background: #faf9f3; border-color: var(--line-strong); }
.btn.secondary:hover { color: var(--green); border-color: var(--green); background: var(--green-soft); }
.btn.danger { color: var(--red); background: var(--red-soft); border-color: #dbada5; }
.text-btn { border: 0; background: transparent; color: var(--green); font-size: 11px; font-weight: 700; cursor: pointer; }

.stat-grid, .gift-status-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 14px 0; }
.stat-card, .status-card {
  min-height: 104px;
  padding: 15px 17px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--paper);
  border: 1px solid var(--line);
  border-top: 3px solid var(--green);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.stat-card:nth-child(3), .monitor-card-latency { border-top-color: var(--amber); }
.stat-card span, .stat-card strong, .stat-card small, .status-card span, .status-card strong, .status-card small { display: block; }
.stat-card span, .status-card span { color: var(--muted); font-size: 11px; }
.stat-card strong, .status-card strong { margin: 5px 0 2px; font: 700 25px/1.2 Consolas, "Microsoft YaHei UI", sans-serif; }
.stat-card small, .status-card small { color: #96998f; font-size: 10px; }
.status-card strong.is-enabled { color: #327048; }
.rule-card { background: #f5efe2; border-top-color: var(--amber); }

.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(290px, .75fr); gap: 12px; }
.section-heading { margin-bottom: 10px; display: flex; justify-content: space-between; align-items: end; }
.section-heading h2, .section-heading p { margin: 0; }
.section-heading h2 { font-size: 18px; }
.section-heading p { margin-top: 2px; color: var(--muted); font-size: 10px; }
.card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.card-head {
  min-height: 62px;
  padding: 13px 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  border-bottom: 1px solid var(--line);
  background: #fbfaf4;
}
.card-head h3, .card-head p { margin: 0; }
.card-head h3 { font-size: 14px; }
.card-head p { margin-top: 2px; color: var(--muted); font-size: 10px; }
.service-list { padding: 4px 17px 10px; }
.service-list > div { min-height: 44px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px dashed var(--line); }
.service-list > div:last-child { border: 0; }
.service-list span { display: flex; align-items: center; gap: 8px; color: #535f57; }
.service-list b { color: #788078; font-size: 10px; }
.bridge-summary { margin: 0 17px 15px; padding: 10px 12px; display: grid; gap: 2px; color: #855915; background: var(--amber-soft); border-left: 3px solid var(--amber); }
.bridge-summary strong { font-size: 11px; }
.bridge-summary span { font-size: 10px; }
.status-dot { width: 7px; height: 7px; background: #a6aaa0; }
.status-dot.ok { background: #4f8d63; }
.status-dot.bad { background: var(--red); }
.status-dot.waiting { background: var(--amber); }

.page-toolbar { min-height: 60px; margin-bottom: 12px; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
.page-toolbar h2, .page-toolbar p { margin: 0; }
.page-toolbar h2 { margin-top: 1px; font-size: 20px; }
.page-toolbar p { margin-top: 3px; color: var(--muted); font-size: 11px; }
.page-toolbar .breadcrumb-inline { margin-bottom: 7px; color: #888c83; }
.toolbar-actions { display: flex; gap: 8px; }

.product-tools, .filter-row {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--line);
  background: #f6f3e9;
}
.result-count { margin-left: auto; padding: 4px 8px; color: #526057; border-left: 2px solid var(--amber); font: 11px Consolas, monospace; white-space: nowrap; }
.search-box {
  width: 280px;
  max-width: 100%;
  height: 36px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #92968c;
  background: var(--paper);
  border: 1px solid var(--line-strong);
}
.search-box.wide { width: 390px; }
.search-box input { height: 100%; padding: 0; border: 0; background: transparent; box-shadow: none; }
.filter-row select { width: auto; min-width: 135px; }
.table-wrap { overflow: auto; }
table { width: 100%; min-width: 760px; border-collapse: collapse; }
th {
  height: 38px;
  padding: 0 14px;
  color: #606a62;
  background: #eeece3;
  border-bottom: 1px solid var(--line-strong);
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .04em;
  white-space: nowrap;
}
td { min-height: 54px; padding: 9px 14px; color: #505b53; border-bottom: 1px solid #e6e2d7; font-size: 11px; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover:not(:has(.empty)) { background: #f6f7f0; }
td strong { color: var(--ink); font-weight: 700; }
td code { color: #465f54; font: 10px Consolas, monospace; }
.empty { padding: 38px 15px !important; color: #91958d !important; text-align: center !important; }
.empty.loading::before { content: ""; width: 12px; height: 12px; margin-right: 7px; display: inline-block; border: 2px solid #c9c5b9; border-top-color: var(--green); border-radius: 50%; vertical-align: -2px; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.product-anchor small, .table-note { display: block; color: #92968d; font-size: 9px; }
.category-path { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.category-path i { color: var(--amber); font-style: normal; }
.category-setting-list { display: grid; gap: 8px; max-height: 320px; overflow-y: auto; }
.category-setting-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
.category-setting-row span { display: flex; align-items: center; gap: 8px; }
.category-setting-row small { color: var(--muted); font-size: 12px; }
.category-setting-actions { display: grid; grid-template-columns: repeat(4, minmax(64px,auto)); gap: 7px; }
.category-action { min-height: 32px; padding: 5px 12px; border: 1px solid #cbd4e1; border-radius: 6px; background: #fff; color: #43536a; font-size: 12px; font-weight: 700; cursor: pointer; }
.category-action:hover { border-color: #9eb5db; background: #f2f6fc; color: var(--blue); }
.category-action.edit { border-color: #a9c0b5; background: #f1f7f3; color: var(--green); }
.category-action.delete { border-color: #e2b4b8; background: var(--red-soft); color: var(--red); }
.category-action:disabled { border-color: #dde1e7; background: #f3f4f6; color: #adb3bc; cursor: not-allowed; }
.category-setting-row i { color: var(--amber); font-style: normal; }
@media (max-width: 760px) {
  .category-setting-row { align-items: stretch; flex-direction: column; }
  .category-setting-actions { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
.code-preview { max-width: 230px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge { padding: 2px 7px; display: inline-flex; align-items: center; color: #626a63; background: #ebece6; border: 1px solid #d5d8cf; border-radius: 2px; font-size: 9px; font-weight: 700; }
.badge.active, .badge.completed, .badge.success, .badge.running { color: #28633d; background: #e1eee3; border-color: #b9d5be; }
.badge.pending, .badge.queued, .badge.waiting { color: #805610; background: #f6ead1; border-color: #e7cea0; }
.badge.processing, .badge.retrying { color: #355d68; background: #e0ebed; border-color: #b9d0d4; }
