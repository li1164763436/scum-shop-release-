/* 股市后台高密度工作台，仅作用于 page-stock-market */
.page-stock-market { display: none; gap: 12px; }


.page-stock-market.active { display: grid; }


.page-stock-market .stockSummaryGrid { margin-bottom: 0; }


.page-stock-market .stock-interface-notice { margin: 0; }


.page-stock-market .stock-interface-notice[hidden] { display: none; }


.page-stock-market .stock-hours-layout { padding: 15px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .55fr); gap: 16px; align-items: end; }


.page-stock-market .stock-weekdays { min-width: 0; margin: 0; padding: 0; border: 0; }


.page-stock-market .stock-weekdays legend,
.page-stock-market .stock-hours-fields > label:not(.switch),
.page-stock-market .stock-workbench-card .form-grid label { color: #536078; font-size: 11px; }


.page-stock-market .stock-weekday-options { margin-top: 6px; display: grid; grid-template-columns: repeat(7, minmax(54px, 1fr)); gap: 7px; }


.page-stock-market .stock-weekday-options label { position: relative; min-width: 0; cursor: pointer; }


.page-stock-market .stock-weekday-options input { position: absolute; opacity: 0; pointer-events: none; }


.page-stock-market .stock-weekday-options span { min-height: 34px; display: grid; place-items: center; color: #667389; background: #f8fafc; border: 1px solid var(--line-strong); border-radius: 7px; font-size: 11px; }


.page-stock-market .stock-weekday-options input:checked + span { color: #245fcf; background: #eaf1ff; border-color: #9db9ee; font-weight: 700; }


.page-stock-market .stock-weekday-options input:focus-visible + span { outline: 2px solid var(--blue); outline-offset: 2px; }


.page-stock-market .stock-hours-fields { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }


.page-stock-market .stock-hours-fields > label:not(.switch) { display: grid; gap: 5px; }


.page-stock-market .stock-enabled-switch { min-height: 34px; padding: 0 4px; white-space: nowrap; }


.page-stock-market .stock-form-sections { display: grid; }


.page-stock-market .stock-form-group + .stock-form-group { border-top: 1px solid var(--line); }


.page-stock-market .stock-form-group-title { padding: 12px 15px 0; display: flex; align-items: baseline; gap: 9px; }


.page-stock-market .stock-form-group-title strong { color: #253044; font-size: 12px; }


.page-stock-market .stock-form-group-title span { color: #929daf; font-size: 9px; }


.page-stock-market .stock-form-group .form-grid { padding-top: 10px; }

