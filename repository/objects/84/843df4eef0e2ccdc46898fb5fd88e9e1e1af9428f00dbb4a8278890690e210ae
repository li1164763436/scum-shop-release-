.page-stock-market .stock-record-list { margin: 0 15px 15px; display: grid; gap: 7px; }


.page-stock-market .stock-record-item { min-width: 0; padding: 10px 11px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #fafbfd; border: 1px solid var(--line); border-radius: 8px; }


.page-stock-market .stock-record-item > div:first-child { min-width: 0; display: grid; gap: 2px; }


.page-stock-market .stock-record-item strong { color: #253044; font-size: 11px; }


.page-stock-market .stock-record-item span { overflow-wrap: anywhere; color: #657187; font-size: 10px; }


.page-stock-market .stock-record-item small { color: #929daf; font-size: 9px; }


.page-stock-market .stock-record-actions { flex: 0 0 auto; display: flex; gap: 7px; }


.page-stock-market .stock-record-actions .btn { min-height: 30px; padding: 5px 10px; }


.page-stock-market .stock-record-empty { padding: 22px 12px; color: var(--muted); background: #fafbfd; border: 1px dashed var(--line-strong); border-radius: 8px; text-align: center; font-size: 10px; }


.page-stock-market .stock-section-label { padding: 0 15px; color: #7d899c; font-size: 9px; font-weight: 700; letter-spacing: .08em; }


.page-stock-market .stock-wide-stack { display: grid; gap: 12px; min-width: 0; }


.page-stock-market .stock-wide-stack > .card { min-width: 0; }


.page-stock-market .stock-price-pagination { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 14px; }


.page-stock-market .stock-trade-table { min-width: 860px; }

