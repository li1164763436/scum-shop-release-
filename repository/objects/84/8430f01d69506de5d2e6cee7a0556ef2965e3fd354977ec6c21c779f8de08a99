
.config-stack { display: grid; gap: 12px; }


.unified-services > section + section { border-top: 1px solid var(--line); }


.unified-services > .service-config-section { min-width: 0; }


.unified-services > .service-config-section .card-head { padding: 17px; }


.unified-services > .service-config-section .form-grid { padding-top: 0; }


.dynamic-row.announcement { grid-template-columns: minmax(130px,.45fr) minmax(260px,1.5fr) minmax(120px,.45fr) auto; }


.version-update-config-backdrop, .version-update-backdrop { z-index: 120; }


.version-update-config-modal { width: min(880px, 94vw) !important; height: min(820px, 90vh); max-height: 90vh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; border-radius: 12px; overflow: hidden; }


.version-update-config-body { min-height: 0; padding: 22px; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; gap: 16px; overflow: hidden; }
.version-update-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.version-update-summary > div, .version-update-checksums > div { padding: 13px; display: grid; gap: 5px; border: 1px solid var(--line); border-radius: 8px; background: #f8fafc; min-width: 0; }
.version-update-summary span, .version-update-checksums span { color: var(--muted); font-size: 11px; }
.version-update-summary strong { font-size: 16px; }
.version-update-checksums { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.version-update-checksums code { overflow: hidden; color: #34425a; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.version-update-file-section { min-height: 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.version-update-file-head { padding: 12px 14px; display: flex; justify-content: space-between; gap: 12px; background: #f5f7fa; }
.version-update-file-head span { color: var(--muted); font-size: 12px; }
.version-update-file-columns, .version-update-file { display: grid; grid-template-columns: 68px minmax(180px, 1fr) 82px 90px minmax(150px, .75fr); gap: 12px; align-items: center; }
.version-update-file-columns { padding: 9px 14px; color: var(--muted); font-size: 11px; border-top: 1px solid var(--line); background: #fbfcfe; }
.version-update-file-list { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
.version-update-file-list > .empty { min-height: 100%; display: grid; place-items: center; }
.version-update-file { height: 52px; min-height: 52px; padding: 10px 14px; border-top: 1px solid var(--line); }
.version-update-file div { display: grid; gap: 3px; min-width: 0; }
.version-update-file strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.version-update-file small { color: var(--muted); font-size: 10px; }
.version-update-file-size { min-width: 0; overflow: hidden; font-variant-numeric: tabular-nums; text-overflow: ellipsis; white-space: nowrap; }
.version-update-file-target-size { color: #246b50; font-weight: 700; }
.version-update-file code { overflow: hidden; color: #536078; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.version-update-install-state { font-size: 11px; font-weight: 700; }
.version-update-install-state.installed { color: #158566; }
.version-update-install-state.downloaded { color: #246bd6; }
.version-update-install-state.pending { color: #b76b12; }
.version-update-file-pager { min-height: 52px; padding: 10px 14px; display: flex; justify-content: center; gap: 12px; align-items: center; border-top: 1px solid var(--line); background: #f8fafc; }
.version-update-file-pager .btn { min-width: 74px; padding: 7px 12px; }
.version-update-file-pager span { min-width: 150px; color: var(--muted); text-align: center; font-size: 11px; }


.version-update-config-body label { display: grid; gap: 7px; color: #536078; font-size: 13px; }


.version-update-config-body label small { color: var(--muted); font-size: 11px; }


.version-update-current-status { padding: 16px; display: grid; gap: 14px; border: 1px solid #dbe2eb; border-radius: 12px; background: #f1f4f8; }


.version-update-status-head, .version-update-status-detail { display: flex; justify-content: space-between; gap: 14px; align-items: center; }


.version-update-status-head strong { font-size: 15px; font-weight: 500; }


.version-update-status-badge { padding: 6px 10px; border-radius: 8px; color: #087f4f; background: #e6f7ee; font-size: 11px; }
.version-update-status-track { height: 8px; overflow: hidden; border-radius: 999px; background: #c5cad2; }
.version-update-status-track i { display: block; width: 0; height: 100%; border-radius: inherit; background: #078856; transition: width .25s ease; }
.version-update-status-detail { color: #657084; font-size: 11px; }
.version-update-current-status.downloading .version-update-status-badge { color: #0b72c7; background: #e8f3fc; }
.version-update-current-status.downloading .version-update-status-track i, .version-update-current-status.ready .version-update-status-track i { background: #1f2937; }
.version-update-current-status.ready .version-update-status-badge { color: #8a5600; background: #f8b72b; }
.version-update-current-status.installing .version-update-status-badge { color: #3759b8; background: #e8edff; }
.version-update-current-status.installing .version-update-status-track i { background: #3759b8; }
.version-update-current-status.failed .version-update-status-badge { color: #b42332; background: #fde9ec; }
.version-update-current-status.failed .version-update-status-track i { background: #d94d5c; }


@media (max-width: 680px) { .version-update-config-modal { height: 94vh; max-height: 94vh; } .version-update-config-body { padding: 14px; gap: 12px; } .version-update-summary, .version-update-checksums { grid-template-columns: 1fr; } .version-update-file-section { overflow-x: auto; } .version-update-file-columns, .version-update-file { min-width: 780px; } .version-update-current-status { padding: 12px; } }
.license-account-card { overflow: hidden; }
.license-account-state { margin: 16px; padding: 18px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 5px 12px; background: #f4f7fb; border: 1px solid #dce4ef; border-radius: 8px; }
.license-account-state strong { color: #263249; font-size: 17px; }
.license-account-state small { grid-column: 2; color: #778398; }
.license-account-badge { grid-row: 1 / span 2; min-width: 70px; padding: 7px 9px; color: #637188; background: #e7ebf1; border: 1px solid #d1d8e3; border-radius: 6px; font-size: 12px; font-weight: 700; text-align: center; }
.license-account-state.active { background: #eef9f5; border-color: #c7e8dc; }
.license-account-badge.active { color: #13795b; background: #dff4ec; border-color: #acdcca; }
.license-account-state.expired, .license-account-state.inactive { background: #fff4f5; border-color: #f0d1d5; }
.license-account-badge.expired, .license-account-badge.inactive { color: #b23d49; background: #ffe8eb; border-color: #efbec4; }
.license-account-details { margin: 0 16px 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.license-account-details div { min-height: 64px; padding: 11px 13px; display: grid; align-content: center; gap: 4px; background: #fff; border: 1px solid #e1e7ef; border-radius: 7px; }
.license-account-details div.full { grid-column: 1 / -1; }
.license-account-details dt { color: #7a8699; font-size: 11px; }
.license-account-details dd { margin: 0; overflow-wrap: anywhere; color: #2b374d; font-weight: 700; }
.license-account-note { margin: 0 16px 16px; padding: 10px 12px; color: #69768a; background: #f7f9fc; border-left: 3px solid #90a6c7; font-size: 12px; }
@media (max-width: 680px) { .license-account-details { grid-template-columns: 1fr; } .license-account-details div.full { grid-column: auto; } }


.rcon-config-stack { gap: 14px; }


.rcon-config-card { position: relative; border-color: #dce5f2; box-shadow: 0 8px 24px rgba(31, 52, 84, .06); }


.rcon-config-card .card-head { min-height: 70px; padding-left: 58px; background: linear-gradient(90deg, #f7faff, #fff 42%); }


.config-card-index { position: absolute; left: 17px; top: 18px; width: 29px; height: 29px; display: grid; place-items: center; color: #fff; background: var(--blue); border-radius: 8px; font-size: 10px; font-weight: 800; }


.rcon-config-card .form-grid { padding-top: 17px; padding-bottom: 17px; }


.rcon-config-card .form-actions { min-height: 52px; align-items: center; justify-content: space-between; }


.rcon-config-card .btn.primary { min-width: 126px; }



#config-rcon .bridge-capabilities { background: #fbfcfe; }


#config-rcon .bridge-capabilities p { padding: 3px 2px 0; }

