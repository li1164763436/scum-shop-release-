function renderExchange() {
  const config = state.exchangeConfig || {};
  const account = state.account?.account && typeof state.account.account === 'object' ? state.account.account : state.account || {};
  const coinBalance = pick(account, ['balance', 'coinBalance', 'coins'], state.user?.balance || 0);
  const goldBalance = pick(account, ['gameGold', 'game_gold'], null);

  $$('[data-exchange-form]').forEach((form) => {
    const direction = form.elements.direction.value;
    const coinToGold = direction === 'coin_to_gold';
    const rate = Number(coinToGold ? config.coinToGoldRate : config.goldToCoinRate) || 0;
    const amount = Math.max(0, Math.floor(Number(form.elements.amount.value) || 0));
    const output = Math.floor(amount * rate);
    $('[data-exchange-balance]', form).textContent = coinToGold
      ? number(coinBalance)
      : (goldBalance === null || goldBalance === undefined ? '—' : number(goldBalance));
    $('[data-exchange-rate]', form).textContent = coinToGold
      ? `${number(rate > 0 ? 1 / rate : 0)} 商城币 = 1 金条`
      : `1 金条 = ${number(rate)} 商城币`;
    $('[data-exchange-output]', form).textContent = `${number(output)} ${coinToGold ? '金条' : '商城币'}`;
    form.elements.amount.max = String(config.maxAmount || 100000);
    const submit = $('button[type="submit"]', form);
    const status = $('[data-exchange-status]', form);
    submit.disabled = config.enabled === false;
    if (config.enabled === false) status.textContent = '资产兑换当前已停用';
    else if (status.textContent === '资产兑换当前已停用') status.textContent = '';
  });
}

async function loadExchangeConfig() {
  try {
    state.exchangeConfig = await api('/api/shop/account/exchange-config');
    renderExchange();
  } catch (error) {
    $$('[data-exchange-status]').forEach((status) => { status.textContent = chineseErrorMessage(error.message, '兑换信息读取失败，请稍后重试'); });
    if (error.status === 401) openAuth('login');
  }
}

async function exchangeCurrency(form, button) {
  const amount = Number(form.elements.amount.value);
  const status = $('[data-exchange-status]', form);
  if (!Number.isSafeInteger(amount) || amount < 1) { form.elements.amount.reportValidity(); return; }
  await withBusy(button, async () => {
    try {
      const data = await api('/api/shop/account/exchange', {
        method: 'POST',
        headers: { 'Idempotency-Key': uuid() },
        body: JSON.stringify({ direction: form.elements.direction.value, amount })
      });
      if (data.status === 'uncertain') {
        status.textContent = '结果待核查，请勿重复提交。';
        toast('兑换结果暂时无法确认，工作人员正在核查，请勿重复提交', 'error', '结果待核查');
      } else {
        const target = data.direction === 'coin_to_gold' ? '金条' : '商城币';
        status.textContent = `兑换成功，到账 ${number(data.outputAmount)} ${target}`;
        toast(`兑换成功，到账 ${number(data.outputAmount)} ${target}`);
        form.elements.amount.value = '';
      }
      await loadAccount();
    } catch (error) {
      status.textContent = error.code === 'PLAYER_OFFLINE'
        ? '游戏角色必须在线，请先进入游戏并等待状态同步。'
        : chineseErrorMessage(error.message, '兑换失败，请稍后重试');
      toast(status.textContent, 'error');
      if (error.status === 401) openAuth('login');
    }
  });
}

