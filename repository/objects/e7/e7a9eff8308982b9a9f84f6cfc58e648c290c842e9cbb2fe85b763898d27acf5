function renderOrders() {
  if (!state.orders.length) { $('#orderList').innerHTML = emptyState('还没有物资订单', '暂无订单'); return; }
  const page = pageItems(state.orders, 'orders');
  $('#orderList').innerHTML = page.items.map((order) => {
    const id = pick(order, ['id', 'orderId']);
    const status = String(pick(order, ['status'], 'pending')).toLowerCase();
    return `<article class="order-entry" data-order-id="${escapeHtml(id)}"><button class="order-summary" type="button" aria-expanded="false"><span><small>订单号</small><strong>${escapeHtml(pick(order, ['orderNo', 'order_no', 'number'], id))}</strong></span><span><small>金额</small><strong class="amount">${number(pick(order, ['totalAmount', 'total_amount', 'amount'], 0))} 币</strong></span><span><small>状态</small><i class="status ${escapeHtml(status)}">${escapeHtml(statusLabels[status] || '状态待确认')}</i></span><span><small>创建时间</small><strong>${escapeHtml(dateTime(pick(order, ['createdAt', 'created_at'])))}</strong></span><span class="order-toggle">＋</span></button><div class="order-details" hidden></div></article>`;
  }).join('') + paginationMarkup('orders', page.totalPages, page.page);
}

async function toggleOrder(entry) {
  const detail = $('.order-details', entry);
  const summary = $('.order-summary', entry);
  const opening = detail.hidden;
  if (!opening) {
    detail.hidden = true; entry.classList.remove('open'); summary.setAttribute('aria-expanded', 'false'); return;
  }
  detail.hidden = false; entry.classList.add('open'); summary.setAttribute('aria-expanded', 'true');
  const id = entry.dataset.orderId;
  if (state.orderDetails.has(id)) { renderOrderDetail(detail, state.orderDetails.get(id)); return; }
  detail.innerHTML = emptyState('正在读取订单明细', '正在读取订单明细');
  try {
    const data = await api(`/api/shop/orders/${encodeURIComponent(id)}`);
    state.orderDetails.set(id, data || {});
    renderOrderDetail(detail, data || {});
  } catch (error) { detail.innerHTML = emptyState(chineseErrorMessage(error.message, '订单明细读取失败，请稍后重试'), '订单明细暂不可用'); }
}

function renderOrderDetail(container, data) {
  const items = asList(data, ['items', 'orderItems', 'details']);
  if (!items.length) { container.innerHTML = emptyState('该订单暂无明细', '暂无订单明细'); return; }
  container.innerHTML = `<div class="order-items">${items.map((item) => `<div class="order-item"><span><strong>${escapeHtml(pick(item, ['name', 'productName'], '未命名物资'))}</strong><small>${escapeHtml(pick(item, ['sku'], '—'))}</small></span><span>单价 ${number(pick(item, ['unitPrice', 'unit_price', 'price'], 0))} 币</span><span>× ${number(pick(item, ['quantity'], 1))}</span></div>`).join('')}</div>`;
}

function startChallengeCountdown(seconds = 60) {
  state.challengeUntil = Date.now() + seconds * 1000;
  clearInterval(state.challengeTimer);
  const button = $('#challengeButton');
  const tick = () => {
    const remaining = Math.max(0, Math.ceil((state.challengeUntil - Date.now()) / 1000));
    button.disabled = remaining > 0;
    button.textContent = remaining > 0 ? `${remaining} 秒后重试` : '重新请求验证码';
    if (!remaining) clearInterval(state.challengeTimer);
  };
  tick(); state.challengeTimer = setInterval(tick, 1000);
}

async function requestChallenge() {
  const form = $('#registerForm');
  const steamInput = form.elements.steamId;
  if (!steamInput.checkValidity()) { steamInput.reportValidity(); return; }
  await withBusy($('#challengeButton'), async () => {
    try {
      await api('/api/shop/auth/challenge', { method: 'POST', body: JSON.stringify({ steamId: steamInput.value.trim() }) });
      toast('验证码已发送，请回到游戏内查看消息');
      startChallengeCountdown(60);
      form.elements.verificationCode.focus();
    } catch (error) { toast(error.message, 'error'); }
  });
}
