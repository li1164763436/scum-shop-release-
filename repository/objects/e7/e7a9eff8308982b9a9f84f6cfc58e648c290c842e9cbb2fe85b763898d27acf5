      purchaseResult(data.status === 'completed' ? `已消耗 ${number(data.totalPrice)} 商城币，玩家技能等级修改成功` : data.status === 'failed' ? '玩家技能等级修改失败，商城币已退还' : `已消耗 ${number(data.totalPrice)} 商城币，等待游戏角色离线后修改`, data.status === 'failed' ? 'error' : 'success');
      await loadAccount();
    });
  } catch (error) {
    purchaseResult(chineseErrorMessage(error.message, '角色成长操作失败，请稍后重试'), 'error');
