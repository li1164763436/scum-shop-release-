function renderPurchaseSkills() {
  const key = state.selectedPurchaseAttribute;
  const meta = purchaseAttributeMeta[key];
  const skillsByKey = new Map(state.profileSkills.map((skill) => [String(pick(skill, ['name', 'skillName'], '')), skill]));
  $('#purchaseSkillTitle').textContent = '技能等级';
  $('#purchaseSkillList').innerHTML = (skillAttributeGroups[key] || []).map((skillKey) => {
    const skill = skillsByKey.get(skillKey);
    const name = pick(skill, ['cnName'], purchaseSkillNames[skillKey] || skillKey);
    const level = pick(skill, ['level', 'skillLevel'], '—');
    const experienceValue = pick(skill, ['experience', 'xp'], null);
    const experience = experienceValue === null || experienceValue === undefined ? '—' : number(experienceValue);
    const reached = Number(level) >= 3 && Number(experienceValue) >= 9999999;
    if (reached) state.selectedPurchaseSkills.delete(skillKey);
    const checked = state.selectedPurchaseSkills.has(skillKey) ? ' checked' : '';
    return `<article><div><strong>${escapeHtml(name)}</strong><small>当前等级 ${escapeHtml(level)} · 经验 ${escapeHtml(experience)}</small></div><b>3 级</b><label class="purchase-skill-choice"><input type="checkbox" data-purchase-skill="${escapeHtml(skillKey)}"${checked}${reached ? ' disabled' : ''}><span>${reached ? '已满' : '选择'}</span></label></article>`;
  }).join('');
  updateSkillPurchaseTotal();
}

function updateSkillPurchaseTotal() {
  $('#skillPurchaseTotal').textContent = number(state.selectedPurchaseSkills.size * state.characterGrowthConfig.skillLevelPrice);
  updateCharacterPurchaseAvailability();
}

function updateCharacterPurchaseAvailability() {
  const attributeMeta = purchaseAttributeMeta[state.selectedPurchaseAttribute];
  const current = Number(state.profileAttributes[state.selectedPurchaseAttribute]);
  const quantity = state.purchaseAttributeQuantities[state.selectedPurchaseAttribute] || 0;
  const attributeOpen = Boolean(state.user) && state.characterGrowthConfig.attributePointPrice > 0 && quantity > 0 && Number.isFinite(current) && current + quantity <= attributeMeta.max;
  const skillOpen = Boolean(state.user) && state.characterGrowthConfig.skillLevelPrice > 0 && state.selectedPurchaseSkills.size > 0;
  $('#purchaseAttributeButton').disabled = !attributeOpen;
  $('#purchaseSkillButton').disabled = !skillOpen;
  const open = state.characterGrowthConfig.attributePointPrice > 0 || state.characterGrowthConfig.skillLevelPrice > 0;
  $('#characterPurchaseStatus').textContent = open ? '购买已开放' : '暂未开放';
  $('#characterPurchaseState').textContent = open ? '可购买' : '暂未开放';
  $('#characterPurchaseHint').textContent = open ? '角色彻底离线后可购买' : '后台设置价格后开放';
}

function prepareAttributePurchase() {
  const attribute = state.selectedPurchaseAttribute;
  const quantity = state.purchaseAttributeQuantities[attribute] || 0;
  if (quantity < 1) return;
  const total = quantity * state.characterGrowthConfig.attributePointPrice;
  state.attributePurchaseDraft = { type: 'attribute', attribute, quantity };
  $('#attributePurchaseName').textContent = purchaseAttributeMeta[attribute].name;
  $('#attributePurchaseSteamId').textContent = pick(state.user, ['steamId', 'steamID', 'steam_id'], '—');
  $('#attributePurchaseQuantity').textContent = String(quantity);
  $('#attributePurchaseConfirmTotal').textContent = number(total);
  openModal($('#attributePurchaseModal'));
}

async function confirmAttributePurchase() {
  if (!state.attributePurchaseDraft) return;
  const draft = state.attributePurchaseDraft;
  try {
    await withBusy($('#confirmAttributePurchase'), async () => {
      const data = await api('/api/shop/account/character-growth/purchase', { method: 'POST', headers: { 'Idempotency-Key': uuid() }, body: JSON.stringify(draft) });
      state.purchaseAttributeQuantities[draft.attribute] = 0;
      state.attributePurchaseDraft = null;
      closeModal($('#attributePurchaseModal'));
      purchaseResult(data.status === 'completed' ? `已消耗 ${number(data.totalPrice)} 商城币，玩家属性修改成功` : data.status === 'failed' ? '玩家属性修改失败，商城币已退还' : `已消耗 ${number(data.totalPrice)} 商城币，等待游戏角色离线后修改`, data.status === 'failed' ? 'error' : 'success');
      await loadAccount();
    });
  } catch (error) {
    purchaseResult(chineseErrorMessage(error.message, '角色成长操作失败，请稍后重试'), 'error');
  } finally {
    updateCharacterPurchaseAvailability();
  }
}

function prepareSkillPurchase() {
  const skills = [...state.selectedPurchaseSkills];
  if (!skills.length) return;
  const names = skills.map((key) => purchaseSkillNames[key] || key);
  state.skillPurchaseDraft = { type: 'skill', skills };
  $('#skillPurchaseNames').textContent = names.join('、');
  $('#skillPurchaseSteamId').textContent = pick(state.user, ['steamId', 'steamID', 'steam_id'], '—');
  $('#skillPurchaseQuantity').textContent = String(skills.length);
  $('#skillPurchaseConfirmTotal').textContent = number(skills.length * state.characterGrowthConfig.skillLevelPrice);
  openModal($('#skillPurchaseModal'));
}

async function confirmSkillPurchase() {
  if (!state.skillPurchaseDraft) return;
  const draft = state.skillPurchaseDraft;
  try {
    await withBusy($('#confirmSkillPurchase'), async () => {
      const data = await api('/api/shop/account/character-growth/purchase', { method: 'POST', headers: { 'Idempotency-Key': uuid() }, body: JSON.stringify(draft) });
      state.selectedPurchaseSkills.clear();
      state.skillPurchaseDraft = null;
