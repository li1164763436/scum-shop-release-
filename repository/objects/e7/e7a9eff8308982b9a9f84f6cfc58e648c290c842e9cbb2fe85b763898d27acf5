function selectPurchaseAttribute(key) {
  if (!purchaseAttributeMeta[key]) return;
  state.selectedPurchaseAttribute = key;
  $$('[data-purchase-attribute]').forEach((item) => {
    const active = item.dataset.purchaseAttribute === key;
    item.classList.toggle('active', active);
    item.setAttribute('aria-pressed', String(active));
  });
  const quantity = state.purchaseAttributeQuantities[key] || 0;
  $('#attributePurchaseTotal').textContent = number(quantity * state.characterGrowthConfig.attributePointPrice);
  renderPurchaseSkills();
}

function updatePurchaseAttributeQuantity(item, step) {
  const key = item.dataset.purchaseAttribute;
  const rawValue = state.profileAttributes[key];
  const current = Number(rawValue);
  const remaining = rawValue === null || rawValue === undefined || !Number.isFinite(current)
    ? purchaseAttributeMeta[key].max
    : Math.max(0, Math.floor(purchaseAttributeMeta[key].max - current));
  const limit = Math.max(0, remaining);
  const quantity = Math.min(limit, Math.max(0, state.purchaseAttributeQuantities[key] + step));
  state.purchaseAttributeQuantities[key] = quantity;
  $(`[data-purchase-quantity="${key}"]`).textContent = String(quantity);
  $('#attributePurchaseTotal').textContent = number(quantity * state.characterGrowthConfig.attributePointPrice);
  updateCharacterPurchaseAvailability();
}

function renderCharacterPurchase() {
  Object.entries(purchaseAttributeMeta).forEach(([key, meta]) => {
    const rawValue = state.profileAttributes[key];
    const value = Number(rawValue);
    const hasValue = rawValue !== null && rawValue !== undefined && Number.isFinite(value);
    const current = hasValue ? value.toFixed(1) : '—';
    const remaining = hasValue ? Math.max(0, Math.floor(meta.max - value)) : meta.max;
    state.purchaseAttributeQuantities[key] = Math.min(remaining, Math.max(0, state.purchaseAttributeQuantities[key] || 0));
    $(`[data-purchase-current="${key}"]`).textContent = current;
    $(`[data-purchase-quantity="${key}"]`).textContent = String(state.purchaseAttributeQuantities[key]);
  });
  const selectedQuantity = state.purchaseAttributeQuantities[state.selectedPurchaseAttribute] || 0;
  $('#attributePointPrice').textContent = number(state.characterGrowthConfig.attributePointPrice);
  $('#attributePurchaseTotal').textContent = number(selectedQuantity * state.characterGrowthConfig.attributePointPrice);
  $('#skillLevelPrice').textContent = number(state.characterGrowthConfig.skillLevelPrice);
  updateSkillPurchaseTotal();
  selectPurchaseAttribute(state.selectedPurchaseAttribute);
}

function renderProfileSkills() {
  const keys = skillAttributeGroups[state.selectedAttribute] || [];
  const skills = state.profileSkills.filter((skill) => keys.includes(String(pick(skill, ['name', 'skillName'], ''))));
  $('#accountSkillList').innerHTML = skills.length
    ? skills.map((skill) => `<div class="skill-row"><span><small>技能名称</small><strong>${escapeHtml(pick(skill, ['cnName', 'name', 'skillName'], '—'))}</strong></span><span><small>等级</small><strong>${escapeHtml(pick(skill, ['level', 'skillLevel'], '—'))}</strong></span><span><small>经验</small><strong class="skill-experience">${number(pick(skill, ['experience', 'xp'], 0))}</strong></span></div>`).join('')
    : emptyState('该属性暂无技能数据', '暂无技能数据');
}

function renderGameProfile(data = {}) {
  const profile = data.gameProfile || data.profile || {};
  const attributes = profile.attributes || {};
  const attributeItems = [
    ['strength', '力量', pick(attributes, ['strength', 'baseStrength'], null)],
    ['constitution', '体质', pick(attributes, ['constitution', 'baseConstitution'], null)],
    ['dexterity', '敏捷', pick(attributes, ['dexterity', 'baseDexterity'], null)],
    ['intelligence', '智力', pick(attributes, ['intelligence', 'baseIntelligence'], null)]
  ];
  const gameMoney = pick(data, ['gameMoney'], null);
  const gameGold = pick(data, ['gameGold'], null);
  $('#accountGameMoney').textContent = gameMoney === null || gameMoney === undefined ? '—' : number(gameMoney);
  $('#accountGameGold').textContent = gameGold === null || gameGold === undefined ? '—' : number(gameGold);
  $('#accountAttributeList').innerHTML = attributeItems.map(([key, name, value]) => {
    const numericValue = Number(value);
    const displayValue = value === null || value === undefined || !Number.isFinite(numericValue) ? '—' : numericValue.toFixed(1);
    const active = key === state.selectedAttribute;
    return `<button type="button" class="attribute-card attribute-${key}${active ? ' active' : ''}" data-attribute-filter="${key}" aria-pressed="${active}"><div class="attribute-meter"><strong>${displayValue}</strong></div><small>${name}</small></button>`;
  }).join('');
  state.profileAttributes = Object.fromEntries(attributeItems.map(([key, , value]) => [key, value]));
  state.profileSkills = asList(profile, ['skills']);
  renderProfileSkills();
  renderCharacterPurchase();
}

async function loadAccount() {
  state.pagination.ledger = 0;
  $('#ledgerList').innerHTML = emptyState('正在读取账户流水', '正在读取账户流水');
  try {
    const data = await api('/api/shop/account');
    state.account = data || {};
    const user = accountUser(data);
    if (user) setUser(user);
    renderGameProfile(data);
    renderExchange();
    renderLedger(asList(data, ['ledger', 'transactions', 'items']));
  } catch (error) {
    state.account = {};
    renderGameProfile();
    $('#accountSkillList').innerHTML = emptyState('角色档案暂不可用', '角色档案暂不可用');
    $('#ledgerList').innerHTML = emptyState(chineseErrorMessage(error.message, '账户数据读取失败，请稍后重试'), '账户数据暂不可用');
    if (error.status === 401) openAuth('login');
  }
}

function renderLedger(items) {
  if (!items.length) { $('#ledgerList').innerHTML = emptyState('暂无商城币流水', '暂无流水记录'); return; }
  const page = pageItems(items, 'ledger');
  $('#ledgerList').innerHTML = page.items.map((item) => {
    const amount = Number(pick(item, ['amount', 'change'], 0));
    const type = pick(item, ['type', 'category'], 'adjustment');
    return `<div class="ledger-row"><span><small>变动类型</small><strong>${escapeHtml(ledgerLabels[type] || '其他变动')}</strong></span><span><small>说明</small><strong>${escapeHtml(chineseErrorMessage(pick(item, ['displayNote', 'display_note'], ''), '账户余额变动'))}</strong></span><span><small>变动金额</small><strong class="ledger-amount ${amount >= 0 ? 'positive' : 'negative'}">${type==='lottery_win'?'—':(amount >= 0 ? '+' : '')+number(amount)}</strong></span><span><small>时间 / 余额</small><strong>${escapeHtml(dateTime(pick(item, ['createdAt', 'created_at', 'time'])))}</strong><small>余额 ${number(pick(item, ['balanceAfter', 'balance_after', 'balance'], 0))}</small></span></div>`;
  }).join('') + paginationMarkup('ledger', page.totalPages, page.page);
}

function duration(seconds) {
  const total = Math.max(0, Math.floor(Number(seconds) || 0));
  const hours = Math.floor(total / 3600);
  const minutes = Math.floor((total % 3600) / 60);
  const rest = total % 60;
  return `${hours} 小时 ${minutes} 分钟 ${rest} 秒`;
}
async function loadOrders() {
  state.pagination.orders = 0;
  $('#orderList').innerHTML = emptyState('正在读取订单档案', '正在读取订单');
