import crypto from 'node:crypto';
import { secureRandomInt } from './lottery-service.js';
import { stockMarketStatus } from './stock-market-hours.js';
import { volumeChangeBps } from './stock-market-service.js';

function rowsOf(value){return Array.isArray(value)?value:[];}
function clamp(value,max){return Math.max(-Number(max),Math.min(Number(max),Number(value)));}
export function stockChangeBps(stock,randomInt){const volatility=Math.min(Number(stock.volatilityBps),Number(stock.maxChangeBps));if(volatility<=0)return 0;const value=randomInt(volatility*2);return value<volatility?value-volatility:value-volatility+1;}
export function applyStockChange(price,changeBps,minPrice,maxPrice=null){const current=Number(price),bps=Number(changeBps),floor=Number(minPrice),ceiling=maxPrice===null||maxPrice===undefined?Number.MAX_SAFE_INTEGER:Number(maxPrice);let delta=Math.round((current*bps)/10000);if(bps!==0&&delta===0)delta=Math.sign(bps);const next=Math.min(ceiling,Math.max(floor,current+delta));if(!Number.isSafeInteger(next)||next<1)throw new RangeError('股价超出安全范围');return next;}
export function selectBinding(item,bindings){const products=bindings.filter(binding=>binding.bindingType==='product'&&((binding.productId&&Number(binding.productId)===Number(item.productId))||(binding.productSku&&binding.productSku===item.sku)));if(products.length)return products[0];return bindings.find(binding=>binding.bindingType==='category'&&(!binding.parentCategory||binding.parentCategory===item.parentCategory)&&(!binding.categoryName||binding.categoryName===item.categoryName))||null;}
export function aggregateBoundVolume(items,bindings){let quantity=0,amount=0;for(const item of items){const binding=selectBinding(item,bindings);if(!binding)continue;const weight=Number(binding.weightBps)/10000;quantity+=Number(item.quantity)*weight;amount+=Number(item.unitPrice)*Number(item.quantity)*weight;}return{quantity:Math.round(quantity),amount:Math.round(amount)};}
export class StockMarketWorker{
 constructor({db,store=null,logger={},clock=()=>Date.now(),randomBytes=crypto.randomBytes,setTimer=setTimeout,clearTimer=clearTimeout,pollIntervalMs=1000}={}){this.db=db;this.store=store;this.logger=logger;this.clock=clock;this.randomInt=max=>secureRandomInt(max,randomBytes);this.setTimer=setTimer;this.clearTimer=clearTimer;this.pollIntervalMs=pollIntervalMs;this.enabled=false;this.running=false;this.stopped=true;this.timer=null;this.activeTick=null;this.lastStartedAt=null;this.lastCompletedAt=null;this.lastError=null;this.market=null;}
 status(){return{enabled:this.enabled,running:this.running,polling:Boolean(this.timer),pollIntervalMs:this.pollIntervalMs,lastStartedAt:this.lastStartedAt,lastCompletedAt:this.lastCompletedAt,lastError:this.lastError,market:this.market};}
 async start(){return this.reconfigure();}
 async reconfigure({enabled=true,pollIntervalMs=this.pollIntervalMs}={}){this.stop();await this.drain();this.enabled=Boolean(enabled);this.pollIntervalMs=Math.max(100,Number(pollIntervalMs)||1000);if(this.enabled){this.stopped=false;void this.tick();}return this.status();}
 stop(){this.stopped=true;this.enabled=false;if(this.timer){this.clearTimer(this.timer);this.timer=null;}}
 async drain(){await this.activeTick;}
 async stopAndDrain(){this.stop();await this.drain();}
 schedule(){if(!this.enabled||this.stopped||this.timer)return;this.timer=this.setTimer(()=>{this.timer=null;void this.tick();},this.pollIntervalMs);}
 async tick(){if(this.running||!this.enabled||this.stopped)return false;this.activeTick=this.performTick();try{return await this.activeTick;}finally{this.activeTick=null;this.schedule();}}
 async performTick(){this.running=true;this.lastStartedAt=new Date(this.clock()).toISOString();try{const nowMs=this.clock(),config=this.store?(await this.store.read()).stockMarket:undefined;this.market=stockMarketStatus(config,new Date(nowMs));if(!this.market.isOpen){this.lastError=null;return true;}const candidates=rowsOf(await this.db.query("SELECT id,period_seconds AS periodSeconds FROM stocks WHERE enabled=1 AND paused=0 AND pricing_mode<>'manual' ORDER BY id"));for(const candidate of candidates){if(this.stopped)break;const periodSeconds=Number(candidate.periodSeconds),periodKey=Math.floor(nowMs/(periodSeconds*1000))-1;if(periodKey<0)continue;const periodStart=new Date(periodKey*periodSeconds*1000),periodEnd=new Date((periodKey+1)*periodSeconds*1000);await this.priceStock(Number(candidate.id),periodKey,periodStart,periodEnd,new Date(nowMs));}this.lastError=null;return true;}catch(error){this.lastError={code:error?.code||error?.name||'STOCK_WORKER_FAILED',message:String(error?.message||'股市周期处理失败').slice(0,300)};this.logger.error?.('股市价格 Worker 失败',{component:'stock-market',errorCode:this.lastError.code});return false;}finally{this.running=false;this.lastCompletedAt=new Date(this.clock()).toISOString();}}
 async volumeFor(tx,stockId,start,end){const bindings=rowsOf(await tx.query('SELECT binding_type AS bindingType,product_id AS productId,product_sku AS productSku,parent_category AS parentCategory,category_name AS categoryName,weight_bps AS weightBps FROM stock_volume_bindings WHERE stock_id=? AND enabled=1 ORDER BY CASE binding_type WHEN \'product\' THEN 0 ELSE 1 END,id',[stockId]));if(!bindings.length)return{quantity:0,amount:0};const items=rowsOf(await tx.query("SELECT oi.product_id AS productId,oi.sku,oi.parent_category AS parentCategory,oi.category_name AS categoryName,oi.quantity,oi.unit_price AS unitPrice FROM coin_ledger l JOIN orders o ON o.id=CAST(l.reference_id AS UNSIGNED) AND o.source='shop' JOIN order_items oi ON oi.order_id=o.id WHERE l.type='order_purchase' AND l.reference_type='order' AND l.created_at>=? AND l.created_at<?",[start,end]));return aggregateBoundVolume(items,bindings);}
 async priceStock(stockId,periodKey,periodStart,periodEnd,pricedAt){return this.db.transaction(async tx=>{const rows=rowsOf(await tx.query('SELECT id,current_price AS currentPrice,min_price AS minPrice,max_price AS maxPrice,pricing_mode AS pricingMode,volume_metric AS volumeMetric,baseline_value AS baselineValue,auto_volume_max AS autoVolumeMax,volume_sensitivity_bps AS volumeSensitivityBps,volatility_bps AS volatilityBps,max_change_bps AS maxChangeBps,price_version AS priceVersion,last_period_key AS lastPeriodKey,enabled,paused FROM stocks WHERE id=? FOR UPDATE',[stockId]));const stock=rows[0];if(!stock||!stock.enabled||stock.paused||stock.pricingMode==='manual'||(stock.lastPeriodKey!==null&&Number(stock.lastPeriodKey)===periodKey))return false;const volume=await this.volumeFor(tx,stockId,periodStart,periodEnd),metric=stock.volumeMetric==='amount'?volume.amount:volume.quantity,signalLimit=Math.min(Number(stock.volumeSensitivityBps),Number(stock.maxChangeBps)),volumeSignal=metric>0?volumeChangeBps(metric,stock.baselineValue,stock.volumeSensitivityBps,signalLimit):0,simulatedMax=Math.min(Number(stock.autoVolumeMax)||0,Math.floor(Number.MAX_SAFE_INTEGER/Number(stock.currentPrice))),simulatedQuantity=simulatedMax>0?this.randomInt(simulatedMax+1):0,simulatedAmount=simulatedQuantity*Number(stock.currentPrice),simulatedImbalanceBps=simulatedQuantity>0?this.randomInt(20001)-10000:0,simulatedSignal=simulatedQuantity>0?clamp(Math.round((simulatedQuantity/simulatedMax)*Number(stock.volumeSensitivityBps)*(simulatedImbalanceBps/10000)),signalLimit):0,randomSignal=stock.pricingMode==='hybrid'?stockChangeBps(stock,this.randomInt):0;const change=clamp(volumeSignal+simulatedSignal+randomSignal,stock.maxChangeBps),next=applyStockChange(stock.currentPrice,change,stock.minPrice,stock.maxPrice),version=Number(stock.priceVersion)+1;try{await tx.query("INSERT INTO stock_price_history (stock_id,source,period_key,price_before,price_after,change_bps,price_version,volume_quantity,volume_amount,simulated_volume_quantity,simulated_volume_amount,baseline_value,volume_change_bps,simulated_volume_change_bps,random_change_bps,priced_at) VALUES (?,'automatic',?,?,?,?,?,?,?,?,?,?,?,?,?,?)",[stockId,periodKey,stock.currentPrice,next,change,version,volume.quantity,volume.amount,simulatedQuantity,simulatedAmount,stock.baselineValue,volumeSignal,simulatedSignal,randomSignal,pricedAt]);}catch(error){if(error?.code==='ER_DUP_ENTRY'||error?.errno===1062)return false;throw error;}await tx.query('UPDATE stocks SET current_price=?,price_version=?,last_period_key=? WHERE id=?',[next,version,periodKey,stockId]);return true;});}
}
