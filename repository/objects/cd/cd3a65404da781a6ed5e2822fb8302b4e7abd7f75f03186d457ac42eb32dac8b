async function handleManualActionClick(event) {
  const action = event.target.closest('[data-action]')?.dataset.action;
  if (action === 'manual-fulfillment') {
    const steamIdInput = $('#manualFulfillmentSteamId');
    const codeInput = $('#manualFulfillmentCode');
    const steamId = steamIdInput?.value.trim() || '';
    const code = codeInput?.value.trim() || '';
    if (!/^\d{17}$/.test(steamId)) { toast('SteamID 必须是 17 位数字', true); steamIdInput?.focus(); return true; }
    if (!code) { toast('请输入发货代码', true); codeInput?.focus(); return true; }
    await api('/api/fulfillment/manual', { method: 'POST', body: JSON.stringify({ steamId, code }) });
    codeInput.value = '';
    toast('发货代码已写入队列');
  }
}

