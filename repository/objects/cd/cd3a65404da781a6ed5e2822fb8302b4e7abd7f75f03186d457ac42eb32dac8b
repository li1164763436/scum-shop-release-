    const chips = Object.entries(weapons).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([label, count]) => `<span>${esc(label)} <b>${count}</b></span>`).join('');
    if (chips) stats += `<div class="gameplay-summary-chips">${chips}</div>`;
    table = auditTable(['时间', '武器/来源', '玩家昵称', 'SteamID', '攻击者漂移', '受害者漂移', '攻击者服务器坐标', '受害者服务器坐标', '原始内容', '操作'], audits.map((item, index) => `<tr><td><code>${esc(formatGameLogTimestamp(item.timestamp))}</code></td><td>${esc(item.weaponName || '--')}</td><td>${esc(item.playerName || '--')}</td><td>${auditId(item.steamId)}</td><td>${esc(item.attackerDrift ?? '--')}</td><td>${esc(item.victimDrift ?? '--')}</td><td>${auditLocation(item.serverAttackerLocation)}</td><td>${auditLocation(item.serverVictimLocation)}</td><td><button class="btn tiny" type="button" data-audit-detail="${index}">查看原文</button></td><td><button class="btn tiny" type="button" data-audit-detail="${index}">详情</button></td></tr>`).join(''), '暂无弹道异常记录');
  } else if (category === 'other_violation') {
    stats = auditStats([['其他违规', audits.length], ['涉及玩家', new Set(audits.map((item) => item.steamId).filter(Boolean)).size]]);
    table = auditTable(['时间', '类型', '玩家昵称', '玩家编号', 'SteamID', '摘要', '原始内容', '操作'], audits.map((item, index) => `<tr><td><code>${esc(formatGameLogTimestamp(item.timestamp))}</code></td><td>${esc(item.type || item.typeLabel || '--')}</td><td>${esc(item.playerName || '--')}</td><td><code>${esc(item.playerNumber || '--')}</code></td><td>${auditId(item.steamId)}</td><td>${esc(item.summary || item.reason || '--')}</td><td>${esc(item.raw || '--')}</td><td><button class="btn tiny" type="button" data-audit-detail="${index}">详情</button></td></tr>`).join(''), '暂无其他违规记录');
  } else if (category === 'loot_diagnostic') {
    const errorCount = audits.filter((item) => item.level === 'Error').length;
    const warningCount = audits.filter((item) => item.level === 'Warning').length;
    const categoryCounts = audits.reduce((result, item) => { const key = item.category || '未分类'; result[key] = (result[key] || 0) + 1; return result; }, {});
    const mainCategory = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || '--';
    stats = auditStats([['错误数', errorCount], ['警告数', warningCount], ['主要分类', mainCategory], ['总记录', audits.length]]);
    const levelPill = (level) => { const map = { Error: 'level-error', Log: 'level-log', Warning: 'level-warning', 'Game version': 'level-version' }; return `<span class="level-pill ${map[level] || 'level-log'}">${esc(level || '--')}</span>`; };
    const categoryPill = (cat) => `<span class="audit-type loot-cat">${esc(cat || '--')}</span>`;
    table = auditTable(['时间', '级别', '分类', '内容', '文件类型', '操作'], audits.map((item, index) => {
      const detailHtml = item.errorDetail ? (item.errorDetail.nodePath ? `<br><span class="muted">节点: ${esc(item.errorDetail.nodePath)} / 物品: ${esc(item.errorDetail.itemName)}</span>` : item.errorDetail.invalidItem ? `<br><span class="muted">无效物品: ${esc(item.errorDetail.invalidItem)}</span>` : item.errorDetail.failedFile ? `<br><span class="muted">解析失败: ${esc(item.errorDetail.failedFile)}</span>` : item.errorDetail.spawnerRef ? `<br><span class="muted">刷新点: ${esc(item.errorDetail.spawnerRef)} / 节点: ${esc(item.errorDetail.lootNode)}</span>` : item.errorDetail.message ? `<br><span class="muted">${esc(item.errorDetail.message)}</span>` : '') : '';
      return `<tr><td><code>${esc(formatGameLogTimestamp(item.timestamp))}</code></td><td>${levelPill(item.level)}</td><td>${categoryPill(item.category)}</td><td>${esc(item.content || '--')}${detailHtml}</td><td>${esc(item.fileType || '--')}</td><td><button class="btn tiny" type="button" data-audit-detail="${index}">详情</button></td></tr>`;
    }).join(''), '暂无 Loot 诊断记录');
  } else if (category === 'raid_diagnostic') {
    const errorCount = audits.filter((item) => item.level === 'Error').length;
    const warningCount = audits.filter((item) => item.level === 'Warning').length;
    const categoryCounts = audits.reduce((result, item) => { const key = item.category || '未分类'; result[key] = (result[key] || 0) + 1; return result; }, {});
    const mainCategory = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || '--';
    stats = auditStats([['错误数', errorCount], ['警告数', warningCount], ['主要分类', mainCategory], ['总记录', audits.length]]);
    const levelPill = (level) => { const map = { Error: 'level-error', Log: 'level-log', Warning: 'level-warning', 'Game version': 'level-version' }; return `<span class="level-pill ${map[level] || 'level-log'}">${esc(level || '--')}</span>`; };
    const categoryPill = (cat) => `<span class="audit-type raid-cat">${esc(cat || '--')}</span>`;
    table = auditTable(['时间', '级别', '分类', '内容', '文件类型', '操作'], audits.map((item, index) => `<tr><td><code>${esc(formatGameLogTimestamp(item.timestamp))}</code></td><td>${levelPill(item.level)}</td><td>${categoryPill(item.category)}</td><td>${esc(item.content || '--')}</td><td>${esc(item.fileType || '--')}</td><td><button class="btn tiny" type="button" data-audit-detail="${index}">详情</button></td></tr>`).join(''), '暂无突袭保护诊断记录');
  } else {
    stats = auditStats([['当前页变更', audits.length], ['旧所有者', new Set(audits.map((item) => item.oldOwnerSteamId).filter(Boolean)).size], ['新所有者', new Set(audits.map((item) => item.newOwnerSteamId).filter(Boolean)).size]]);
    table = auditTable(['时间', '认领人 SteamID', '被认领人 SteamID', '结果', '详情', '记录ID', '操作'], audits.map((item, index) => `<tr><td><code>${esc(formatGameLogTimestamp(item.timestamp))}</code></td><td>${auditId(item.oldOwnerSteamId)}</td><td>${auditId(item.newOwnerSteamId)}</td><td><span class="audit-type">所有权已变更</span></td><td>${esc(`${item.oldOwner?.playerName || item.oldOwnerSteamId || '--'} → ${item.newOwner?.playerName || item.newOwnerSteamId || '--'}`)}</td><td><code>${esc(item.recordId || '--')}</code></td><td><button class="btn tiny" type="button" data-audit-detail="${index}">详情</button></td></tr>`).join(''), '暂无队友认领记录');
  }
  $('#logOutput').innerHTML = `<section class="structured-audit"><header class="structured-audit-head"><div><h3>${esc(meta[0])}<span>${esc(meta[1])}</span><b>共 ${audits.length} 条</b></h3><p>${esc(meta[2])}</p></div>${gameLogSearchTools()}</header><div class="structured-audit-notice"><strong>重点提示</strong><span>${esc(meta[3])}</span></div>${stats}${table}</section>`;
  return true;
}
