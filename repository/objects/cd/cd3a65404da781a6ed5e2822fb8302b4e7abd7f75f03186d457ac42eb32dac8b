async function loadLogs(preserveContent = false) {
  const requestVersion = ++logLoadVersion;
  if (!preserveContent) $('#logOutput').innerHTML = '<div class="empty">正在加载日志...</div>';
  try {
    const query = new URLSearchParams({ source: $('#logSourceFilter').value, category: $('#logCategoryFilter').value, file: $('#logFileFilter').value, level: $('#logLevelFilter').value, search: $('#logSearch').value.trim(), limit: $('#logLimit').value });
    const response = await api(`/api/logs?${query}`);
    if (requestVersion !== logLoadVersion) return;
    state.logBrowser = response || {};
    if (renderLogBrowserFilters()) return;
    renderLogs();
  } catch (error) {
    if (requestVersion !== logLoadVersion) return;
    $('#logOutput').innerHTML = `<div class="empty">${esc(error.message)}</div>`;
  }
}
function renderLogBrowserFilters() {
  const data = state.logBrowser || {};
  const category = $('#logCategoryFilter'); const selectedCategory = category.value;
  const categories = data.categories || [];
  const categoryIds = categories.map((item) => item.id || item).filter(Boolean);
  if ((!selectedCategory || !categoryIds.includes(selectedCategory)) && categoryIds.length) {
    category.value = categoryIds[0];
    loadLogs();
    return true;
  }
  const tabs = $('#logCategoryTabs');
  if (tabs) tabs.innerHTML = categories.filter((item) => item.id || item).map((item) => `<button type="button" class="log-category-tab ${selectedCategory === (item.id || item) ? 'active' : ''}" data-log-category="${esc(item.id || item)}"><span>${esc(item.icon || '📄')}</span>${esc(item.label || item)}</button>`).join('');
  return false;
}
