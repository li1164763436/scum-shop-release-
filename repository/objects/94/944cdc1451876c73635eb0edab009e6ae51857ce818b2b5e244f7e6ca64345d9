<div class="modal-backdrop" id="teleportReceiptModal" hidden>
  <section class="modal teleport-receipt-modal" role="dialog" aria-modal="true" aria-labelledby="teleportReceiptTitle">
    <button class="modal-close" type="button" data-modal-close aria-label="关闭">×</button>
    <p class="overline"><span></span> TELEPORT QUOTE</p>
    <h2 id="teleportReceiptTitle">确认传送</h2>
    <p class="teleport-receipt-status" id="teleportReceiptStatus">请核对本次传送距离与费用</p>
    <dl class="teleport-receipt-details" id="teleportReceiptDetails"></dl>
    <p class="teleport-receipt-warning" id="teleportReceiptWarning">位置和费用将在最终确认时重新校验；发生变化时不会扣款。</p>
    <div class="modal-actions">
      <button class="button ghost" id="teleportReceiptCancel" type="button" data-modal-close>取消</button>
      <button class="button primary" id="teleportReceiptConfirm" type="button">确认传送</button>
      <button class="button primary" id="teleportReceiptDone" type="button" data-modal-close hidden>完成</button>
    </div>
  </section>
</div>
