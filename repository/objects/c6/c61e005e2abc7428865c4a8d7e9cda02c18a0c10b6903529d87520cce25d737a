async function handleProductCategoryClick(event) {
  const renameProductParentId = event.target.closest('[data-rename-product-parent]')?.dataset.renameProductParent;
  if (renameProductParentId) {
    const name = $('#modalForm')?.elements.parentName?.value.trim();
    if (!name) { toast('主分类名称不能为空', true); return true; }
    await api(`/api/product-parent-categories/${encodeURIComponent(renameProductParentId)}/name`, { method: 'PUT', body: JSON.stringify({ name }) });
    [state.productParentCategories, state.productCategories, state.products] = await Promise.all([api('/api/product-parent-categories'), api('/api/product-categories'), api('/api/products')]);
    toast('主分类名称已修改');
    const parent = list(state.productParentCategories).find((item) => String(item.id) === renameProductParentId);
    if (parent) productParentModal(parent);
    return true;
  }
  const renameProductCategoryId = event.target.closest('[data-rename-product-category]')?.dataset.renameProductCategory;
  if (renameProductCategoryId) {
    const category = state.productCategories.find((item) => String(item.id) === renameProductCategoryId);
    const name = window.prompt('请输入新的副分类名称', category?.category || '')?.trim();
    if (!name || name === category?.category) return true;
    await api(`/api/product-categories/${encodeURIComponent(renameProductCategoryId)}`, { method: 'PUT', body: JSON.stringify({ name }) });
    [state.productCategories, state.products] = await Promise.all([api('/api/product-categories'), api('/api/products')]);
    toast('副分类名称已修改');
    const parentId = event.target.closest('[data-rename-product-category]')?.dataset.parentId;
    const parent = state.productParentCategories.find((item) => String(item.id) === parentId);
    if (parent) productParentModal(parent);
    return true;
  }
  const deleteProductParentId = event.target.closest('[data-delete-product-parent]')?.dataset.deleteProductParent;
  if (deleteProductParentId) {
    if (!window.confirm('确认删除该主分类及其副分类？正在被商品使用时将无法删除。')) return true;
    await api(`/api/product-parent-categories/${encodeURIComponent(deleteProductParentId)}`, { method: 'DELETE' });
    [state.productParentCategories, state.productCategories] = await Promise.all([api('/api/product-parent-categories'), api('/api/product-categories')]);
    toast('主分类已删除'); productCategoriesModal(); return true;
  }
  if (event.target.closest('[data-back-product-categories]')) { productCategoriesModal(); return true; }
  const editProductParentId = event.target.closest('[data-edit-product-parent]')?.dataset.editProductParent;
  if (editProductParentId) {
    const parent = state.productParentCategories.find((item) => String(item.id) === editProductParentId);
    if (parent) productParentModal(parent);
    return true;
  }
  const moveProductParent = event.target.closest('[data-move-product-parent]');
  if (moveProductParent) {
    const index = state.productParentCategories.findIndex((item) => String(item.id) === moveProductParent.dataset.moveProductParent);
    const target = index + Number(moveProductParent.dataset.direction);
    if (index < 0 || target < 0 || target >= state.productParentCategories.length) return true;
    const ordered = [...state.productParentCategories];
    [ordered[index], ordered[target]] = [ordered[target], ordered[index]];
    await api('/api/product-parent-categories/order', { method: 'PUT', body: JSON.stringify({ ids: ordered.map((item) => item.id) }) });
    state.productParentCategories = list(await api('/api/product-parent-categories'));
    toast('主分类顺序已更新'); productCategoriesModal();
    return true;
  }
  const deleteProductCategoryId = event.target.closest('[data-delete-product-category]')?.dataset.deleteProductCategory;
  if (deleteProductCategoryId) {
    if (!window.confirm('确认删除该分类？')) return true;
    await api(`/api/product-categories/${encodeURIComponent(deleteProductCategoryId)}`, { method: 'DELETE' });
    state.productCategories = list(await api('/api/product-categories'));
    const parentId = event.target.closest('[data-delete-product-category]')?.dataset.parentId;
    toast('副分类已删除');
    const parent = state.productParentCategories.find((item) => String(item.id) === parentId);
    if (parent) productParentModal(parent); else productCategoriesModal();
    return true;
  }
}

async function handleProductClick(event) {
  const productId = event.target.closest('[data-edit-product]')?.dataset.editProduct;
  if (productId) productModal(state.products.find((item) => String(item.id) === productId) || {});
  const productStatus = event.target.closest('[data-product-status]')?.dataset.productStatus;
  if (productStatus !== undefined && window.confirm(productStatus === 'true' ? '确认将全部商品上架？' : '确认将全部商品下架？')) await withBusy(event.target.closest('[data-product-status]'), async () => {
    const result = await api('/api/products/status', { method: 'PATCH', body: JSON.stringify({ enabled: productStatus === 'true' }) });
    toast(`${productStatus === 'true' ? '上架' : '下架'}完成，共更新 ${Number(result?.affectedRows || result?.data?.affectedRows || 0)} 个商品`);
    await loadProducts();
  });
  const deleteProductId = event.target.closest('[data-delete-product]')?.dataset.deleteProduct;
  if (deleteProductId && window.confirm('确认删除该商品？所有相关订单、明细、履约和关联数据将被永久删除，且无法恢复。')) await withBusy(event.target, async () => {
    await api(`/api/products/${encodeURIComponent(deleteProductId)}`, { method: 'DELETE' });
    toast('商品已删除'); await loadProducts();
  });
  if (event.target.closest('[data-add-product-code]')) appendProductCode();
  const removeProductCode = event.target.closest('[data-remove-product-code]');
  if (removeProductCode) removeProductCode.closest('.product-code-row')?.remove();
  if (event.target.closest('[data-clean-product-codes]')) {
    $$('.product-code-row', $('#productCodeRows')).forEach((row) => { if (!normalizeProductCode($('input', row).value)) row.remove(); });
    if (!$('#productCodeRows')?.children.length) appendProductCode();
  }
  if (event.target.closest('[data-upload-product-image]')) $('#productImageFile')?.click();
}

function handleProductCreateClick(event) {
  const action = event.target.closest('[data-action]')?.dataset.action;
  if (action === 'product-categories') productCategoriesModal();
  if (action === 'new-product') productModal();
}


