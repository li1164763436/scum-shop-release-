function productCodes(product) {
  if (Array.isArray(product.codes)) return product.codes.map(String);
  const raw = product.fulfillmentCodes || product.itemId || '';
  return String(raw).split(',').map((code) => code.trim()).filter(Boolean);
}
async function loadProducts() {
  $('#productRows').innerHTML = empty(8, '正在加载商品...', true);
  try {
    const [data, categories, parents] = await Promise.all([api('/api/products'), api('/api/product-categories'), api('/api/product-parent-categories')]);
    state.products = list(data, ['products', 'items']);
    state.productCategories = list(categories);
    state.productParentCategories = list(parents);
    syncProductFilters();
    renderProducts();
    refreshStarterGiftProductData();
  } catch (error) { $('#productRows').innerHTML = empty(8, error.message === '接口不存在' ? '商品接口尚未启用' : error.message); }
}
function uniqueProductValues(key, parent = '') {
  return [...new Set(state.products.filter((item) => !parent || String(item.parentCategory || '') === parent).map((item) => String(item[key] || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
}
function syncProductFilters() {
  const parentSelect = $('#productParentFilter');
  const categorySelect = $('#productCategoryFilter');
  const selectedParent = parentSelect.value;
  const selectedCategory = categorySelect.value;
  parentSelect.innerHTML = '<option value="">全部分类</option>' + uniqueProductValues('parentCategory').map((value) => `<option value="${esc(value)}">${esc(value)}</option>`).join('');
  parentSelect.value = uniqueProductValues('parentCategory').includes(selectedParent) ? selectedParent : '';
  if (!parentSelect.value) {
    categorySelect.innerHTML = '';
    categorySelect.value = '';
    categorySelect.hidden = true;
    categorySelect.disabled = true;
    return;
  }
  const categories = uniqueProductValues('category', parentSelect.value);
  categorySelect.innerHTML = categories.map((value) => `<option value="${esc(value)}">${esc(value)}</option>`).join('');
  categorySelect.value = categories.includes(selectedCategory) ? selectedCategory : '';
  categorySelect.hidden = false;
  categorySelect.disabled = false;
}
function renderProducts() {
  const keyword = $('#productSearch').value.trim().toLowerCase();
  const filter = $('#productStatusFilter').value;
  const parentFilter = $('#productParentFilter').value;
  const categoryFilter = $('#productCategoryFilter').value;
  const rows = state.products.filter((item) => {
    const text = [item.name, item.parentCategory, item.category, item.sku, ...productCodes(item)].join(' ').toLowerCase();
    const itemStatus = item.enabled === false ? 'inactive' : 'active';
    return (!keyword || text.includes(keyword)) && (!filter || itemStatus === filter) && (!parentFilter || item.parentCategory === parentFilter) && (!categoryFilter || item.category === categoryFilter);
  });
  $('#productResultCount').textContent = `${rows.length} / ${state.products.length} 项`;
  $('#productRows').innerHTML = rows.length ? rows.map((item) => {
    const itemStatus = item.enabled === false ? 'inactive' : 'active';
    const codes = productCodes(item);
    const fullCodes = codes.join(', ');
    const codePreview = codes.slice(0, 3).join(', ') + (codes.length > 3 ? ` 等 ${codes.length} 条` : '');
    const image = item.imagePath ? `<img class="product-thumb" src="${esc(item.imagePath)}" alt="${esc(item.name || '商品')}" loading="lazy">` : '<span class="product-thumb placeholder">无图</span>';
    const memberLevel = Number(item.minMemberLevel || 0);
    return `<tr><td class="product-id">${esc(item.id ?? '--')}</td><td><strong class="product-name" title="${esc(item.name || '未命名商品')}">${esc(item.name || '未命名商品')}</strong></td><td>${image}</td><td><span class="category-path">${esc(item.parentCategory || '未分组')}<i>/</i>${esc(item.category || '未分类')}</span></td><td><code class="code-preview" title="${esc(fullCodes)}">${esc(codePreview || '--')}</code><small class="table-note">${codes.length} 条发货代码</small></td><td><span class="money">${number(item.price)} ${esc({ money: '美金', gold: '金条' }[item.currencyType] || '商城币')}</span></td><td>${memberLevel > 0 ? `Lv.${number(memberLevel)}` : '无限制'}</td><td>${status(itemStatus)}</td><td><div class="row-actions product-actions"><button class="row-btn product-action edit" data-edit-product="${esc(item.id)}">编辑</button><button class="row-btn product-action danger" data-delete-product="${esc(item.id)}">删除</button></div></td></tr>`;
  }).join('') : empty(9, '暂无符合条件的商品');
}

function productCodeRow(value = '') {
  return `<div class="product-code-row"><input type="search" name="fulfillmentCode" value="${esc(value)}" placeholder="#spawnanimal / #SpawnZombie / #SpawnItem / 纯物品代码" maxlength="160" aria-label="物品代码"><button class="row-btn danger" type="button" data-remove-product-code>删除</button></div>`;
}
function normalizeProductCode(value, parentCategory = '', category = '') {
  const code = String(value || '').trim();
  if (parentCategory !== 'NPC' || category !== '动物') return code;
  if (/^#spawnanimal\b/i.test(code)) return code.replace(/^#spawnanimal\b/i, '#spawnanimal');
  if (/^#spawnitem\s+/i.test(code)) return code.replace(/^#spawnitem\s+/i, '#spawnanimal ');
  return code.startsWith('#') || !code ? code : `#spawnanimal ${code}`;
}
function appendProductCode(value = '') {
  $('#productCodeRows')?.insertAdjacentHTML('beforeend', productCodeRow(value));
}
async function uploadProductImage(file, form) {
  const query = new URLSearchParams({ parentCategory: form.elements.parentCategory?.value || '', category: form.elements.category?.value || '' });
  return uploadImage(file, `/api/products/image?${query}`);
}
function updateProductImagePreview(path) {
  const preview = $('#productImagePreview');
  if (!preview) return;
  preview.innerHTML = path ? `<img src="${esc(path)}" alt="商品图片预览">` : '<span>暂无图片</span>';
}
function productCategoryOptions(selectedParent = '', selectedCategory = '') {
  const parents = [...new Set(state.productCategories.map((item) => item.parentCategory))];
  const parentOptions = parents.map((value) => `<option value="${esc(value)}" ${value === selectedParent ? 'selected' : ''}>${esc(value)}</option>`).join('');
  const categories = state.productCategories.filter((item) => item.parentCategory === selectedParent);
  const categoryOptions = categories.map((item) => `<option value="${esc(item.category)}" ${item.category === selectedCategory ? 'selected' : ''}>${esc(item.category)}</option>`).join('');
  return { parentOptions, categoryOptions };
}
function syncProductModalCategories() {
  const form = $('#modalForm');
  const parent = form?.elements.parentCategory;
  const category = form?.elements.category;
  if (!parent || !category) return;
  const selected = category.value;
  const values = state.productCategories.filter((item) => item.parentCategory === parent.value).map((item) => item.category);
  category.innerHTML = '<option value="">请选择副分类</option>' + values.map((value) => `<option value="${esc(value)}">${esc(value)}</option>`).join('');
  category.value = values.includes(selected) ? selected : '';
}
