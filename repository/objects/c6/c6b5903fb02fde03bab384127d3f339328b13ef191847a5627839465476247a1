 async manualPrice(value,input,key,actor){const stockId=idOf(value),newPrice=positive(input?.newPrice,'新价格'),reason=String(input?.reason||'').trim(),requestKey=String(key||'').trim();if(!requestKey||requestKey.length>100)throw new ServiceError('Idempotency-Key 长度必须为 1-100');if(!reason||reason.length>500)throw new ServiceError('调价原因长度必须为 1-500');const existing=(await this.db.query('SELECT stock_id AS stockId,price_after AS priceAfter,reason FROM stock_price_history WHERE request_key=?',[requestKey]))[0];if(existing){if(Number(existing.stockId)!==stockId||Number(existing.priceAfter)!==newPrice||existing.reason!==reason)throw new ServiceError('Idempotency-Key 已被其他调价请求使用',409,'IDEMPOTENCY_CONFLICT');return{...mapHistory((await this.db.query('SELECT id,stock_id AS stockId,source,period_key AS periodKey,price_before AS priceBefore,price_after AS priceAfter,change_bps AS changeBps,price_version AS priceVersion,volume_quantity AS volumeQuantity,volume_amount AS volumeAmount,baseline_value AS baselineValue,volume_change_bps AS volumeChangeBps,random_change_bps AS randomChangeBps,actor_username_snapshot AS actorUsername,reason,priced_at AS pricedAt FROM stock_price_history WHERE request_key=?',[requestKey]))[0]),idempotent:true};}try{return await this.db.transaction(async tx=>{const stock=await this.get(stockId,tx,true);if(stock.maxPrice!==null&&newPrice>stock.maxPrice)throw new ServiceError('新价格不能超过股票最高价',409,'PRICE_ABOVE_MAXIMUM');const version=stock.priceVersion+1,change=stock.currentPrice?Math.round(((newPrice-stock.currentPrice)/stock.currentPrice)*10000):0,now=this.clock();const result=await tx.query('INSERT INTO stock_price_history (stock_id,source,period_key,price_before,price_after,change_bps,price_version,actor_user_id,actor_username_snapshot,reason,request_key,priced_at) VALUES (?,\'manual\',NULL,?,?,?,?,?,?,?,?,?)',[stockId,stock.currentPrice,newPrice,change,version,idOf(actor?.id,'管理员用户 ID'),String(actor?.username||'admin').slice(0,100),reason,requestKey,now]);aw