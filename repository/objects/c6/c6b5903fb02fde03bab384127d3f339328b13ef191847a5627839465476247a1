 async setWatch(steamId,stockId,enabled){if(!isSteamId64(steamId))throw new ServiceError('SteamID 格式无效');await this.get(stockId);if(enabled)await this.db.query('INSERT INTO stock_watchlists (steam_id,stock_id) VALUES (?,?) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)',[String(steamId),idOf(stockId)]);else await this.db.query('DELETE FROM stock_watchlists WHERE steam_id=? AND stock_id=?',[String(steamId),idOf(stockId)]);return this.watchlist(steamId);}
 async announcements(publicOnly=false){const where=publicOnly?'WHERE enabled=1 AND (starts_at IS NULL OR starts_at<=?) AND (ends_at IS NULL OR ends_at>?)':'';const params=publicOnly?[this.clock(),this.clock()]:[];return this.db.query(`SELECT id,title,content,enabled,starts_at AS startsAt,ends_at AS endsAt,created_at AS createdAt,updated_at AS updatedAt FROM stock_market_announcements ${where} ORDER BY created_at DESC`,params);}
 async saveAnnouncement(input,value=null,actorId){const title=String(input?.title||'').trim(),content=String(input?.content||'').trim(),ends=announcementDate(input?.endsAt,'结束时间'),starts=announcementDate(value===null?this.clock():input?.startsAt,'开始时间');if(!title||title.length>150||!content)throw new ServiceError('公告标题或内容无效');if(starts&&ends&&new Date(starts)>=new Date(ends))throw new ServiceError('公告开始时间必须早于结束时间');const actor=idOf(actorId,'管理员用户 ID');if(value===null){const result=await this.db.query('INSERT INTO stock_market_announcements (title,content,enabled,starts_at,ends_at,created_by_user_id,updated_by_user_id) VALUES (?,?,?,?,?,?,?)',[title,content,input?.enabled!==false,starts,ends,actor,actor]);return{id:Number(result.insertId)};}const result=await this.db.query('UPDATE stock_market_announcements SET title=?,content=?,enabled=?,starts_at=?,ends_at=?,updated_by_user_id=? WHERE id=?',[title,content,input?.enabled!==false,starts,ends,actor,idOf(value,'公告 ID')]);if(!result.affectedRows)throw new ServiceError('公告不存在',404,'NOT_FOUND');return{id:Number(value)};}
 async setAnnouncementStatus(value,enabled,actorId){const result=await this.db.query('UPDATE stock_market_announcements SET enabled=?,updated_by_user_id=? WHERE id=?',[Boolean(enabled),idOf(actorId,'管理员用户 ID'),idOf(value,'公告 ID')]);if(!result.affectedRows)throw new ServiceError('公告不存在',404,'NOT_FOUND');}
 async deleteAnnouncement(value){const result=await this.db.query('DELETE FROM stock_market_announcements WHERE id=?',[idOf(value,'公告 ID')]);if(!result.affectedRows)throw new ServiceError('公告不存在',404,'NOT_FOUND');}
 async overview(steamId=null){const hasPlayer=isSteamId64(steamId),emptyPortfolio={balance:0,marketValue:0,totalAssets:0,portfolioCost:0,unrealizedProfit:0,unrealizedReturnBps:0,realizedProfit:0,totalFees:0,items:[],risks:[]};const [quotes,portfolio,watchlist,announcements,status]=await Promise.all([this.quotes(),hasPlayer?this.portfolio(steamId):emptyPortfolio,hasPlayer?this.watchlist(steamId):[],this.announcements(true),this.marketStatus()]);const ratios=quotes.map(item=>item.currentPrice/item.basePrice),indexValue=ratios.length?1000*ratios.reduce((a,b)=>a+b,0)/ratios.length:1000,indexChangeBps=Math.round((indexValue/1000-1)*10000),descending=(a,b)=>Number(b.lastChangeBps)-Number(a.lastChangeBps)||a.code.localeCompare(b.code),ascending=(a,b)=>Number(a.lastChangeBps)-Number(b.lastChangeBps)||a.code.localeCompare(b.code);if(quotes.some(item=>item.atLimit)&&!portfolio.risks.some(item=>item.code==='PRICE_LIMIT'))portfolio.risks.push({code:'PRICE_LIMIT',level:'warning',message:'存在股票最近一次价格变动达到单周期最大涨跌限制。'});return{market:{name:'虚拟股市',...status,riskStatement:'模拟证券交易仅使用游戏商城币，不代表真实证券或收益承诺。'},index:{value:Number(indexValue.toFixed(2)),changeBps:indexChangeBps,riseCount:quotes.filter(x=>x.currentPrice>x.basePrice).length,fallCount:quotes.filter(x=>x.currentPrice<x.basePrice).length,flatCount:quotes.filter(x=>x.currentPrice===x.basePrice).length},gainers:[...quotes].sort(descending).slice(0,5),losers:[...quotes].sort(ascending).slice(0,5),quotes,watchlist,announcements,portfolio};}
 async findTrade(key,query=this.db){const rows=await query.query('SELECT t.id,t.steam_id AS steamId,t.stock_id AS stockId,s.code,s.name,t.direction,t.quantity,t.price,t.fee,t.gross_amount AS grossAmount,t.net_amount AS netAmount,t.balance_before AS balanceBefore,t.balance_after AS balanceAfter,t.holding_before AS holdingBefore,t.holding_after AS holdingAfter,t.average_cost_before AS averageCostBefore,t.average_cost_after AS averageCostAfter,t.price_version AS priceVersion,t.price_time_snapshot AS priceTimeSnapshot,t.created_at AS createdAt FROM stock_trades t JOIN stocks s ON s.id=t.stock_id WHERE t.request_key=?',[key]);return rows[0]?Object.fromEntries(Object.entries(rows[0]).map(([k,v])=>[k,['id','stockId','quantity','price','fee','grossAmount','netAmount','balanceBefore','balanceAfter','holdingBefore','holdingAfter','averageCostBefore','averageCostAfter','priceVersion'].includes(k)?Number(v):v])):null;}
 replay(existing,steamId,stockId,direction,quantity){if(String(existing.steamId)!==String(steamId)||Number(existing.stockId)!==stockId||existing.direction!==direction||Number(existing.quantity)!==quantity)throw new ServiceError('Idempotency-Key 已被其他交易请求使用',409,'IDEMPOTENCY_CONFLICT');return{...existing,idempotent:true};}
 async trade(stockValue,steamId,direction,quantityValue,requestKey){const status=await this.marketStatus();if(!status.isOpen)throw new ServiceError('证券市场当前闭市',409,'MARKET_CLOSED');const stockId=idOf(stockValue),quantity=positive(quantityValue,'交易数量'),side=String(direction);if(!['buy','sell'].includes(side))throw new ServiceError('交易方向无效');if(!isSteamId64(steamId))throw new ServiceError('SteamID 格式无效');const key=String(requestKey||'').trim();if(!key||key.length>100)throw new ServiceError('Idempotency-Key 长度必须为 1-100');const prior=await this.findTrade(key);if(prior)return this.replay(prior,steamId,stockId,side,quantity);try{return await this.db.transaction(async tx=>{const repeated=await this.findTrade(key,tx);if(repeated)return this.replay(repeated,steamId,stockId,side,quantity);await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)',[String(steamId)]);const user=(await tx.query("SELECT \`商城用户编号\` AS id FROM \`商城用户\` WHERE \`SteamID\`=? AND \`用户角色\` IN ('user','admin','super_admin') AND \`账户状态\`='active' FOR UPDATE",[String(steamId)]))[0];if(!user)throw new ServiceError('商城用户不存在或已停用',403,'SHOP_USER_UNAVAILABLE');const stock=await this.get(stockId,tx,true);if(!stock.enabled||stock.paused)throw new ServiceError('股票当前不可交易',409,'STOCK_UNAVAILABLE');const account=(await tx.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE',[String(steamId)]))[0],balance=Number(account.balance);await tx.query('INSERT INTO stock_holdings (stock_id,steam_id,quantity,average_cost) VALUES (?,?,0,0) ON DUPLICATE KEY UPDATE stock_id=VALUES(stock_id)',[stockId,String(steamId)]);const holding=(await tx.query('SELECT quantity,average_cost AS averageCost FROM stock_holdings WHERE stock_id=? AND steam_id=? FOR UPDATE',[stockId,String(steamId)]))[0],before=Number(holding.quantity),averageBefore=Number(holding.averageCost),gross=safeMul(stock.currentPrice,quantity),fee=feeFor(gross,stock.feeBps);let afterBalance,afterHolding,averageAfter,net;if(side==='buy'){net=gross+fee;if(balance<net)throw new ServiceError('商城币余额不足',409,'INSUFFICIENT_BALANCE');afterBalance=balance-net;afterHolding=before+quantity;averageAfter=nextAverageCost(before,averageBefore,quantity,stock.currentPrice,fee);}else{if(before<quantity)throw new ServiceError('持仓不足',409,'INSUFFICIENT_HOLDING');if(fee>=gross)throw new ServiceError('卖出金额不足以支付手续费',409,'FEE_EXCEEDS_GROSS');net=gross-fee;afterBalance=balance+net;afterHolding=before-quantity;averageAfter=afterHolding===0?0:averageBefore;}const inserted=await tx.query('INSERT INTO stock_trades (request_key,steam_id,stock_id,direction,quantity,price,fee,gross_amount,net_amount,balance_before,balance_after,holding_before,holding_after,average_cost_before,average_cost_after,price_version,price_time_snapshot) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',[key,String(steamId),stockId,side,quantity,stock.currentPrice,fee,gross,net,balance,afterBalance,before,afterHolding,averageBefore,averageAfter,stock.priceVersion,stock.updatedAt]);await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?',[afterBalance,String(steamId)]);await tx.query('UPDATE stock_holdings SET quantity=?,average_cost=? WHERE stock_id=? AND steam_id=?',[afterHolding,averageAfter,stockId,String(steamId)]);await tx.query('INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,?,?,?,?)',[String(steamId),side==='buy'?-net:net,afterBalance,side==='buy'?'stock_buy':'stock_sell','stock_trade',String(inserted.insertId),`${side==='buy'?'买入':'卖出'} ${stock.code} × ${quantity}`]);return{...await this.findTrade(key,tx),idempotent:false};});}catch(error){if(!duplicate(error))throw error;const existing=await this.findTrade(key);if(existing)return this.replay(existing,steamId,stockId,side,quantity);throw error;}}
 async portfolio(steamId){if(!isSteamId64(steamId))throw new ServiceError('SteamID 格式无效');const account=(await this.db.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=?',[String(steamId)]))[0]||{balance:0};const holdings=await this.db.query('SELECT h.stock_id AS stockId,s.code,s.name,h.quantity,h.average_cost AS averageCost,s.current_price AS currentPrice,s.price_version AS priceVersion,s.paused,(SELECT t.price FROM stock_trades t WHERE t.stock_id=h.stock_id AND t.steam_id=h.steam_id ORDER BY t.id DESC LIMIT 1) AS lastTradePrice,(SELECT t.created_at FROM stock_trades t WHERE t.stock_id=h.stock_id AND t.steam_id=h.steam_id ORDER BY t.id DESC LIMIT 1) AS lastTradeAt FROM stock_holdings h JOIN stocks s ON s.id=h.stock_id WHERE h.steam_id=? AND h.quantity>0 ORDER BY s.code',[String(steamId)]);let marketValue=0,portfolioCost=0;const items=holdings.map(item=>{const value=safeMul(Number(item.quantity),Number(item.currentPrice)),cost=safeMul(Number(item.quantity),Number(item.averageCost));marketValue+=value;portfolioCost+=cost;return{...item,paused:Boolean(item.paused),stockId:Number(item.stockId),quantity:Number(item.quantity),averageCost:Number(item.averageCost),currentPrice:Number(item.currentPrice),lastTradePrice:item.lastTradePrice===null||item.lastTradePrice===undefined?null:Number(item.lastTradePrice),marketValue:value,cost,unrealizedProfit:value-cost};});const totals=(await this.db.query("SELECT COALESCE(SUM(CASE WHEN direction='sell' THEN (CAST(price AS DECIMAL(65,0))-CAST(average_cost_before AS DECIMAL(65,0)))*CAST(quantity AS DECIMAL(65,0))-CAST(fee AS DECIMAL(65,0)) ELSE CAST(0 AS DECIMAL(65,0)) END),CAST(0 AS DECIMAL(65,0))) AS realizedProfit,COALESCE(SUM(CAST(fee AS DECIMAL(65,0))),CAST(0 AS DECIMAL(65,0))) AS totalFees FROM stock_trades WHERE steam_id=?",[String(steamId)]))[0]||{};const balance=Number(account.balance),totalAssets=balance+marketValue,unrealizedProfit=marketValue-portfolioCost,unrealizedReturnBps=portfolioCost?Math.round(unrealizedProfit/portfolioCost*10000):0,realizedProfit=Number(totals.realizedProfit||0),totalFees=Number(totals.totalFees||0);const risks=[];const status=await this.marketStatus();if(!status.isOpen)risks.push({code:'MARKET_CLOSED',level:'info',message:'市场当前闭市，无法买卖。'});if(items.length===1)risks.push({code:'SINGLE_STOCK',level:'warning',message:'当前仅持有单只股票，存在集中风险。'});if(marketValue&&Math.max(...items.map(x=>x.marketValue))/marketValue>=0.7)risks.push({code:'CONCENTRATION',level:'warning',message:'单只股票仓位达到或超过 70%。'});if(unrealizedReturnBps<=-2000)risks.push({code:'LARGE_LOSS',level:'danger',message:'当前持仓浮亏达到或超过 20%。'});if(items.some(x=>x.paused))risks.push({code:'PAUSED_HOLDING',level:'warning',message:'持仓中包含暂停交易股票。'});if(totalAssets&&balance/totalAssets<0.1)risks.push({code:'LOW_CASH',level:'warning',message:'现金比例低于总资产的 10%。'});return{balance,marketValue,totalAssets,portfolioCost,unrealizedProfit,unrealizedReturnBps,realizedProfit,totalFees,items,risks};}
 async trades(steamId=null,{limit=100}={}){const safe=Math.min(Math.max(Number(limit)||100,1),500);if(steamId!==null){if(!isSteamId64(steamId))throw new ServiceError('SteamID 格式无效');return this.db.query(`SELECT t.id,t.stock_id AS stockId,s.code,s.name,t.direction,t.quantity,t.price,t.fee,t.gross_amount AS grossAmount,t.net_amount AS netAmount,t.balance_after AS balanceAfter,t.holding_after AS holdingAfter,t.created_at AS createdAt FROM stock_trades t JOIN stocks s ON s.id=t.stock_id WHERE t.steam_id=? ORDER BY t.id DESC LIMIT ${safe}`,[String(steamId)]);}return this.db.query(`SELECT t.id,t.steam_id AS steamId,t.stock_id AS stockId,s.code,s.name,t.direction,t.quantity,t.price,t.fee,t.net_amount AS netAmount,t.created_at AS createdAt FROM stock_trades t JOIN stocks s ON s.id=t.stock_id ORDER BY t.id DESC LIMIT ${safe}`);}
