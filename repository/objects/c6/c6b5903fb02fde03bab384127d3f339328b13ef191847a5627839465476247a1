 async candles(value,{period='stock',limit=60,enabledOnly=false}={}){const stockId=idOf(value),selectedPeriod=candlePeriod(period),safeLimit=candleLimit(limit);const rows=await this.db.query(`SELECT id,current_price AS currentPrice,period_seconds AS periodSeconds,created_at AS createdAt FROM stocks WHERE id=?${enabledOnly?' AND enabled=1':''}`,[stockId]);if(!rows[0])throw new ServiceError('股票标的不存在',404,'NOT_FOUND');const stock=rows[0],stockInterval=positive(stock.periodSeconds,'股票周期',86400),intervalSeconds=selectedPeriod==='stock'?stockInterval:CANDLE_INTERVALS[selectedPeriod],currentMs=timeMs(this.clock());let nowMs=currentMs;if(nowMs===null)throw new ServiceError('当前时间无效',500,'INVALID_TIME');const market=await this.marketStatus();if(!market.isOpen){const latest=(await this.db.query('SELECT priced_at AS pricedAt FROM stock_price_history WHERE stock_id=? AND priced_at<=? ORDER BY priced_at DESC,id DESC LIMIT 1',[stockId,new Date(currentMs)]))[0];nowMs=timeMs(latest?.pricedAt??stock.createdAt)??currentMs;}const endStart=bucketStart(nowMs,selectedPeriod,intervalSeconds),windowStart=endStart-(safeLimit-1)*intervalSeconds*1000,windowEnd=endStart+intervalSeconds*1000;const events=await this.db.query('SELECT id,price_before AS priceBefore,price_after AS priceAfter,simulated_volume_quantity AS simulatedVolumeQuantity,simulated_volume_amount AS simulatedVolumeAmount,priced_at AS pricedAt FROM stock_price_history WHERE stock_id=? AND priced_at>=? AND priced_at<? ORDER BY priced_at ASC,id ASC',[stockId,new Date(windowStart),new Date(windowEnd)]);const prior=(await this.db.query('SELECT price_after AS priceAfter,priced_at AS pricedAt FROM stock_price_history WHERE stock_id=? AND priced_at<? ORDER BY priced_at DESC,id DESC LIMIT 1',[stockId,new Date(windowStart)]))[0],trades=await this.db.query('SELECT quantity,gross_amount AS grossAmount,created_at AS createdAt FROM stock_trades WHERE stock_id=? AND created_at>=? AND created_at<? ORDER BY created_at ASC,id ASC',[stockId,new Date(windowStart),new Date(windowEnd)]);if(!events.length&&!prior&&!trades.length){const price=positive(stock.currentPrice,'当前价格'),createdMs=timeMs(stock.createdAt)??nowMs,start=Math.max(windowStart,Math.min(endStart,bucketStart(createdMs,selectedPeriod,intervalSeconds)));return{stockId,period:selectedPeriod,timezone:'Asia/Shanghai',intervalSeconds,candles:[{startAt:new Date(start).toISOString(),endAt:new Date(start+intervalSeconds*1000).toISOString(),open:price,high:price,low:price,close:price,volume:0,turnover:0}]};}const buckets=new Map(),simulatedBuckets=new Map();for(const event of events){const at=timeMs(event.pricedAt),before=positive(event.priceBefore,'历史价格'),after=positive(event.priceAfter,'历史价格');if(at===null)continue;const start=bucketStart(at,selectedPeriod,intervalSeconds);if(start<windowStart||start>=windowEnd)continue;const simulated=simulatedBuckets.get(start)||{volume:0,turnover:0},simulatedVolume=safeNonNegative(event.simulatedVolumeQuantity)||0,simulatedTurnover=safeNonNegative(event.simulatedVolumeAmount)||0;if(Number.isSafeInteger(simulated.volume+simulatedVolume)&&Number.isSafeInteger(simulated.turnover+simulatedTurnover)){simulated.volume+=simulatedVolume;simulated.turnover+=simulatedTurnover;simulatedBuckets.set(start,simulated);}const candle=buckets.get(start);if(candle){candle.high=Math.max(candle.high,before,after);candle.low=Math.min(candle.low,before,after);candle.close=after;}else buckets.set(start,{startAt:new Date(start).toISOString(),endAt:new Date(start+intervalSeconds*1000).toISOString(),open:before,high:Math.max(before,after),low:Math.min(before,after),close:after,volume:0,turnover:0});}const tradeBuckets=new Map();for(const trade of trades){const at=timeMs(trade.createdAt),quantity=safeNonNegative(trade.quantity),gross=safeNonNegative(trade.grossAmount);if(at===null||quantity===null||gross===null)continue;const start=bucketStart(at,selectedPeriod,intervalSeconds),current=tradeBuckets.get(start)||{volume:0,turnover:0};if(Number.isSa