 async save(input,value=null,creatorId){try{return await this.db.transaction(async tx=>{let id;if(value===null){const stock=normalize(input,creatorId);const result=await tx.query('INSERT INTO stocks (code,name,description,current_price,base_price,enabled,paused,pricing_mode,volume_metric,baseline_value,auto_volume_max,volume_sensitivity_bps,volatility_bps,max_change_bps,min_price,max_price,fee_bps,period_seconds,created_by_user_id) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',[stock.code,stock.name,stock.description||null,stock.currentPrice,stock.basePrice,stock.enabled,stock.paused,stock.pricingMode,stock.volumeMetric,stock.baselineValue,stock.autoVolumeMax,stock.volumeSensitivityBps,stock.volatilityBps,stock.maxChangeBps,stock.minPrice,stock.maxPrice,stock.feeBps,stock.periodSeconds,stock.creatorId]);id=result.insertId;}else{id=idOf(value);const previous=await this.get(id,tx,true),stock=normalize(input,creatorId,{editing:true,currentPrice:previous.currentPrice});const result=await tx.query('UPDATE stocks SET code=?,name=?,description=?,base_price=?,enabled=?,paused=?,pricing_mode=?,volume_metric=?,baseline_value=?,auto_volume_max=?,volume_sensitivity_bps=?,volatility_bps=?,max_change_bps=?,min_price=?,max_price=?,fee_bps=?,last_period_key=CASE WHEN period_seconds<>? THEN NULL ELSE last_period_key END,period_seconds=? WHERE id=?',[stock.code,stock.name,stock.description||null,stock.basePrice,stock.enabled,stock.paused,stock.pricingMode,stock.volumeMetric,stock.baselineValue,stock.autoVolumeMax,stock.volumeSensitivityBps,stock.volatilityBps,stock.maxChangeBps,stock.minPrice,stock.maxPrice,stock.feeBps,stock.periodSeconds,stock.periodSeconds,id]);if(!result.affectedRows)throw new ServiceError('股票标的不存在',404,'NOT_FOUND');}return this.get(id,tx);});}catch(error){if(duplicate(error))throw new ServiceError('股票代码已存在',409,'DUPLICATE_CODE');throw error;}}
