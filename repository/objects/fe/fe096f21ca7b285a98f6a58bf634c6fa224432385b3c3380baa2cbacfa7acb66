  }

  replay(operation, owner, target) {
    if (String(operation.steamId) !== owner || operation.requestFingerprint !== fingerprint(owner, target)) throw new ServiceError('Idempotency-Key 已被其他传送请求使用', 409, 'IDEMPOTENCY_CONFLICT');
    return publicOperation({ ...operation, idempotent: true });
  }

  async quota(owner, category, settings, entitlements, query = this.db) {
    const vehicle = category === 'vehicle';
    const typeClause = vehicle ? "`目标类型` IN ('vehicle_to_territory_flag','vehicle_to_player')" : "`目标类型` IN ('player','owned_vehicle','territory_flag','fixed_location')";
    const result = rows(await query.query(`SELECT COUNT(*) AS used,MAX(\`创建时间\`) AS lastUsedAt FROM \`传送执行记录\` WHERE \`发起玩家SteamID\`=? AND ${typeClause} AND \`执行状态\` IN ('prepared','completed','manual_review','command_result_unknown','success_pending_persistence','verified') AND \`创建时间\`>=UTC_DATE() AND \`创建时间\`<UTC_DATE()+INTERVAL 1 DAY`, [owner]))[0] || {};
    const included = Math.max(0, Number(entitlements.dailyTeleports || 0));
    const base = Math.max(0, Number(vehicle ? settings.vehicleDailyLimit : settings.characterDailyLimit));
    const total = base + included;
    const used = Number(result.used || 0);
    const intervalSeconds = Math.max(0, Number(vehicle ? settings.vehicleIntervalSeconds : settings.characterIntervalSeconds) || 0);
    const lastUsedMs = result.lastUsedAt ? Date.parse(result.lastUsedAt) : NaN;
    const intervalRemainingSeconds = Number.isFinite(lastUsedMs) ? Math.max(0, Math.ceil((lastUsedMs + intervalSeconds * 1000 - Date.now()) / 1000)) : 0;
    return { date: new Date().toISOString().slice(0, 10), base, included, total, used, remaining: Math.max(0, total - used), intervalSeconds, intervalRemainingSeconds };
  }

  async onlinePlayers() {
    const { ggcon } = await this.clients();
    return rows(await ggcon.players({ priority: 'high' }));
  }

  async squadMemberIds(owner, query = this.db) {
    const members = rows(await query.query("SELECT mate.`SteamID` AS steamId FROM `商城用户` self JOIN `商城用户` mate ON mate.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND mate.`SteamID`<>self.`SteamID`", [owner]));
    return new Set(members.map((member) => String(member.steamId || '')).filter(isSteamId64));
  }

  playerTargets(owner, players, squadMemberIds) {
    const counts = new Map();
    for (const player of players) {
      const steamId = String(player?.steamId || '');
      if (isSteamId64(steamId)) counts.set(steamId, (counts.get(steamId) || 0) + 1);
    }
    return players
      .filter((player) => {
        const steamId = String(player?.steamId || '');
        return steamId !== owner && squadMemberIds.has(steamId) && isSteamId64(steamId) && counts.get(steamId) === 1;
      })
      .map((player) => ({ id: playerTargetId(player.steamId), type: 'player', name: playerTargetName(player) }))
      .sort((left, right) => left.name.localeCompare(right.name, 'zh-CN'));
  }

  async overview(steamId) {
    const owner = String(steamId || '');
    if (!isSteamId64(owner)) throw new ServiceError('SteamID 格式无效', 400, 'INVALID_STEAM_ID');
    const [settings, entitlements, vehicles, lastKnownPlayers, flags, fixedLocations, runtimeCapabilities] = await Promise.all([
      this.settings(),
      this.membershipEntitlements(owner),
      this.db.query("SELECT v.`载具档案编号` AS id,COALESCE(NULLIF(v.`显示名称`,''),NULLIF(v.`型号名称`,''),NULLIF(v.`载具类型`,''),'已上锁载具') AS name,v.`车牌号` AS plateNumber,(v.`来源同步时间`>=DATE_SUB(NOW(),INTERVAL 5 MINUTE)) AS realtime FROM `载具档案` v WHERE (v.`车主SteamID`=? OR EXISTS (SELECT 1 FROM `商城用户` self JOIN `商城用户` vehicle_owner ON vehicle_owner.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND vehicle_owner.`SteamID`=v.`车主SteamID`)) AND v.`来源类型`='scum_locked_vehicle' AND v.`来源同步状态`='present' AND v.`来源同步时间`>=DATE_SUB(NOW(),INTERVAL 24 HOUR) AND v.`世界X坐标` IS NOT NULL AND v.`世界Y坐标` IS NOT NULL AND v.`世界Z坐标` IS NOT NULL AND v.`来源锁槽数量`>0 AND v.`来源载具编号` IS NOT NULL AND v.`档案状态`='active' ORDER BY COALESCE(v.`显示名称`,v.`型号名称`,v.`载具类型`),v.`载具档案编号`", [owner, owner]),
      this.db.query("SELECT mate.`SteamID` AS steamId,mate.`游戏名称` AS name,mate.`位置是否当前有效` AS online FROM `商城用户` mate JOIN `商城用户` self ON self.`小队编号`=mate.`小队编号` AND self.`SteamID`=? AND self.`小队编号`<>'' WHERE mate.`SteamID`<>? AND mate.`位置观测时间`>=DATE_SUB(NOW(),INTERVAL 24 HOUR) AND mate.`位置世界Z坐标` IS NOT NULL", [owner, owner]),
      this.db.query("SELECT f.`实体标识` AS flagId,f.`显示名称` AS name FROM `传送位置快照` f WHERE f.`实体类型`='flag' AND f.`是否当前有效`=1 AND (f.`归属SteamID`=? OR EXISTS (SELECT 1 FROM `商城用户` self JOIN `商城用户` flag_owner ON flag_owner.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND flag_owner.`SteamID`=f.`归属SteamID`)) ORDER BY f.`显示名称`,f.`实体标识`", [owner, owner]),
      this.fixedLocations({ enabledOnly: true, ownerSteamId: owner }),
      this.runtimeCapabilities()
    ]);
    let playerTargets = [];
    let onlinePlayerTargets = [];
    let playerTargetError = null;
    if ((settings.playerEnabled && runtimeCapabilities.player) || (settings.vehicleToPlayerEnabled && runtimeCapabilities.vehicleToPlayer)) {
      try {
        const [players, squadMemberIds] = await Promise.all([this.onlinePlayers(), this.squadMemberIds(owner)]);
        playerTargets = this.playerTargets(owner, players, squadMemberIds);
        onlinePlayerTargets = [...playerTargets];
        const liveTargetIds = new Set(playerTargets.map((item) => item.id));
        for (const player of rows(lastKnownPlayers)) {
          const id = playerTargetId(player.steamId);
          if (!liveTargetIds.has(id) && squadMemberIds.has(String(player.steamId || ''))) playerTargets.push({ id, type: 'player', name: `${String(player.name || '小队成员')}（离线最后位置）`, lastKnown: true });
        }
        playerTargets.sort((left, right) => left.name.localeCompare(right.name, 'zh-CN'));
      } catch (error) {
        playerTargetError = '在线玩家列表暂时不可用';
      }
    }
    const [characterQuota, vehicleQuota] = await Promise.all([
      this.quota(owner, 'character', settings, entitlements),
      this.quota(owner, 'vehicle', settings, entitlements)
    ]);
    const characterQuote = priceFor(settings.characterFixedPrice, entitlements.teleportDiscount);
    const vehicleQuote = priceFor(settings.vehicleFixedPrice, entitlements.teleportDiscount);
    return {
      capabilities: {
        player: settings.playerEnabled && runtimeCapabilities.player && !playerTargetError,
        ownedVehicle: settings.ownedVehicleEnabled && runtimeCapabilities.ownedVehicle,
        territoryFlag: settings.territoryFlagEnabled && runtimeCapabilities.territoryFlag,
        fixedLocation: settings.fixedLocationEnabled && runtimeCapabilities.player,
        vehicleToTerritoryFlag: settings.vehicleToTerritoryFlagEnabled && runtimeCapabilities.vehicleToTerritoryFlag,
        vehicleToPlayer: settings.vehicleToPlayerEnabled && runtimeCapabilities.vehicleToPlayer,
        vehicleToFixedLocation: settings.vehicleToFixedLocationEnabled && runtimeCapabilities.vehicleToFixedLocation
      },
      capabilityStatus: runtimeCapabilities,
      playerDisabledReason: !settings.playerEnabled ? '玩家互传当前未开放' : (!runtimeCapabilities.player ? '玩家互传管理命令不可用' : playerTargetError),
      pricing: {
        character: { mode: settings.characterPricingMode, fixedPrice: settings.characterFixedPrice, perKilometerPrice: settings.characterPerKilometerPrice, discountPercent: characterQuote.discount, price: characterQuote.chargedAmount },
        vehicle: { mode: settings.vehiclePricingMode, fixedPrice: settings.vehicleFixedPrice, perKilometerPrice: settings.vehiclePerKilometerPrice, discountPercent: vehicleQuote.discount, price: vehicleQuote.chargedAmount }
      },
      quota: { character: characterQuota, vehicle: vehicleQuota },
      membership: { memberLevel: Number(entitlements.memberLevel || 0), dailyTeleports: Math.max(0, Number(entitlements.dailyTeleports || 0)), teleportDiscount: characterQuote.discount },
      targets: {
        players: playerTargets,
        onlinePlayers: onlinePlayerTargets,
        vehicles: rows(vehicles).map((item) => ({ id: `vehicle:${item.id}`, type: 'owned_vehicle', name: Number(item.realtime) === 1 ? item.name : `${item.name}（离线最后位置）`, plateNumber: item.plateNumber || null, lastKnown: Number(item.realtime) !== 1 })),
        realtimeVehicles: rows(vehicles).filter((item) => Number(item.realtime) === 1).map((item) => ({ id: `vehicle:${item.id}`, type: 'owned_vehicle', name: item.name, plateNumber: item.plateNumber || null })),
        territoryFlags: rows(flags).map((item) => ({ id: flagTargetId(item.flagId), type: 'territory_flag', name: item.name || '本人或小队领地旗' })),
        fixedLocations: settings.fixedLocationEnabled ? fixedLocations.map((item) => ({ id: fixedLocationTargetId(item.id), type: 'fixed_location', name: item.name })) : []
      }
    };
  }

  async ensureOnline(owner, target) {
    const players = await this.onlinePlayers();
    const ownerMatches = players.filter((player) => String(player.steamId || '') === owner);
    if (ownerMatches.length !== 1) throw new ServiceError('当前玩家必须在线且唯一解析后才能传送', 409, 'TELEPORT_PLAYER_NOT_ONLINE');
    const destinationId = target.targetType === 'player' ? target.targetId : target.targetType === 'vehicle_to_player' ? target.destinationId : null;
    if (!destinationId || destinationId === 'player:self') return {};
    if (!/^player:[0-9a-f]{32}$/i.test(destinationId)) throw new ServiceError('在线玩家目标无效，请刷新列表', 400, 'INVALID_PLAYER_TARGET');
    const targetMatches = players.filter((player) => String(player.steamId || '') !== owner && playerTargetId(String(player.steamId || '')) === destinationId);
    if (targetMatches.length > 1 || (targetMatches.length === 1 && !isSteamId64(String(targetMatches[0]?.steamId || '')))) throw new ServiceError('目标玩家在线数据无法唯一解析，请刷新列表', 409, 'TELEPORT_TARGET_NOT_ONLINE');
    if (target.targetType === 'vehicle_to_player' && targetMatches.length !== 1) throw new ServiceError('载具只能传送到当前在线且唯一解析的队友', 409, 'TELEPORT_TARGET_NOT_ONLINE');
    if (targetMatches.length === 1) {
      const squadMemberIds = await this.squadMemberIds(owner);
      if (!squadMemberIds.has(String(targetMatches[0].steamId))) throw new ServiceError('载具目标玩家仅允许当前小队成员', 409, 'TELEPORT_TARGET_NOT_SQUAD_MEMBER');
    }
    return target.targetType === 'vehicle_to_player' ? { vehicleTargetPlayer: targetMatches[0] } : { targetPlayer: targetMatches[0] || null };
  }

  async livePlayerLocation(steamId) {
    const matches = this.snapshotStore?.readPlayersForSteamIds?.([steamId]) || [];
    const location = matches.length === 1 ? matches[0] : null;
    const observedAt = Date.parse(location?.observedAt || '');
    const sampleAge = this.now() - observedAt;
    const isFreshLiveSample = location?.source === 'rcon_location' && location.online === true && Number.isFinite(observedAt) && sampleAge >= 0 && sampleAge <= this.playerLocationMaxAgeMs;
    if (isFreshLiveSample) return this.validateLivePlayerLocation(steamId, location);

    // Refresh only players participating in this teleport request, never every online player.
    let request = this.livePlayerLocationRequests.get(steamId);
    if (!request && this.livePlayerLocationRequests.size >= this.maxConcurrentLivePlayerLocationRequests) {
      throw new ServiceError('实时坐标查询繁忙，请稍后重试', 503, 'TELEPORT_LOCATION_BUSY');
    }
    if (!request) {
      request = (async () => {
        try {
          const { ggcon } = await this.clients();
          const result = await ggcon.command(`#Location ${steamId}`, { retry: false, priority: 'normal', skipHealth: true });
          const parsed = parseTeleportLocationResponse(result?.response ?? result);
          if (parsed.steamId && parsed.steamId !== steamId) throw new ServiceError('角色实时位置身份不匹配', 502, 'TELEPORT_LOCATION_IDENTITY_MISMATCH');
          const record = { steamId, name: parsed.name, worldX: parsed.worldX, worldY: parsed.worldY, worldZ: parsed.worldZ, observedAt: new Date(this.now()).toISOString(), source: 'rcon_location' };
          this.snapshotStore?.upsertPlayer?.(record);
          try { await this.snapshotStore?.persistPlayers?.([record]); } catch { /* the fresh in-memory RCON sample remains authoritative for this request */ }
          return record;
        } catch {
          throw new ServiceError('角色实时位置尚未同步或已过期，请等待地图刷新后重试', 409, 'TELEPORT_LOCATION_STALE');
        } finally {
          this.livePlayerLocationRequests.delete(steamId);
        }
      })();
      this.livePlayerLocationRequests.set(steamId, request);
    }
    return this.validateLivePlayerLocation(steamId, await request);
  }

  validateLivePlayerLocation(steamId, location) {
    const coordinates = [location.worldX, location.worldY, location.worldZ].map(Number);
    if (!coordinates.every((value) => Number.isFinite(value) && Math.abs(value) <= 10_000_000)) {
      throw new ServiceError('角色实时位置无效，请等待地图刷新后重试', 409, 'TELEPORT_LOCATION_INVALID');
    }
    return { steamId, name: String(location.name || ''), worldX: coordinates[0], worldY: coordinates[1], worldZ: coordinates[2] };
  }

  async liveVehicleLocation(vehicleEntityId) {
    const { ggcon } = await this.clients();
    const result = await ggcon.command(`QueryVehicleLocation ${vehicleEntityId}`, { retry: false, priority: 'high', skipHealth: true });
    const location = parseVehicleLocation(result, vehicleEntityId);
    if (location.locationSource !== 'rcon_live') throw new ServiceError('载具当前未实时加载，已取消传送', 409, 'TELEPORT_VEHICLE_NOT_REALTIME');
    return location;
  }

  async attachLivePlayerLocations(owner, target, online, { ownerRequired = false } = {}) {
    const requests = [];
    if (ownerRequired || (target.targetType === 'vehicle_to_player' && target.destinationId === 'player:self')) {
      requests.push(this.livePlayerLocation(owner).then((location) => { online.ownerLocation = location; }));
    }
    const targetPlayer = target.targetType === 'player' ? online.targetPlayer : online.vehicleTargetPlayer;
    if (targetPlayer?.steamId) {
      requests.push(this.livePlayerLocation(String(targetPlayer.steamId)).then((location) => {
        const key = target.targetType === 'player' ? 'targetPlayer' : 'vehicleTargetPlayer';
        online[key] = { ...targetPlayer, ...location };
      }));
    }
    await Promise.all(requests);
    return online;
  }

  async resolveTerritoryFlag(owner, target) {
    if (!/^territory_flag:[0-9a-f]{32}$/i.test(target.targetId)) throw new ServiceError('领地旗目标无效，请刷新列表', 400, 'INVALID_TARGET');
    const candidates = rows(await this.db.query("SELECT f.`实体标识` AS flagId,f.`显示名称` AS name,f.`世界X坐标` AS worldX,f.`世界Y坐标` AS worldY,f.`世界Z坐标` AS worldZ FROM `传送位置快照` f WHERE f.`实体类型`='flag' AND f.`是否当前有效`=1 AND f.`世界X坐标` IS NOT NULL AND f.`世界Y坐标` IS NOT NULL AND f.`世界Z坐标` IS NOT NULL AND (f.`归属SteamID`=? OR EXISTS (SELECT 1 FROM `商城用户` self JOIN `商城用户` flag_owner ON flag_owner.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND flag_owner.`SteamID`=f.`归属SteamID`))", [owner, owner])).filter((flag) => flagTargetId(flag.flagId) === target.targetId);
    if (candidates.length !== 1) throw new ServiceError('领地旗不存在、数据已失效或不属于本人及当前小队', 404, 'TARGET_NOT_AUTHORIZED');
    const flag = candidates[0];
    return { ...target, targetName: flag.name || '本人或小队领地旗', nativeTargetId: null, worldX: flag.worldX, worldY: flag.worldY, worldZ: flag.worldZ };
  }

  async requireUniqueVehicleTerritoryFlag(owner, destinationId, query = this.db) {
    const flags = rows(await query.query("SELECT f.`实体标识` AS flagId,f.`显示名称` AS name,f.`世界X坐标` AS worldX,f.`世界Y坐标` AS worldY,f.`世界Z坐标` AS worldZ FROM `传送位置快照` f WHERE f.`实体类型`='flag' AND f.`是否当前有效`=1 AND f.`世界X坐标` IS NOT NULL AND f.`世界Y坐标` IS NOT NULL AND f.`世界Z坐标` IS NOT NULL AND (f.`归属SteamID`=? OR EXISTS (SELECT 1 FROM `商城用户` self JOIN `商城用户` flag_owner ON flag_owner.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND flag_owner.`SteamID`=f.`归属SteamID`))", [owner, owner]));
    if (flags.length !== 1) throw new ServiceError('载具传送到领地旗要求本人或当前小队恰好有一个有效授权领地旗', 409, 'VEHICLE_TERRITORY_FLAG_NOT_UNIQUE');
    if (flagTargetId(flags[0].flagId) !== destinationId) throw new ServiceError('所选领地旗已失效，请刷新地图后重新选择', 409, 'TELEPORT_FLAG_TARGET_STALE');
    return { id: destinationId, name: flags[0].name || '本人或小队领地旗', worldX: flags[0].worldX, worldY: flags[0].worldY, worldZ: flags[0].worldZ };
  }

  async resolveTarget(owner, target, query, online = {}, resolvedTerritoryFlag = null) {
    if (target.targetType === 'player') {
      const player = online.targetPlayer;
      const onlineSteamId = String(player?.steamId || '');
      if (player && (!isSteamId64(onlineSteamId) || onlineSteamId === owner || playerTargetId(onlineSteamId) !== target.targetId)) throw new ServiceError('在线玩家目标已失效，请刷新列表', 409, 'TELEPORT_TARGET_NOT_ONLINE');
      const candidates = rows(await query.query("SELECT mate.`SteamID` AS steamId,mate.`游戏名称` AS name,mate.`位置世界X坐标` AS worldX,mate.`位置世界Y坐标` AS worldY,mate.`位置世界Z坐标` AS worldZ FROM `商城用户` mate JOIN `商城用户` self ON self.`小队编号`=mate.`小队编号` AND self.`SteamID`=? AND self.`小队编号`<>'' WHERE mate.`SteamID`<>? AND mate.`位置观测时间`>=DATE_SUB(NOW(),INTERVAL 24 HOUR) AND mate.`位置世界X坐标` IS NOT NULL AND mate.`位置世界Y坐标` IS NOT NULL AND mate.`位置世界Z坐标` IS NOT NULL", [owner, owner])).filter((item) => isSteamId64(String(item.steamId || '')) && playerTargetId(item.steamId) === target.targetId && (!player || String(item.steamId) === onlineSteamId));
      if (candidates.length !== 1) throw new ServiceError(player ? '队友实时坐标尚未同步，请稍后重试' : '队友离线位置不存在、已超过24小时或小队关系已变化', 404, 'TARGET_NOT_AUTHORIZED');
      const savedLocation = candidates[0];
      const location = player && [player.worldX, player.worldY, player.worldZ].every((value) => Number.isFinite(Number(value))) ? player : savedLocation;
      return { ...target, targetName: player ? playerTargetName(player) : `${savedLocation.name || '小队成员'}（离线最后位置）`, nativeTargetId: null, targetSteamId: String(savedLocation.steamId), worldX: location.worldX, worldY: location.worldY, worldZ: location.worldZ };
    }
    if (target.targetType === 'fixed_location') {
      if (!/^fixed_location:[0-9a-f]{32}$/i.test(target.targetId)) throw new ServiceError('固定位置目标无效，请刷新列表', 400, 'INVALID_TARGET');
      const candidates = (await this.fixedLocations({ enabledOnly: true, ownerSteamId: owner, query })).filter((item) => fixedLocationTargetId(item.id) === target.targetId);
      if (candidates.length !== 1) throw new ServiceError('固定位置不存在或已停用', 404, 'TARGET_NOT_AUTHORIZED');
      const location = candidates[0];
      return { ...target, targetName: location.name, nativeTargetId: null, worldX: location.worldX, worldY: location.worldY, worldZ: location.worldZ };
    }
    if (target.targetType === 'territory_flag') {
      if (!resolvedTerritoryFlag || resolvedTerritoryFlag.targetId !== target.targetId) throw new ServiceError('领地旗实时目标无效，请刷新列表', 409, 'TELEPORT_FLAG_TARGET_STALE');
      return resolvedTerritoryFlag;
    }
    const match = /^vehicle:(\d+)$/.exec(target.targetId);
    if (!match) throw new ServiceError('载具目标无效', 400, 'INVALID_TARGET');
    const vehicleId = Number(match[1]);
    if (!Number.isSafeInteger(vehicleId) || vehicleId < 1) throw new ServiceError('载具目标无效', 400, 'INVALID_TARGET');
    const vehicle = rows(await query.query("SELECT v.`载具档案编号` AS id,v.`来源载具编号` AS nativeTargetId,COALESCE(NULLIF(v.`显示名称`,''),NULLIF(v.`型号名称`,''),NULLIF(v.`载具类型`,''),'已上锁载具') AS targetName,v.`世界X坐标` AS worldX,v.`世界Y坐标` AS worldY,v.`世界Z坐标` AS worldZ,(v.`来源同步时间`>=DATE_SUB(NOW(),INTERVAL 5 MINUTE)) AS realtime FROM `载具档案` v WHERE v.`载具档案编号`=? AND (v.`车主SteamID`=? OR EXISTS (SELECT 1 FROM `商城用户` self JOIN `商城用户` vehicle_owner ON vehicle_owner.`小队编号`=self.`小队编号` WHERE self.`SteamID`=? AND self.`小队编号`<>'' AND vehicle_owner.`SteamID`=v.`车主SteamID`)) AND v.`来源类型`='scum_locked_vehicle' AND v.`来源同步状态`='present' AND v.`来源同步时间`>=DATE_SUB(NOW(),INTERVAL 24 HOUR) AND v.`世界X坐标` IS NOT NULL AND v.`世界Y坐标` IS NOT NULL AND v.`世界Z坐标` IS NOT NULL AND v.`来源锁槽数量`>0 AND v.`来源载具编号` IS NOT NULL AND v.`档案状态`='active' LIMIT 1 FOR UPDATE", [vehicleId, owner, owner]))[0];
    if (!vehicle) throw new ServiceError('该载具不存在、已失效、超过24小时或不属于本人及当前小队', 404, 'TARGET_NOT_AUTHORIZED');
    const nativeTargetId = Number(vehicle.nativeTargetId);
    if (!Number.isSafeInteger(nativeTargetId) || nativeTargetId < 1) throw new ServiceError('载具运行时标识无效，请等待数据重新同步', 409, 'TARGET_METADATA_INVALID');
    const destinationPlayer = target.targetType === 'vehicle_to_player' ? online.vehicleTargetPlayer : null;
    if (target.targetType === 'vehicle_to_player' && target.destinationId !== 'player:self' && !destinationPlayer) throw new ServiceError('载具目标队友已离线或小队关系已变化', 409, 'TELEPORT_TARGET_NOT_ONLINE');
    const territoryFlag = target.targetType === 'vehicle_to_territory_flag' ? await this.requireUniqueVehicleTerritoryFlag(owner, target.destinationId, query) : null;
    const fixedLocationCandidates = target.targetType === 'vehicle_to_fixed_location'
      ? (await this.fixedLocations({ enabledOnly: true, ownerSteamId: owner, query })).filter((item) => fixedLocationTargetId(item.id) === target.destinationId)
      : [];
    if (target.targetType === 'vehicle_to_fixed_location' && fixedLocationCandidates.length !== 1) throw new ServiceError('固定位置不存在、不可见或已停用', 404, 'TARGET_NOT_AUTHORIZED');
    const fixedLocation = fixedLocationCandidates[0] || null;
    const targetSteamId = target.targetType === 'vehicle_to_player' ? String(destinationPlayer?.steamId || owner) : null;
    if (target.targetType === 'owned_vehicle') return { ...target, targetName: `本人位置 → ${vehicle.targetName}`, nativeTargetId, targetSteamId: null, worldX: vehicle.worldX, worldY: vehicle.worldY, worldZ: vehicle.worldZ };
    const destinationName = fixedLocation?.name || territoryFlag?.name || (destinationPlayer ? playerTargetName(destinationPlayer) : '本人位置');
    const playerLocation = destinationPlayer || online.ownerLocation;
    return { ...target, targetName: `${vehicle.targetName} → ${destinationName}`, nativeTargetId, targetSteamId, worldX: vehicle.worldX, worldY: vehicle.worldY, worldZ: vehicle.worldZ, destinationWorldX: fixedLocation?.worldX ?? territoryFlag?.worldX ?? playerLocation?.worldX, destinationWorldY: fixedLocation?.worldY ?? territoryFlag?.worldY ?? playerLocation?.worldY, destinationWorldZ: fixedLocation?.worldZ ?? territoryFlag?.worldZ ?? playerLocation?.worldZ };
  }

  async quote(steamId, input) {
    const owner = String(steamId || '');
    if (!isSteamId64(owner)) throw new ServiceError('SteamID 格式无效', 400, 'INVALID_STEAM_ID');
    const target = targetInput(input);
    const [settings, capabilities, entitlements] = await Promise.all([this.settings(), this.runtimeCapabilities(), this.membershipEntitlements(owner)]);
    const modes = {
      player: ['playerEnabled', 'player', '小队成员互传'],
      owned_vehicle: ['ownedVehicleEnabled', 'ownedVehicle', '玩家传送到小队载具'],
      territory_flag: ['territoryFlagEnabled', 'territoryFlag', '玩家传送到领地旗'],
      fixed_location: ['fixedLocationEnabled', 'player', '玩家传送到固定位置'],
      vehicle_to_territory_flag: ['vehicleToTerritoryFlagEnabled', 'vehicleToTerritoryFlag', '载具传送到授权领地旗'],
      vehicle_to_player: ['vehicleToPlayerEnabled', 'vehicleToPlayer', '载具传送到玩家位置'],
      vehicle_to_fixed_location: ['vehicleToFixedLocationEnabled', 'vehicleToFixedLocation', '载具传送到固定位置']
    };
    const mode = modes[target.targetType];
    if (!settings[mode[0]]) throw new ServiceError(`${mode[2]}当前未开放`, 409, target.targetType === 'player' ? 'PLAYER_TELEPORT_DISABLED' : 'TELEPORT_MODE_DISABLED');
    if (!capabilities[mode[1]]) throw new ServiceError(`${mode[2]}执行能力当前不可用`, 503, 'TELEPORT_CAPABILITY_UNAVAILABLE');
    const category = teleportCategory(target.targetType);
    const pricingModeValue = category === 'vehicle' ? settings.vehiclePricingMode : settings.characterPricingMode;
    const online = await this.ensureOnline(owner, target);
    await this.attachLivePlayerLocations(owner, target, online, { ownerRequired: category === 'character' });
    const resolvedTerritoryFlag = target.targetType === 'territory_flag' ? await this.resolveTerritoryFlag(owner, target) : null;
    if (target.targetType === 'vehicle_to_territory_flag') await this.requireUniqueVehicleTerritoryFlag(owner, target.destinationId);
    let resolved = await this.resolveTarget(owner, target, this.db, online, resolvedTerritoryFlag);
    if (category === 'vehicle') {
      const liveVehicle = await this.liveVehicleLocation(resolved.nativeTargetId);
      resolved = { ...resolved, worldX: liveVehicle.worldX, worldY: liveVehicle.worldY, worldZ: liveVehicle.worldZ };
    }
    const fixedPrice = category === 'vehicle' ? settings.vehicleFixedPrice : settings.characterFixedPrice;
    const perKilometerPrice = category === 'vehicle' ? settings.vehiclePerKilometerPrice : settings.characterPerKilometerPrice;
    const source = category === 'character' ? online.ownerLocation : resolved;
    const destination = { worldX: resolved.destinationWorldX ?? resolved.worldX, worldY: resolved.destinationWorldY ?? resolved.worldY };
    const kilometers = distanceKilometers(source, destination);
    const basePrice = pricingModeValue === 'distance' ? kilometers * perKilometerPrice : fixedPrice;
    const calculated = priceFor(basePrice, entitlements.teleportDiscount);
    const account = rows(await this.db.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? LIMIT 1', [owner]))[0] || { balance: 0 };
    const balance = Number(account.balance || 0);
    const quota = await this.quota(owner, category, settings, entitlements);
    if (quota.total < 1 || quota.remaining < 1) throw new ServiceError(`今日${category === 'vehicle' ? '载具' : '角色'}传送次数已用完或尚未配置可用次数`, 409, 'TELEPORT_DAILY_LIMIT');
    if (quota.intervalRemainingSeconds > 0) throw new ServiceError(`${category === 'vehicle' ? '载具' : '角色'}传送间隔中，请在 ${quota.intervalRemainingSeconds} 秒后重试`, 409, 'TELEPORT_INTERVAL');
    if (balance < calculated.chargedAmount) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
    const token = randomUUID();
    const expiresAt = this.now() + 60_000;
    for (const [storedToken, storedQuote] of this.quotes) if (storedQuote.expiresAt <= this.now()) this.quotes.delete(storedToken);
    this.quotes.set(token, { owner, fingerprint: fingerprint(owner, target), expiresAt, pricingMode: pricingModeValue, kilometers, basePrice, discountPercent: calculated.discount, chargedAmount: calculated.chargedAmount });
    return { quoteToken: token, expiresAt: new Date(expiresAt).toISOString(), targetName: resolved.targetName, category, pricingMode: pricingModeValue, kilometers, perKilometerPrice, basePrice, discountPercent: calculated.discount, chargedAmount: calculated.chargedAmount, balance, balanceAfter: balance - calculated.chargedAmount };
  }

  async execute(steamId, input, keyValue, quoteToken = null) {
    const owner = String(steamId || '');
    if (!isSteamId64(owner)) throw new ServiceError('SteamID 格式无效', 400, 'INVALID_STEAM_ID');
    const key = requestKey(keyValue);
    const target = targetInput(input);
    const existing = await this.findOperation(key);
    if (existing) return this.replay(existing, owner, target);
    const expectedQuote = quoteToken ? this.consumeQuote(owner, target, quoteToken) : null;
    const [settings, capabilities] = await Promise.all([this.settings(), this.runtimeCapabilities()]);
    const modes = {
      player: ['playerEnabled', 'player', '小队成员互传'],
      owned_vehicle: ['ownedVehicleEnabled', 'ownedVehicle', '玩家传送到小队载具'],
      territory_flag: ['territoryFlagEnabled', 'territoryFlag', '玩家传送到领地旗'],
      fixed_location: ['fixedLocationEnabled', 'player', '玩家传送到固定位置'],
      vehicle_to_territory_flag: ['vehicleToTerritoryFlagEnabled', 'vehicleToTerritoryFlag', '载具传送到授权领地旗'],
      vehicle_to_player: ['vehicleToPlayerEnabled', 'vehicleToPlayer', '载具传送到玩家位置'],
      vehicle_to_fixed_location: ['vehicleToFixedLocationEnabled', 'vehicleToFixedLocation', '载具传送到固定位置']
    };
    const mode = modes[target.targetType];
    if (!settings[mode[0]]) throw new ServiceError(`${mode[2]}当前未开放`, 409, target.targetType === 'player' ? 'PLAYER_TELEPORT_DISABLED' : 'TELEPORT_MODE_DISABLED');
    if (!capabilities[mode[1]]) throw new ServiceError(`${mode[2]}执行能力当前不可用`, 503, 'TELEPORT_CAPABILITY_UNAVAILABLE');
    const category = teleportCategory(target.targetType);
    const online = await this.ensureOnline(owner, target);
    await this.attachLivePlayerLocations(owner, target, online, { ownerRequired: category === 'character' });
    const resolvedTerritoryFlag = target.targetType === 'territory_flag' ? await this.resolveTerritoryFlag(owner, target) : null;
    if (target.targetType === 'vehicle_to_territory_flag') await this.requireUniqueVehicleTerritoryFlag(owner, target.destinationId);
    const entitlements = await this.membershipEntitlements(owner);
    let prepared;
    try {
      prepared = await this.db.transaction(async (tx) => {
        const repeated = await this.findOperation(key, tx, true);
        if (repeated) return this.replay(repeated, owner, target);
        await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)', [owner]);
        const account = rows(await tx.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [owner]))[0] || { balance: 0 };
        const serializedRepeated = await this.findOperation(key, tx, true);
        if (serializedRepeated) return this.replay(serializedRepeated, owner, target);
        const quota = await this.quota(owner, category, settings, entitlements, tx);
        if (quota.total < 1 || quota.remaining < 1) throw new ServiceError(`今日${category === 'vehicle' ? '载具' : '角色'}传送次数已用完或尚未配置可用次数`, 409, 'TELEPORT_DAILY_LIMIT');
        if (quota.intervalRemainingSeconds > 0) throw new ServiceError(`${category === 'vehicle' ? '载具' : '角色'}传送间隔中，请在 ${quota.intervalRemainingSeconds} 秒后重试`, 409, 'TELEPORT_INTERVAL');
        let resolved = await this.resolveTarget(owner, target, tx, online, resolvedTerritoryFlag);
        const liveVehicleSource = category === 'vehicle' ? await this.liveVehicleLocation(resolved.nativeTargetId) : null;
        if (liveVehicleSource) resolved = { ...resolved, worldX: liveVehicleSource.worldX, worldY: liveVehicleSource.worldY, worldZ: liveVehicleSource.worldZ };
        const pricingModeValue = category === 'vehicle' ? settings.vehiclePricingMode : settings.characterPricingMode;
        const fixedPrice = category === 'vehicle' ? settings.vehicleFixedPrice : settings.characterFixedPrice;
        const perKilometerPrice = category === 'vehicle' ? settings.vehiclePerKilometerPrice : settings.characterPerKilometerPrice;
        const source = category === 'character' ? online.ownerLocation : (liveVehicleSource || resolved);
        const destination = { worldX: resolved.destinationWorldX ?? resolved.worldX, worldY: resolved.destinationWorldY ?? resolved.worldY };
        const kilometers = distanceKilometers(source, destination);
        const basePrice = pricingModeValue === 'distance' ? kilometers * perKilometerPrice : fixedPrice;
        const quote = priceFor(basePrice, entitlements.teleportDiscount);
        if (expectedQuote && (expectedQuote.pricingMode !== pricingModeValue || expectedQuote.kilometers !== kilometers || expectedQuote.basePrice !== basePrice || expectedQuote.discountPercent !== quote.discount || expectedQuote.chargedAmount !== quote.chargedAmount)) throw new ServiceError('传送距离或费用已变化，请重新计算后确认', 409, 'TELEPORT_QUOTE_CHANGED');
        const balance = Number(account.balance || 0);
        if (balance < quote.chargedAmount) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
        const balanceAfter = balance - quote.chargedAmount;
        await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [balanceAfter, owner]);
        const targetSteamId = resolved.targetSteamId || (target.targetType.startsWith('vehicle_to_') ? owner : null);
        const inserted = await tx.query("INSERT INTO `传送执行记录` (`发起玩家SteamID`,`请求幂等键`,`请求指纹`,`目标类型`,`目标引用`,`目标名称快照`,`游戏目标编号`,`目标玩家SteamID`,`计费方式`,`传送距离公里`,`基础价格`,`折扣百分比`,`实扣商城币`,`扣款后余额`,`执行状态`) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?, 'prepared')", [owner, key, fingerprint(owner, target), target.targetType, target.targetId, resolved.targetName, resolved.nativeTargetId, targetSteamId, pricingModeValue, kilometers, basePrice, quote.discount, quote.chargedAmount, balanceAfter]);
        if (quote.chargedAmount > 0) await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'teleport_charge','teleport_charge',?,'商城传送余额预留')", [owner, -quote.chargedAmount, balanceAfter, String(inserted.insertId)]);
        return { id: Number(inserted.insertId), steamId: owner, requestKey: key, requestFingerprint: fingerprint(owner, target), ...resolved, pricingMode: pricingModeValue, kilometers, basePrice, discountPercent: quote.discount, chargedAmount: quote.chargedAmount, balanceAfter, status: 'prepared', idempotent: false };
