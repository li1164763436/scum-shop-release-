    if (!name || name.length > 100) throw new ServiceError('位置名称必填且不能超过100字', 400, 'INVALID_FIXED_LOCATION');
    const [worldX, worldY, worldZ] = fixedLocationCoordinates(input.coordinates);
    const visibility = String(input.visibility || '').trim();
    if (!['public', 'private'].includes(visibility)) throw new ServiceError('可见范围必须为全部玩家或私人玩家', 400, 'INVALID_FIXED_LOCATION');
    const ownerSteamId = String(input.ownerSteamId || '').trim();
    if (visibility === 'private' && !isSteamId64(ownerSteamId)) throw new ServiceError('私人位置必须填写有效的17位 SteamID', 400, 'INVALID_FIXED_LOCATION');
    if (visibility === 'public' && ownerSteamId) throw new ServiceError('全部玩家位置不能绑定私人玩家', 400, 'INVALID_FIXED_LOCATION');
    return { name, worldX, worldY, worldZ, enabled: booleanSetting(input.enabled, '启用状态'), sortOrder: boundedInteger(input.sortOrder, '排序值', 0, 1000000), visibility, ownerSteamId: visibility === 'private' ? ownerSteamId : null };
  }

  async createFixedLocation(input, userId = null) {
    const value = this.fixedLocationInput(input);
    const result = await this.db.query("INSERT INTO `传送固定位置` (`位置名称`,`世界X坐标`,`世界Y坐标`,`世界Z坐标`,`是否启用`,`排序值`,`来源类型`,`可见范围`,`归属SteamID`,`创建管理员编号`,`最后修改管理员编号`) VALUES (?,?,?,?,?,?,'admin',?,?,?,?)", [value.name, value.worldX, value.worldY, value.worldZ, value.enabled ? 1 : 0, value.sortOrder, value.visibility, value.ownerSteamId, userId || null, userId || null]);
