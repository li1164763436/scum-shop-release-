    } catch (error) {
      const message = String(error?.message || '传送命令执行失败').slice(0, 500);
      if (delivered) {
        await this.db.query("UPDATE `传送执行记录` SET `执行状态`='manual_review',`错误代码`='COMPLETION_PERSIST_FAILED',`错误信息`=? WHERE `记录编号`=? AND `执行状态`='prepared'", [message, prepared.id]);
        return publicOperation({ ...prepared, status: 'manual_review', errorCode: 'COMPLETION_PERSIST_FAILED', errorMessage: '传送已成功，但完成状态未能落库，已转人工核查' });
      }
      if (vehicleTeleportSent && (error?.uncertainDelivery || error?.code !== 'RCON_COMMAND_FAILED')) {
        await this.db.query("UPDATE `传送执行记录` SET `执行状态`='command_result_unknown',`错误代码`='COMMAND_RESULT_UNKNOWN',`错误信息`=? WHERE `记录编号`=? AND `执行状态`='prepared'", [message, prepared.id]);
        return publicOperation({ ...prepared, status: 'command_result_unknown', errorCode: 'COMMAND_RESULT_UNKNOWN', errorMessage: '载具命令结果无法确认，未重试且未自动退款，已转人工核查' });
      }
      if (error?.uncertainDelivery && !error?.vehiclePreflightFailed) {
        const uncertain = await this.db.transaction(async (tx) => {
          const current = await this.findOperation(key, tx, true);
          if (!current || current.status !== 'prepared') return current || prepared;
          let balanceAfter = current.balanceAfter;
          if (current.chargedAmount > 0) {
            await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)', [owner]);
            const account = rows(await tx.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [owner]))[0] || { balance: 0 };
            balanceAfter = Number(account.balance || 0) + current.chargedAmount;
            await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [balanceAfter, owner]);
            await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'teleport_refund','teleport_refund',?,'商城传送结果不确定退款')", [owner, current.chargedAmount, balanceAfter, String(current.id)]);
          }
          await tx.query("UPDATE `传送执行记录` SET `执行状态`='manual_review',`扣款后余额`=?,`错误代码`='UNCERTAIN_DELIVERY',`错误信息`=? WHERE `记录编号`=? AND `执行状态`='prepared'", [balanceAfter, message, current.id]);
          return { ...current, balanceAfter, status: 'manual_review', errorCode: 'UNCERTAIN_DELIVERY', errorMessage: '命令结果不确定，已退款、停止重试并转人工核查' };
        });
        return publicOperation(uncertain);
      }
      const failed = await this.db.transaction(async (tx) => {
        const current = await this.findOperation(key, tx, true);
        if (!current || current.status !== 'prepared') return current || prepared;
        let balanceAfter = current.balanceAfter;
        if (current.chargedAmount > 0) {
          await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)', [owner]);
          const account = rows(await tx.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [owner]))[0] || { balance: 0 };
          balanceAfter = Number(account.balance || 0) + current.chargedAmount;
          await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [balanceAfter, owner]);
          await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'teleport_refund','teleport_refund',?,'商城传送明确失败退款')", [owner, current.chargedAmount, balanceAfter, String(current.id)]);
        }
        const finalStatus = vehicleCommandAttempted ? 'refunded' : 'failed';
        await tx.query("UPDATE `传送执行记录` SET `执行状态`=?,`扣款后余额`=?,`错误代码`='COMMAND_FAILED',`错误信息`=?,`完成时间`=CURRENT_TIMESTAMP(3),`退款时间`=CASE WHEN ?='refunded' THEN CURRENT_TIMESTAMP(3) ELSE `退款时间` END,`退款原因`=CASE WHEN ?='refunded' THEN '载具传送命令明确失败' ELSE `退款原因` END WHERE `记录编号`=? AND `执行状态`='prepared'", [finalStatus, balanceAfter, message, finalStatus, finalStatus, current.id]);
        return { ...current, balanceAfter, status: finalStatus, errorCode: 'COMMAND_FAILED', errorMessage: message };
      });
      return publicOperation(failed);
    }
  }
}
