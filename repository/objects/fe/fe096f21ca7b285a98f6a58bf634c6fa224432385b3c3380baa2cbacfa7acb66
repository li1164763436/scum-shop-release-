    } catch (error) {
      if (error?.code !== 'ER_DUP_ENTRY' && error?.errno !== 1062) throw error;
      const repeated = await this.findOperation(key);
      if (!repeated) throw error;
      return this.replay(repeated, owner, target);
    }
    if (prepared.idempotent) return prepared;
    let delivered = false;
    let vehicleCommandAttempted = prepared.targetType.startsWith('vehicle_to_');
    let vehicleTeleportSent = false;
    try {
      if (prepared.targetType === 'fixed_location') {
        const currentFixedLocation = await this.resolveTarget(owner, target, this.db, online, null);
        prepared = { ...prepared, worldX: currentFixedLocation.worldX, worldY: currentFixedLocation.worldY, worldZ: currentFixedLocation.worldZ, targetName: currentFixedLocation.targetName };
      }
      if (prepared.targetType === 'player') {
        const currentSquadMemberIds = await this.squadMemberIds(owner);
        if (!currentSquadMemberIds.has(String(prepared.targetSteamId || ''))) throw new ServiceError('小队关系已发生变化，已取消传送', 409, 'TELEPORT_TARGET_NOT_SQUAD_MEMBER');
      }
      if (prepared.targetType === 'owned_vehicle') {
        const currentVehicle = await this.resolveTarget(owner, target, this.db, online, null);
        if (String(currentVehicle.nativeTargetId || '') !== String(prepared.nativeTargetId || '')) throw new ServiceError('目标载具授权或实体标识已变化，已取消传送', 409, 'TELEPORT_VEHICLE_OWNERSHIP_CHANGED');
        prepared = { ...prepared, worldX: currentVehicle.worldX, worldY: currentVehicle.worldY, worldZ: currentVehicle.worldZ, targetName: currentVehicle.targetName };
      }
      if (prepared.targetType.startsWith('vehicle_to_')) {
        if (prepared.targetType === 'vehicle_to_territory_flag') await this.requireUniqueVehicleTerritoryFlag(owner, target.destinationId);
        const currentOnline = await this.ensureOnline(owner, target);
        if (prepared.targetType === 'vehicle_to_player' && String(currentOnline.vehicleTargetPlayer?.steamId || owner) !== String(prepared.targetSteamId || '')) throw new ServiceError('目标玩家已离线或小队关系已变化，已取消传送', 409, 'TELEPORT_TARGET_NOT_ONLINE');
        const currentSource = await this.resolveTarget(owner, target, this.db, currentOnline, null);
        if (String(currentSource.nativeTargetId || '') !== String(prepared.nativeTargetId || '')) throw new ServiceError('源载具授权或实体标识已变化，已取消传送', 409, 'TELEPORT_VEHICLE_OWNERSHIP_CHANGED');
        if (prepared.targetType === 'vehicle_to_fixed_location') prepared = { ...prepared, destinationWorldX: currentSource.destinationWorldX, destinationWorldY: currentSource.destinationWorldY, destinationWorldZ: currentSource.destinationWorldZ, targetName: currentSource.targetName };
      }
      const { ggcon } = await this.clients();
      if (teleportCategory(prepared.targetType) === 'vehicle') {
        try {
          await this.liveVehicleLocation(prepared.nativeTargetId);
        } catch (error) {
          error.vehiclePreflightFailed = true;
          throw error;
        }
      }
      const commandSpec = commandFor(owner, prepared, capabilities);
      vehicleCommandAttempted = Boolean(commandSpec.vehicleExpected);
      vehicleTeleportSent = Boolean(commandSpec.vehicleExpected);
      let vehicleReceipt = null;
      if (commandSpec.destinations) {
        let lastRejected;
        for (const destination of commandSpec.destinations) {
          try {
            const command = commandSpec.commandForDestination ? commandSpec.commandForDestination(destination) : coordinateCommand(owner, destination);
            const result = await ggcon.command(command, { retry: false, priority: 'high' });
            if (commandSpec.vehicleExpected) {
              try {
                vehicleReceipt = parseVehicleTeleportResult(result?.response ?? result, commandSpec.vehicleExpected);
              } catch (error) {
                if (error?.code !== 'RCON_COMMAND_FAILED') error.uncertainDelivery = true;
                throw error;
              }
            } else {
              parseTeleportCoordinateResult(result?.response ?? result, destination);
            }
            lastRejected = null;
            break;
          } catch (error) {
            if (isRejectedSafeDestination(error)) {
              lastRejected = error;
              continue;
            }
            if (error?.code !== 'RCON_COMMAND_FAILED') error.uncertainDelivery = true;
            throw error;
          }
        }
        if (lastRejected) throw lastRejected;
      } else {
        const result = await ggcon.command(commandSpec.command, { retry: false, priority: 'high' });
        if (commandSpec.vehicleExpected) {
          try {
            vehicleReceipt = parseVehicleTeleportResult(result?.response ?? result, commandSpec.vehicleExpected);
          } catch (error) {
            if (error?.code !== 'RCON_COMMAND_FAILED') error.uncertainDelivery = true;
            throw error;
          }
        }
      }
      delivered = true;
      if (vehicleReceipt) {
        const completion = await this.db.query("UPDATE `传送执行记录` SET `执行状态`='completed',`载具回执`=?,`载具目标X`=?,`载具目标Y`=?,`载具目标Z`=?,`载具命令完成时间`=CURRENT_TIMESTAMP(3),`载具复核次数`=0,`载具下次复核时间`=DATE_ADD(CURRENT_TIMESTAMP(3),INTERVAL 60 SECOND),`载具复核响应`=NULL,`载具复核租约时间`=NULL,`完成时间`=CURRENT_TIMESTAMP(3),`错误代码`=NULL,`错误信息`=NULL WHERE `记录编号`=? AND `执行状态`='prepared'", [vehicleReceipt.raw, vehicleReceipt.x, vehicleReceipt.y, vehicleReceipt.z, prepared.id]);
        if (Number(completion?.affectedRows) !== 1) throw new Error('载具传送已成功，但完成状态未能唯一落库');
        return publicOperation({ ...prepared, status: 'completed', completedAt: new Date().toISOString() });
      }
