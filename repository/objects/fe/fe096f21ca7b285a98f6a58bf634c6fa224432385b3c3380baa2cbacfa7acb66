  async findOperation(key, query = this.db, lock = false) {
    const suffix = lock ? ' FOR UPDATE' : '';
    const sql = "SELECT `记录编号` AS id,`发起玩家SteamID` AS steamId,`请求幂等键` AS requestKey,`请求指纹` AS requestFingerprint,`目标类型` AS targetType,`目标引用` AS targetId,`目标名称快照` AS targetName,`游戏目标编号` AS nativeTargetId,`目标玩家SteamID` AS targetSteamId,`计费方式` AS pricingMode,`传送距离公里` AS kilometers,`基础价格` AS basePrice,`折扣百分比` AS discountPercent,`实扣商城币` AS chargedAmount,`扣款后余额` AS balanceAfter,`执行状态` AS status,`错误代码` AS errorCode,`错误信息` AS errorMessage,`创建时间` AS createdAt,`完成时间` AS completedAt FROM `传送执行记录` WHERE `请求幂等键`=? LIMIT 1" + suffix;
