  async fixedLocations({ enabledOnly = false, ownerSteamId = null, query = this.db } = {}) {
    const conditions = [];
    const params = [];
    if (enabledOnly) conditions.push("`是否启用`=1 AND `来源类型`='admin'");
    if (ownerSteamId !== null) {
      conditions.push("(`可见范围`='public' OR (`可见范围`='private' AND `归属SteamID`=?))");
      params.push(String(ownerSteamId));
    }
    const where = conditions.length ? ` WHERE ${conditions.join(' AND ')}` : '';
    return rows(await query.query(`SELECT \`位置编号\` AS id,\`位置名称\` AS name,\`世界X坐标\` AS worldX,\`世界Y坐标\` AS worldY,\`世界Z坐标\` AS worldZ,\`是否启用\` AS enabled,\`排序值\` AS sortOrder,\`来源类型\` AS sourceType,\`可见范围\` AS visibility,\`归属SteamID\` AS ownerSteamId,\`更新时间\` AS updatedAt FROM \`传送固定位置\`${where} ORDER BY \`排序值\`,\`位置编号\``, params)).map((item) => ({ ...item, id: Number(item.id), worldX: Number(item.worldX), worldY: Number(item.worldY), worldZ: Number(item.worldZ), enabled: Boolean(item.enabled), sortOrder: Number(item.sortOrder), ownerSteamId: item.ownerSteamId ? String(item.ownerSteamId) : null }));
