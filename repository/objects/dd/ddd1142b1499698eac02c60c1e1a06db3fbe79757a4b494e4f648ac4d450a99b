.product-table table { min-width: 1180px; table-layout: fixed; }


.product-table { background: #f3f5f7; }


.product-table thead th { background: #e4e9ef; border-bottom: 2px solid #c5ced8; }


.product-table tbody tr { background: #fff; }


.product-table tbody tr:nth-child(even) { background: #f8fafc; }


.product-table tbody tr:hover:not(:has(.empty)) { background: #eef4f8; }


.product-table tbody td { border-bottom: 1px solid #cfd6de; }


.product-table tbody tr:last-child td { border-bottom: 0; }


.product-table th:nth-child(1) { width: 72px; }


.product-table th:nth-child(2) { width: 190px; }


.product-table th:nth-child(3) { width: 82px; }


