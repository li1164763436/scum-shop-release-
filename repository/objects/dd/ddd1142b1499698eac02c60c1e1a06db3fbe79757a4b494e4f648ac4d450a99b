.product-anchor { min-width: 230px; display: flex; align-items: center; gap: 10px; }


.product-anchor > div { min-width: 0; display: grid; gap: 1px; }


.product-anchor strong { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }


.product-thumb { width: 46px; height: 46px; flex: 0 0 auto; display: block; object-fit: cover; border: 1px solid var(--line); background: #eceae1; }


.product-thumb.placeholder { display: grid; place-items: center; color: #93978e; font-size: 9px; }


.product-code-rows { display: grid; gap: 7px; }


.product-code-row { display: grid; grid-template-columns: minmax(0,1fr) 42px; align-items: center; gap: 8px; }


.product-tools { box-shadow: none; }


.product-thumb, .product-thumb.placeholder { border-radius: 7px; background: #f0f3f7; }

