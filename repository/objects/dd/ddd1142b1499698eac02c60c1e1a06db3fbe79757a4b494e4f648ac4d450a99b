.product-table td { vertical-align: middle; }


.product-id { color: var(--muted); font-variant-numeric: tabular-nums; }


.product-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }


.product-actions { gap: 7px; }


.product-action { min-width: 52px; min-height: 32px; padding: 5px 12px; border: 1px solid #a9c0b5; border-radius: 6px; background: #f1f7f3; color: var(--green); font-size: 12px; }


