  async listActivityVisible(activityId, steamId, memberLevel) { return this.listVisible(steamId, memberLevel, activityId); }
  async findClaim(key, db = this.db) {
    const rows = await db.query('SELECT c.id AS claimId,c.gift_id AS giftId,c.steam_id AS steamId,c.order_id AS id,o.order_no AS orderNo,o.status,o.total_amount AS totalAmount,agc.activity_id AS activityId FROM gift_claims c LEFT JOIN orders o ON o.id=c.order_id LEFT JOIN activity_gift_claims agc ON agc.gift_claim_id=c.id WHERE c.request_key=?', [key]);
    return rows[0];
  }
  idempotentClaim(existing, steamId, giftId, activityId = null) {
    const existingActivityId = existing.activityId === null || existing.activityId === undefined ? null : Number(existing.activityId);
    if (String(existing.steamId) !== String(steamId) || Number(existing.giftId) !== Number(giftId) || existingActivityId !== activityId) throw new ServiceError('Idempotency-Key 已被其他领取请求使用', 409, 'IDEMPOTENCY_CONFLICT');
    const { activityId: hiddenActivityId, ...result } = existing;
    return { ...result, idempotent: true };
  }
  async claim(idValue, steamId, memberLevel, requestKey, options = {}) {
    const giftId = id(idValue);
    const activityId = options.activityId === undefined || options.activityId === null ? null : id(options.activityId, '活动 ID');
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const key = String(requestKey || '').trim();
    if (!key || key.length > 100) throw new ServiceError('Idempotency-Key 长度必须为 1-100');
    const prior = await this.findClaim(key);
    if (prior) return this.idempotentClaim(prior, steamId, giftId, activityId);
    try {
      return await this.db.transaction(async (tx) => {
        const repeated = await this.findClaim(key, tx);
        if (repeated) return this.idempotentClaim(repeated, steamId, giftId, activityId);
        let activity = null;
        if (activityId !== null) {
          const activities = await tx.query('SELECT id,name,description,starts_at AS startsAt,ends_at AS endsAt,enabled FROM activities WHERE id=? FOR UPDATE', [activityId]);
          activity = activities[0];
        }
        const rows = await tx.query('SELECT id,name,gift_type AS type,description,expires_at AS expiresAt,enabled,target_steam_id AS targetSteamId,required_title AS requiredTitle,member_level AS memberLevel,member_mode AS memberMode,total_limit AS totalLimit,daily_limit AS dailyLimit,period_limit AS periodLimit,price FROM gift_packages WHERE id=? FOR UPDATE', [giftId]);
        if (!rows[0]) throw new ServiceError('礼包不存在', 404, 'NOT_FOUND');
        const gift = mapGift(rows[0]);
        if (activityId !== null) {
          const relation = await tx.query('SELECT activity_id AS activityId FROM activity_gifts WHERE activity_id=? AND gift_id=?', [activityId, giftId]);
          const now = this.clock();
          if (!activity || !relation[0] || !activity.enabled || new Date(activity.startsAt) > now || new Date(activity.endsAt) <= now) throw new ServiceError('活动无效或未关联该礼包', 409, 'ACTIVITY_GIFT_INVALID');
        } else {
          const active = await tx.query('SELECT ag.activity_id AS activityId FROM activity_gifts ag JOIN activities a ON a.id=ag.activity_id WHERE ag.gift_id=? AND a.enabled=1 AND a.starts_at<=? AND a.ends_at>? ORDER BY ag.activity_id LIMIT 1', [giftId, this.clock(), this.clock()]);
          if (active[0]) throw new ServiceError('该礼包必须通过活动入口领取', 409, 'ACTIVITY_ENTRY_REQUIRED');
        }
        await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)', [String(steamId)]);
        const users = await tx.query("SELECT \`商城用户编号\` AS id,CASE WHEN \`会员等级\`>0 AND (\`会员到期时间\` IS NULL OR \`会员到期时间\`>CURRENT_TIMESTAMP(3)) THEN \`会员等级\` ELSE 0 END AS memberLevel FROM \`商城用户\` WHERE \`SteamID\`=? AND \`用户角色\` IN ('user','admin','super_admin') AND \`账户状态\`='active' FOR UPDATE", [String(steamId)]);
        if (!users[0]) throw new ServiceError('商城用户不存在或已停用', 403, 'SHOP_USER_UNAVAILABLE');
        const memberStrategy = (await tx.query('SELECT gift_discount AS giftDiscount FROM membership_strategies WHERE level=? AND enabled=1', [Number(users[0].memberLevel || 0)]))[0];
        const discountedPrice = Math.round(gift.price * Number(memberStrategy?.giftDiscount ?? 100) / 100);
        const ctx = await this.context(tx, steamId, users[0].memberLevel, giftId);
        ctx.steamId = String(steamId);
        let periodCount = 0, periodKey = null;
        if (PERIOD_TYPES.has(gift.type)) {
          const w = ctx.windows[gift.type];
          periodKey = w.key;
          periodCount = Number((await tx.query('SELECT COUNT(*) AS count FROM gift_claims WHERE gift_id=? AND steam_id=? AND created_at >= ? AND created_at < ?', [giftId, String(steamId), w.start, w.end]))[0]?.count || 0);
        }
        const reason = this.eligibility(gift, ctx, periodCount);
        if (reason) throw new ServiceError(reason, 409, 'GIFT_NOT_CLAIMABLE');
        const account = await tx.query('SELECT \`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [String(steamId)]);
        const balance = Number(account[0].balance);
        if (balance < discountedPrice) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
        const actions = await tx.query('SELECT action_index AS actionIndex,action_type AS actionType,product_id AS productId,item_id AS itemId,quantity,options_json AS optionsJson,coin_amount AS coinAmount FROM gift_actions WHERE gift_id=? ORDER BY action_index ASC FOR UPDATE', [giftId]);
        if (!actions.length) throw new ServiceError('礼包没有可执行动作', 409, 'GIFT_EMPTY');
        const claim = await tx.query('INSERT INTO gift_claims (gift_id,steam_id,request_key,claim_period_key,claim_day,price_paid) VALUES (?,?,?,?,?,?)', [giftId, String(steamId), key, periodKey, ctx.windows.day.key, discountedPrice]);
        const number = orderNo();
        const order = await tx.query("INSERT INTO orders (order_no,source,external_order_id,steam_id,gift_id,gift_claim_id,total_amount,status) VALUES (?,'gift',?,?,?, ?,?,'pending')", [number, key, String(steamId), giftId, claim.insertId, discountedPrice]);
        await tx.query('UPDATE gift_claims SET order_id=? WHERE id=?', [order.insertId, claim.insertId]);
        if (activity) await tx.query('INSERT INTO activity_gift_claims (activity_id,gift_id,gift_claim_id,steam_id,activity_snapshot_json,gift_snapshot_json) VALUES (?,?,?,?,?,?)', [activityId, giftId, claim.insertId, String(steamId), JSON.stringify({ id: Number(activity.id), name: activity.name, description: activity.description || '', startsAt: activity.startsAt, endsAt: activity.endsAt }), JSON.stringify({ ...gift, actions: actions.map((action) => ({ actionIndex: Number(action.actionIndex), actionType: action.actionType, productId: action.productId || null, itemId: action.itemId || null, quantity: action.quantity === null ? null : Number(action.quantity), coinAmount: action.coinAmount === null ? null : Number(action.coinAmount), options: parseJson(action.optionsJson) })) })]);
        for (const action of actions) {
          const itemName = action.actionType === 'shop_coin' ? `商城币奖励 ${action.coinAmount}` : `物品 ${action.itemId}`;
          const detail = await tx.query('INSERT INTO order_items (order_id,product_id,sku,name,unit_price,quantity,item_id,grant_amount,currency_type,min_member_level,fulfillment_codes_snapshot) VALUES (?,?,?,?,0,?,?,?,?,0,NULL)', [order.insertId, action.productId, `GIFT-${giftId}-${action.actionIndex}`, itemName, Number(action.quantity || 1), action.itemId, action.quantity, action.actionType === 'shop_coin' ? 'coin' : 'gift']);
          const actionOptions = parseJson(action.optionsJson); delete actionOptions.giftProductQuantity;
          const payload = action.actionType === 'spawn_item' ? { itemId: action.itemId, quantity: Number(action.quantity), ...actionOptions } : null;
          await tx.query("INSERT INTO fulfillment_tasks (order_id,order_item_id,code_index,steam_id,task_type,payload_json,coin_amount,item_id,amount,status) VALUES (?,?,?,?,?,?,?,?,?,'pending')", [order.insertId, detail.insertId, action.actionIndex, String(steamId), action.actionType, payload ? JSON.stringify(payload) : null, action.coinAmount, action.itemId, action.quantity]);
        }
        const after = balance - discountedPrice;
        if (discountedPrice > 0) {
          await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [after, String(steamId)]);
          await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'gift_purchase','gift_claim',?,?)", [String(steamId), -discountedPrice, after, String(claim.insertId), '礼包 #' + giftId + ' ' + gift.name]);
        }
        return { id: order.insertId, claimId: claim.insertId, orderNo: number, status: 'pending', totalAmount: discountedPrice, balanceAfter: after, idempotent: false };
      });
    } catch (error) {
      if (!duplicate(error)) throw error;
      const existing = await this.findClaim(key);
      if (existing) return this.idempotentClaim(existing, steamId, giftId, activityId);
      throw error;
    }
  }
}

export async function importLegacyGifts(db, gifts, logger) {
  const count=await db.query('SELECT COUNT(*) AS count FROM gift_packages'); if(Number(count[0]?.count)>0)return{imported:0,skipped:0}; let imported=0,skipped=0;
  for(const source of Array.isArray(gifts)?gifts:[]){try{const items=Array.isArray(source.items)?source.items:[]; if(!items.length){skipped++;continue;} const products=await db.query(`SELECT id,sku,name,grant_amount,fulfillment_codes,item_id FROM products WHERE sku IN (${items.map(()=>'?').join(',')})`,items.map((item)=>String(item.sku))); if(products.length!==new Set(items.map((item)=>String(item.sku))).size){skipped++;logger?.warn('跳过旧礼包导入：商品不存在',{giftName:source.name});continue;} const bySku=new Map(products.map((p)=>[p.sku,p])); const actions=[]; for(const item of items){const product=bySku.get(String(item.sku)); const quantity=positive(item.quantity,'旧礼包数量',1000)*positive(product.grant_amount,'商品发放数量',100000); const codes=String(product.fulfillment_codes||product.item_id).split(',').map((v)=>v.trim()).filter(Boolean); for(const code of codes)actions.push({productId:product.id,raw:`#spawnitem ${code} ${quantity}`,itemId:code,quantity});} await db.transaction(async(tx)=>{const gift=await tx.query('INSERT INTO gift_packages (name,gift_type,description,enabled,member_level,member_mode,total_limit,daily_limit,period_limit,price) VALUES (?,\'normal\',?, ?,0,\'minimum\',1,1,1,0)',[String(source.name||'新手礼包').slice(0,100),String(source.category||'旧配置导入'),source.enabled!==false]); for(const [index,a] of actions.entries())await tx.query('INSERT INTO gift_actions (gift_id,action_index,action_type,product_id,item_id,quantity,options_json,raw_text) VALUES (?, ?,\'spawn_item\',?,?,?,NULL,?)',[gift.insertId,index,a.productId,a.itemId,a.quantity,a.raw]);}); imported++;}catch(error){skipped++;logger?.warn('旧礼包导入失败，已跳过',{component:'gift',giftName:source?.name,error:error.message});}}
  logger?.info('旧 starterGifts 一次性导入完成',{imported,skipped}); return{imported,skipped};
}
