export const SCUM_LOG_TABLES = [
  ['admin_command', '管理命令'],
  ['field_kill', '野外击杀'],
  ['event_kill', '活动击杀'],
  ['chat', '聊天'],
  ['presence', '上下线'],
  ['teammate_claim', '队友认领'],
  ['purchase', '购买'],
  ['sale', '出售'],
  ['balance', '余额'],
  ['bank_transfer', '存取转账'],
  ['gold', '金条'],
  ['bank_card', '银行卡'],
  ['vehicle', '载具'],
  ['chest', '箱子'],
  ['lockpick', '开锁'],
  ['wire_cut', '剪线'],
  ['trap', '陷阱'],
  ['fame', '声望'],
  ['gameplay', '玩法'],
  ['territory_risk', '领地风险'],
  ['quest', '系统任务'],
  ['sentry', '岗哨'],
  ['bunker_unlock', '地堡解锁'],
  ['bunker_status', '地堡状态'],
  ['base_destruction', '基地破坏'],
  ['rcon_stats', 'RCON统计'],
  ['kick', '踢出'],
  ['distance', '超距'],
  ['ammo', '弹药'],
  ['ballistics', '弹道'],
  ['other_violation', '其他违规'],
  ['loot_diagnostic', 'Loot诊断'],
  ['raid_diagnostic', '突袭诊断']
].map(([category, label]) => ({ category, label, table: `scum_${label}`.toLowerCase() }));

function createScumLogTable({ category, label, table }) {
  return `CREATE TABLE IF NOT EXISTS \`${table}\` (
    \`日志编号\` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '数据库日志编号',
    \`发生时间\` DATETIME(3) NOT NULL COMMENT '游戏日志记录的事件时间',
    \`服务器标识\` VARCHAR(64) NOT NULL DEFAULT '默认' COMMENT 'SCUM服务器标识',
    \`玩家昵称\` VARCHAR(255) NULL COMMENT '相关玩家昵称',
    \`玩家编号\` VARCHAR(64) NULL COMMENT '游戏内玩家或角色编号',
    \`Steam编号\` VARCHAR(17) NULL COMMENT '玩家SteamID',
    \`日志级别\` VARCHAR(16) NOT NULL DEFAULT '信息' COMMENT '信息、警告或错误级别',
    \`事件类型\` VARCHAR(64) NULL COMMENT '分类内部的事件类型',
    \`日志内容\` MEDIUMTEXT NOT NULL COMMENT '页面显示的日志正文',
    \`详细数据\` JSON NULL COMMENT '分类解析后的结构化详细数据',
    \`来源文件编号\` BIGINT UNSIGNED NOT NULL COMMENT '关联SCUM日志文件状态编号',
    \`来源文件\` VARCHAR(255) NOT NULL COMMENT '原始日志文件名称',
    \`文件位置\` BIGINT UNSIGNED NOT NULL COMMENT '原始日志在文件中的字节位置',
    \`行序号\` INT UNSIGNED NOT NULL DEFAULT 0 COMMENT '同一文件位置产生多条记录时的顺序',
    \`行指纹\` CHAR(64) NOT NULL COMMENT '原始日志行SHA256指纹',
    \`事件指纹\` CHAR(64) NULL COMMENT '可选业务事件SHA256指纹',
    \`解析版本\` VARCHAR(16) NOT NULL COMMENT '日志解析器版本',
    \`原始日志\` MEDIUMTEXT NULL COMMENT '未经格式化的原始日志内容',
    \`入库时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) COMMENT '首次写入数据库的时间',
    \`更新时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3) COMMENT '记录最后更新时间',
    PRIMARY KEY (\`日志编号\`),
    UNIQUE KEY \`来源位置唯一\` (\`来源文件编号\`,\`文件位置\`,\`行序号\`),
    INDEX \`时间查询索引\` (\`发生时间\`,\`日志编号\`),
    INDEX \`玩家时间索引\` (\`Steam编号\`,\`发生时间\`,\`日志编号\`),
    INDEX \`事件时间索引\` (\`事件类型\`,\`发生时间\`,\`日志编号\`),
    INDEX \`来源文件索引\` (\`来源文件编号\`,\`文件位置\`),
    INDEX \`事件指纹索引\` (\`事件指纹\`),
    CONSTRAINT \`fk_scum_zh_${category}_file\` FOREIGN KEY (\`来源文件编号\`) REFERENCES scum_log_files(id)
  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='SCUM${label}日志中文物理表'`;
}

export const SCUM_LOG_TABLE_STATEMENTS = SCUM_LOG_TABLES.map(createScumLogTable);
