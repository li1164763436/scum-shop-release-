.storefront-error-page{--error-bg:#090b0b;--error-panel:#121514;--error-line:#343936;--error-text:#eceee8;--error-muted:#929a94;--error-acid:#d5f24b;--error-danger:#ef614d;--error-success:#80bd55;margin:0;min-height:100vh;background:var(--error-bg);color:var(--error-text);font-family:"Microsoft YaHei UI","Microsoft YaHei",sans-serif;display:grid;grid-template-rows:auto 1fr auto}.storefront-error-page *{box-sizing:border-box}.storefront-error-page a{color:inherit;text-decoration:none}.error-header{min-height:82px;padding:0 max(24px,5vw);border-bottom:1px solid #292d2a;display:flex;align-items:center;justify-content:space-between;background:#0b0d0d}.error-brand{display:flex;align-items:center;gap:12px}.error-brand-mark{display:grid;place-items:center;width:39px;height:44px;background:var(--error-acid);color:#0c0e0b;font:900 30px/1 "Arial Narrow",sans-serif;clip-path:polygon(0 0,100% 0,100% 78%,50% 100%,0 78%)}.error-brand strong{display:block;font:800 19px/1 "Arial Narrow","Microsoft YaHei UI",sans-serif;letter-spacing:.12em}.error-brand small{display:block;color:#737b75;font:600 9px/1.8 "Arial Narrow",sans-serif;letter-spacing:.2em}.error-system-state{display:flex;align-items:center;gap:9px;color:#b8c0b9;font-size:12px;font-weight:700}.error-system-state i{width:8px;height:8px;background:var(--error-success);box-shadow:0 0 0 4px rgba(128,189,85,.13)}.error-system-state.warning i{background:var(--error-danger);box-shadow:0 0 0 4px rgba(239,97,77,.13)}.error-layout{width:min(1180px,90vw);margin:auto;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:clamp(48px,8vw,120px);align-items:center;padding:64px 0}.error-copy{min-width:0}.error-kicker{margin:0 0 18px;color:var(--error-acid);font:700 12px/1 "Arial Narrow",sans-serif;letter-spacing:.18em}.error-code{color:#232724;font:800 clamp(112px,19vw,230px)/.7 "Arial Narrow",sans-serif;letter-spacing:0;user-select:none}.error-copy h1{margin:28px 0 16px;font:800 clamp(34px,5vw,66px)/1.05 "Arial Narrow","Microsoft YaHei UI",sans-serif;letter-spacing:0}.error-description{max-width:650px;margin:0;color:var(--error-muted);font-size:15px;line-height:1.9}.error-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.error-button{min-height:46px;padding:0 24px;border:1px solid #474d48;background:transparent;color:var(--error-text);display:inline-flex;align-items:center;justify-content:center;font:700 13px/1 "Microsoft YaHei UI",sans-serif;cursor:pointer}.error-button.primary{border-color:var(--error-acid);background:var(--error-acid);color:#11140d}.error-button:hover{border-color:var(--error-acid)}.error-button:focus-visible{outline:3px solid rgba(213,242,75,.35);outline-offset:3px}.error-button[disabled]{cursor:wait;opacity:.55}.error-probe-message{min-height:24px;margin:16px 0 0;color:#7f8781;font-size:12px}.error-status{border:1px solid var(--error-line);background:var(--error-panel);padding:0}.error-status-head{min-height:54px;padding:0 20px;border-bottom:1px solid var(--error-line);display:flex;align-items:center;justify-content:space-between;color:#a8afa9;font:700 11px/1 "Microsoft YaHei UI",sans-serif}.error-status-head b{color:var(--error-danger);font-family:"Arial Narrow",sans-serif;letter-spacing:.08em}.error-status dl{margin:0;padding:8px 20px}.error-status dl div{min-height:52px;border-bottom:1px solid #292d2a;display:flex;align-items:center;justify-content:space-between;gap:20px}.error-status dt{color:#757d77;font-size:12px}.error-status dd{margin:0;font-size:13px;font-weight:700;text-align:right}.error-status .state-online{color:var(--error-success)}.error-status .state-warning{color:var(--error-danger)}.error-status>p{margin:0;padding:17px 20px;color:#717872;font-size:11px}.error-status>p strong{float:right;color:#afb5b0}.error-footer{min-height:58px;padding:0 max(24px,5vw);border-top:1px solid #292d2a;color:#676e69;display:flex;align-items:center;justify-content:space-between;font:600 10px/1 "Arial Narrow","Microsoft YaHei UI",sans-serif;letter-spacing:.1em}.error-footer b{color:var(--error-danger)}.error-service-overlay{position:fixed;inset:0;z-index:200;background:rgba(9,11,11,.96);overflow:auto}.error-service-overlay .error-layout{min-height:calc(100vh - 140px)}.error-service-overlay .error-overlay-close{position:absolute;top:20px;right:24px;width:42px;height:42px;border:1px solid #454a46;background:#111413;color:#d8dbd5;font-size:24px;cursor:pointer}.error-service-overlay .error-overlay-close:hover{border-color:var(--error-acid);color:var(--error-acid)}
