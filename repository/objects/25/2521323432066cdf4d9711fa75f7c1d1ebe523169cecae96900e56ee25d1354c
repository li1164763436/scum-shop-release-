<section class="page vehicle-management-page" id="page-vehicle-management">
  <div class="page-toolbar vehicle-toolbar">
    <div><span class="section-kicker">INSURANCE MANAGEMENT</span><h2>保险管理</h2><p>集中查看保险策略、载具状态、地图位置和操作记录。</p></div>
  </div>
  <nav class="vehicle-section-nav" aria-label="载具功能导航">
    <button type="button" data-vehicle-panel="insurance">载具保险</button>
    <button type="button" class="active" data-vehicle-panel="management">保险管理</button>
    <button type="button" data-vehicle-panel="restrictions">载具限制</button>
  </nav>
  <div class="vehicle-summary-grid" data-vehicle-section="management">
    <article><span>载具总数</span><strong id="vehicleTotalCount">--</strong><small>上锁载具档案</small></article>
    <article><span>正常使用</span><strong id="vehicleActiveCount">--</strong><small>状态为正常</small></article>
    <article><span>有效保险</span><strong id="vehicleInsuredCount">--</strong><small>当前有效保单</small></article>
    <article><span>需要关注</span><strong id="vehicleAttentionCount">--</strong><small>丢失或损毁</small></article>
  </div>
  <section class="vehicle-sync-status" data-vehicle-section="management" aria-live="polite">
    <div><span>档案来源</span><strong>RCON + SCUM.db 上锁载具</strong></div>
    <div><span>自动同步</span><strong id="vehicleSyncState">读取中</strong></div>
    <div><span>已同步档案</span><strong id="vehicleSynchronizedCount">--</strong></div>
    <div><span>最后同步</span><strong id="vehicleLastSynchronizedAt">--</strong></div>
  </section>
  <section class="card vehicle-directory" data-vehicle-section="management">
    <div class="vehicle-filter-bar">
      <div class="search-box wide">⌕<input id="vehicleSearch" placeholder="搜索档案号、车主、型号、车牌"></div>
      <select id="vehicleStatusFilter"><option value="">全部状态</option><option value="active">正常</option><option value="stored">停放</option><option value="maintenance">维修</option><option value="lost">丢失</option><option value="destroyed">损毁</option><option value="retired">退役</option><option value="recovered">已回收</option></select>
      <select id="vehicleInsuranceFilter"><option value="">全部保险</option><option value="active">已投保</option><option value="expired">已过期</option><option value="suspended">已暂停</option><option value="claimed">已索赔</option><option value="none">无保单</option></select>
      <button class="btn secondary" id="searchVehicles" type="button">查询</button>
      <span class="result-count" id="vehicleResultCount">0 辆载具</span>
    </div>
    <div class="table-wrap"><table class="vehicle-table"><thead><tr><th>操作</th><th>状态</th><th>同步</th><th>载具</th><th>车主</th><th>保险</th><th>位置</th><th>车况 / 油量</th><th>更新时间</th></tr></thead><tbody id="vehicleRows"><tr><td colspan="9" class="empty loading">正在加载载具...</td></tr></tbody></table></div>
    <div class="vehicle-pagination"><button class="btn secondary small" id="vehiclePreviousPage" type="button">上一页</button><span id="vehiclePageStatus">第 1 页</span><button class="btn secondary small" id="vehicleNextPage" type="button">下一页</button></div>
  </section>
  <section class="card vehicle-subpage" data-vehicle-section="insurance" hidden>
    <div class="vehicle-subpage-heading"><div><h3>载具保险</h3><p>配置玩家可自助购买的载具保险销售策略。</p></div><button class="btn primary" id="createVehicleInsuranceStrategy" type="button">新增</button></div>
    <div class="vehicle-insurance-strategy-block">
      <div class="vehicle-block-title"><div><strong>保险销售策略</strong><small>策略名称不可重复，售价以商城币计算。</small></div><span id="vehicleInsuranceStrategyCount">0 个策略</span></div>
      <div class="table-wrap"><table class="vehicle-table"><thead><tr><th>操作</th><th>保险名称</th><th>载具类型</th><th>总赔付次数</th><th>每日赔付次数</th><th>有效时长</th><th>售价</th><th>状态</th></tr></thead><tbody id="vehicleInsuranceStrategyRows"><tr><td colspan="8" class="empty loading">正在加载保险策略...</td></tr></tbody></table></div>
    </div>
    <div class="vehicle-insurance-record-block">
      <div class="vehicle-block-title"><div><strong>已登记保险</strong><small>查看载具当前保单状态与有效期。</small></div><span id="vehicleInsuranceCount">0 条保险记录</span></div>
      <div class="table-wrap"><table class="vehicle-table"><thead><tr><th>载具</th><th>车主</th><th>保险状态</th><th>保单编号</th><th>保险价值</th><th>生效时间</th><th>到期时间</th></tr></thead><tbody id="vehicleInsuranceRows"><tr><td colspan="7" class="empty">暂无保险记录</td></tr></tbody></table></div>
    </div>
  </section>
  <section class="card vehicle-subpage vehicle-restrictions" data-vehicle-section="restrictions" hidden>
    <div class="vehicle-subpage-heading"><div><h3>载具限制</h3><p>用于展示载具使用、区域及状态限制。</p></div></div>
    <div class="empty">暂未配置载具限制</div>
  </section>
</section>
