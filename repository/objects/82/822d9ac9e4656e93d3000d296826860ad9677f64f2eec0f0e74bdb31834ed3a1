#page-membership{--member-accent:#c49a3a;--member-deep:#18251f;--member-line:#dde3dd;gap:18px}
#page-membership.active{display:grid}
#page-membership .page-toolbar{margin-bottom:0;padding:24px 28px;border:1px solid #263a30;border-radius:10px;background:linear-gradient(120deg,#17271f,#21372b);box-shadow:0 12px 30px rgba(18,39,29,.12)}
#page-membership .page-toolbar h2{color:#fff;font-size:27px}#page-membership .page-toolbar p{color:#b9c9bf}#page-membership .section-kicker{color:#e0bd68}
#page-membership>.card{overflow:hidden;margin:0;border:1px solid var(--member-line);border-radius:10px;background:#fff;box-shadow:0 8px 24px rgba(35,54,44,.07)}
#page-membership>.card>.card-head{min-height:82px;padding:18px 22px;border-bottom:1px solid var(--member-line);background:linear-gradient(180deg,#fff,#fafbf9)}
#page-membership .card-head h3{margin:3px 0 4px;color:#1e3027;font-size:18px}#page-membership .card-head p{margin:0;color:#77857d;font-size:11px}
.membership-card-kicker{color:#a57d25;font-size:9px;font-weight:800;letter-spacing:.16em}.membership-policy-badge{padding:6px 10px;border:1px solid #dbc58e;border-radius:999px;background:#fff9e9;color:#8b681a;font-size:10px;font-weight:700}
.membership-strategy-card .strategy-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding:18px 20px;background:#f5f7f5}
.membership-strategy-card .strategy-block{min-width:0;padding:15px;border:1px solid #dce3dd;border-radius:8px;background:#fff;box-shadow:0 4px 12px rgba(32,54,42,.05)}
.strategy-block-head{display:flex;align-items:center;gap:10px;margin:-2px 0 13px;padding-bottom:11px;border-bottom:1px solid #e5e9e5}.strategy-block-head>span{display:grid;place-items:center;width:29px;height:29px;border-radius:7px;background:#1d3428;color:#e9c66f;font-size:10px;font-weight:800}.strategy-block-head div{display:grid;gap:2px}.strategy-block-head strong{color:#26382f;font-size:13px}.strategy-block-head small{color:#8a968f;font-size:9px}
.membership-strategy-card .strategy-row{min-height:39px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;padding:6px 0;border-bottom:1px dashed #e4e8e5}.membership-strategy-card .strategy-row:last-of-type{border-bottom:0}.membership-strategy-card .strategy-row>span:first-child{color:#536159;font-size:11px;font-weight:600}
.membership-strategy-card .strategy-row input[type=number],.membership-strategy-card .strategy-row select{width:128px;height:34px;border:1px solid #d1d8d2;border-radius:6px;background:#fafbf9;color:#25372e;padding:0 9px;outline:0}.membership-strategy-card .strategy-row input:focus,.membership-strategy-card .strategy-row select:focus{border-color:#8aa896;box-shadow:0 0 0 3px rgba(92,132,107,.1)}
.membership-strategy-card .strategy-row>span:last-child{color:#8a681b;font-size:10px;font-weight:700}.strategy-hint{margin:3px 0 5px;color:#929d96;font-size:9px;line-height:1.45}.strategy-actions{display:flex;justify-content:stretch;margin-top:12px}.strategy-status{width:100%;min-height:36px;display:flex;align-items:center;justify-content:center;padding:8px 12px;border:1px solid #b9d4c1;border-radius:7px;background:#edf7ef;color:#326447;font-size:11px;font-weight:800;letter-spacing:.03em}.strategy-status:before{content:"";width:7px;height:7px;margin-right:7px;border-radius:50%;background:#4aa267;box-shadow:0 0 0 3px rgba(74,162,103,.12)}.strategy-status.consumption{border-color:#dbc98f;background:#fff9e8;color:#85651d}.strategy-status.consumption:before{background:#c69a32;box-shadow:0 0 0 3px rgba(198,154,50,.13)}.strategy-save{padding:0 20px 18px;display:flex;justify-content:flex-end;background:#f5f7f5}.strategy-save .btn{min-width:128px}
.membership-level-card .table-wrap,.membership-player-card .table-wrap,.membership-log-card .table-wrap{margin:0;overflow:auto}.membership-level-table,.membership-player-card table,.membership-log-card table{width:100%;border-collapse:separate;border-spacing:0}.membership-level-table th,.membership-player-card th,.membership-log-card th{position:sticky;top:0;z-index:1;padding:11px 10px;border-bottom:1px solid #d9e0da;background:#f0f4f1;color:#53645a;font-size:10px;font-weight:800;white-space:nowrap}.membership-level-table td,.membership-player-card td,.membership-log-card td{padding:11px 10px;border-bottom:1px solid #edf0ed;color:#34473d;font-size:11px;vertical-align:middle}.membership-level-table tbody tr:nth-child(even),.membership-player-card tbody tr:nth-child(even),.membership-log-card tbody tr:nth-child(even){background:#fbfcfb}.membership-level-table tbody tr:hover,.membership-player-card tbody tr:hover,.membership-log-card tbody tr:hover{background:#f3f7f4}.membership-level-table td:first-child{color:#9a741e;font-weight:800}.membership-level-table td:nth-child(2){color:#263a30;font-weight:700}.membership-level-table .row-actions{flex-wrap:nowrap}
.membership-player-card .account-filter-bar{margin:0;padding:14px 18px;display:grid;grid-template-columns:minmax(260px,1fr) 120px 150px auto auto;gap:9px;align-items:center;border-bottom:1px solid var(--member-line);background:#f7f9f7}.membership-player-card .account-filter-bar>input,.membership-player-card .account-filter-bar>select{height:38px;border:1px solid #d4dbd5;border-radius:6px;background:#fff;padding:0 10px}.membership-player-card .search-box{height:38px;border-radius:6px;background:#fff}.membership-player-card .result-count{justify-self:end;color:#69786f;font-size:10px;font-weight:700}.member-level{color:#a37920;white-space:nowrap}
#membershipRows .badge.active{border-color:#b7d8c0;background:#edf8ef;color:#327348}#membershipRows .badge.inactive{border-color:#e1b5ad;background:#fff1ef;color:#a84b3c}#membershipRows .badge.none{border-color:#d8deda;background:#f2f4f2;color:#78827c}
.membership-player-card .table-pagination,.membership-log-card .table-pagination{padding:13px 18px;border-top:1px solid var(--member-line);background:#fafbfa}.membership-player-card .table-pagination button,.membership-log-card .table-pagination button{min-width:76px;height:32px;border:1px solid #ced6d0;border-radius:5px;background:#fff;color:#4e6257}.membership-player-card .table-pagination span,.membership-log-card .table-pagination span{color:#6f7c74;font-size:10px}
.membership-log-card{margin-top:0!important}.membership-log-card #membershipLogScope{max-width:650px}.membership-log-card td:nth-child(2),.membership-log-card td:nth-child(3){font-weight:700}.membership-log-card td:nth-child(3){color:#a07822}
.membership-consumption-search{padding:16px 20px;display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:10px;align-items:end;border-bottom:1px solid var(--member-line);background:#f7f9f7}.membership-consumption-search label{display:grid;gap:6px;color:#5d6c63;font-size:10px;font-weight:700}.membership-consumption-search input{height:40px;border:1px solid #cfd8d1;border-radius:6px;background:#fff;padding:0 12px;font-family:Consolas,monospace;font-size:13px;letter-spacing:.04em}.membership-consumption-search .btn{min-width:108px;height:40px}
.membership-consumption-search{grid-template-columns:260px 88px;justify-content:start;padding:12px 18px}.membership-consumption-search input{height:34px;padding:0 10px;font-size:12px}.membership-consumption-search .btn{min-width:88px;height:34px;padding:0 10px}
.membership-consumption-card{display:grid;grid-template-columns:260px minmax(0,1fr);align-items:stretch}.membership-consumption-card>.card-head{grid-column:1/-1}.membership-consumption-search{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:10px;padding:18px;border-right:1px solid var(--member-line);border-bottom:0;background:#f7f9f7}.membership-consumption-search label{width:100%}.membership-consumption-search input{width:100%}.membership-consumption-search .btn{width:100%;margin:0}.membership-consumption-result{min-width:0;border-left:0}
.membership-consumption-result{min-height:190px;padding:18px 20px;background:#fff}.membership-consumption-result>.empty-row{padding:42px 20px}.membership-consumption-identity{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;margin-bottom:13px;padding:11px 13px;border:1px solid #dce3dd;border-radius:7px;background:#f8faf8}.membership-consumption-identity>span{color:#7d8982;font-size:9px;font-weight:700}.membership-consumption-identity>strong{color:#263a30;font-size:14px}.membership-consumption-identity>code{color:#52665a;font-size:11px}
.membership-consumption-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.membership-consumption-metrics article{min-width:0;padding:14px;border:1px solid #dce3dd;border-radius:8px;background:linear-gradient(145deg,#fff,#f7f9f7)}.membership-consumption-metrics span,.membership-consumption-metrics small{display:block;color:#829087;font-size:9px}.membership-consumption-metrics strong{display:block;margin:5px 0 3px;color:#956f1d;font-size:22px;line-height:1}.membership-consumption-metrics article:nth-child(2) strong{color:#32654a}.membership-consumption-metrics article:nth-child(3) small{color:#4e745c;font-weight:700}
.membership-consumption-next{margin-top:12px;padding:12px 14px;display:grid;grid-template-columns:minmax(180px,1fr) minmax(180px,2fr) auto;gap:12px;align-items:center;border:1px solid #dfe5e0;border-radius:8px;background:#f6f8f6}.membership-consumption-next div{display:grid;gap:3px}.membership-consumption-next strong{color:#30443a;font-size:12px}.membership-consumption-next small{color:#839087;font-size:9px}.membership-consumption-next em{color:#8c6a20;font-size:10px;font-style:normal;font-weight:800}.membership-consumption-progress{height:8px;overflow:hidden;border-radius:999px;background:#dfe6e1}.membership-consumption-progress i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#3b7655,#c59a39)}
@media(max-width:1180px){.membership-strategy-card .strategy-grid{grid-template-columns:1fr 1fr}.membership-strategy-card .strategy-block:last-child{grid-column:1/-1}.membership-player-card .account-filter-bar{grid-template-columns:1fr 120px 150px auto}.membership-player-card .result-count{grid-column:1/-1;justify-self:start}}
@media(max-width:760px){#page-membership .page-toolbar{padding:20px}.membership-strategy-card .strategy-grid{grid-template-columns:1fr;padding:12px}.membership-strategy-card .strategy-block:last-child{grid-column:auto}.membership-player-card .account-filter-bar{grid-template-columns:1fr}.membership-player-card .result-count{grid-column:auto}.membership-strategy-card .strategy-row input[type=number],.membership-strategy-card .strategy-row select{width:118px}.membership-level-card .card-head,.membership-log-card .card-head{align-items:flex-start;flex-direction:column;gap:10px}.membership-consumption-card{grid-template-columns:1fr}.membership-consumption-card>.card-head{grid-column:auto}.membership-consumption-search{border-right:0;border-bottom:1px solid var(--member-line)}.membership-consumption-metrics{grid-template-columns:1fr}.membership-consumption-next{grid-template-columns:1fr}.membership-consumption-identity{grid-template-columns:1fr}.membership-consumption-identity>code{overflow-wrap:anywhere}}
.membership-level-actions{display:flex;align-items:center;gap:8px}.membership-log-modal .modal{width:min(1180px,96vw);max-height:calc(100vh - 48px)}.membership-log-modal .modal-body{display:block;padding:0}.membership-log-modal-table{max-height:calc(100vh - 220px);overflow:auto}.membership-log-modal-table table{width:100%;min-width:980px;border-collapse:separate;border-spacing:0}.membership-log-modal-table th{position:sticky;top:0;z-index:1;padding:11px 10px;border-bottom:1px solid #d9e0da;background:#f0f4f1;color:#53645a;font-size:10px;white-space:nowrap}.membership-log-modal-table td{padding:11px 10px;border-bottom:1px solid #edf0ed;color:#34473d;font-size:11px}.membership-log-modal-table tbody tr:nth-child(even){background:#fbfcfb}.membership-log-modal-table tbody tr:hover{background:#f3f7f4}.membership-log-modal-pagination{margin:0}.membership-log-modal .modal-actions{padding:10px 18px}.membership-log-modal #cancelModal{display:none}@media(max-width:760px){.membership-level-actions{width:100%;justify-content:flex-start}.membership-log-modal .modal{width:96vw}.membership-log-modal-table{max-height:calc(100vh - 250px)}}
.membership-strategy-modal .modal{width:min(900px,94vw);max-height:calc(100vh - 48px)}.membership-strategy-modal .modal-body{grid-template-columns:1fr;padding:18px}.membership-strategy-modal .modal-section-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.membership-adjust-modal .modal{width:min(620px,94vw);max-height:calc(100vh - 48px)}.membership-adjust-modal .modal-body{grid-template-columns:1fr 1fr}.membership-adjust-modal .modal-body .full{grid-column:1/-1}@media(max-width:760px){.membership-strategy-modal .modal-section-grid,.membership-adjust-modal .modal-body{grid-template-columns:1fr}.membership-strategy-modal .modal-section-grid .full,.membership-adjust-modal .modal-body .full{grid-column:auto}}
