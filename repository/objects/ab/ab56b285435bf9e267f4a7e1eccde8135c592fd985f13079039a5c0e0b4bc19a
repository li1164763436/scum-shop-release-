      <div class="vehicle-form-grid compact"><label>地图格<input name="gridCode" maxlength="16" value="${esc(vehicle.gridCode || '')}" placeholder="例如 B2"${automaticAttribute}></label><label>最后发现<input name="lastSeenAt" type="datetime-local" value="${vehicleDateInput(vehicle.lastSeenAt)}"${automaticAttribute}></label><label>X 坐标<input name="worldX" type="number" step="0.0001" value="${esc(vehicle.worldX ?? '')}"${automaticAttribute}></label><label>Y 坐标<input name="worldY" type="number" step="0.0001" value="${esc(vehicle.worldY ?? '')}"${automaticAttribute}></label><label>Z 坐标<input name="worldZ" type="number" step="0.0001" value="${esc(vehicle.worldZ ?? '')}"${automaticAttribute}></label><label>地图横向 %<input name="mapXPercent" type="number" min="0" max="100" step="0.0001" value="${esc(vehicle.mapXPercent ?? '')}"></label><label>地图纵向 %<input name="mapYPercent" type="number" min="0" max="100" step="0.0001" value="${esc(vehicle.mapYPercent ?? '')}"></label><label class="full">位置说明<input name="locationNote" maxlength="500" value="${esc(vehicle.locationNote || '')}"></label></div>
      <div class="vehicle-map-picker" id="vehicleMapPicker" title="点击地图设置标记"><img src="/shop/assets/teleport/scum-map-ultra.webp" alt="SCUM地图"><span id="vehicleMapMarker" hidden></span><small>点击地图设置标记位置</small></div>
    </div>
    <h3>管理员保险配置</h3>
    <div class="vehicle-form-grid"><label>保险状态<select name="insuranceStatus">${Object.entries(vehicleInsuranceNames).map(([key,label]) => `<option value="${key}"${insuranceStatus === key ? ' selected' : ''}>${label}</option>`).join('')}</select></label><label>保单编号<input name="policyNumber" maxlength="100" value="${esc(vehicle.policyNumber || '')}"></label><label>保险价值<input name="insuredValue" type="number" min="0" step="1" value="${esc(vehicle.insuredValue ?? '')}"></label><label>保费<input name="premiumAmount" type="number" min="0" step="1" value="${esc(vehicle.premiumAmount ?? '')}"></label><label>生效时间<input name="insuranceStartsAt" type="datetime-local" value="${vehicleDateInput(vehicle.insuranceStartsAt)}"></label><label>到期时间<input name="insuranceExpiresAt" type="datetime-local" value="${vehicleDateInput(vehicle.insuranceExpiresAt)}"></label><label class="full">保障范围<textarea name="coverageNote" maxlength="1000">${esc(vehicle.coverageNote || '')}</textarea></label><label class="full">保险备注<textarea name="insuranceNotes" maxlength="1000">${esc(vehicle.insuranceNotes || '')}</textarea></label><label class="full">载具备注<textarea name="notes" maxlength="2000">${esc(vehicle.notes || '')}</textarea></label></div>
    ${vehicle.id ? `<button class="btn danger vehicle-delete" type="button" data-delete-vehicle="${vehicle.id}">删除载具档案</button>` : ''}
  </section>`;
}

function optionalNumberInput(element) { return element.value === '' ? null : Number(element.value); }
function optionalDateInput(element) { return element.value ? new Date(element.value).toISOString() : null; }
function setupVehicleMapPicker() {
  const picker = $('#vehicleMapPicker'), marker = $('#vehicleMapMarker'), form = $('#modalForm'); if (!picker || !marker) return;
  const render = () => { const x = Number(form.elements.mapXPercent.value), y = Number(form.elements.mapYPercent.value); const visible = Number.isFinite(x) && Number.isFinite(y) && form.elements.mapXPercent.value !== '' && form.elements.mapYPercent.value !== ''; marker.hidden = !visible; if (visible) { marker.style.left = `${x}%`; marker.style.top = `${y}%`; } };
  picker.addEventListener('click', (event) => { const rect = picker.querySelector('img').getBoundingClientRect(); const x = Math.max(0, Math.min(100, (event.clientX - rect.left) / rect.width * 100)); const y = Math.max(0, Math.min(100, (event.clientY - rect.top) / rect.height * 100)); form.elements.mapXPercent.value = x.toFixed(4); form.elements.mapYPercent.value = y.toFixed(4); render(); });
  form.elements.mapXPercent.addEventListener('input', render); form.elements.mapYPercent.addEventListener('input', render); render();
}

function vehicleEditorModal(vehicle = null) {
  openModal({ title: vehicle ? `编辑载具 · ${vehicle.vehicleCode}` : '新增载具档案', description: '档案与保险均由管理员手动维护；地图点击仅记录标记百分比。', submitText: '保存载具', body: vehicleEditorBody(vehicle || {}), onSubmit: async (form) => {
    const f = form.elements;
    const payload = { vehicleCode:f.vehicleCode.value.trim(),status:f.status.value,vehicleType:f.vehicleType.value.trim(),modelName:f.modelName.value.trim(),displayName:f.displayName.value.trim(),plateNumber:f.plateNumber.value.trim(),ownerSteamId:f.ownerSteamId.value.trim(),ownerName:f.ownerName.value.trim(),conditionPercent:optionalNumberInput(f.conditionPercent),fuelPercent:optionalNumberInput(f.fuelPercent),gridCode:f.gridCode.value.trim(),worldX:optionalNumberInput(f.worldX),worldY:optionalNumberInput(f.worldY),worldZ:optionalNumberInput(f.worldZ),mapXPercent:optionalNumberInput(f.mapXPercent),mapYPercent:optionalNumberInput(f.mapYPercent),locationNote:f.locationNote.value.trim(),lastSeenAt:optionalDateInput(f.lastSeenAt),notes:f.notes.value.trim() };
    const saved = await api(vehicle ? `/api/vehicles/${vehicle.id}` : '/api/vehicles', { method: vehicle ? 'PUT' : 'POST', body: JSON.stringify(payload) });
    await api(`/api/vehicles/${saved.id}/insurance`, { method:'PUT', body:JSON.stringify({ status:f.insuranceStatus.value,policyNumber:f.policyNumber.value.trim(),insuredValue:optionalNumberInput(f.insuredValue),premiumAmount:optionalNumberInput(f.premiumAmount),startsAt:optionalDateInput(f.insuranceStartsAt),expiresAt:optionalDateInput(f.insuranceExpiresAt),coverageNote:f.coverageNote.value.trim(),notes:f.insuranceNotes.value.trim() }) });
    toast('载具档案已保存'); closeModal(); await loadVehicleManagement();
  }});
  setupVehicleMapPicker();
  $('[data-delete-vehicle]')?.addEventListener('click', async (event) => { if (!confirm('确认删除该载具档案？保险资料会一并删除，审计记录保留。')) return; await api(`/api/vehicles/${event.currentTarget.dataset.deleteVehicle}`, { method:'DELETE' }); toast('载具档案已删除'); closeModal(); await loadVehicleManagement(); });
}

function vehicleMapPopoverPosition(anchor, viewport, popup, gap = 8) {
  const margin = 12;
  const left = Math.min(Math.max(margin, anchor.left), Math.max(margin, viewport.width - popup.width - margin));
  const below = anchor.bottom + gap;
  const above = anchor.top - popup.height - gap;
  const top = below + popup.height <= viewport.height - margin ? below : above >= margin ? above : Math.min(Math.max(margin, below), Math.max(margin, viewport.height - popup.height - margin));
  return { left, top };
}

function vehicleLocationPopover(vehicle, anchor) {
  const position = vehicleMapPosition(vehicle); if (!vehicle || !position || !anchor) return;
  vehicleMapPopoverCleanup?.();
  const labels = vehicleMapGridRows.flatMap((row, rowIndex) => vehicleMapGridColumns.map((column, columnIndex) => `<span class="vehicle-location-grid-label" style="--grid-row:${rowIndex};--grid-column:${columnIndex}">${row}${column}</span>`)).join('');
  const hasWorldPosition = vehicle.worldX !== null && vehicle.worldX !== undefined && vehicle.worldY !== null && vehicle.worldY !== undefined;
  const coordinate = hasWorldPosition ? [`X ${number(vehicle.worldX)}`, `Y ${number(vehicle.worldY)}`, vehicle.worldZ === null || vehicle.worldZ === undefined ? '' : `Z ${number(vehicle.worldZ)}`].filter(Boolean).join(' / ') : '';
  const title = vehicle.displayName || vehicle.modelName || '载具位置';
  const offset = vehicleMapViewportOffset(position);
  const popup = document.createElement('aside');
  popup.className = 'vehicle-location-popover';
  popup.id = 'vehicleLocationPopover';
  popup.setAttribute('role', 'dialog');
  popup.setAttribute('aria-label', `${title}地图位置`);
  popup.innerHTML = `<header class="vehicle-location-popover-head"><strong>${esc(title)}</strong><button type="button" class="vehicle-location-popover-close" aria-label="关闭地图预览">×</button></header><div class="vehicle-location-map"><div class="vehicle-location-map-canvas" style="left:${offset.left};top:${offset.top}"><img src="/shop/assets/teleport/scum-map-ultra.webp" alt="SCUM 载具位置地图"><div class="vehicle-location-map-grid">${labels}</div><span class="vehicle-location-marker" style="left:${position.x}%;top:${position.y}%" aria-label="载具位置"></span></div></div><div class="vehicle-location-popover-caption"><strong>${esc(vehicle.gridCode || '地图坐标')}</strong><span>${esc(coordinate || '暂无世界坐标')}</span></div>`;
  const width = Math.min(360, Math.max(0, window.innerWidth - 24));
  const point = vehicleMapPopoverPosition(anchor.getBoundingClientRect(), { width:window.innerWidth, height:window.innerHeight }, { width, height:width + 84 });
  popup.style.left = `${point.left}px`;
  popup.style.top = `${point.top}px`;
  document.body.append(popup);
  anchor.setAttribute('aria-expanded', 'true');
  anchor.setAttribute('aria-controls', popup.id);
  const close = (restoreFocus = false) => {
    popup.remove();
    anchor.setAttribute('aria-expanded', 'false');
    anchor.removeAttribute('aria-controls');
    document.removeEventListener('pointerdown', onOutside, true);
    document.removeEventListener('keydown', onKeyDown, true);
    window.removeEventListener('resize', onViewportChange);
    window.removeEventListener('scroll', onViewportChange, true);
    if (vehicleMapPopoverCleanup === cleanup) vehicleMapPopoverCleanup = null;
    if (restoreFocus && anchor.isConnected) anchor.focus();
  };
  const onOutside = (event) => { if (!popup.contains(event.target) && !anchor.contains(event.target)) close(); };
  const onKeyDown = (event) => { if (event.key === 'Escape') { event.preventDefault(); close(true); } };
  const onViewportChange = () => close();
  const cleanup = () => close();
  vehicleMapPopoverCleanup = cleanup;
  popup.querySelector('.vehicle-location-popover-close').addEventListener('click', () => close(true));
  document.addEventListener('pointerdown', onOutside, true);
  document.addEventListener('keydown', onKeyDown, true);
  window.addEventListener('resize', onViewportChange);
  window.addEventListener('scroll', onViewportChange, true);
}

function vehicleDetailField(label, value, wide = false) {
  if (value === null || value === undefined || value === '') return '';
  return `<div${wide ? ' class="wide"' : ''}><dt>${esc(label)}</dt><dd>${esc(value)}</dd></div>`;
}

