}
function vehicleDisplayId(vehicle) {
  return String(vehicle?.vehicleCode || vehicle?.id || '').replace(/^scum:/i, '');
}
function vehicleMapPosition(vehicle) {
  const hasStoredPosition = vehicle?.mapXPercent !== null && vehicle?.mapXPercent !== undefined && vehicle?.mapXPercent !== '' && vehicle?.mapYPercent !== null && vehicle?.mapYPercent !== undefined && vehicle?.mapYPercent !== '';
  const storedX = Number(vehicle?.mapXPercent), storedY = Number(vehicle?.mapYPercent);
  if (hasStoredPosition && Number.isFinite(storedX) && Number.isFinite(storedY) && storedX >= 0 && storedX <= 100 && storedY >= 0 && storedY <= 100) return { x:storedX, y:storedY };
  const hasWorldPosition = vehicle?.worldX !== null && vehicle?.worldX !== undefined && vehicle?.worldX !== '' && vehicle?.worldY !== null && vehicle?.worldY !== undefined && vehicle?.worldY !== '';
  const worldX = Number(vehicle?.worldX), worldY = Number(vehicle?.worldY);
  if (!hasWorldPosition || !Number.isFinite(worldX) || !Number.isFinite(worldY)) return null;
  const x = (619200 - worldX) / (619200 - (-904800)) * 100;
  const y = (619199.9375 - worldY) / (619199.9375 - (-904800)) * 100;
  return x >= 0 && x <= 100 && y >= 0 && y <= 100 ? { x, y } : null;
}

