async function loadGameChatPlayers() {
  const select = $('#gameChatPlayer');
  if (!select) return;
  try {
    const players = list(await api('/api/ggcon/players'), ['players', 'items']);
    select.innerHTML = '<option value="">请选择在线玩家</option><option value="__global__">全球频道（所有玩家）</option>' + players.map((player) => `<option value="${esc(player.steamId)}">${esc(player.characterName || player.steamName || player.steamId)} (${esc(player.steamId)})</option>`).join('');
  } catch (error) { select.innerHTML = '<option value="">无法读取在线玩家</option>'; }
}

function renderDeliveryNotificationConfig(config) {
  const fulfillment = config?.fulfillment || {};
  const form = $('#deliveryNotificationForm')?.elements;
  if (!form) return;
  state.gameClaimNotificationFulfillment = fulfillment;
  form.notifyOnSuccess.checked = Boolean(fulfillment.notifyOnSuccess);
  form.deliveryName.value = fulfillment.deliveryName || '';
  form.notificationMessage.value = fulfillment.purchaseMessage || fulfillment.successMessage || '[玩家昵称]的【{orderName}】';
}

async function loadGameClaims() {
  const [overview, settings, replies, config] = await Promise.allSettled([
    api('/api/chat-logs/overview'),
    api('/api/chat-logs/settings'),
    api('/api/chat-logs/auto-replies'),
    api('/api/config')
  ]);
  if (overview.status === 'fulfilled') renderChatOverview(overview.value);
  else renderChatOverviewError(overview.reason.message);
  if (settings.status === 'fulfilled') {
    const value=settings.value,logForm=$('#gameLogSettingsForm').elements;
    renderClaimPrefix(value.claimPrefix);
    state.gameRecycleCommand=value.recycleCommand||'回收';
    $('#gameQaEnabled').checked = value.autoReplyEnabled === true;
    logForm.logsEnabled.checked = value.scumLogs?.enabled !== false && value.chatLogs?.enabled !== false;
    logForm.logsPollSeconds.value = Math.round(Number(value.chatLogs?.pollIntervalMs || value.scumLogs?.pollIntervalMs || 5000) / 1000);
    logForm.logsRetentionDays.value = value.chatLogs?.retentionDays || value.scumLogs?.retentionDays || 365;
  }
  if (replies.status === 'fulfilled') { state.gameQaRules = replies.value || []; renderGameQaRules(); }
  else $('#gameQaRows').innerHTML = empty(8, replies.reason.message);
  if (config.status === 'fulfilled') renderDeliveryNotificationConfig(config.value);
  else toast(`发货通知读取失败：${config.reason.message}`, true);
}
