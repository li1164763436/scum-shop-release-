  openModal({ title: item.id ? '编辑问答规则' : '添加问答规则', description: '配置触发条件、使用限制和商城币价格。0 表示不限制或免费。', submitText: item.id ? '保存规则' : '添加规则', body: `<section class="modal-section full game-qa-modal-section"><div class="modal-section-grid"><label>触发词<input name="triggerText" maxlength="50" value="${esc(item.triggerText || '')}" placeholder="例如：@帮助" required></label><label>问答价格<input name="price" type="number" min="0" step="1" value="${Number(item.price || 0)}" required><span class="field-hint">每次成功触发扣除的商城币</span></label><label>总次数<input name="totalLimit" type="number" min="0" step="1" value="${Number(item.totalLimit || 0)}" required><span class="field-hint">每名玩家累计可触发次数</span></label><label>每日次数<input name="dailyLimit" type="number" min="0" step="1" value="${Number(item.dailyLimit || 0)}" required><span class="field-hint">每名玩家每日可触发次数</span></label><label>等级要求<input name="minMemberLevel" type="number" min="0" max="100" step="1" value="${Number(item.minMemberLevel || 0)}" required><span class="field-hint">玩家有效会员最低等级</span></label><label class="full">商城回复词<textarea name="responseText" maxlength="500" placeholder="例如：玩家可发送@领取新手礼包" required>${esc(item.responseText || '')}</textarea></label></div></section>`, onSubmit: async (form) => { const body={triggerText:form.elements.triggerText.value.trim(),responseText:form.elements.responseText.value.trim(),totalLimit:Number(form.elements.totalLimit.value),dailyLimit:Number(form.elements.dailyLimit.value),minMemberLevel:Number(form.elements.minMemberLevel.value),price:Number(form.elements.price.value),enabled:$('#gameQaModalEnabled').checked};await api(item.id?`/api/chat-logs/auto-replies/${item.id}`:'/api/chat-logs/auto-replies',{method:item.id?'PUT':'POST',body:JSON.stringify(body)});toast(item.id?'问答规则已更新':'问答规则已添加');closeModal();await loadGameClaims(); } });
  $('#modalBackdrop').classList.add('centered-modal', 'game-qa-modal');
  const prefix=String(state.gameClaimPrefix||'@'),triggerInput=$('#modalForm').elements.triggerText;triggerInput.value=String(triggerInput.value||'').startsWith(prefix)?String(triggerInput.value).slice(prefix.length):triggerInput.value;triggerInput.placeholder='例如：帮助';$('#modalDescription').textContent=`只填写触发词正文，商城会自动添加前缀“${prefix}”。0 表示不限制或免费。`;
  const head=$('#modalTitle').closest('.modal-head'),tools=document.createElement('div');tools.className='game-qa-title-tools';tools.innerHTML=`<label class="switch"><input id="gameQaModalEnabled" type="checkbox" ${item.enabled === false ? '' : 'checked'}><span></span>启用规则</label>`;head.insertBefore(tools,$('#closeModal'));$('#closeModal').hidden=true;
