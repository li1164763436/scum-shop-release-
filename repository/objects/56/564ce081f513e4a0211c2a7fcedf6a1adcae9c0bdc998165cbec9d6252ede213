function renderClaimPrefix(value) {
  const prefix = String(value || '@');
  state.gameClaimPrefix = prefix;
  const form = $('#claimPrefixForm');
  if (form) form.elements.claimPrefix.value = prefix;
  $('#claimPrefixPreview').textContent = `${prefix}领取1`;
}
function renderChatOverview(data) {
  state.chatOverview = data || {};
  const worker = data?.worker || data?.collector || {};
  const enabled = worker.enabled === true;
  const active = worker.running === true || worker.polling === true;
  const directoryConfigured = worker.directoryConfigured === true || data?.directoryConfigured === true;
  $('#chatCollectorState').textContent = !enabled ? '未启用' : !directoryConfigured ? '目录未配置' : worker.running ? '处理中' : worker.polling ? '运行中' : '已停止';
  $('#chatCollectorState').className = enabled && active && directoryConfigured ? 'monitor-ok' : enabled ? 'monitor-bad' : '';
  $('.game-claim-collector')?.classList.toggle('is-online', enabled && active && directoryConfigured);
  $('.game-claim-collector')?.classList.toggle('is-error', !enabled || !active || !directoryConfigured);
  $('#chatCollectorDetail').textContent = `启用 ${enabled ? '是' : '否'} / 运行 ${active ? '是' : '否'} / 目录 ${directoryConfigured ? '已配置' : '未配置'}`;
  $('#chatLastProcessed').textContent = date(pick(data, ['lastProcessedAt', 'collection.lastProcessedAt'], worker.lastCompletedAt || worker.lastSuccessAt));
  $('#chatFilesSeen').textContent = optionalNumber(pick(data, ['files', 'filesSeen', 'collection.filesSeen', 'collection.files'], worker.filesSeen));
  $('#chatEventsStored').textContent = optionalNumber(pick(data, ['totalEvents', 'eventsStored', 'parsing.eventsStored', 'parsing.events', 'stats.eventsStored'], worker.eventsStored));
  $('#chatCommandsSeen').textContent = optionalNumber(pick(data, ['claimCommands', 'commandsProcessed', 'commands.total', 'commands.recognized', 'stats.commands'], ''));
  $('#chatClaimsSucceeded').textContent = optionalNumber(pick(data, ['succeeded', 'claimsSucceeded', 'claims.succeeded', 'claims.success', 'stats.claimsSucceeded'], ''));
  $('#chatClaimsFailed').textContent = optionalNumber(pick(data, ['failed', 'claimsFailed', 'claims.failed', 'stats.claimsFailed'], ''));
  $('#chatTriggerResultHint').textContent = `仅统计 ${pick(data, ['triggerPrefix'], '@')} 前缀`;
}
function renderChatOverviewError(message) {
  $('#chatCollectorState').textContent = '读取失败';
  $('#chatCollectorState').className = 'monitor-bad';
  $('.game-claim-collector')?.classList.remove('is-online');
  $('.game-claim-collector')?.classList.add('is-error');
  $('#chatCollectorDetail').textContent = message;
  for (const id of ['chatLastProcessed', 'chatFilesSeen', 'chatEventsStored', 'chatCommandsSeen', 'chatClaimsSucceeded', 'chatClaimsFailed']) $(`#${id}`).textContent = '--';
}
function chatEventStatus(value) {
  const raw = String(value || 'unknown').toLowerCase();
  const labels = { succeeded: '成功', success: '成功', completed: '成功', failed: '失败', rejected: '安全拒绝', ignored: '忽略', parsed: '已解析', pending: '待处理', unknown: '未知' };
  const style = ['succeeded', 'success', 'completed'].includes(raw) ? 'success' : ['failed', 'rejected'].includes(raw) ? 'failed' : raw === 'ignored' ? 'inactive' : 'waiting';
  return `<span class="badge ${esc(style)}">${esc(labels[raw] || value || '未知')}</span>`;
}
function renderChatEvents(data) {
  state.chatEvents = list(data, ['items', 'events']);
  $('#chatEventRows').innerHTML = state.chatEvents.length ? state.chatEvents.map((item) => {
    const playerName = pick(item, ['playerName', 'name'], '未知玩家');
    const steamId = pick(item, ['steamIdMasked', 'maskedSteamId', 'steamId'], '--');
    const channel = pick(item, ['channel', 'chatChannel'], '未知');
    const commandTarget = pick(item, ['commandTarget'], ''), commandType=pick(item,['commandType'],'');
    const fallbackCommand=commandTarget===''?'--':commandType==='recycle'?`${state.gameClaimPrefix||'@'}${state.gameRecycleCommand||'回收'} ${commandTarget}`:`${state.gameClaimPrefix||'@'}领取${commandTarget}`;
    const command = pick(item, ['command', 'claimCommand', 'commandName'], fallbackCommand);
    const eventStatus = pick(item, ['result', 'status', 'resultStatus'], item.parseStatus === 'ignored_channel' ? 'ignored' : item.parseStatus === 'claim_command' ? 'pending' : 'parsed');
    const gift = pick(item, ['giftName', 'gift.name'], '');
    const giftId = pick(item, ['giftId', 'gift.id'], '');
    const order = pick(item, ['orderNo', 'orderId', 'order.id'], '');
    const relation = [gift || (giftId !== '' ? `礼包 #${giftId}` : ''), order !== '' ? `订单 ${order}` : ''].filter(Boolean).join(' / ') || '--';
    const safeError = pick(item, ['securityError', 'errorCode', 'error.message', 'error'], '--');
    return `<tr><td>${esc(date(pick(item, ['eventTime', 'createdAt', 'timestamp', 'time'])))}</td><td><strong>${esc(playerName)}</strong></td><td><code>${esc(steamId)}</code></td><td><span class="chat-channel ${String(channel).toLowerCase() === 'global' ? 'global' : 'ignored'}">${esc(channel)}</span></td><td><code>${esc(command)}</code></td><td>${chatEventStatus(eventStatus)}</td><td>${esc(relation)}</td><td><span class="chat-safe-error">${esc(safeError)}</span></td></tr>`;
  }).join('') : empty(8, '暂无聊天领取安全审计');
}

const deliveryNotificationParameterGroups = {
  '玩家资料': ['玩家昵称','SteamID','会员等级','会员称号','会员到期','触发词后的内容'],
  '货币资产': ['商城币名','商城币','游戏美金','金条','声望点','复活币'],
  '在线与战绩': ['游戏时间','在线人数','今日在线秒','今日在线时间','累计在线秒','累计在线时间','击杀数','死亡数','KD'],
  '位置与任务': ['玩家坐标','玩家附近10米','玩家位置增高500Z','附近10米并增高500Z','领地旗坐标','最近领地旗','领地旗附近','预估在线奖励','回收进度'],
  '领取次数': ['成功后剩余总次数','成功后剩余每日次数'],
  '发货业务': ['{username}','{orderName}','{action}','{quantity}','{orderNo}']
};
const deliveryNotificationForm = $('#deliveryNotificationForm');
const deliveryNotificationParameterHelper = $('#notificationParameterHelper');
if (deliveryNotificationParameterHelper) {
  deliveryNotificationParameterHelper.innerHTML = Object.entries(deliveryNotificationParameterGroups).map(([group, parameters]) => `<section><b>${group}</b><div>${parameters.map((parameter) => `<button type="button" data-notification-parameter="${parameter}">${parameter.startsWith('{') ? parameter : `[${parameter}]`}</button>`).join('')}</div></section>`).join('');
  deliveryNotificationParameterHelper.addEventListener('click', (event) => {
    const button = event.target.closest('[data-notification-parameter]');
    if (!button) return;
    const textarea = deliveryNotificationForm.elements.notificationMessage;
    const parameter = button.dataset.notificationParameter;
    const value = parameter.startsWith('{') ? parameter : `[${parameter}]`;
    const start = textarea.selectionStart ?? textarea.value.length;
    textarea.setRangeText(value, start, textarea.selectionEnd ?? start, 'end');
    textarea.focus();
  });
}
deliveryNotificationForm?.addEventListener('submit', (event) => {
  event.preventDefault();
  const form = event.currentTarget.elements;
  const current = state.gameClaimNotificationFulfillment || {};
  const notificationMessage = form.notificationMessage.value.trim();
  withBusy(event.submitter, async () => {
    const saved = await api('/api/config', { method: 'PUT', body: JSON.stringify({ fulfillment: {
      notifyOnSuccess: form.notifyOnSuccess.checked,
      deliveryName: form.deliveryName.value.trim(),
      successMessage: current.successMessage || '{username}，{orderName} {action}，数量 {quantity}。',
      purchaseMessage: notificationMessage,
      giftMessage: notificationMessage,
      recycleMessage: notificationMessage,
      withdrawMessage: notificationMessage,
      bulkWithdrawMessage: notificationMessage
    } }) });
    renderDeliveryNotificationConfig(saved);
    toast('发货通知已保存');
  });
});

