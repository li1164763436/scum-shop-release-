function quoteIdentifier(value) {
  const identifier = String(value || '');
  if (!identifier || identifier.includes('`')) throw new Error(`非法数据库标识符: ${identifier}`);
  return `\`${identifier}\``;
}

async function tableExists(db, table) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name=? AND table_type=\'BASE TABLE\'', [table]);
  return Number(rows?.[0]?.count || 0) > 0;
}

async function normalizeTargetColumns(db) {
  if (await columnExists(db, TARGET_TABLE, '角色名称') && !(await columnExists(db, TARGET_TABLE, '游戏名称'))) {
    await db.query('ALTER TABLE `商城用户` RENAME COLUMN `角色名称` TO `游戏名称`');
  }
  for (const column of ['玩家名称', '是否游戏管理员']) {
    if (await columnExists(db, TARGET_TABLE, column)) await db.query(`ALTER TABLE \`商城用户\` DROP COLUMN ${quoteIdentifier(column)}`);
  }
}

async function viewExists(db, view) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.views WHERE table_schema=DATABASE() AND table_name=?', [view]);
  return Number(rows?.[0]?.count || 0) > 0;
}

async function scalarCount(db, sql, params = []) {
  const rows = await db.query(sql, params);
  return Number(rows?.[0]?.count || 0);
}

async function foreignKeyExists(db, table, constraint) {
  return (await scalarCount(db, 'SELECT COUNT(*) AS count FROM information_schema.referential_constraints WHERE constraint_schema=DATABASE() AND table_name=? AND constraint_name=?', [table, constraint])) > 0;
}

async function columnExists(db, table, column) {
  return (await scalarCount(db, 'SELECT COUNT(*) AS count FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name=? AND column_name=?', [table, column])) > 0;
}

