async function readSteamIdStorage(db) {
  const rows = await db.query("SELECT table_name AS tableName,character_set_name AS charset,collation_name AS collation FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name IN ('shop_users','player_accounts') AND column_name='steam_id' ORDER BY table_name");
  if (rows.length !== 2) throw new Error('账号表合并预检失败: 旧账号表缺少 steam_id 字段定义');
  const [first, second] = rows;
  if (!first.charset || !first.collation || first.charset !== second.charset || first.collation !== second.collation) {
    throw new Error('账号表合并预检失败: 两张旧账号表的 SteamID 字符集或排序规则不一致');
  }
  if (!/^[A-Za-z0-9_]+$/.test(first.charset) || !/^[A-Za-z0-9_]+$/.test(first.collation)) throw new Error('账号表合并预检失败: SteamID 字符集定义无效');
  return { charset: first.charset, collation: first.collation };
}

async function getState(db) {
  const rows = await db.query(`SELECT \`迁移阶段\` AS phase FROM \`${STATE_TABLE}\` WHERE \`迁移名称\`='账号物理表合并' LIMIT 1`);
  return rows?.[0]?.phase || null;
}

async function setState(db, phase, detail = null) {
  await db.query(`INSERT INTO \`${STATE_TABLE}\` (\`迁移名称\`,\`迁移阶段\`,\`迁移详情\`) VALUES ('账号物理表合并',?,?) ON DUPLICATE KEY UPDATE \`迁移阶段\`=VALUES(\`迁移阶段\`),\`迁移详情\`=VALUES(\`迁移详情\`),\`更新时间\`=CURRENT_TIMESTAMP(3)`, [phase, detail]);
}

async function recordError(db, error) {
  const detail = String(error?.message || error);
  const state = await getState(db);
  if (state) await db.query(`UPDATE \`${STATE_TABLE}\` SET \`迁移详情\`=?,\`更新时间\`=CURRENT_TIMESTAMP(3) WHERE \`迁移名称\`='账号物理表合并'`, [detail]);
  else await setState(db, '失败', detail);
}

async function createMigrationTables(db) {
  await db.query(`CREATE TABLE IF NOT EXISTS \`${STATE_TABLE}\` (\`迁移名称\` VARCHAR(64) PRIMARY KEY, \`迁移阶段\` VARCHAR(32) NOT NULL, \`迁移详情\` TEXT NULL, \`更新时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
  await db.query(`CREATE TABLE IF NOT EXISTS \`${FK_TABLE}\` (\`约束架构\` VARCHAR(64) NOT NULL, \`子表名称\` VARCHAR(64) NOT NULL, \`外键名称\` VARCHAR(64) NOT NULL, \`列序号\` INT UNSIGNED NOT NULL, \`子表列名\` VARCHAR(64) NOT NULL, \`原目标表\` VARCHAR(64) NOT NULL, \`原目标列\` VARCHAR(64) NOT NULL, \`删除规则\` VARCHAR(16) NOT NULL, \`更新规则\` VARCHAR(16) NOT NULL, \`是否已删除\` TINYINT(1) NOT NULL DEFAULT 0, \`是否已重建\` TINYINT(1) NOT NULL DEFAULT 0, PRIMARY KEY (\`约束架构\`,\`子表名称\`,\`外键名称\`,\`列序号\`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
}

function conflictValue(value) {
  if (value == null) return 'NULL';
  if (value instanceof Date) return value.toISOString();
  return String(value);
}

async function preflight(db) {
  const conflicts = [
    ['用户角色', 's.role', 'p.role', "p.role IS NOT NULL AND s.role<>p.role"],
    ['账户状态', 's.status', 'p.status', "p.status IS NOT NULL AND s.status<>p.status"],
    ['会员等级', 's.member_level', 'p.member_level', 's.member_level<>p.member_level'],
    ['会员到期时间', 's.member_expires_at', 'p.member_expires_at', 'NOT (s.member_expires_at <=> p.member_expires_at)']
  ];
  for (const [label, shopExpression, playerExpression, predicate] of conflicts) {
    const rows = await db.query(`SELECT s.steam_id AS steamId,${shopExpression} AS shopValue,${playerExpression} AS playerValue FROM shop_users s JOIN player_accounts p ON BINARY p.steam_id=BINARY s.steam_id WHERE s.steam_id IS NOT NULL AND ${predicate} ORDER BY s.steam_id LIMIT 21`);
    if (rows.length) {
      const details = rows.slice(0, 20).map(row => `${row.steamId}:${label}[商城=${conflictValue(row.shopValue)},玩家=${conflictValue(row.playerValue)}]`).join('; ');
      const suffix = rows.length > 20 ? '; 另有更多冲突' : '';
      throw new Error(`账号表合并预检失败: ${details}${suffix}`);
    }
  }
  const missing = await db.query('SELECT s.steam_id AS steamId FROM shop_users s LEFT JOIN player_accounts p ON BINARY p.steam_id=BINARY s.steam_id WHERE s.steam_id IS NOT NULL AND p.steam_id IS NULL ORDER BY s.steam_id LIMIT 21');
  if (missing.length) {
    const details = missing.slice(0, 20).map(row => row.steamId).join(',');
    const suffix = missing.length > 20 ? ',另有更多记录' : '';
    throw new Error(`账号表合并预检失败: 商城账号 SteamID 缺少玩家账号: ${details}${suffix}`);
  }
}

const WRITE_BARRIER_TRIGGERS = [
  ['账号合并锁_shop_users_insert', 'shop_users', 'INSERT'],
  ['账号合并锁_shop_users_update', 'shop_users', 'UPDATE'],
  ['账号合并锁_shop_users_delete', 'shop_users', 'DELETE'],
  ['账号合并锁_player_accounts_insert', 'player_accounts', 'INSERT'],
  ['账号合并锁_player_accounts_update', 'player_accounts', 'UPDATE'],
  ['账号合并锁_player_accounts_delete', 'player_accounts', 'DELETE']
];

async function installWriteBarrier(db) {
  for (const [name, table, event] of WRITE_BARRIER_TRIGGERS) {
    const exists = await scalarCount(db, 'SELECT COUNT(*) AS count FROM information_schema.triggers WHERE trigger_schema=DATABASE() AND trigger_name=?', [name]);
    if (!exists) await (db.rawQuery || db.query)(`CREATE TRIGGER ${quoteIdentifier(name)} BEFORE ${event} ON ${quoteIdentifier(table)} FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='账号表正在合并，暂时禁止写入'`);
  }
}

async function removeWriteBarrier(db) {
  for (const [name] of WRITE_BARRIER_TRIGGERS) await (db.rawQuery || db.query)(`DROP TRIGGER IF EXISTS ${quoteIdentifier(name)}`);
}

async function buildStagingTable(db, steamIdStorage) {
  await db.query(`DROP TABLE IF EXISTS \`${STAGING_TABLE}\``);
  const statement = accountTableStatement
    .replace('IF NOT EXISTS `商城用户`', `\`${STAGING_TABLE}\``)
    .replace('`SteamID` VARCHAR(17) NULL', `\`SteamID\` VARCHAR(17) CHARACTER SET ${steamIdStorage.charset} COLLATE ${steamIdStorage.collation} NULL`);
  await db.query(statement);
  await db.query(`INSERT INTO \`${STAGING_TABLE}\` (\`商城用户编号\`,\`SteamID\`,\`登录账号\`,\`登录账号规范值\`,\`密码哈希\`,\`密码盐\`,\`用户角色\`,\`管理员权限\`,\`管理员授权时间\`,\`账户状态\`,\`会员等级\`,\`会员到期时间\`,\`最后登录时间\`,\`游戏名称\`,\`游戏币\`,\`游戏金条\`,\`最后游戏在线时间\`,\`商城币余额\`,\`商城账户创建时间\`) SELECT s.id,s.steam_id,s.username,s.normalized,s.password_hash,s.password_salt,s.role,s.admin_permissions_json,s.admin_authorized_at,s.status,s.member_level,s.member_expires_at,s.last_login,p.character_name,p.game_money,p.game_gold,p.last_game_seen_at,COALESCE(p.balance,0),s.created_at FROM shop_users s LEFT JOIN player_accounts p ON p.steam_id=s.steam_id ORDER BY s.id`);
  await db.query(`INSERT INTO \`${STAGING_TABLE}\` (\`SteamID\`,\`用户角色\`,\`账户状态\`,\`会员等级\`,\`会员到期时间\`,\`游戏名称\`,\`游戏币\`,\`游戏金条\`,\`最后游戏在线时间\`,\`商城币余额\`) SELECT p.steam_id,COALESCE(p.role,'user'),COALESCE(p.status,'active'),p.member_level,p.member_expires_at,p.character_name,p.game_money,p.game_gold,p.last_game_seen_at,p.balance FROM player_accounts p LEFT JOIN shop_users s ON s.steam_id=p.steam_id WHERE s.id IS NULL ORDER BY p.steam_id`);
}

async function captureIncomingForeignKeys(db) {
  await db.query(`DELETE f FROM \`${FK_TABLE}\` f JOIN information_schema.REFERENTIAL_CONSTRAINTS r ON r.CONSTRAINT_SCHEMA=f.\`约束架构\` AND r.TABLE_NAME=f.\`子表名称\` AND r.CONSTRAINT_NAME=f.\`外键名称\` WHERE r.CONSTRAINT_SCHEMA=DATABASE()`);
  await db.query(`INSERT IGNORE INTO \`${FK_TABLE}\` (\`约束架构\`,\`子表名称\`,\`外键名称\`,\`列序号\`,\`子表列名\`,\`原目标表\`,\`原目标列\`,\`删除规则\`,\`更新规则\`) SELECT k.CONSTRAINT_SCHEMA,k.TABLE_NAME,k.CONSTRAINT_NAME,k.ORDINAL_POSITION,k.COLUMN_NAME,k.REFERENCED_TABLE_NAME,k.REFERENCED_COLUMN_NAME,r.DELETE_RULE,r.UPDATE_RULE FROM information_schema.KEY_COLUMN_USAGE k JOIN information_schema.REFERENTIAL_CONSTRAINTS r ON r.CONSTRAINT_SCHEMA=k.CONSTRAINT_SCHEMA AND r.TABLE_NAME=k.TABLE_NAME AND r.CONSTRAINT_NAME=k.CONSTRAINT_NAME WHERE k.CONSTRAINT_SCHEMA=DATABASE() AND k.REFERENCED_TABLE_NAME IN ('player_accounts','shop_users') AND k.TABLE_NAME NOT IN ('player_accounts','shop_users') ORDER BY k.TABLE_NAME,k.CONSTRAINT_NAME,k.ORDINAL_POSITION`);
}

async function groupedForeignKeys(db, condition) {
  const rows = await db.query(`SELECT \`子表名称\` AS childTable,\`外键名称\` AS constraintName,MIN(\`原目标表\`) AS targetTable,MIN(\`删除规则\`) AS deleteRule,MIN(\`更新规则\`) AS updateRule,GROUP_CONCAT(\`子表列名\` ORDER BY \`列序号\` SEPARATOR '\\n') AS childColumns,GROUP_CONCAT(\`原目标列\` ORDER BY \`列序号\` SEPARATOR '\\n') AS targetColumns FROM \`${FK_TABLE}\` WHERE ${condition} GROUP BY \`子表名称\`,\`外键名称\` ORDER BY \`子表名称\`,\`外键名称\``);
  return Array.isArray(rows) ? rows : [];
}

async function dropIncomingForeignKeys(db) {
  for (const fk of await groupedForeignKeys(db, '`是否已删除`=0')) {
    if (await foreignKeyExists(db, fk.childTable, fk.constraintName)) {
      await db.query(`ALTER TABLE ${quoteIdentifier(fk.childTable)} DROP FOREIGN KEY ${quoteIdentifier(fk.constraintName)}`);
    }
    await db.query(`UPDATE \`${FK_TABLE}\` SET \`是否已删除\`=1 WHERE \`子表名称\`=? AND \`外键名称\`=?`, [fk.childTable, fk.constraintName]);
  }
}

function mappedTargetColumn(fk) {
  const sourceColumns = String(fk.targetColumns).split('\n');
  if (sourceColumns.length !== 1) throw new Error(`不支持复合账号外键: ${fk.childTable}.${fk.constraintName}`);
  const source = `${fk.targetTable}.${sourceColumns[0]}`;
  if (source === 'player_accounts.steam_id' || source === 'shop_users.steam_id') return 'SteamID';
  if (source === 'shop_users.id') return '商城用户编号';
  throw new Error(`不支持的账号外键目标: ${fk.childTable}.${fk.constraintName} -> ${source}`);
}

async function validateIncomingForeignKeys(db) {
  for (const fk of await groupedForeignKeys(db, '1=1')) mappedTargetColumn(fk);
}

async function assertNoLegacyIncomingForeignKeys(db) {
  const count = await scalarCount(db, "SELECT COUNT(*) AS count FROM information_schema.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA=DATABASE() AND REFERENCED_TABLE_NAME IN ('player_accounts','shop_users') AND TABLE_NAME NOT IN ('player_accounts','shop_users')");
  if (count) throw new Error(`账号表合并无法继续: ${count} 个旧账号外键未纳入切换`);
}

async function recreateIncomingForeignKeys(db) {
  for (const fk of await groupedForeignKeys(db, '1=1')) {
    const childColumns = String(fk.childColumns).split('\n').map(quoteIdentifier).join(',');
    const targetColumn = mappedTargetColumn(fk);
    const deleteRule = fk.deleteRule === 'RESTRICT' ? '' : ` ON DELETE ${fk.deleteRule}`;
    const updateRule = fk.updateRule === 'RESTRICT' ? '' : ` ON UPDATE ${fk.updateRule}`;
    if (await foreignKeyExists(db, fk.childTable, fk.constraintName)) {
      const rows = await db.query(`SELECT k.REFERENCED_TABLE_NAME AS targetTable,GROUP_CONCAT(k.COLUMN_NAME ORDER BY k.ORDINAL_POSITION SEPARATOR '\n') AS childColumns,GROUP_CONCAT(k.REFERENCED_COLUMN_NAME ORDER BY k.ORDINAL_POSITION SEPARATOR '\n') AS targetColumns,MIN(r.DELETE_RULE) AS deleteRule,MIN(r.UPDATE_RULE) AS updateRule FROM information_schema.KEY_COLUMN_USAGE k JOIN information_schema.REFERENTIAL_CONSTRAINTS r ON r.CONSTRAINT_SCHEMA=k.CONSTRAINT_SCHEMA AND r.TABLE_NAME=k.TABLE_NAME AND r.CONSTRAINT_NAME=k.CONSTRAINT_NAME WHERE k.CONSTRAINT_SCHEMA=DATABASE() AND k.TABLE_NAME=? AND k.CONSTRAINT_NAME=? GROUP BY k.REFERENCED_TABLE_NAME`, [fk.childTable, fk.constraintName]);
      const actual = rows?.[0];
      if (!actual || actual.targetTable !== TARGET_TABLE || actual.childColumns !== fk.childColumns || actual.targetColumns !== targetColumn || actual.deleteRule !== fk.deleteRule || actual.updateRule !== fk.updateRule) throw new Error(`外键定义冲突: ${fk.childTable}.${fk.constraintName}`);
    } else {
      await db.query(`ALTER TABLE ${quoteIdentifier(fk.childTable)} ADD CONSTRAINT ${quoteIdentifier(fk.constraintName)} FOREIGN KEY (${childColumns}) REFERENCES \`${TARGET_TABLE}\` (${quoteIdentifier(targetColumn)})${deleteRule}${updateRule}`);
    }
    await db.query(`UPDATE \`${FK_TABLE}\` SET \`是否已重建\`=1 WHERE \`子表名称\`=? AND \`外键名称\`=?`, [fk.childTable, fk.constraintName]);
  }
}

