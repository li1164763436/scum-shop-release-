  ['位置是否当前有效', 'tinyint(1)', 'YES', null, 'TINYINT(1) NULL'],
  ['小队编号', 'varchar(100)', 'YES', null, 'VARCHAR(100) NULL'],
  ['小队名称', 'varchar(100)', 'YES', null, 'VARCHAR(100) NULL'],
  ['小队更新时间', 'datetime(3)', 'YES', null, 'DATETIME(3) NULL'],
  ['商城币余额', 'bigint', 'NO', '0', 'BIGINT NOT NULL DEFAULT 0'],
  ['商城账户创建时间', 'datetime(3)', 'YES', null, 'DATETIME(3) NULL']
];

async function ensureAccountIndex(db, name, columns) {
  const rows = await db.query('SELECT column_name AS columnName,non_unique AS nonUnique FROM information_schema.statistics WHERE table_schema=DATABASE() AND table_name=? AND index_name=? ORDER BY seq_in_index', [TARGET_TABLE, name]);
  if (!rows.length) {
    await db.query(`ALTER TABLE \`${TARGET_TABLE}\` ADD UNIQUE KEY ${quoteIdentifier(name)} (${columns.map(quoteIdentifier).join(',')})`);
    return;
  }
  if (rows.some(row => Number(row.nonUnique) !== 0) || rows.map(row => row.columnName).join('\n') !== columns.join('\n')) throw new Error(`账号表合并无法继续: 商城用户索引 ${name} 定义不一致`);
}

async function ensureAccountCheck(db, name, clause) {
  const rows = await db.query("SELECT c.check_clause AS checkClause FROM information_schema.check_constraints c JOIN information_schema.table_constraints t ON t.constraint_schema=c.constraint_schema AND t.constraint_name=c.constraint_name WHERE c.constraint_schema=DATABASE() AND t.table_name=? AND c.constraint_name=? AND t.constraint_type='CHECK'", [TARGET_TABLE, name]);
  if (!rows.length) {
    await db.query(`ALTER TABLE \`${TARGET_TABLE}\` ADD CONSTRAINT ${quoteIdentifier(name)} CHECK (${clause})`);
    return;
  }
}

async function validateAccountPrimaryKey(db) {
  const rows = await db.query("SELECT column_name AS columnName FROM information_schema.statistics WHERE table_schema=DATABASE() AND table_name=? AND index_name='PRIMARY' ORDER BY seq_in_index", [TARGET_TABLE]);
  if (rows.map(row => row.columnName).join('\n') !== '商城用户编号') throw new Error('账号表合并无法继续: 商城用户主键定义不一致');
}

async function validateTargetLayout(db) {
  for (const [column, type, nullable, defaultValue, definition, core] of accountColumnContract) {
    const rows = await db.query('SELECT column_type AS columnType,is_nullable AS nullable,column_default AS defaultValue,extra AS extraValue FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name=? AND column_name=?', [TARGET_TABLE, column]);
    if (!rows.length) {
      if (core) throw new Error(`账号表合并无法继续: 商城用户缺少核心字段 ${column}`);
      await db.query(`ALTER TABLE \`${TARGET_TABLE}\` ADD COLUMN ${quoteIdentifier(column)} ${definition}`);
      continue;
    }
    const actual = rows[0];
    if (String(actual.columnType).toLowerCase() !== type || actual.nullable !== nullable || String(actual.defaultValue) !== String(defaultValue)) throw new Error(`账号表合并无法继续: 商城用户字段 ${column} 定义不一致`);
    const shouldBeInvisible = / INVISIBLE$/.test(definition);
    const isInvisible = /invisible/i.test(String(actual.extraValue || ''));
    if (shouldBeInvisible !== isInvisible) await db.query(`ALTER TABLE \`${TARGET_TABLE}\` MODIFY COLUMN ${quoteIdentifier(column)} ${definition}`);
    if (column === '商城用户编号' && !/auto_increment/i.test(String(actual.extraValue || ''))) throw new Error('账号表合并无法继续: 商城用户编号不是自增字段');
  }
  await validateAccountPrimaryKey(db);
  await ensureAccountIndex(db, 'uk_商城用户_SteamID', ['SteamID']);
  await ensureAccountIndex(db, 'uk_商城用户_登录账号规范值', ['登录账号规范值']);
  await ensureAccountCheck(db, 'chk_商城用户_登录凭据完整', '(`登录账号` IS NULL AND `登录账号规范值` IS NULL AND `密码哈希` IS NULL AND `密码盐` IS NULL) OR (`登录账号` IS NOT NULL AND `登录账号规范值` IS NOT NULL AND `密码哈希` IS NOT NULL AND `密码盐` IS NOT NULL)');
  await ensureAccountCheck(db, 'chk_商城用户_商城币余额', '`商城币余额` >= 0');
  await ensureAccountCheck(db, 'chk_商城用户_身份存在', '`SteamID` IS NOT NULL OR `登录账号` IS NOT NULL');
}

async function validateCompletedLayout(db) {
  await validateTargetLayout(db);
  if (!(await tableExists(db, FK_TABLE))) return;
  const pendingForeignKeys = await scalarCount(db, `SELECT COUNT(*) AS count FROM \`${FK_TABLE}\` WHERE \`是否已删除\`=1 AND \`是否已重建\`=0`);
  if (pendingForeignKeys) throw new Error(`账号表合并无法继续: ${pendingForeignKeys} 个外键尚未重建`);
}

async function validateMerge(db, playerSource, shopSource, targetTable = TARGET_TABLE) {
  const target = quoteIdentifier(targetTable);
  const expectedRows = await scalarCount(db, `SELECT COUNT(*) AS count FROM (SELECT id FROM ${quoteIdentifier(shopSource)} UNION ALL SELECT p.steam_id FROM ${quoteIdentifier(playerSource)} p LEFT JOIN ${quoteIdentifier(shopSource)} s ON s.steam_id=p.steam_id WHERE s.id IS NULL) merged`);
  const actualRows = await scalarCount(db, `SELECT COUNT(*) AS count FROM ${target}`);
  if (actualRows !== expectedRows) throw new Error(`账号表合并校验失败: 行数 ${actualRows}/${expectedRows}`);
  const idMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM ${quoteIdentifier(shopSource)} s LEFT JOIN ${target} u ON u.\`商城用户编号\`=s.id WHERE u.\`商城用户编号\` IS NULL`);
  if (idMismatch) throw new Error(`账号表合并校验失败: ${idMismatch} 个商城用户编号未保留`);
  const steamMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM ${quoteIdentifier(playerSource)} p LEFT JOIN ${target} u ON u.\`SteamID\`=p.steam_id WHERE u.\`SteamID\` IS NULL`);
  if (steamMismatch) throw new Error(`账号表合并校验失败: ${steamMismatch} 个 SteamID 未保留`);
  const shopMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM ${quoteIdentifier(shopSource)} s JOIN ${target} u ON u.\`商城用户编号\`=s.id WHERE NOT (BINARY u.\`SteamID\`<=>BINARY s.steam_id) OR NOT (BINARY u.\`登录账号\`<=>BINARY s.username) OR NOT (BINARY u.\`登录账号规范值\`<=>BINARY s.normalized) OR NOT (BINARY u.\`密码哈希\`<=>BINARY s.password_hash) OR NOT (BINARY u.\`密码盐\`<=>BINARY s.password_salt) OR NOT (BINARY u.\`用户角色\`<=>BINARY s.role) OR NOT (BINARY u.\`管理员权限\`<=>BINARY s.admin_permissions_json) OR NOT (u.\`管理员授权时间\`<=>s.admin_authorized_at) OR NOT (BINARY u.\`账户状态\`<=>BINARY s.status) OR NOT (u.\`会员等级\`<=>s.member_level) OR NOT (u.\`会员到期时间\`<=>s.member_expires_at) OR NOT (u.\`最后登录时间\`<=>s.last_login) OR NOT (u.\`商城账户创建时间\`<=>s.created_at)`);
  if (shopMismatch) throw new Error(`账号表合并校验失败: ${shopMismatch} 个商城登录账户字段不一致`);
  const playerMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM ${quoteIdentifier(playerSource)} p LEFT JOIN ${quoteIdentifier(shopSource)} s ON s.steam_id=p.steam_id JOIN ${target} u ON u.\`SteamID\`=p.steam_id WHERE NOT (BINARY u.\`用户角色\`<=>BINARY CASE WHEN s.id IS NULL THEN COALESCE(p.role,'user') ELSE s.role END) OR NOT (BINARY u.\`账户状态\`<=>BINARY CASE WHEN s.id IS NULL THEN COALESCE(p.status,'active') ELSE s.status END) OR NOT (u.\`会员等级\`<=>CASE WHEN s.id IS NULL THEN p.member_level ELSE s.member_level END) OR NOT (u.\`会员到期时间\`<=>CASE WHEN s.id IS NULL THEN p.member_expires_at ELSE s.member_expires_at END) OR NOT (BINARY u.\`游戏名称\`<=>BINARY p.character_name) OR NOT (u.\`游戏币\`<=>p.game_money) OR NOT (u.\`游戏金条\`<=>p.game_gold) OR NOT (u.\`最后游戏在线时间\`<=>p.last_game_seen_at) OR NOT (u.\`商城币余额\`<=>p.balance)`);
  if (playerMismatch) throw new Error(`账号表合并校验失败: ${playerMismatch} 个玩家账户字段不一致`);
}

async function validateFinalizeCoverage(db) {
  const idMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM \`${SHOP_BACKUP}\` s LEFT JOIN \`${TARGET_TABLE}\` u ON u.\`商城用户编号\`=s.id WHERE u.\`商城用户编号\` IS NULL`);
  if (idMismatch) throw new Error(`账号表合并无法收尾: ${idMismatch} 个商城用户编号未保留`);
  const steamMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM \`${PLAYER_BACKUP}\` p LEFT JOIN \`${TARGET_TABLE}\` u ON BINARY u.\`SteamID\`=BINARY p.steam_id WHERE u.\`SteamID\` IS NULL`);
  if (steamMismatch) throw new Error(`账号表合并无法收尾: ${steamMismatch} 个 SteamID 未保留`);
  const shopMismatch = await scalarCount(db, `SELECT COUNT(*) AS count FROM \`${SHOP_BACKUP}\` s JOIN \`${TARGET_TABLE}\` u ON u.\`商城用户编号\`=s.id WHERE (s.steam_id IS NOT NULL AND NOT (BINARY u.\`SteamID\`<=>BINARY s.steam_id)) OR (s.username IS NOT NULL AND NOT (BINARY u.\`登录账号\`<=>BINARY s.username)) OR (s.normalized IS NOT NULL AND NOT (BINARY u.\`登录账号规范值\`<=>BINARY s.normalized))`);
  if (shopMismatch) throw new Error(`账号表合并无法收尾: ${shopMismatch} 个商城登录身份绑定不一致`);
}

async function recoverOrMigrate(db) {
  const target = await tableExists(db, TARGET_TABLE);
  const players = await tableExists(db, 'player_accounts');
  const shops = await tableExists(db, 'shop_users');
  const playerBackup = await tableExists(db, PLAYER_BACKUP);
  const shopBackup = await tableExists(db, SHOP_BACKUP);

  if (target && !players && !shops) {
    if (playerBackup !== shopBackup) throw new Error('账号表合并无法继续: 账号备份表不完整');
    if (!playerBackup) {
      await validateCompletedLayout(db);
      return;
    }
    if ((await getState(db)) !== '已完成') {
      await recreateIncomingForeignKeys(db);
      await validateCompletedLayout(db);
      await removeWriteBarrier(db);
      await setState(db, '已完成');
    } else {
      await validateCompletedLayout(db);
    }
    return;
  }
  if (!players && !shops && !playerBackup && !shopBackup) return;
  if (!players || !shops) throw new Error('账号表合并无法继续: player_accounts 与 shop_users 必须同时存在');
  if (target || playerBackup || shopBackup) throw new Error('账号表合并无法继续: 检测到不完整的目标表或备份表');

  await setState(db, '预检中');
  await ensureLegacySourceColumns(db);
  const steamIdStorage = await readSteamIdStorage(db);
  await preflight(db);
  if (await viewExists(db, TARGET_TABLE)) await db.query(`DROP VIEW \`${TARGET_TABLE}\``);
  await setState(db, '复制中');
  await installWriteBarrier(db);
  await buildStagingTable(db, steamIdStorage);
  await captureIncomingForeignKeys(db);
  await validateIncomingForeignKeys(db);
  await setState(db, '切换中');
  await dropIncomingForeignKeys(db);
  await assertNoLegacyIncomingForeignKeys(db);
  await validateMerge(db, 'player_accounts', 'shop_users', STAGING_TABLE);
  await db.query(`RENAME TABLE \`player_accounts\` TO \`${PLAYER_BACKUP}\`, \`shop_users\` TO \`${SHOP_BACKUP}\`, \`${STAGING_TABLE}\` TO \`${TARGET_TABLE}\``);
  await setState(db, '重建外键中');
  await recreateIncomingForeignKeys(db);
  await validateCompletedLayout(db);
  await removeWriteBarrier(db);
  await setState(db, '已完成');
}

async function inspectLayout(db) {
  const [target, players, shops, playerBackup, shopBackup, staging] = await Promise.all([
    tableExists(db, TARGET_TABLE),
    tableExists(db, 'player_accounts'),
    tableExists(db, 'shop_users'),
    tableExists(db, PLAYER_BACKUP),
    tableExists(db, SHOP_BACKUP),
    tableExists(db, STAGING_TABLE)
  ]);
  return { target, players, shops, playerBackup, shopBackup, staging };
}

async function migrateOnConnection(db) {
  const lockRows = await db.query('SELECT GET_LOCK(?, 60) AS acquired', [LOCK_NAME]);
  if (Number(lockRows?.[0]?.acquired) !== 1) throw new Error('账号表合并迁移锁获取超时');
  try {
    const layout = await inspectLayout(db);
    if (layout.target) await normalizeTargetColumns(db);
    if (!layout.players && !layout.shops && !layout.playerBackup && !layout.shopBackup && !layout.staging) {
      if (layout.target) await validateTargetLayout(db);
      return;
    }
    await createMigrationTables(db);
    await recoverOrMigrate(db);
  } catch (error) {
    try { if (await tableExists(db, STATE_TABLE)) await recordError(db, error); } catch {}
    throw error;
  } finally {
    await db.query('SELECT RELEASE_LOCK(?) AS released', [LOCK_NAME]);
  }
}

async function finalizeOnConnection(db) {
  const lockRows = await db.query('SELECT GET_LOCK(?, 60) AS acquired', [LOCK_NAME]);
  if (Number(lockRows?.[0]?.acquired) !== 1) throw new Error('账号表合并收尾锁获取超时');
  try {
    const layout = await inspectLayout(db);
    if (!layout.target || layout.players || layout.shops || layout.staging) throw new Error('账号表合并尚未处于可收尾状态');
    if (layout.playerBackup !== layout.shopBackup) throw new Error('账号表合并无法收尾: 账号备份表不完整');
    await validateTargetLayout(db);
    if (layout.playerBackup) {
      if (!(await tableExists(db, STATE_TABLE)) || (await getState(db)) !== '已完成') throw new Error('账号表合并无法收尾: 迁移状态不是已完成');
      await validateCompletedLayout(db);
      await validateFinalizeCoverage(db);
      const externalReferences = await scalarCount(db, `SELECT COUNT(*) AS count FROM information_schema.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA=DATABASE() AND REFERENCED_TABLE_NAME IN (?,?) AND TABLE_NAME NOT IN (?,?)`, [PLAYER_BACKUP, SHOP_BACKUP, PLAYER_BACKUP, SHOP_BACKUP]);
      if (externalReferences) throw new Error(`账号表合并无法收尾: ${externalReferences} 个业务外键仍指向备份表`);
    }
    await removeWriteBarrier(db);
    await db.query(`DROP TABLE IF EXISTS \`${SHOP_BACKUP}\`,\`${PLAYER_BACKUP}\`,\`${FK_TABLE}\`,\`${STATE_TABLE}\``);
    return { finalized: true };
  } finally {
    await db.query('SELECT RELEASE_LOCK(?) AS released', [LOCK_NAME]);
  }
}

async function migrateAccountSchema(db) {
  if (typeof db.withConnection === 'function') return db.withConnection(session => migrateOnConnection(session));
  return migrateOnConnection(db);
}

async function finalizeAccountSchemaMigration(db) {
  if (typeof db.withConnection === 'function') return db.withConnection(session => finalizeOnConnection(session));
  return finalizeOnConnection(db);
}

