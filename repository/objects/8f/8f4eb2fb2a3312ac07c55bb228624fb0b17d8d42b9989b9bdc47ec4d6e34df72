function createTeleportMarkerIcon(type, className = 'teleport-marker-icon') {
  const icon = document.createElement('span');
  icon.className = `${className} ${className}-${type}`;
  icon.innerHTML = teleportMarkerIcons[type] || '';
  return icon;
}

function visibleTeleportMarkers() {
  if (!teleportMapData) return [];
  const visible = [];
  if (teleportElement('#teleportLayerVehicles')?.checked !== false) {
    (teleportMapData.vehicles || []).forEach((marker) => visible.push({ marker, type:'vehicle' }));
  }
  if (teleportElement('#teleportLayerPlayer')?.checked === true && teleportMapData.player) {
    visible.push({ marker:teleportMapData.player, type:'player' });
  }
  if (teleportElement('#teleportLayerTeammates')?.checked === true) {
    (teleportMapData.teammates || []).forEach((marker) => visible.push({ marker, type:'teammate' }));
  }
  if (teleportElement('#teleportLayerFlags')?.checked === true) {
    (teleportMapData.flags || []).forEach((marker) => visible.push({ marker, type:'flag' }));
  }
  if (teleportElement('#teleportLayerFixedLocations')?.checked === true) {
    (teleportMapData.fixedLocations || []).forEach((marker) => visible.push({ marker, type:'fixed' }));
  }
  return visible.filter(({ marker }) => Number.isFinite(Number(marker.xPercent)) && Number.isFinite(Number(marker.yPercent)));
}

function teleportMarkerScreenSize(scale) {
  return Math.round(Math.min(46, 26 + Math.max(0, scale - 1) * 3));
}

function layoutTeleportMarkers(items, mapSize, scale) {
  const collisionDistance = teleportMarkerScreenSize(scale) + 14;
  const canvasSize = mapSize * scale;
  const records = items.map((item, index) => ({
    ...item,
    index,
    baseX:Number(item.marker.xPercent) * canvasSize / 100,
    baseY:Number(item.marker.yPercent) * canvasSize / 100
  }));
  const groups = [];
  const assigned = new Set();
  records.forEach((record, start) => {
    if (assigned.has(start)) return;
    const indexes = [start];
    assigned.add(start);
    for (let cursor = 0; cursor < indexes.length; cursor += 1) {
      records.forEach((candidate, index) => {
        if (!assigned.has(index) && Math.hypot(records[indexes[cursor]].baseX - candidate.baseX, records[indexes[cursor]].baseY - candidate.baseY) < collisionDistance) {
          assigned.add(index);
          indexes.push(index);
        }
      });
    }
    groups.push(indexes.map((index) => records[index]));
  });

  const placed = [];
  const result = new Array(items.length);
  const commit = (record, x, y) => {
    placed.push({ x, y });
    const offsetX = (x - record.baseX) / scale;
    const offsetY = (y - record.baseY) / scale;
    result[record.index] = { marker:record.marker, type:record.type, offset:{
      x:offsetX,
      y:offsetY,
      distance:Math.hypot(offsetX, offsetY),
      angle:Math.atan2(offsetY, offsetX) * 180 / Math.PI
    } };
  };
  const available = (x, y) => x >= collisionDistance / 2 && y >= collisionDistance / 2
    && x <= canvasSize - collisionDistance / 2 && y <= canvasSize - collisionDistance / 2
    && placed.every((position) => Math.hypot(position.x - x, position.y - y) >= collisionDistance);

  groups.filter((group) => group.length === 1).forEach(([record]) => commit(record, record.baseX, record.baseY));
  groups.filter((group) => group.length > 1).sort((left, right) => right.length - left.length).forEach((group) => {
    const centerX = group.reduce((sum, record) => sum + record.baseX, 0) / group.length;
    const centerY = group.reduce((sum, record) => sum + record.baseY, 0) / group.length;
    const ordered = group.map((record) => ({
      record,
      sourceAngle:Math.atan2(record.baseY - centerY, record.baseX - centerX),
      sourceDistance:Math.hypot(record.baseX - centerX, record.baseY - centerY)
    })).sort((left, right) => left.sourceDistance - right.sourceDistance || left.sourceAngle - right.sourceAngle || String(left.record.marker.id).localeCompare(String(right.record.marker.id)));
    ordered.forEach((entry, index) => {
      if (available(entry.record.baseX, entry.record.baseY)) {
        commit(entry.record, entry.record.baseX, entry.record.baseY);
        return;
      }
      const preferredAngle = entry.sourceDistance > 1
        ? entry.sourceAngle
        : -Math.PI / 2 + Math.PI * 2 * index / ordered.length;
      const angleSteps = [0, -1, 1, -2, 2, -3, 3, 4];
      let selected = null;
      for (let ring = 1; ring <= 8 && !selected; ring += 1) {
        const radius = collisionDistance * (.55 + ring * .45);
        for (const step of angleSteps) {
          const angle = preferredAngle + step * Math.PI / 12;
          const x = entry.record.baseX + Math.cos(angle) * radius;
          const y = entry.record.baseY + Math.sin(angle) * radius;
          if (available(x, y)) {
            selected = { x, y };
            break;
          }
        }
      }
      if (!selected) {
        for (let ring = 2; ring <= 12 && !selected; ring += 1) {
          const radius = collisionDistance * ring;
          for (let step = 0; step < 24; step += 1) {
            const angle = preferredAngle + step * Math.PI / 12;
            const x = entry.record.baseX + Math.cos(angle) * radius;
            const y = entry.record.baseY + Math.sin(angle) * radius;
            if (available(x, y)) {
              selected = { x, y };
              break;
            }
          }
        }
      }
      commit(entry.record, selected?.x ?? entry.record.baseX, selected?.y ?? entry.record.baseY);
    });
  });
  return result;
}

function teleportVehicleMapDestination(marker, type) {
  if (teleportMode !== 'vehicle' || !teleportElement('#teleportTargetId')?.value) return null;
  if (type === 'player') return { id:'player:self', name:'本人当前位置', targetType:'vehicle_to_player' };
  if (type === 'teammate' && marker.online === true) {
    const player = (teleportActionData?.targets?.onlinePlayers || []).find((item) => item.id === marker.id);
    return player ? { ...player, targetType:'vehicle_to_player' } : null;
  }
  if (type === 'flag') {
    const flag = (teleportActionData?.targets?.territoryFlags || []).find((item) => item.id === marker.id);
    return flag ? { ...flag, targetType:'vehicle_to_territory_flag' } : null;
  }
  if (type === 'fixed') {
    const location = (teleportActionData?.targets?.fixedLocations || []).find((item) => item.id === marker.id);
    return location ? { ...location, targetType:'vehicle_to_fixed_location' } : null;
  }
  return null;
}

function appendTeleportMarker(container, marker, type, offset) {
  const element = document.createElement('button');
  element.type = 'button';
  const edgeClass = Number(marker.xPercent) < 8 ? ' edge-left' : Number(marker.xPercent) > 92 ? ' edge-right' : '';
  const targetType = teleportTargetTypeForMarker(type);
  const destination = teleportVehicleMapDestination(marker, type);
  const source = teleportMode === 'vehicle' && type === 'vehicle'
    ? (teleportActionData?.targets?.realtimeVehicles || []).find((item) => item.id === marker.id)
    : null;
  const authorized = destination || source || teleportAuthorizedTarget(targetType, marker.id);
  const selected = destination
    ? teleportElement('#teleportDestinationId')?.value === destination.id
    : authorized && teleportElement('#teleportTargetId')?.value === authorized.id;
  element.className = `teleport-marker teleport-marker-${type}${marker.stale ? ' stale' : ''}${offset.distance ? ' displaced' : ''}${authorized ? ' selectable' : ' unavailable-target'}${selected ? ' selected' : ''}${edgeClass}`;
  element.style.setProperty('--marker-x', `${marker.xPercent}%`);
  element.style.setProperty('--marker-y', `${marker.yPercent}%`);
  element.style.setProperty('--marker-offset-x', `${offset.x}px`);
  element.style.setProperty('--marker-offset-y', `${offset.y}px`);
  const screenSize = teleportMarkerScreenSize(teleportMapScale);
  element.style.setProperty('--marker-label-offset-y', `${(screenSize / 2 + 12) / teleportMapScale}px`);
  element.style.setProperty('--marker-leader-length', `${offset.distance}px`);
  element.style.setProperty('--marker-leader-angle', `${offset.angle}deg`);
  element.style.setProperty('--marker-line-width', `${2 / teleportMapScale}px`);
  element.style.setProperty('--marker-visual-scale', String(screenSize / 42 / teleportMapScale));
  element.style.setProperty('--marker-label-scale', String(1 / teleportMapScale));
  element.setAttribute('aria-label', teleportMarkerTitle(marker));
  element.title = teleportMarkerTitle(marker);
  element.dataset.teleportMarker = marker.id;
  element.setAttribute('aria-expanded', 'false');
  element.addEventListener('click', () => {
    const show = !element.classList.contains('show-label');
    teleportPage()?.querySelectorAll('.teleport-marker.show-label').forEach((item) => {
      item.classList.remove('show-label');
      item.setAttribute('aria-expanded', 'false');
    });
    teleportPage()?.querySelectorAll('.teleport-marker-anchor.highlighted').forEach((item) => item.classList.remove('highlighted'));
    element.classList.toggle('show-label', show);
    element.setAttribute('aria-expanded', String(show));
    if (show) [...(teleportPage()?.querySelectorAll('.teleport-marker-anchor') || [])]
      .find((item) => item.dataset.markerId === String(marker.id))?.classList.add('highlighted');
    if (destination) selectTeleportMapDestination(marker, type);
    else if (authorized) selectTeleportMapTarget(marker, type);
  });
  const icon = createTeleportMarkerIcon(type);
  const label = document.createElement('small');
  label.className = 'teleport-marker-name';
  label.textContent = marker.name || marker.gridCode || '未命名目标';
  element.append(icon, label);
  container.append(element);
}

function appendTeleportMarkerAnchor(container, marker, type, displaced) {
  const anchor = document.createElement('span');
  anchor.className = `teleport-marker-anchor teleport-marker-anchor-${type}${marker.stale ? ' stale' : ''}${displaced ? ' displaced' : ''}`;
  anchor.style.setProperty('--marker-x', `${marker.xPercent}%`);
  anchor.style.setProperty('--marker-y', `${marker.yPercent}%`);
  anchor.style.setProperty('--marker-anchor-scale', String(1 / teleportMapScale));
  anchor.dataset.markerId = String(marker.id);
  anchor.setAttribute('aria-hidden', 'true');
  container.append(anchor);
}

function renderTeleportMarkers() {
  const markers = teleportElement('#teleportMapMarkers');
  if (!markers) return;
  markers.replaceChildren();
  syncTeleportLayerAvailability();
  const mapSize = teleportElement('#teleportMapFrame')?.clientWidth || 800;
  const layout = layoutTeleportMarkers(visibleTeleportMarkers(), mapSize, teleportMapScale);
  layout.forEach(({ marker, type, offset }) => appendTeleportMarker(markers, marker, type, offset));
  layout.forEach(({ marker, type, offset }) => appendTeleportMarkerAnchor(markers, marker, type, offset.distance > 0));
}

function renderTeleportMapStatus(error = null) {
  const status = teleportElement('#teleportMapStatus');
  const warning = teleportElement('#teleportMapWarning');
  if (!status || !warning) return;
  status.classList.toggle('error', Boolean(error));
  if (error) {
    status.textContent = error;
    warning.hidden = true;
    return;
  }
  if (!state.user) {
    status.textContent = '登录后读取本人、小队与载具位置';
    warning.hidden = true;
    return;
  }
  if (!teleportMapData) {
    status.textContent = '正在读取本人位置数据…';
    warning.hidden = true;
    return;
  }
  const vehicles = teleportMapData.vehicles || [];
  const flags = teleportMapData.flags || [];
  const fixedLocations = teleportMapData.fixedLocations || [];
  const teammates = teleportMapData.teammates || [];
  const onlineTeammates = teammates.filter((item) => item.online === true).length;
  const onlineVehicles = vehicles.filter((item) => item.online === true).length;
  const teammateVehicles = vehicles.filter((item) => item.ownership === 'teammate').length;
  const capabilities = teleportMapData.capabilities || {};
  const playerState = teleportMapData.player
    ? `本人${teleportMapData.player.online === true ? '在线' : '离线'}位置`
    : '本人暂无位置';
  const teammateState = capabilities.teammateLocation === true
    ? `队友位置 ${teammates.length} 个（在线 ${onlineTeammates}）`
    : `队友位置采集离线 · 保留上次位置 ${teammates.length} 个`;
  const flagState = capabilities.flagLocation === true ? `领地旗 ${flags.length} 面` : `领地旗采集离线 · 保留 ${flags.length} 面`;
  const generated = teleportObservedLabel(teleportMapData.generatedAt).replace('更新于 ', '数据生成于 ');
  status.textContent = `${playerState} · ${teammateState} · 载具 ${vehicles.length} 台（在线 ${onlineVehicles}，队友 ${teammateVehicles}） · ${flagState} · 固定位置 ${fixedLocations.length} 个 · ${generated}`;
  warning.textContent = teleportMapData.calibration?.warning || '';
  warning.hidden = !warning.textContent;
}

async function loadTeleportMapData({ force = false } = {}) {
  if (!state.user) {
    teleportMapData = null;
    renderTeleportMarkers();
    renderTeleportMapStatus();
    return null;
  }
  if (!teleportActionData) loadTeleportActionData().catch(() => {});
  if (teleportMapLoading) return teleportMapLoading;
  renderTeleportMapStatus();
  teleportMapLoading = api('/api/shop/teleport/map')
    .then((data) => {
      teleportMapData = data;
      renderTeleportMarkers();
      renderTeleportMapStatus();
      return data;
    })
    .catch((error) => {
      if (teleportMapData) {
        const offlineMarker = (marker) => ({ ...marker, online:false, stale:true });
        teleportMapData = {
          ...teleportMapData,
          player:teleportMapData.player ? offlineMarker(teleportMapData.player) : null,
          teammates:(teleportMapData.teammates || []).map(offlineMarker),
          vehicles:(teleportMapData.vehicles || []).map(offlineMarker),
          flags:(teleportMapData.flags || []).map(offlineMarker),
          fixedLocations:teleportMapData.fixedLocations || [],
          capabilities:{ playerLocation:false, teammateLocation:false, vehicleLocation:false, flagLocation:false }
        };
        renderTeleportMarkers();
      }
      if (error.status !== 401) renderTeleportMapStatus(`${chineseErrorMessage(error.message, '位置数据读取失败，请稍后重试')} · 已保留最后位置`);
      throw error;
    })
    .finally(() => { teleportMapLoading = null; });
  return teleportMapLoading;
}

function loadTeleportPage() {
  const root = teleportPage();
  if (!root || root.dataset.teleportReady) return;
  const frame = root.querySelector('#teleportMapFrame');
  const canvas = root.querySelector('#teleportMapCanvas');
  const grid = root.querySelector('#teleportMapGrid');
  const markers = root.querySelector('#teleportMapMarkers');
  const image = root.querySelector('#teleportMapImage');
  const range = root.querySelector('#teleportZoomRange');
  const zoomValue = root.querySelector('#teleportZoomValue');
  const zoomOut = root.querySelector('#teleportZoomOut');
  const zoomIn = root.querySelector('#teleportZoomIn');
  const zoomReset = root.querySelector('#teleportZoomReset');
  const refresh = root.querySelector('#teleportMapRefresh');
  const vehicleLayer = root.querySelector('#teleportLayerVehicles');
  const playerLayer = root.querySelector('#teleportLayerPlayer');
  const teammateLayer = root.querySelector('#teleportLayerTeammates');
  const flagLayer = root.querySelector('#teleportLayerFlags');
  const fixedLayer = root.querySelector('#teleportLayerFixedLocations');
  const gridLayer = root.querySelector('#teleportLayerGrid');
  const actionForm = root.querySelector('#teleportActionForm');
  const actionType = root.querySelector('#teleportTargetType');
  const actionTarget = root.querySelector('#teleportTargetId');
  const actionExecute = root.querySelector('#teleportExecute');
  const actionRefresh = root.querySelector('#teleportActionRefresh');
  const actionClear = root.querySelector('#teleportClearTarget');
  const destinationClear = root.querySelector('#teleportClearDestination');
  const modeButtons = [...root.querySelectorAll('[data-teleport-mode]')];
  const destinationId = root.querySelector('#teleportDestinationId');
  const receiptModal = document.querySelector('#teleportReceiptModal');
  const receiptTitle = document.querySelector('#teleportReceiptTitle');
  const receiptStatus = document.querySelector('#teleportReceiptStatus');
  const receiptDetails = document.querySelector('#teleportReceiptDetails');
  const receiptWarning = document.querySelector('#teleportReceiptWarning');
  const receiptConfirm = document.querySelector('#teleportReceiptConfirm');
  const receiptCancel = document.querySelector('#teleportReceiptCancel');
  const receiptDone = document.querySelector('#teleportReceiptDone');
  if (![frame, canvas, grid, markers, image, range, zoomValue, zoomOut, zoomIn, zoomReset, refresh, vehicleLayer, playerLayer, teammateLayer, flagLayer, fixedLayer, gridLayer, actionForm, actionType, actionTarget, actionExecute, actionRefresh, actionClear, destinationClear, destinationId, receiptModal, receiptTitle, receiptStatus, receiptDetails, receiptWarning, receiptConfirm, receiptCancel, receiptDone].every(Boolean) || modeButtons.length !== 2) return;

  root.querySelectorAll('[data-teleport-icon]').forEach((slot) => {
    slot.replaceChildren(createTeleportMarkerIcon(slot.dataset.teleportIcon, 'teleport-layer-icon'));
  });

  grid.innerHTML = teleportGridRows.flatMap((row, rowIndex) =>
    teleportGridColumns.map((column, columnIndex) =>
      `<span class="teleport-grid-label" style="--grid-row:${rowIndex};--grid-column:${columnIndex}">${row}${column}</span>`
    )
  ).join('');

  let scale = 1;
  let panX = 0;
  let panY = 0;
  let dragState = null;

  const clampPan = () => {
    if (scale <= 1) {
      panX = 0;
      panY = 0;
      return;
    }
    const maxX = frame.clientWidth * (scale - 1) / 2;
    const maxY = frame.clientHeight * (scale - 1) / 2;
    panX = Math.min(maxX, Math.max(-maxX, panX));
    panY = Math.min(maxY, Math.max(-maxY, panY));
  };
  const applyTransform = () => {
    clampPan();
    canvas.style.transform = `translate(${panX}px,${panY}px) scale(${scale})`;
    range.value = String(scale * 100);
    zoomValue.textContent = `${Math.round(scale * 100)}%`;
    zoomOut.disabled = scale <= 1;
    zoomIn.disabled = scale >= 8;
    frame.classList.toggle('zoomed', scale > 1);
  };
  const setScale = (nextScale, pointer) => {
    const previousScale = scale;
    const next = Math.min(8, Math.max(1, Math.round(nextScale * 4) / 4));
    if (pointer && next !== previousScale) {
      const bounds = frame.getBoundingClientRect();
      const offsetX = pointer.x - bounds.left - bounds.width / 2;
      const offsetY = pointer.y - bounds.top - bounds.height / 2;
      const ratio = next / previousScale;
      panX = offsetX - (offsetX - panX) * ratio;
      panY = offsetY - (offsetY - panY) * ratio;
    }
    scale = next;
    teleportMapScale = scale;
    applyTransform();
    if (next !== previousScale) renderTeleportMarkers();
  };
  const resetScale = () => {
    const changed = scale !== 1;
    scale = 1;
    teleportMapScale = 1;
    panX = 0;
    panY = 0;
    applyTransform();
    if (changed) renderTeleportMarkers();
  };
  const stopDragging = (event) => {
    if (!dragState) return;
    dragState = null;
    canvas.classList.remove('dragging');
    frame.classList.remove('dragging');
    if (event?.pointerId !== undefined && frame.hasPointerCapture(event.pointerId)) frame.releasePointerCapture(event.pointerId);
  };

  const receiptRows = (result) => {
    const discount = Number(result.discountPercent ?? 100);
    const details = [
      ['传送位置', result.targetName || '已授权位置'],
      ['计价方式', result.pricingMode === 'distance' ? '按距离计价' : '固定价格']
    ];
    if (result.pricingMode === 'distance') details.push(['传送距离', `${number(result.kilometers)} 公里`]);
    details.push(
      ['基础费用', `${number(result.basePrice)} 商城币`],
      ['会员折扣', discount >= 100 ? '无折扣' : `${discount}%`],
      ['实际花费', `${number(result.chargedAmount)} 商城币`],
      ['当前余额', `${number(result.balance)} 商城币`],
      ['扣款后余额', `${number(result.balanceAfter)} 商城币`]
    );
    return details;
  };
  const renderTeleportReceipt = (result, phase = 'quote') => {
    receiptDetails.replaceChildren(...receiptRows(result).map(([label, value]) => {
      const row = document.createElement('div');
      const term = document.createElement('dt');
      const detail = document.createElement('dd');
      term.textContent = label;
      detail.textContent = value;
      if (label === '实际花费') row.className = 'teleport-receipt-cost';
      row.append(term, detail);
      return row;
    }));
    const isQuote = phase === 'quote';
    receiptTitle.textContent = isQuote ? '确认传送' : '传送结果';
    receiptStatus.textContent = isQuote ? '请核对本次传送距离与费用' : phase === 'pending' ? '传送申请已提交，正在等待游戏确认' : '传送已完成';
    receiptWarning.hidden = !isQuote;
    receiptConfirm.hidden = !isQuote;
    receiptCancel.hidden = !isQuote;
    receiptDone.hidden = isQuote;
    openModal(receiptModal);
  };
  const showTeleportResult = (result) => {
    const receipt = { ...(teleportQuoteDraft?.quote || {}), ...result };
    if (['manual_review', 'command_result_unknown'].includes(result.status)) {
      closeModal(receiptModal);
      toast(chineseErrorMessage(result.errorMessage, '传送结果暂时无法确认，已转人工核查', { code: result.errorCode }), 'error', '需要人工核查');
    } else if (['failed', 'refunded'].includes(result.status)) {
      closeModal(receiptModal);
      toast(chineseErrorMessage(result.errorMessage, '传送失败，费用已退回', { code: result.errorCode }), 'error');
    } else if (result.status === 'success_pending_persistence') renderTeleportReceipt(receipt, 'pending');
    else renderTeleportReceipt(receipt, 'success');
  };
  const pollTeleportResult = async (payload, key) => {
    try {
      for (let attempt = 0; attempt < teleportResultPollAttempts; attempt += 1) {
        await new Promise((resolve) => window.setTimeout(resolve, teleportResultPollMs));
        const result = await api('/api/shop/teleport', { method: 'POST', headers: { 'Idempotency-Key': key }, body: JSON.stringify(payload) });
        if (['processing', 'success_pending_persistence'].includes(result.status)) {
          if (result.status === 'success_pending_persistence' && attempt === 0) showTeleportResult(result);
          continue;
        }
        showTeleportResult(result);
        return;
      }
      toast('传送仍在游戏内处理中，可稍后刷新查看结果');
    } catch (error) {
      toast(error.message, 'error');
    } finally {
      teleportExecutionPending = false;
      await Promise.allSettled([loadTeleportActionData({ force: true }), loadTeleportMapData({ force: true })]);
      renderTeleportActions();
    }
  };

  modeButtons.forEach((button) => button.addEventListener('click', () => {
    teleportMode = button.dataset.teleportMode === 'vehicle' ? 'vehicle' : 'character';
    modeButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    clearTeleportTarget();
    renderTeleportActions();
    renderTeleportMarkers();
  }));
  actionClear.addEventListener('click', () => {
    clearTeleportTarget();
    renderTeleportActions();
    renderTeleportMarkers();
  });
  destinationClear.addEventListener('click', () => {
    clearTeleportDestination();
    renderTeleportActions();
    renderTeleportMarkers();
  });
  actionRefresh.addEventListener('click', () => withBusy(actionRefresh, async () => {
    try { await Promise.all([loadTeleportActionData({ force: true }), loadTeleportMapData({ force: true })]); } catch (error) { if (error.status !== 401) toast(error.message, 'error'); }
  }));
  actionForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!actionTarget.value || teleportExecutionPending) return;
    withBusy(actionExecute, async () => {
      try {
        const payload = { targetType: actionType.value, targetId: actionTarget.value };
        if (actionType.value.startsWith('vehicle_to_')) payload.destinationId = destinationId.value;
        const quote = await api('/api/shop/teleport/quote', { method: 'POST', body: JSON.stringify(payload) });
        teleportQuoteDraft = { payload, quote };
        renderTeleportReceipt(quote, 'quote');
      } catch (error) { toast(error.message, 'error'); }
    }).finally(() => renderTeleportActions());
  });
  receiptConfirm.addEventListener('click', () => {
    if (!teleportQuoteDraft || teleportExecutionPending) return;
    withBusy(receiptConfirm, async () => {
      const key = teleportRequestKey();
      const payload = { ...teleportQuoteDraft.payload, quoteToken: teleportQuoteDraft.quote.quoteToken };
      try {
        const result = await api('/api/shop/teleport', { method: 'POST', headers: { 'Idempotency-Key': key }, body: JSON.stringify(payload) });
        if (['processing', 'success_pending_persistence'].includes(result.status)) {
          teleportExecutionPending = true;
          renderTeleportActions();
          if (result.status === 'success_pending_persistence') showTeleportResult(result);
          else renderTeleportReceipt(teleportQuoteDraft.quote, 'pending');
          void pollTeleportResult(payload, key);
          return;
        }
        showTeleportResult(result);
        await Promise.allSettled([loadTeleportActionData({ force: true }), loadTeleportMapData({ force: true })]);
      } catch (error) {
        closeModal(receiptModal);
        teleportQuoteDraft = null;
        toast(error.message, 'error');
      }
    }).finally(() => renderTeleportActions());
  });
  zoomOut.addEventListener('click', () => setScale(scale - 0.25));
  zoomIn.addEventListener('click', () => setScale(scale + 0.25));
  zoomReset.addEventListener('click', resetScale);
  range.addEventListener('input', () => setScale(Number(range.value) / 100));
  refresh.addEventListener('click', () => withBusy(refresh, async () => {
    try { await loadTeleportMapData({ force: true }); } catch (error) { if (error.status !== 401) toast(error.message, 'error'); }
  }));
  vehicleLayer.addEventListener('change', renderTeleportMarkers);
  playerLayer.addEventListener('change', renderTeleportMarkers);
  teammateLayer.addEventListener('change', renderTeleportMarkers);
  flagLayer.addEventListener('change', renderTeleportMarkers);
  fixedLayer.addEventListener('change', renderTeleportMarkers);
  gridLayer.addEventListener('change', () => { grid.hidden = !gridLayer.checked; });
  frame.addEventListener('wheel', (event) => {
    event.preventDefault();
    setScale(scale + (event.deltaY < 0 ? 0.25 : -0.25), { x: event.clientX, y: event.clientY });
  }, { passive: false });
  frame.addEventListener('pointerdown', (event) => {
    if (scale <= 1 || event.button > 0 || event.target.closest('.teleport-marker')) return;
    dragState = { x: event.clientX, y: event.clientY, panX, panY };
    frame.setPointerCapture(event.pointerId);
    canvas.classList.add('dragging');
    frame.classList.add('dragging');
  });
  frame.addEventListener('pointermove', (event) => {
    if (!dragState) return;
    panX = dragState.panX + event.clientX - dragState.x;
    panY = dragState.panY + event.clientY - dragState.y;
    applyTransform();
  });
  frame.addEventListener('pointerup', stopDragging);
  frame.addEventListener('pointercancel', stopDragging);
  frame.addEventListener('dblclick', resetScale);

  image.addEventListener('error', () => renderTeleportMapStatus('地图加载失败，请刷新页面重试'), { once: true });
  if (window.ResizeObserver) {
    teleportMapResizeObserver?.disconnect();
    teleportMapResizeObserver = new ResizeObserver(() => renderTeleportMarkers());
    teleportMapResizeObserver.observe(frame);
  }
  resetScale();
  renderTeleportMapStatus();
  renderTeleportActions();
  if (state.user) loadTeleportActionData().catch(() => {});
  if (!teleportMapRefreshTimer) configureTeleportMapRefresh();
  root.dataset.teleportReady = 'true';
}

loadTeleportPage();
