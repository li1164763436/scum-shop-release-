const teleportGridRows = ['D', 'C', 'B', 'A', 'Z'];
const teleportGridColumns = ['4', '3', '2', '1', '0'];
let teleportMapData = null;
let teleportMapLoading = null;
let teleportMapRefreshTimer = null;
let teleportActionData = null;
let teleportActionLoading = null;
let teleportMapScale = 1;
let teleportMapResizeObserver = null;
let teleportExecutionPending = false;
let teleportQuoteDraft = null;
let teleportMode = 'character';
const teleportResultPollMs = 1000;
const teleportResultPollAttempts = 120;
let teleportMapRefreshMs = 15000;

function configureTeleportMapRefresh() {
  const root = teleportPage();
  if (!root) return;
  const configuredSeconds = Number(teleportActionData?.quota?.character?.intervalSeconds || 0);
  teleportMapRefreshMs = configuredSeconds > 0 ? configuredSeconds * 1000 : 15000;
  if (teleportMapRefreshTimer) window.clearInterval(teleportMapRefreshTimer);
  teleportMapRefreshTimer = window.setInterval(() => {
    if (!root.hidden && state.user && document.visibilityState === 'visible') Promise.allSettled([loadTeleportActionData({ force: true }), loadTeleportMapData({ force: true })]);
  }, teleportMapRefreshMs);
}

function teleportPage() { return document.getElementById('page-teleport'); }
function teleportElement(selector) { return teleportPage()?.querySelector(selector) || null; }

function teleportRequestKey() {
  return window.crypto?.randomUUID?.() || `teleport-${Date.now()}-${Math.random().toString(16).slice(2)}`;
}

function teleportTargetsFor(type) {
  if (['vehicle_to_territory_flag', 'vehicle_to_player', 'vehicle_to_fixed_location'].includes(type)) return teleportActionData?.targets?.realtimeVehicles || [];
  if (type === 'owned_vehicle') return teleportActionData?.targets?.vehicles || [];
  if (type === 'territory_flag') return teleportActionData?.targets?.territoryFlags || [];
  if (type === 'fixed_location') return teleportActionData?.targets?.fixedLocations || [];
  if (type === 'player') return teleportActionData?.targets?.players || [];
  return [];
}

function teleportTargetTypeForMarker(type) {
  if (teleportMode === 'vehicle') return type === 'vehicle' ? 'vehicle_source' : '';
  return type === 'teammate' ? 'player' : type === 'vehicle' ? 'owned_vehicle' : type === 'flag' ? 'territory_flag' : type === 'fixed' ? 'fixed_location' : '';
}

function teleportAuthorizedTarget(targetType, targetId) {
  return teleportTargetsFor(targetType).find((item) => item.id === targetId) || null;
}

function teleportMapMarker(targetId) {
  return [teleportMapData?.player, ...(teleportMapData?.teammates || []), ...(teleportMapData?.vehicles || []), ...(teleportMapData?.flags || []), ...(teleportMapData?.fixedLocations || [])]
    .find((item) => item?.id === targetId) || null;
}

function clearTeleportDestination() {
  const destination = teleportElement('#teleportDestinationId');
  const type = teleportElement('#teleportTargetType');
  if (destination) destination.value = '';
  if (teleportMode === 'vehicle' && type) type.value = '';
}

function clearTeleportTarget() {
  teleportQuoteDraft = null;
  const type = teleportElement('#teleportTargetType');
  const target = teleportElement('#teleportTargetId');
  if (type) type.value = '';
  if (target) target.value = '';
  clearTeleportDestination();
}

function selectTeleportMapTarget(marker, markerType) {
  if (teleportMode === 'vehicle') {
    if (markerType !== 'vehicle') return false;
    const authorized = (teleportActionData?.targets?.realtimeVehicles || []).find((item) => item.id === marker.id);
    if (!authorized) return false;
    teleportElement('#teleportTargetId').value = authorized.id;
    clearTeleportDestination();
    renderTeleportActions();
    renderTeleportMarkers();
    return true;
  }
  const targetType = teleportTargetTypeForMarker(markerType);
  const authorized = teleportAuthorizedTarget(targetType, marker.id);
  if (!authorized) return false;
  teleportElement('#teleportTargetType').value = targetType;
  teleportElement('#teleportTargetId').value = authorized.id;
  renderTeleportActions();
  renderTeleportMarkers();
  return true;
}

function selectTeleportMapDestination(marker, markerType) {
  if (teleportMode !== 'vehicle' || !teleportElement('#teleportTargetId')?.value) return false;
  let targetType = '';
  let destinationId = '';
  if (markerType === 'flag' && (teleportActionData?.targets?.territoryFlags || []).some((item) => item.id === marker.id)) {
    targetType = 'vehicle_to_territory_flag';
    destinationId = marker.id;
  } else if (markerType === 'player') {
    targetType = 'vehicle_to_player';
    destinationId = 'player:self';
  } else if (markerType === 'teammate' && marker.online === true && (teleportActionData?.targets?.onlinePlayers || []).some((item) => item.id === marker.id)) {
    targetType = 'vehicle_to_player';
    destinationId = marker.id;
  } else if (markerType === 'fixed' && (teleportActionData?.targets?.fixedLocations || []).some((item) => item.id === marker.id)) {
    targetType = 'vehicle_to_fixed_location';
    destinationId = marker.id;
  }
  if (!targetType) return false;
  teleportElement('#teleportTargetType').value = targetType;
  teleportElement('#teleportDestinationId').value = destinationId;
  renderTeleportActions();
  renderTeleportMarkers();
  return true;
}

function renderTeleportActions(error = null) {
  const status = teleportElement('#teleportActionStatus');
  const quota = teleportElement('#teleportActionQuota');
  const price = teleportElement('#teleportActionPrice');
  const type = teleportElement('#teleportTargetType');
  const target = teleportElement('#teleportTargetId');
  const destinationId = teleportElement('#teleportDestinationId');
  const execute = teleportElement('#teleportExecute');
  const note = teleportElement('#teleportActionNote');
  const selected = teleportElement('#teleportSelectedTarget');
  const selectedName = teleportElement('#teleportSelectedTargetName');
  const selectedMeta = teleportElement('#teleportSelectedTargetMeta');
  const clear = teleportElement('#teleportClearTarget');
  const destinationPanel = teleportElement('#teleportSelectedDestination');
  const destinationName = teleportElement('#teleportSelectedDestinationName');
  const destinationMeta = teleportElement('#teleportSelectedDestinationMeta');
  const clearDestination = teleportElement('#teleportClearDestination');
  if (![status, quota, price, type, target, destinationId, execute, note, selected, selectedName, selectedMeta, clear, destinationPanel, destinationName, destinationMeta, clearDestination].every(Boolean)) return;

  const source = teleportMode === 'vehicle'
    ? (teleportActionData?.targets?.realtimeVehicles || []).find((item) => item.id === target.value)
    : teleportAuthorizedTarget(type.value, target.value);
  if (target.value && !source) clearTeleportTarget();
  const destinationMarker = destinationId.value === 'player:self' ? teleportMapData?.player : teleportMapMarker(destinationId.value);
  const destination = type.value === 'vehicle_to_territory_flag'
    ? (teleportActionData?.targets?.territoryFlags || []).find((item) => item.id === destinationId.value)
    : type.value === 'vehicle_to_fixed_location'
      ? (teleportActionData?.targets?.fixedLocations || []).find((item) => item.id === destinationId.value)
      : destinationId.value === 'player:self'
        ? { id:'player:self', name:'本人当前位置' }
        : (teleportActionData?.targets?.onlinePlayers || []).find((item) => item.id === destinationId.value);
  if (teleportMode === 'vehicle' && destinationId.value && !destination) clearTeleportDestination();
  destinationPanel.hidden = teleportMode !== 'vehicle';

  note.classList.toggle('error', Boolean(error));
  if (error) {
    clearTeleportTarget();
    status.textContent = '传送服务暂不可用';
    quota.textContent = '今日可用次数：—';
    price.textContent = '本次价格：—';
    note.textContent = error;
    execute.disabled = true;
  } else if (!state.user) {
    clearTeleportTarget();
    status.textContent = '登录后读取传送额度';
    quota.textContent = '今日可用次数：—';
    price.textContent = '本次价格：—';
    note.textContent = '登录后可读取安全传送目标。';
    execute.disabled = true;
  } else if (!teleportActionData) {
    status.textContent = '正在读取安全传送配置…';
    execute.disabled = true;
  } else {
    const category = teleportMode === 'vehicle' ? 'vehicle' : 'character';
    const q = teleportActionData.quota?.[category] || {};
    const pricing = teleportActionData.pricing?.[category] || {};
    const characterCapabilities = ['player', 'ownedVehicle', 'territoryFlag', 'fixedLocation'].some((name) => teleportActionData.capabilities?.[name] === true);
    const selectedVehicleCapability = type.value === 'vehicle_to_territory_flag' ? 'vehicleToTerritoryFlag' : type.value === 'vehicle_to_player' ? 'vehicleToPlayer' : type.value === 'vehicle_to_fixed_location' ? 'vehicleToFixedLocation' : null;
    const anyVehicleCapability = teleportActionData.capabilities?.vehicleToTerritoryFlag === true || teleportActionData.capabilities?.vehicleToPlayer === true || teleportActionData.capabilities?.vehicleToFixedLocation === true;
    const modeAvailable = teleportMode === 'vehicle' ? (selectedVehicleCapability ? teleportActionData.capabilities?.[selectedVehicleCapability] === true : anyVehicleCapability) : characterCapabilities;
    quota.textContent = `今日可用次数：${q.remaining ?? 0} / ${q.total ?? 0}`;
    price.textContent = pricing.mode === 'distance' ? `距离计价：${number(pricing.perKilometerPrice || 0)} 商城币/公里` : `本次价格：${number(pricing.price || 0)} 商城币`;
    const modeName = teleportMode === 'vehicle' ? '载具传送' : '角色传送';
    status.textContent = teleportExecutionPending ? '传送已提交，游戏处理中' : !modeAvailable ? `${modeName}能力不可用` : q.intervalRemainingSeconds > 0 ? `载具传送间隔中：${q.intervalRemainingSeconds} 秒` : teleportMode === 'vehicle' && !source ? '请在地图选择实时载具' : teleportMode === 'vehicle' && !destination ? '请在地图选择目的地' : `${modeName}已就绪`;
    note.textContent = !modeAvailable ? `当前选择的${modeName}能力不可用。` : teleportMode === 'vehicle' ? '先选择实时载具，再直接点击固定位置、领地旗、本人或在线队友作为目的地。' : teleportActionData.playerDisabledReason || '仅地图上通过安全校验的目标可以被选择。';
    execute.disabled = teleportExecutionPending || !modeAvailable || Number(q.remaining || 0) < 1 || Number(q.intervalRemainingSeconds || 0) > 0 || !source || (teleportMode === 'vehicle' && !destination);
  }

  const sourceMarker = source ? teleportMapMarker(source.id) : null;
  selected.classList.toggle('has-target', Boolean(source));
  selectedName.textContent = source ? `${source.name}${source.plateNumber ? ` · ${source.plateNumber}` : ''}` : teleportMode === 'vehicle' ? '请在地图选择实时载具' : '未选择传送目标';
  selectedMeta.textContent = source ? `${teleportMode === 'vehicle' ? '源载具' : type.value === 'player' ? '小队成员' : type.value === 'territory_flag' ? '领地旗' : type.value === 'fixed_location' ? '固定位置' : '上锁载具'} · ${sourceMarker?.gridCode || '位置已授权'}${source.lastKnown || sourceMarker?.stale ? ' · 离线最后位置' : ' · 实时位置'}` : '—';
  clear.hidden = !source;

  destinationPanel.classList.toggle('has-target', Boolean(destination));
  destinationName.textContent = destination?.name || '请选择固定位置、领地旗、本人或在线队友';
  destinationMeta.textContent = destination ? `${type.value === 'vehicle_to_fixed_location' ? '固定位置' : type.value === 'vehicle_to_territory_flag' ? '授权领地旗' : destinationId.value === 'player:self' ? '本人角色' : '在线队友'} · ${destinationMarker?.gridCode || '位置已授权'} · ${type.value === 'vehicle_to_fixed_location' ? '固定位置' : '实时位置'}` : '—';
  clearDestination.hidden = !destination;
}

async function loadTeleportActionData({ force = false } = {}) {
  if (!state.user) { teleportActionData = null; renderTeleportActions(); return null; }
  if (teleportActionLoading) return teleportActionLoading;
  renderTeleportActions();
  teleportActionLoading = api('/api/shop/teleport').then((data) => { teleportActionData = data; configureTeleportMapRefresh(); renderTeleportActions(); renderTeleportMarkers(); return data; })
    .catch((error) => { if (error.status !== 401) renderTeleportActions(chineseErrorMessage(error.message, '传送配置读取失败，请稍后重试')); throw error; })
    .finally(() => { teleportActionLoading = null; });
  return teleportActionLoading;
}

function teleportObservedLabel(value) {
  if (!value) return '更新时间未知';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? '更新时间未知' : `更新于 ${date.toLocaleString('zh-CN', { hour12: false })}`;
}

function teleportMarkerTitle(marker) {
  const stateLabel = marker.online === true ? '在线实时位置' : '离线最后位置';
  const ownership = marker.type === 'vehicle' ? (marker.ownership === 'teammate' ? ' · 队友载具' : ' · 本人载具') : '';
  return `${marker.name}${ownership} · ${stateLabel} · ${marker.gridCode || '网格未知'} · ${teleportObservedLabel(marker.observedAt)}`;
}

function syncTeleportLayerAvailability() {
  const capabilities = teleportMapData?.capabilities || {};
  const layers = teleportMapData?.layers || {};
  for (const [id, available] of [
    ['teleportLayerPlayer', capabilities.playerLocation === true || layers.player === true],
    ['teleportLayerTeammates', capabilities.teammateLocation === true || layers.teammates === true],
    ['teleportLayerFlags', capabilities.flagLocation === true || layers.flags === true],
    ['teleportLayerFixedLocations', capabilities.fixedLocation === true || layers.fixedLocations === true]
  ]) {
    const input = teleportElement(`#${id}`);
    if (!input) continue;
    input.disabled = !available;
    input.closest('label')?.classList.toggle('unavailable', !available);
  }
}

