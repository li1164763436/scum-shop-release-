    const saved = list(await api('/api/gift-types'));
    for (let index = 0; index < types.length; index++) {
      let current = saved.findIndex((item) => item.code === types[index].code);
      while (current > index) {
        await api('/api/gift-types/' + encodeURIComponent(types[index].code) + '/move', { method: 'PATCH', body: JSON.stringify({ direction: 'up' }) });
        [saved[current - 1], saved[current]] = [saved[current], saved[current - 1]];
