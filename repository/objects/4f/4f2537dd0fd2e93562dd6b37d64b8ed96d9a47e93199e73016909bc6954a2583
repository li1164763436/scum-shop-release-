async function loadStarterGiftPage() {
  const [gifts, products, types] = await Promise.all([api('/api/gifts'), api('/api/products'), api('/api/gift-types')]);
  state.gifts = list(gifts, ['gifts', 'items']);
  state.products = list(products, ['products', 'items']);
  Object.keys(giftTypes).forEach((key) => delete giftTypes[key]);
  list(types).forEach((item) => { giftTypes[item.code] = item.name; });
  const giftTypeSelect = $('#starterGiftForm').elements.giftType;
  const selectedType = giftTypeSelect.value;
  giftTypeSelect.innerHTML = Object.entries(giftTypes).map(([code, name]) => '<option value="' + esc(code) + '">' + esc(name) + '</option>').join('');
  if (giftTypes[selectedType]) giftTypeSelect.value = selectedType;
  if (state.selectedGiftId && !state.gifts.some((gift) => Number(gift.id) === Number(state.selectedGiftId))) state.selectedGiftId = null;
  renderStarterGiftWorkbench();
}
