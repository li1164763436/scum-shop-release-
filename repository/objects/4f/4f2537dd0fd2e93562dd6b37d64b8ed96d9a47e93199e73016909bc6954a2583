    const saved = await api(id ? `/api/gifts/${encodeURIComponent(id)}` : '/api/gifts', { method: id ? 'PUT' : 'POST', body: JSON.stringify(body) });
    state.selectedGiftId = saved.id;
    toast(id ? '礼包已更新' : '礼包已创建');
    closeStarterGiftModal();
    await loadStarterGiftPage();
  });
});

$('#addStarterGift').addEventListener('click', () => { state.selectedGiftId = null; renderStarterGiftWorkbench(); openStarterGiftModal(); });

$('#giftTypeSettings').addEventListener('click', openGiftTypeSettings);

$('#closeStarterGiftModal').addEventListener('click', closeStarterGiftModal);

$('#cancelStarterGiftModal').addEventListener('click', closeStarterGiftModal);

$('#starterGiftModal').addEventListener('click', (event) => {
  if (event.target !== event.currentTarget) return;
  event.preventDefault();
  event.stopPropagation();
});

$('#starterGiftForm').addEventListener('change', (event) => { if (event.target.name === 'giftType') updateGiftVisibility(); });

$('#starterGiftForm').addEventListener('click', (event) => {
  const previewPage = event.target.closest('[data-gift-preview-page]');
  if (previewPage) {
    giftProductPreviewPage += previewPage.dataset.giftPreviewPage === 'next' ? 1 : -1;
    renderGiftProductPreview();
    return;
  }
  if (event.target.closest('[data-manage-gift-product]')) openGiftProductPicker();
  if (event.target.closest('[data-upload-gift-image]')) $('#giftImageFile').click();
});

$('#giftImageFile').addEventListener('change', async (event) => {
  const file = event.target.files?.[0];
  if (!file) return;
  const form = $('#starterGiftForm').elements;
  const query = new URLSearchParams({ giftType: form.giftType.value, giftName: form.giftName.value.trim() });
  const path = await uploadImage(file, '/api/gifts/image?' + query);
  form.imagePath.value = path;
  updateGiftImagePreview(path);
  event.target.value = '';
});



$('#deleteStarterGift')?.addEventListener('click', async () => {
  const gift = currentGift();
  if (!gift || !window.confirm(`确认永久删除礼包“${gift.name}”？所有相关数据将被永久删除，且无法恢复。`)) return;
  await api(`/api/gifts/${encodeURIComponent(gift.id)}`, { method: 'DELETE' });
  toast('礼包已永久删除');
  closeStarterGiftModal();
  state.selectedGiftId = null;
  await loadStarterGiftPage();
});

async function handleGiftClick(event) {
  const manageGiftId = event.target.closest('[data-gift-manage]')?.dataset.giftManage;
  if (manageGiftId) { event.preventDefault(); event.stopPropagation(); await openGiftManage(manageGiftId, event.target.closest('[data-gift-manage]')); return true; }
  const giftAction = event.target.closest('[data-gift-action]');
  if (giftAction) {
    $('.gift-manage-menu')?.remove();
    const id = giftAction.dataset.id;
    if (giftAction.dataset.giftAction === 'status') {
      const gift = state.gifts.find((item) => Number(item.id) === Number(id));
      if (!gift) { toast('礼包不存在或已刷新', true); return true; }
      await withBusy(giftAction, async () => {
        await api('/api/gifts/' + encodeURIComponent(id) + '/status', { method: 'PATCH', body: JSON.stringify({ enabled: !gift.enabled }) });
        toast(gift.enabled ? '礼包已禁用' : '礼包已启用');
        await loadStarterGiftPage();
      });
      return true;
    }
    const gift = await api('/api/gifts/' + encodeURIComponent(id));
    if (giftAction.dataset.giftAction === 'edit') { closeModal(); state.selectedGiftId = Number(id); const index = state.gifts.findIndex((item) => Number(item.id) === Number(id)); if (index >= 0) state.gifts[index] = gift; renderStarterGiftWorkbench(); openStarterGiftModal(); }
    if (giftAction.dataset.giftAction === 'delete') {
      openModal({ title: '删除礼包', description: '此操作无法撤销，请确认礼包信息。', submitText: '确认删除', body: '<div class="gift-delete-confirm"><span>!</span><div><strong>确认删除“' + esc(gift.name) + '”吗？</strong><p>礼包配置、关联内容及后续领取入口将被删除，历史记录不会因此恢复。</p></div></div>', onSubmit: async () => { await api('/api/gifts/' + id, { method: 'DELETE' }); toast('礼包已删除'); closeModal(); await loadStarterGiftPage(); } });
      $('#modalBackdrop').classList.add('centered-modal', 'gift-type-action-modal', 'modal-static-backdrop');
      $('#submitModal').classList.add('danger');
    }
    return true;
  }
  const giftId = event.target.closest('[data-select-gift]')?.dataset.selectGift;
  if (giftId !== undefined) await selectGift(giftId);
}
