
.redeem-code-directory { overflow: hidden; }
.cdk-content-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e7ecf2; }
.cdk-content-head h3 { margin: 0; font-size: 15px; }
.cdk-content-head .btn { padding: 7px 12px; white-space: nowrap; }
#modalBody [data-redeem-member][hidden], #modalBody [data-redeem-coin][hidden] { display: none; }
.modal-backdrop.centered-modal:has(input[name="codePrefix"]) .modal { width: min(1000px, 94vw); }
#modalBody:has(input[name="codePrefix"]) {
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  align-items: stretch;
  gap: 16px;
  padding: 20px;
  background: #f1f5f9;
}
#modalBody:has(input[name="codePrefix"]) > .modal-section {
  grid-column: auto;
  min-width: 0;
  padding: 18px;
  border: 1px solid #dfe6ee;
  border-radius: 12px;
  background: #fff;
}
#modalBody:has(input[name="codePrefix"]) > .modal-section:last-child { grid-column: 1 / -1; }
#modalBody:has(input[name="codePrefix"]) .modal-section > h3 {
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e7ecf2;
  font-size: 15px;
}
#modalBody:has(input[name="codePrefix"]) .modal-section-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
#modalBody:has(input[name="codePrefix"]) input,
#modalBody:has(input[name="codePrefix"]) select,
#modalBody:has(input[name="codePrefix"]) textarea { width: 100%; min-width: 0; border-radius: 8px; }
#modalBody:has(input[name="codePrefix"]) textarea[name="generatedCode"] {
  min-height: 88px;
  padding: 12px;
  background: #f5f8fd;
  color: #245fcf;
  font-family: Consolas, monospace;
  overflow-wrap: anywhere;
}
@media (max-width: 760px) {
  #modalBody:has(input[name="codePrefix"]) { grid-template-columns: minmax(0, 1fr); padding: 14px; }
}
@media (max-width: 480px) {
  #modalBody:has(input[name="codePrefix"]) .modal-section-grid { grid-template-columns: minmax(0, 1fr); }
}
.redeem-code-directory-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid #e7ecf2;
}
.redeem-code-directory-head h3 { margin: 0; }
@media (max-width: 520px) {
  .redeem-code-directory-head { align-items: flex-start; flex-direction: column; }
}

.redeem-config-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  align-items: stretch;
  margin-bottom: 16px;
}

.redeem-config-grid .config-stack { min-width: 0; margin: 0; }
.redeem-config-grid .form-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 20px;
  border: 1px solid #dfe6ee;
  border-radius: 14px;
  background: linear-gradient(145deg, #ffffff, #f7f9fc);
  box-shadow: 0 4px 16px rgba(33, 54, 75, .06);
}
.redeem-config-grid .card-head {
  min-height: 64px;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid #e7ecf2;
}
.redeem-config-grid .card-head h3 { margin-bottom: 5px; }
.redeem-config-grid .card-head p { max-width: 42em; line-height: 1.6; }
.redeem-config-grid .form-grid { align-items: start; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0; }
.redeem-config-grid .form-grid input { width: 100%; min-width: 0; border-radius: 8px; }
.redeem-config-grid .form-actions {
  justify-content: flex-end;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid #e7ecf2;
}

@media (max-width: 900px) {
  .redeem-config-grid { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
  .redeem-config-grid .form-grid { grid-template-columns: 1fr; }
  .redeem-config-grid .card-head { flex-wrap: wrap; gap: 12px; }
}


.redeem-code-table { min-width: 1320px; }


.redeem-code-hint { padding: 4px 7px; color: #245fcf; background: #eef4ff; border-radius: 5px; letter-spacing: .08em; }


.redeem-action-editor { min-height: 210px; font: 12px/1.7 Consolas, monospace; }


[data-redeem-private][hidden], [data-redeem-member][hidden], [data-redeem-limit][hidden], [data-redeem-timed][hidden] { display: none; }

