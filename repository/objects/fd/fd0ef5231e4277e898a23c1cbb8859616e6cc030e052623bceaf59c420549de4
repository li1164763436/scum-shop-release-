}

async function alignDatabaseDefaultToAccountSteamId(db) {
  const storage = await db.query("SELECT c.character_set_name AS charset,c.collation_name AS collation,s.default_character_set_name AS databaseCharset,s.default_collation_name AS databaseCollation FROM information_schema.columns c JOIN information_schema.schemata s ON s.schema_name=c.table_schema WHERE c.table_schema=DATABASE() AND c.table_name='商城用户' AND c.column_name='SteamID' LIMIT 1");
  if (!Array.isArray(storage)) return;
  const definition = storage[0];
  if (!definition) throw new Error('商城用户.SteamID 字符集定义不存在');
  if (!/^[A-Za-z0-9_]+$/.test(definition.charset || '') || !/^[A-Za-z0-9_]+$/.test(definition.collation || '')) throw new Error('商城用户.SteamID 字符集定义无效');
  if (definition.databaseCharset !== definition.charset || definition.databaseCollation !== definition.collation) {
    const alter = `ALTER DATABASE CHARACTER SET ${definition.charset} COLLATE ${definition.collation}`;
    if (typeof db.rawQuery === 'function') await db.rawQuery(alter);
    else await db.query(alter);
  }
}

