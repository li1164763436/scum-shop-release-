  if (!(await hasIndex(db, 'orders', 'idx_orders_source_id'))) await db.query('ALTER TABLE orders ADD INDEX idx_orders_source_id (source,id)');
  if (!(await hasIndex(db, 'order_items', 'idx_order_items_product_category'))) await db.query('ALTER TABLE order_items ADD INDEX idx_order_items_product_category (product_id,sku,parent_category,category_name,order_id)');
  if (await hasColumn(db, 'player_admin_actions', 'expires_at')) await db.query('UPDATE player_admin_actions SET temporary_ban_expires_at=expires_at WHERE temporary_ban_expires_at IS NULL AND expires_at IS NOT NULL');
  await db.query('ALTER TABLE player_admin_actions MODIFY COLUMN admin_user_id BIGINT UNSIGNED NULL');
  await db.query('ALTER TABLE player_admin_actions MODIFY COLUMN delivery_token CHAR(36) NULL');
  if (!(await hasIndex(db, 'player_admin_actions', 'uk_player_admin_parent_action'))) await db.query('ALTER TABLE player_admin_actions ADD UNIQUE KEY uk_player_admin_parent_action (parent_action_id,action_type)');
  if (!(await hasIndex(db, 'player_admin_action_attempts', 'uk_player_admin_attempt'))) await db.query('ALTER TABLE player_admin_action_attempts ADD UNIQUE KEY uk_player_admin_attempt (action_id,attempt_no)');
  await migrateVehicleTablesToChinese(db);
  await ensureVehicleLimitSchema(db);
  await migrateTableCatalog(db);
  await db.query('DROP VIEW IF EXISTS `维护审计记录`');
  await db.query('DROP VIEW IF EXISTS `维护公告执行`');
  for (const [name, select] of views) await db.query(`CREATE OR REPLACE ALGORITHM=TEMPTABLE VIEW \`${name}\` AS ${select}`);
}

async function ensureVehicleLimitSchema(db) {
  await db.query(`CREATE TABLE IF NOT EXISTS \`载具数量治理配置\` (\`配置编号\` TINYINT UNSIGNED PRIMARY KEY,\`是否启用\` TINYINT(1) NOT NULL DEFAULT 0,\`每玩家允许数量\` INT UNSIGNED NOT NULL DEFAULT 3,\`宽限分钟数\` INT UNSIGNED NOT NULL DEFAULT 1440,\`提醒间隔分钟数\` INT UNSIGNED NOT NULL DEFAULT 60,\`更新管理员名称\` VARCHAR(100) NULL,\`更新时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),CONSTRAINT chk_vehicle_limit_singleton CHECK (\`配置编号\`=1),CONSTRAINT chk_vehicle_limit_enabled CHECK (\`是否启用\` IN (0,1)),CONSTRAINT chk_vehicle_limit_count CHECK (\`每玩家允许数量\` BETWEEN 1 AND 100),CONSTRAINT chk_vehicle_limit_grace CHECK (\`宽限分钟数\` BETWEEN 5 AND 43200),CONSTRAINT chk_vehicle_limit_warning CHECK (\`提醒间隔分钟数\` BETWEEN 5 AND 1440)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
  await db.query("INSERT IGNORE INTO `载具数量治理配置` (`配置编号`) VALUES (1)");
  await db.query(`CREATE TABLE IF NOT EXISTS \`载具数量治理状态\` (\`玩家SteamID\` VARCHAR(17) PRIMARY KEY,\`当前上锁数量\` INT UNSIGNED NOT NULL DEFAULT 0,\`允许数量快照\` INT UNSIGNED NOT NULL,\`治理状态\` VARCHAR(16) NOT NULL DEFAULT 'compliant',\`首次超限时间\` DATETIME(3) NULL,\`移除截止时间\` DATETIME(3) NULL,\`最近提醒时间\` DATETIME(3) NULL,\`更新时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),INDEX idx_vehicle_limit_state (\`治理状态\`,\`移除截止时间\`),CONSTRAINT chk_vehicle_limit_state CHECK (\`治理状态\` IN ('compliant','threshold','exceeded','review'))) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
  await db.query(`CREATE TABLE IF NOT EXISTS \`载具数量治理任务\` (\`任务编号\` CHAR(36) PRIMARY KEY,\`玩家SteamID\` VARCHAR(17) NOT NULL,\`来源载具编号\` BIGINT UNSIGNED NOT NULL,\`载具身份指纹\` VARCHAR(500) NOT NULL,\`载具显示名称\` VARCHAR(120) NOT NULL,\`任务状态\` VARCHAR(16) NOT NULL DEFAULT 'pending',\`首次超限时间\` DATETIME(3) NOT NULL,\`移除截止时间\` DATETIME(3) NOT NULL,\`执行次数\` INT UNSIGNED NOT NULL DEFAULT 0,\`最近执行时间\` DATETIME(3) NULL,\`最后错误\` VARCHAR(500) NULL,\`完成时间\` DATETIME(3) NULL,\`创建时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),\`更新时间\` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),UNIQUE KEY uk_vehicle_limit_entity (\`来源载具编号\`),INDEX idx_vehicle_limit_due (\`任务状态\`,\`移除截止时间\`),INDEX idx_vehicle_limit_owner (\`玩家SteamID\`,\`任务状态\`),CONSTRAINT chk_vehicle_limit_task_state CHECK (\`任务状态\` IN ('pending','removing','removed','cancelled','review'))) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
  const taskStateChecks = await db.query("SELECT cc.CHECK_CLAUSE AS clause FROM information_schema.table_constraints tc JOIN information_schema.check_constraints cc ON cc.constraint_schema=tc.constraint_schema AND cc.constraint_name=tc.constraint_name WHERE tc.table_schema=DATABASE() AND tc.table_name='载具数量治理任务' AND tc.constraint_name='chk_vehicle_limit_task_state'");
  if (taskStateChecks[0] && !String(taskStateChecks[0].clause || '').includes('removing')) await db.query('ALTER TABLE `载具数量治理任务` DROP CHECK chk_vehicle_limit_task_state');
  if (!await hasConstraint(db, '载具数量治理任务', 'chk_vehicle_limit_task_state')) await db.query("ALTER TABLE `载具数量治理任务` ADD CONSTRAINT chk_vehicle_limit_task_state CHECK (`任务状态` IN ('pending','removing','removed','cancelled','review'))");
  if (!await hasConstraint(db, '载具数量治理配置', 'chk_vehicle_limit_enabled')) {
    await db.query('UPDATE `载具数量治理配置` SET `是否启用`=IF(`是否启用`=0,0,1)');
    await db.query('ALTER TABLE `载具数量治理配置` ADD CONSTRAINT chk_vehicle_limit_enabled CHECK (`是否启用` IN (0,1))');
  }
}

async function ensureSchemaWithLock(db) {
  const lockRows = await db.query('SELECT GET_LOCK(?, 120) AS acquired', [SCHEMA_LOCK_NAME]);
  if (Number(lockRows?.[0]?.acquired) !== 1) throw new Error('数据库结构升级锁获取超时，请确认没有其他商城进程正在升级');
  try {
    await ensureSchemaOnConnection(db);
  } finally {
    await db.query('SELECT RELEASE_LOCK(?) AS released', [SCHEMA_LOCK_NAME]);
  }
}

export async function ensureSchema(db) {
  if (typeof db.withConnection === 'function') return db.withConnection(session => ensureSchemaWithLock(session));
  return ensureSchemaWithLock(db);
}

