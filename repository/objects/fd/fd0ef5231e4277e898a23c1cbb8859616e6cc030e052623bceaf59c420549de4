      for (const constraint of checksByTable.get(chineseTable) || []) {
        if (await hasConstraint(db, chineseTable, constraint)) await db.query(`ALTER TABLE ${quoteIdentifier(chineseTable)} DROP CHECK ${quoteIdentifier(constraint)}`);
