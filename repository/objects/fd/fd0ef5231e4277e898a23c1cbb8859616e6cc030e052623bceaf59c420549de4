const columnComments = Object.fromEntries(columnCommentNames);

function splitDefinitions(body) {
  const definitions = [];
  let start = 0;
  let depth = 0;
  let quote = null;
  for (let index = 0; index <= body.length; index += 1) {
    const character = body[index];
    if (quote) {
      if (character === quote && body[index - 1] !== '\\') quote = null;
    } else if (character === "'" || character === '`' || character === '"') quote = character;
    else if (character === '(') depth += 1;
    else if (character === ')') depth -= 1;
    else if ((character === ',' && depth === 0) || index === body.length) {
      definitions.push(body.slice(start, index).trim());
      start = index + 1;
    }
  }
  return definitions;
}

function describeColumns(table, columns) {
  return columns.map((column) => columnComments[column] || `${tableComments[table]}业务字段 ${column}`).join('、');
}

function parseSchemaObjects() {
  const comments = [];
  for (const statement of statements) {
    const tableMatch = statement.match(/^CREATE TABLE IF NOT EXISTS (?:`([^`]+)`|([a-z0-9_]+))/);
    const table = tableMatch?.[1] || tableMatch?.[2];
    const body = statement.slice(statement.indexOf('(') + 1, statement.lastIndexOf(') ENGINE='));
    const definitions = splitDefinitions(body);
    comments.push({ objectType: 'table', table, objectName: '', comment: tableComments[table] });
    for (const definition of definitions) {
      const columnMatch = definition.match(/^(?:`([^`]+)`|([a-z][a-z0-9_]*))\s/);
      const column = columnMatch?.[1] || columnMatch?.[2];
      if (column) {
        comments.push({ objectType: 'column', table, objectName: column, comment: columnComments[column] || `${tableComments[table]}业务字段 ${column}` });
        if (/\bPRIMARY KEY\b/.test(definition)) comments.push({ objectType: 'index', table, objectName: 'PRIMARY', comment: `${describeColumns(table, [column])}主键索引` });
        if (/\bUNIQUE\b/.test(definition)) comments.push({ objectType: 'index', table, objectName: column, comment: `${describeColumns(table, [column])}唯一索引` });
        continue;
      }
      const index = definition.match(/^(PRIMARY KEY|UNIQUE KEY|INDEX)\s*(?:([a-z0-9_]+)\s*)?\(([^)]+)\)/);
      if (index) {
        const columns = index[3].split(',').map((value) => value.trim().replaceAll('`', '').split(/\s|\(/)[0]);
        const name = index[1] === 'PRIMARY KEY' ? 'PRIMARY' : index[2];
        comments.push({ objectType: 'index', table, objectName: name, comment: `${describeColumns(table, columns)}${index[1] === 'UNIQUE KEY' || name === 'PRIMARY' ? '唯一' : '查询'}索引` });
      }
      const foreignKey = definition.match(/^CONSTRAINT\s+(?:`([^`]+)`|([a-z0-9_]+))\s+FOREIGN KEY\s*\(([^)]+)\)\s+REFERENCES\s+(?:`([^`]+)`|([a-z0-9_]+))\s*\(([^)]+)\)/);
      if (foreignKey) {
        const constraint = foreignKey[1] || foreignKey[2];
        const columns = foreignKey[3].split(',').map((value) => value.trim().replaceAll('`', ''));
        const targetTable = foreignKey[4] || foreignKey[5];
        comments.push({ objectType: 'foreign_key', table, objectName: constraint, comment: `${describeColumns(table, columns)}关联${tableComments[targetTable]}` });
      }
    }
  }
  return comments;
}

