async function hasColumn(db, table, column) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ? AND column_name = ?', [table, column]);
  return Number(rows[0]?.count) > 0;
}
async function columnIsNullable(db, table, column) {
  const rows = await db.query('SELECT is_nullable AS isNullable FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ? AND column_name = ? LIMIT 1', [table, column]);
  return String(rows[0]?.isNullable || '').toUpperCase() === 'YES';
}
async function columnIsInvisible(db, table, column) {
  const rows = await db.query('SELECT extra FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ? AND column_name = ? LIMIT 1', [table, column]);
  return String(rows[0]?.extra || '').toUpperCase().split(/\s+/).includes('INVISIBLE');
}
async function columnCharacterLength(db, table, column) {
  const rows = await db.query('SELECT character_maximum_length AS characterLength FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ? AND column_name = ? LIMIT 1', [table, column]);
  const length = Number(rows[0]?.characterLength);
  return Number.isFinite(length) ? length : null;
}
async function hasTable(db, table) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ? AND table_type = ?', [table, 'BASE TABLE']);
  return Array.isArray(rows) && Number(rows[0]?.count) > 0;
}
async function hasView(db, view) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ? AND table_type = ?', [view, 'VIEW']);
  return Array.isArray(rows) && Number(rows[0]?.count) > 0;
}
async function hasIndex(db, table, name) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = ? AND index_name = ?', [table, name]);
  return Number(rows[0]?.count) > 0;
}
async function hasForeignKey(db, table, name) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.referential_constraints WHERE constraint_schema = DATABASE() AND table_name = ? AND constraint_name = ?', [table, name]);
  return Number(rows[0]?.count) > 0;
}
async function hasConstraint(db, table, name) {
  const rows = await db.query('SELECT COUNT(*) AS count FROM information_schema.table_constraints WHERE constraint_schema = DATABASE() AND table_name = ? AND constraint_name = ?', [table, name]);
  return Number(rows[0]?.count) > 0;
}
async function checkConstraintClause(db, name) {
  const rows = await db.query('SELECT check_clause AS checkClause FROM information_schema.check_constraints WHERE constraint_schema = DATABASE() AND constraint_name = ?', [name]);
  return String(rows[0]?.checkClause || '');
}
async function migrateNullableUserReference(db, table, column, foreignKey) {
  await db.query(`ALTER TABLE \`${table}\` MODIFY COLUMN \`${column}\` BIGINT UNSIGNED NULL`);
  const current = await db.query('SELECT delete_rule AS deleteRule FROM information_schema.referential_constraints WHERE constraint_schema=DATABASE() AND table_name=? AND constraint_name=?', [table, foreignKey]);
  if (current[0] && current[0].deleteRule !== 'SET NULL') await db.query(`ALTER TABLE \`${table}\` DROP FOREIGN KEY \`${foreignKey}\``);
  if (!(await hasForeignKey(db, table, foreignKey))) await db.query(`ALTER TABLE \`${table}\` ADD CONSTRAINT \`${foreignKey}\` FOREIGN KEY (\`${column}\`) REFERENCES \`商城用户\`(\`商城用户编号\`) ON DELETE SET NULL`);
}

function quoteIdentifier(identifier) {
  if (!identifier || String(identifier).includes('`')) throw new Error(`Invalid schema identifier: ${identifier}`);
  return `\`${identifier}\``;
}

function quoteComment(comment) {
  return `'${String(comment).replaceAll("'", "''")}'`;
}

function columnDefinitionFromCreateTable(createSql, column) {
  const body = createSql.slice(createSql.indexOf('(') + 1, createSql.lastIndexOf(')'));
  const definition = splitDefinitions(body).find((item) => item.startsWith(`${quoteIdentifier(column)} `));
  if (!definition) throw new Error(`Missing column definition for ${column}`);
  return definition.slice(quoteIdentifier(column).length + 1).replace(/\s+COMMENT\s+'(?:''|[^'])*'\s*$/i, '');
}

async function migrateSchemaComments(db) {
  await db.query("CREATE TABLE IF NOT EXISTS schema_comments (object_type ENUM('table','column','index','foreign_key') NOT NULL COMMENT '结构对象类型', table_name VARCHAR(64) NOT NULL COMMENT '英文物理表名', object_name VARCHAR(64) NOT NULL DEFAULT '' COMMENT '英文物理对象名', comment_text VARCHAR(500) NOT NULL COMMENT '中文备注说明', updated_at DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3) COMMENT '更新时间', PRIMARY KEY (object_type,table_name,object_name)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='数据库结构中文备注字典'");
  const tableEntries = schemaComments.filter(({ objectType, table }) => objectType === 'table' && tableComments[table] !== undefined);
  for (const { table, comment } of tableEntries) {
    const rows = await db.query('SELECT table_comment AS tableComment FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name=?', [table]);
    if (rows[0] && rows[0].tableComment !== comment) await db.query(`ALTER TABLE ${quoteIdentifier(table)} COMMENT = ${quoteComment(comment)}`);
  }
  const columnEntries = schemaComments.filter(({ objectType, table }) => objectType === 'column' && tableComments[table] !== undefined);
  for (const table of Object.keys(tableComments)) {
    const entries = columnEntries.filter((entry) => entry.table === table);
    const current = await db.query('SELECT column_name AS columnName, column_comment AS columnComment FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name=?', [table]);
    if (!Array.isArray(current)) continue;
    const pending = entries.filter(({ objectName, comment }) => current.some((column) => column.columnName === objectName && column.columnComment !== comment));
    if (!pending.length) continue;
    const createRows = await db.query(`SHOW CREATE TABLE ${quoteIdentifier(table)}`);
    const createSql = createRows[0]?.['Create Table'] || createRows[0]?.createTable;
    for (const { objectName, comment } of pending) {
      const definition = columnDefinitionFromCreateTable(createSql, objectName);
      await db.query(`ALTER TABLE ${quoteIdentifier(table)} MODIFY COLUMN ${quoteIdentifier(objectName)} ${definition} COMMENT ${quoteComment(comment)}`);
    }
  }
  for (const { objectType, table, objectName, comment } of schemaComments) {
    await db.query('INSERT INTO schema_comments (object_type,table_name,object_name,comment_text) VALUES (?,?,?,?) ON DUPLICATE KEY UPDATE comment_text=VALUES(comment_text)', [objectType, table, objectName, comment]);
  }
  await db.query("DELETE c FROM schema_comments c LEFT JOIN information_schema.tables t ON t.table_schema=DATABASE() AND t.table_name=c.table_name WHERE c.object_type='table' AND t.table_name IS NULL");
  await db.query("DELETE c FROM schema_comments c LEFT JOIN information_schema.columns i ON i.table_schema=DATABASE() AND i.table_name=c.table_name AND i.column_name=c.object_name WHERE c.object_type='column' AND i.column_name IS NULL");
  await db.query("DELETE c FROM schema_comments c LEFT JOIN information_schema.statistics i ON i.table_schema=DATABASE() AND i.table_name=c.table_name AND i.index_name=c.object_name WHERE c.object_type='index' AND i.index_name IS NULL");
  await db.query("DELETE c FROM schema_comments c LEFT JOIN information_schema.referential_constraints i ON i.constraint_schema=DATABASE() AND i.table_name=c.table_name AND i.constraint_name=c.object_name WHERE c.object_type='foreign_key' AND i.constraint_name IS NULL");
}

