      if (await hasTable(db, chineseTable)) throw new Error(`传送表迁移冲突：${legacyTable} 与 ${chineseTable} 同时存在`);
      await db.query(`RENAME TABLE ${quoteIdentifier(legacyTable)} TO ${quoteIdentifier(chineseTable)}`);
    }
    if (!(await hasTable(db, chineseTable))) continue;
    const hasLegacyColumns = await hasColumn(db, chineseTable, columns[0][0]);
