async function createVehicleCompatibilityViews(db) {
  for (const [legacyTable, chineseTable, columns] of vehicleTableMigrations) {
    if (await hasTable(db, legacyTable)) continue;
    if (await hasView(db, legacyTable)) await db.query(`DROP VIEW ${quoteIdentifier(legacyTable)}`);
    if (await hasTable(db, chineseTable)) {
      const projection = columns.map(([legacyColumn, chineseColumn]) => `${quoteIdentifier(chineseColumn)} AS ${quoteIdentifier(legacyColumn)}`).join(',');
      await db.query(`CREATE VIEW ${quoteIdentifier(legacyTable)} AS SELECT ${projection} FROM ${quoteIdentifier(chineseTable)}`);
    }
  }
}

export async function migrateVehicleTablesToChinese(db) {
  for (const [, chineseTable] of vehicleTableMigrations) if (await hasView(db, chineseTable)) await db.query(`DROP VIEW ${quoteIdentifier(chineseTable)}`);
  if (await hasView(db, '传送载具位置')) await db.query('DROP VIEW `传送载具位置`');
  for (const [legacyTable, chineseTable] of vehicleTableMigrations) {
    if (await hasTable(db, legacyTable) && await hasTable(db, chineseTable)) throw new Error(`载具表迁移冲突：${legacyTable} 与 ${chineseTable} 同时存在`);
  }
  for (const [legacyTable, chineseTable] of vehicleTableMigrations) {
    const physicalTable = await hasTable(db, legacyTable) ? legacyTable : chineseTable;
    if (!(await hasTable(db, physicalTable))) continue;
    for (const [constraint] of vehicleChecks.get(chineseTable) || []) {
      if (await hasConstraint(db, physicalTable, constraint)) await db.query(`ALTER TABLE ${quoteIdentifier(physicalTable)} DROP CHECK ${quoteIdentifier(constraint)}`);
    }
  }
  const renames = [];
  for (const [legacyTable, chineseTable] of vehicleTableMigrations) if (await hasTable(db, legacyTable)) renames.push(`${quoteIdentifier(legacyTable)} TO ${quoteIdentifier(chineseTable)}`);
  if (renames.length) await db.query(`RENAME TABLE ${renames.join(',')}`);
  for (const [, chineseTable, columns] of vehicleTableMigrations) {
    if (!(await hasTable(db, chineseTable))) continue;
    for (const [legacyColumn, chineseColumn] of columns) {
      if (await hasColumn(db, chineseTable, legacyColumn) && await hasColumn(db, chineseTable, chineseColumn)) throw new Error(`载具字段迁移冲突：${chineseTable}.${legacyColumn} 与 ${chineseColumn} 同时存在`);
      if (await hasColumn(db, chineseTable, legacyColumn)) await db.query(`ALTER TABLE ${quoteIdentifier(chineseTable)} RENAME COLUMN ${quoteIdentifier(legacyColumn)} TO ${quoteIdentifier(chineseColumn)}`);
    }
    for (const [constraint, clause] of vehicleChecks.get(chineseTable) || []) {
      if (!(await hasConstraint(db, chineseTable, constraint))) await db.query(`ALTER TABLE ${quoteIdentifier(chineseTable)} ADD CONSTRAINT ${quoteIdentifier(constraint)} CHECK (${clause})`);
    }
  }
  if (await hasTable(db, '载具保险销售策略') && !(await hasConstraint(db, '载具保险销售策略', 'fk_vehicle_insurance_strategy_product'))) await db.query('ALTER TABLE `载具保险销售策略` ADD CONSTRAINT `fk_vehicle_insurance_strategy_product` FOREIGN KEY (`载具商品编号`) REFERENCES products(id) ON DELETE SET NULL');
  if (await hasTable(db, '载具保险') && !(await hasConstraint(db, '载具保险', 'fk_vehicle_insurance_strategy'))) await db.query('ALTER TABLE `载具保险` ADD CONSTRAINT `fk_vehicle_insurance_strategy` FOREIGN KEY (`策略编号`) REFERENCES `载具保险销售策略`(`策略编号`) ON DELETE SET NULL');
  await createVehicleCompatibilityViews(db);
  if (await hasTable(db, '载具档案')) await db.query("CREATE OR REPLACE ALGORITHM=TEMPTABLE VIEW `传送载具位置` AS SELECT `载具档案编号`,`车主SteamID` AS `归属SteamID`,COALESCE(NULLIF(`显示名称`,''),NULLIF(`型号名称`,''),`载具类型`) AS `显示名称`,`车牌号`,`世界X坐标`,`世界Y坐标`,`世界Z坐标`,`地图X百分比`,`地图Y百分比`,`位置来源`,`最后观测时间`,`档案状态`,`更新时间` FROM `载具档案` WHERE `车主SteamID` IS NOT NULL");
}

