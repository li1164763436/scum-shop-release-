async function playerLocationRawQuery(db, sql) {
  if (typeof db.rawQuery === 'function') return db.rawQuery(sql);
  return db.query(sql);
}

async function withPlayerLocationTableLock(db, clause, work) {
  await playerLocationRawQuery(db, `LOCK TABLES ${clause}`);
  try {
    return await work();
  } finally {
    await playerLocationRawQuery(db, 'UNLOCK TABLES').catch(() => {});
  }
}

