async function loadDashboard() {
  const [dashboard] = await Promise.allSettled([api('/api/dashboard'), loadMonitor(), loadGameChatPlayers()]);
  if (dashboard.status === 'fulfilled') {
    const data = dashboard.value || {};
    $('#dashboardPlayerCount').textContent = `${number(data.accounts?.registered_count)} / ${number(data.accounts?.count)}`;
    $('#dashboardTodayTasks').textContent = optionalNumber(data.tasks?.today_processed_count);
    const username = String(data?.license?.username || '');
    $('#licenseUsername').textContent = !username ? '--' : username.length === 1 ? '*' : `${username[0]}${'*'.repeat(Math.max(1, username.length - 2))}${username.at(-1)}`;
    $('#licenseExpiresAt').textContent = date(data?.license?.expiresAt);
  } else {
    $('#dashboardPlayerCount').textContent = '-- / --';
    $('#dashboardTodayTasks').textContent = '--';
    toast(dashboard.reason.message, true);
  }
  await loadHealth();
 }
