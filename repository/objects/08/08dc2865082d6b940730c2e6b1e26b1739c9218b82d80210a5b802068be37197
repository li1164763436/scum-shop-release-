$('#scumRconConfigForm').addEventListener('submit', async (event) => {
  event.preventDefault();
  await withBusy(event.submitter, async () => {
    const f = event.currentTarget.elements;
    const rconPassword = pendingRconPasswords.get(f.rconPassword) || '';
    await saveConfig({ ggcon: { mode: 'source-tcp', discoveryMode: 'manual', serverDirectory: f.scumGameDirectory.value.trim(), host: f.rconHost.value.trim(), port: 28015, ...(rconPassword ? { password: rconPassword, syncPassword: true } : {}) } });
    pendingRconPasswords.delete(f.rconPassword);
    f.rconPassword.value = '';
    toast(rconPassword ? 'RCON 密钥已同步，请重启 SCUM 游戏服务端后再测试连接' : '配置连接已保存');
    await loadConfig();
  });
});

