async function loadActivitiesLottery({ poolId = state.selectedLotteryPoolId } = {}) {
  try {
    const poolsPromise = api('/api/lottery/pools');
    const giftsPromise = api('/api/gifts');
    const productsPromise = api('/api/lottery/products');
    const recordsPromise = api('/api/lottery/records?limit=50');
    const [pools, gifts, products, records] = await Promise.all([poolsPromise, giftsPromise, productsPromise, recordsPromise]);
    state.lotteryPools = list(pools); state.gifts = list(gifts); state.lotteryProducts = list(products); state.lotteryRecords = list(records);
    state.selectedLotteryPoolId = state.lotteryPools.some((item) => Number(item.id) === Number(poolId)) ? Number(poolId) : null;
    if (state.selectedLotteryPoolId) {
      const index = state.lotteryPools.findIndex((item) => Number(item.id) === Number(state.selectedLotteryPoolId));
      state.lotteryPoolPage = Math.floor(index / state.lotteryPoolPageSize) + 1;
    }
    renderLotteryPoolList();
    await loadLotteryVersion();
    const recordRows = $('#lotteryRecordRows');
    if (recordRows) recordRows.innerHTML = state.lotteryRecords.length ? state.lotteryRecords.map((item) => `<tr><td>#${number(item.id)}</td><td>${esc(item.steamId)}</td><td>${esc(item.poolName)}</td><td>v${number(item.versionId)}</td><td>${number(item.drawCount)}</td><td>${number(item.freeCount)}</td><td>${number(item.pricePaid)}</td><td>${number(item.pityBefore)} → ${number(item.pityAfter)}</td><td>${date(item.createdAt)}</td></tr>`).join('') : empty(9, '暂无抽奖记录');
  } catch (error) {
    $('#lotteryPoolList').innerHTML = `<div class="stock-record-empty">奖池加载失败：${esc(error.message)}</div>`;
    throw error;
  }
}
async function loadLotteryVersion() {
  const pool = lotteryCurrent();
  state.lotteryVersion = null;
  state.lotteryVersionDraft = null;
  if (!pool?.currentVersionId) return;
  state.lotteryVersion = await api(`/api/lottery/versions/${encodeURIComponent(pool.currentVersionId)}`);
}
