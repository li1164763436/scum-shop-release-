async function handleLotteryDraftClick(event) {
  const prizePage=event.target.closest('[data-lottery-prize-page]');
  if(prizePage){state.lotteryPrizePage=Math.max(1,(Number(state.lotteryPrizePage)||1)+(prizePage.dataset.lotteryPrizePage==='next'?1:-1));lotteryVersionModal();return true;}
  const removePrize = event.target.closest('[data-remove-lottery-prize]');
  if (removePrize && state.lotteryVersionDraft) { captureLotteryVersionDraft(); state.lotteryVersionDraft.prizes.splice(Number(removePrize.dataset.removeLotteryPrize), 1); lotteryVersionModal(); return true; }
  const editPrize = event.target.closest('[data-edit-lottery-prize]');
  if (editPrize && state.lotteryVersionDraft) { lotteryPrizeModal(Number(editPrize.dataset.editLotteryPrize)); return true; }
  if (event.target.closest('[data-add-lottery-prize]')) { lotteryPrizeModal(); return true; }
}

async function handleLotteryPoolClick(event) {
  if (event.target.closest('[data-upload-lottery-image]')) $('#lotteryPoolImageFile')?.click();
  const poolPrizesId = event.target.closest('[data-lottery-pool-prizes]')?.dataset.lotteryPoolPrizes;
  if (poolPrizesId) await lotteryPoolPrizesModal(poolPrizesId);
  if (event.target.closest('[data-open-lottery-version]')) lotteryVersionModal();
  const poolEditId = event.target.closest('[data-lottery-pool-edit]')?.dataset.lotteryPoolEdit;
  if (poolEditId) lotteryPoolModal(state.lotteryPools.find((item) => Number(item.id) === Number(poolEditId)) || {});
  const poolDeleteId = event.target.closest('[data-lottery-pool-delete]')?.dataset.lotteryPoolDelete;
  if (poolDeleteId && window.confirm('确认永久删除该奖池？历史版本、抽奖、订单、履约和关联数据将全部删除，且无法恢复。')) await withBusy(event.target.closest('button'), async () => {
    await api(`/api/lottery/pools/${encodeURIComponent(poolDeleteId)}`, { method: 'DELETE' });
    toast('奖池及所有相关数据已永久删除');
    await loadActivitiesLottery({ poolId: null });
