async function handleAccountMenuClick(event) {
  const editAdmin = event.target.closest('[data-edit-admin]'); if (editAdmin) { editAdminPermissionsModal(editAdmin); return true; }
  const cancelAdmin = event.target.closest('[data-cancel-admin]'); if (cancelAdmin) { if (confirm('确认取消该后台管理员授权？')) { await api('/api/admin/users/'+cancelAdmin.dataset.cancelAdmin+'/demote',{method:'POST',body:JSON.stringify({confirmSteamId:cancelAdmin.dataset.steamId,reason:'通过后台授权管理取消权限'})}); toast('后台管理员授权已取消'); closeModal(); await loadAccounts(); } return true; }
  const copyOrder = event.target.closest('[data-copy-order]');
  if (copyOrder) {
    try { await navigator.clipboard.writeText(copyOrder.dataset.copyOrder); toast('订单号已复制'); }
    catch { toast('订单号复制失败', true); }
    return true;
  }
  const accountMenuButton = event.target.closest('[data-account-menu]');
  const accountMenu = $('#accountMenu');
  if (accountMenuButton) {
    const rect = accountMenuButton.getBoundingClientRect();
    accountMenu.dataset.steamId = accountMenuButton.dataset.accountMenu;
    accountMenu.hidden = false;
    accountMenu.style.left = `${Math.min(rect.left, window.innerWidth - accountMenu.offsetWidth - 12)}px`;
    accountMenu.style.top = `${Math.min(rect.bottom + 5, window.innerHeight - accountMenu.offsetHeight - 12)}px`;
    $$('[data-account-menu]').forEach((button) => button.setAttribute('aria-expanded', button === accountMenuButton ? 'true' : 'false'));
    return true;
  }
  const accountMenuAction = event.target.closest('[data-account-action]')?.dataset.accountAction;
  if (accountMenuAction) {
    const steamId = accountMenu.dataset.steamId;
    accountMenu.hidden = true;
    $$('[data-account-menu]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
    if (accountMenuAction === 'profile') {
      await accountProfileModal(steamId);
    } else if (accountMenuAction === 'add-balance') balanceModal(steamId);
    else if (accountMenuAction === 'gifts') await accountGiftsModal(steamId);
    else if (accountMenuAction === 'orders') await accountOrdersModal(steamId);
    else if (accountMenuAction === 'add-coins') goldModal(steamId);
    else if (accountMenuAction === 'member') membershipModal(steamId);
    else if (accountMenuAction === 'pass') playerAttributesModal(steamId);
    else toast('该功能框架已预留，当前尚未接入业务');
    return true;
  }
  if (!accountMenu.hidden && !event.target.closest('#accountMenu')) {
    accountMenu.hidden = true;
    $$('[data-account-menu]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
  }
}

