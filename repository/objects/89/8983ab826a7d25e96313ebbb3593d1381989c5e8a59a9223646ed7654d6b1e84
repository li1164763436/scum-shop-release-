let accountLoadVersion = 0;

async function loadAccounts() {
  const loadVersion = ++accountLoadVersion;
  $('#accountRows').innerHTML = empty(7, '正在加载账户...', true);
  try {
    const search = $('#accountSearch').value.trim();
    const data = await api(`/api/accounts?search=${encodeURIComponent(search)}`);
    if (loadVersion !== accountLoadVersion) return;
    state.accounts = list(data, ['accounts', 'items']);
    const onlineCount = state.accounts.filter((account) => Boolean(account.online)).length;
    const balanceTotal = state.accounts.reduce((total, account) => total + Number(account.balance || 0), 0);
    $('#accountTotalCount').textContent = number(state.accounts.length);
    $('#accountOnlineCount').textContent = number(onlineCount);
    $('#accountBalanceTotal').textContent = number(balanceTotal);
    $('#accountResultCount').textContent = `${number(state.accounts.length)} 位玩家`;
    $('#accountRows').innerHTML = state.accounts.length ? state.accounts.map((account) => {
      const steamId = account.steamId;
      const displayName = account.characterName || account.steamName || account.username || '未绑定昵称';
      const userName = account.username || account.steamName || '--';
      const shopRoleBadge = account.role === 'super_admin' ? '<span class="badge failed">超级管理员</span>' : account.role === 'admin' ? '<span class="badge failed">后台管理员</span>' : account.username ? '<span class="badge">商城玩家</span>' : '<span class="badge">未注册商城</span>';
      const gameAdminBadge = account.isAdmin
        ? '<span class="badge game-role-badge admin">游戏管理员</span>'
        : '<span class="badge game-role-badge player">普通玩家</span>';
      const promoteButton = '';
      const onlineBadge = account.online ? '<span class="badge active">在线</span>' : '<span class="badge inactive">离线</span>';
      const accountBadge = account.status === 'active' ? '<span class="badge active">账户正常</span>' : account.status ? `<span class="badge inactive">${esc(account.status)}</span>` : '<span class="badge">未注册商城</span>';
      const activity = account.online ? `在线 · ${esc(date(account.lastSeenAt))}` : account.lastSeenAt ? `最后出现 ${esc(date(account.lastSeenAt))}` : account.lastLogin ? `最后登录 ${esc(date(account.lastLogin))}` : '暂无在线记录';
      return `<tr><td><div class="row-actions"><button class="btn secondary account-action" data-account-menu="${esc(steamId)}" aria-expanded="false">操作</button>${promoteButton}</div></td><td><div class="account-badges">${shopRoleBadge}${gameAdminBadge}${onlineBadge}${accountBadge}</div></td><td><div class="account-identity"><strong>${esc(userName)}</strong><span>${esc(displayName)}</span></div></td><td><code>${esc(steamId)}</code></td><td><span class="account-activity">${activity}</span></td><td><strong class="member-level">等级：${number(account.memberLevel || 0)}</strong></td><td><span class="money">${number(account.balance)}</span></td></tr>`;
    }).join('') : empty(7, '暂无玩家账户');
  } catch (error) {
    if (loadVersion !== accountLoadVersion) return;
    $('#accountTotalCount').textContent = '--';
    $('#accountOnlineCount').textContent = '--';
    $('#accountBalanceTotal').textContent = '--';
    $('#accountResultCount').textContent = '0 位玩家';
    $('#accountRows').innerHTML = empty(7, error.message === '接口不存在' ? '玩家账户接口尚未启用' : error.message);
  }
}

function formatDuration(value) {
  const seconds = Number(value);
  if (!Number.isFinite(seconds) || seconds < 0) return '--';
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor((seconds % 86400) / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  return `${days ? `${days} 天 ` : ''}${hours ? `${hours} 小时 ` : ''}${minutes} 分钟`;
}

