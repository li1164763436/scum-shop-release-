  async market({ search = '', limit = 100 } = {}) {
    const safeLimit = Math.min(Math.max(Number(limit) || 100, 1), 500), keyword = String(search || '').trim();
    const itemName = "COALESCE((SELECT p.name FROM products p WHERE p.item_id=l.item_code AND p.name<>'' ORDER BY p.enabled DESC,p.id DESC LIMIT 1),l.item_name)";
    const imagePath = "(SELECT p.image_path FROM products p WHERE (p.item_id=l.item_code OR p.item_id=REGEXP_REPLACE(l.item_code,'_ES$','')) AND p.image_path IS NOT NULL AND p.image_path<>'' ORDER BY p.enabled DESC,p.id DESC LIMIT 1)";
    const where = keyword ? ` AND (${itemName} LIKE ? OR l.item_code LIKE ?)` : '', params = keyword ? [`%${keyword}%`, `%${keyword}%`] : [];
    return rows(await this.db.query(`SELECT l.id,l.inventory_id AS inventoryId,l.seller_steam_id AS sellerSteamId,COALESCE(NULLIF(a.\`游戏名称\`,''),NULLIF(a.\`登录账号\`,''),l.seller_steam_id) AS sellerName,l.item_code AS itemCode,${itemName} AS itemName,${imagePath} AS imagePath,b.source_item_id AS sourceItemId,l.quantity,l.remaining_quantity AS remainingQuantity,l.unit_price AS unitPrice,l.fee_bps AS feeBps,l.status,b.item_health AS itemHealth,b.item_max_health AS itemMaxHealth,b.item_uses AS itemUses,COALESCE(b.item_max_uses,(SELECT p.max_uses FROM products p WHERE (p.item_id=l.item_code OR p.item_id=REGEXP_REPLACE(l.item_code,'_ES$','')) AND p.max_uses IS NOT NULL ORDER BY p.enabled DESC,p.id DESC LIMIT 1)) AS itemMaxUses,b.item_max_quantity AS itemMaxQuantity,b.item_dirtiness AS itemDirtiness,b.item_stackable AS itemStackable,l.created_at AS createdAt,l.updated_at AS updatedAt FROM cloud_market_listings l JOIN cloud_inventory_batches b ON b.id=l.inventory_id LEFT JOIN \`商城用户\` a ON a.\`SteamID\`=l.seller_steam_id WHERE l.status='active' AND l.remaining_quantity>0${where} ORDER BY itemName,l.unit_price,l.id LIMIT ${safeLimit}`, params)).map(listingRow);
  }

  async list(steamId, inventoryId, input) {
    const owner = steam(steamId), batchId = id(inventoryId, '库存编号'), unitPrice = positive(input?.unitPrice, '单价', Number.MAX_SAFE_INTEGER);
    const settings = await this.settings();
    if (!settings.marketEnabled) throw new ServiceError('交易中心未开放', 409, 'MARKET_DISABLED');
    const fee = marketFee(unitPrice, settings.feeBps, settings.minimumFee);
    if (unitPrice <= fee) throw new ServiceError('上架单价必须大于手续费', 409, 'PRICE_NOT_GREATER_THAN_FEE');
    return this.db.transaction(async (tx) => {
      const batch = rows(await tx.query('SELECT id,steam_id AS steamId,item_code AS itemCode,item_name AS itemName,quantity,reserved_quantity AS reservedQuantity,item_stackable AS itemStackable,status FROM cloud_inventory_batches WHERE id=? FOR UPDATE', [batchId]))[0];
      if (!batch || batch.steamId !== owner) throw new ServiceError('库存不存在', 404, 'NOT_FOUND');
      const storedQuantity = Boolean(batch.itemStackable) ? 1 : Number(batch.quantity), quantity = 1;
      if (batch.status !== 'active' || Number(batch.reservedQuantity) > 0 || storedQuantity < 1) throw new ServiceError('可上架库存不足', 409, 'INSUFFICIENT_INVENTORY');
      const result = await tx.query('INSERT INTO cloud_market_listings (inventory_id,seller_steam_id,item_code,item_name,quantity,remaining_quantity,unit_price,fee_bps,minimum_fee) VALUES (?,?,?,?,?,?,?,?,?)', [batchId, owner, batch.itemCode, batch.itemName, quantity, quantity, unitPrice, settings.feeBps, settings.minimumFee]);
      await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=? WHERE id=?', [storedQuantity, batchId]);
      return { id: Number(result.insertId), inventoryId: batchId, itemCode: batch.itemCode, itemName: batch.itemName, quantity, remainingQuantity: quantity, unitPrice, feeBps: settings.feeBps, status: 'active' };
    });
  }

  async withdraw(steamId, inventoryId, input, options = {}) {
    const owner = steam(steamId), batchId = id(inventoryId, '库存编号'), quantity = 1;
    if (!this.clients) throw new ServiceError('RCON 服务未就绪', 503, 'WITHDRAW_UNAVAILABLE');
    const settings = await this.settings();
    const withdrawFee = options.withdrawFee === undefined ? settings.withdrawFee : Number(options.withdrawFee);
    const withdrawalId = randomUUID();
    const reserved = await this.db.transaction(async (tx) => {
      const batch = rows(await tx.query('SELECT id,steam_id AS steamId,source_item_id AS sourceItemId,item_code AS itemCode,item_name AS itemName,quantity,reserved_quantity AS reservedQuantity,item_health AS itemHealth,item_max_health AS itemMaxHealth,item_dirtiness AS itemDirtiness,item_uses AS itemUses,item_stackable AS itemStackable,item_snapshot_json AS itemSnapshotJson,status FROM cloud_inventory_batches WHERE id=? FOR UPDATE', [batchId]))[0];
      if (!batch || batch.steamId !== owner) throw new ServiceError('库存不存在', 404, 'NOT_FOUND');
      if (batch.status !== 'active' || Number(batch.reservedQuantity) !== 0) throw new ServiceError('可取出库存不足', 409, 'INSUFFICIENT_INVENTORY');
      const storedQuantity = Number(batch.quantity);
      const storedSnapshot = typeof batch.itemSnapshotJson === 'string' ? JSON.parse(batch.itemSnapshotJson) : batch.itemSnapshotJson;
      const vehicle = storedSnapshot?.actionType === 'spawn_vehicle';
      const stackable = Boolean(batch.itemStackable) && !discreteUsageOnly(batch.itemSnapshotJson);
      const inventoryQuantity = stackable ? 1 : storedQuantity;
      if (!batch.itemSnapshotJson && batch.sourceItemId) throw new ServiceError('该库存没有完整物品快照，禁止按默认满属性取出', 409, 'INCOMPLETE_ITEM_SNAPSHOT');
      if (withdrawFee > 0) {
        const account = rows(await tx.query('SELECT \`SteamID\` AS steamId,\`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [owner]))[0];
        if (!account || Number(account.balance) < withdrawFee) throw new ServiceError('商城币余额不足，无法支付取出手续费', 409, 'INSUFFICIENT_BALANCE');
        const balanceAfter = Number(account.balance) - withdrawFee;
        await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [balanceAfter, owner]);
        await tx.query('INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,?,?,?,?)', [owner, -withdrawFee, balanceAfter, 'cloud_withdraw_fee', 'cloud_withdraw_fee', withdrawalId, `取出手续费：库存 ${batchId} × ${quantity}`]);
      }
      if (vehicle) {
        if (storedQuantity !== 1) throw new ServiceError('载具库存数量无效', 409, 'INVALID_VEHICLE_INVENTORY');
        await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=1 WHERE id=?', [batchId]);
        return { itemCode: code(batch.itemCode), itemName: batch.itemName, inventoryQuantity: 1, vehicle: true };
      }
      if (!batch.itemSnapshotJson) {
        await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=? WHERE id=?', [inventoryQuantity, batchId]);
        return { itemCode: code(batch.itemCode), itemName: batch.itemName, inventoryQuantity, spawnCount: 1, uses: null, health: null, dirtiness: null, legacy: true };
      }
      const hasStoredUses = batch.itemUses !== null && batch.itemUses !== undefined;
      const uses = hasStoredUses ? Number(batch.itemUses) : 0;
      if (!Number.isSafeInteger(uses) || uses < 0 || uses > 10000) throw new ServiceError('物品剩余次数无法恢复', 409, 'UNSUPPORTED_ITEM_ATTRIBUTES');
      const health = batch.itemHealth === null || batch.itemHealth === undefined ? null : Number(batch.itemHealth);
      await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=? WHERE id=?', [inventoryQuantity, batchId]);
      const dirtiness = percent(batch.itemDirtiness, 0);
      return { itemCode: code(batch.itemCode), itemName: batch.itemName, inventoryQuantity, spawnCount: 1, stackCount: stackable ? (hasStoredUses ? uses : storedQuantity) : null, uses: stackable ? 0 : uses, health: percent(health, 100), dirtiness: String(Number(dirtiness) / 100) };
    });
    try {
      const { ggcon } = await this.clients();
      const command = reserved.vehicle
        ? `#SpawnVehicle ${reserved.itemCode} 1 Location ${owner}`
        : reserved.legacy
        ? `SpawnItem ${reserved.itemCode} 1 Location ${owner}`
        : `SpawnItemForPlayer ${owner} ${reserved.itemCode} 1 Uses ${reserved.uses} Health ${reserved.health} Dirtiness ${reserved.dirtiness}${reserved.stackCount === null ? '' : ` StackCount ${reserved.stackCount}`} CONFIRM`;
      const result = await ggcon.command(command, { retry: false });
      if (reserved.vehicle ? !responseText(result).split(/\r?\n/).includes('spawn_vehicle_for_player=executed') : responseFields(result).get('spawn_item_for_player') !== 'executed') throw new Error('生成接口未返回明确成功结果');
    } catch (error) {
      if (error?.uncertainDelivery) throw new ServiceError('物品取出结果不确定，库存已锁定等待人工核验', 503, 'WITHDRAW_UNCERTAIN');
      await this.db.transaction(async (tx) => {
        await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=0 WHERE id=? AND reserved_quantity=?', [batchId, reserved.inventoryQuantity]);
        if (withdrawFee > 0) {
          const account = rows(await tx.query('SELECT \`SteamID\` AS steamId,\`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\`=? FOR UPDATE', [owner]))[0];
          if (!account) throw new ServiceError('退款账户不存在', 409, 'NOT_FOUND');
          const balanceAfter = Number(account.balance) + withdrawFee;
          await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [balanceAfter, owner]);
          await tx.query('INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,?,?,?,?)', [owner, withdrawFee, balanceAfter, 'cloud_withdraw_refund', 'cloud_withdraw_refund', withdrawalId, '取出失败退还手续费']);
        }
      });
      throw new ServiceError(error.message || '物品取出失败', 409, 'WITHDRAW_REJECTED');
    }
    await this.db.query("UPDATE cloud_inventory_batches SET status='empty',quantity=0,reserved_quantity=0 WHERE id=? AND reserved_quantity=?", [batchId, reserved.inventoryQuantity]);
    if (options.notify !== false) await this.notify(owner, reserved.itemName, reserved.itemCode, quantity, '取出成功');
    return { id: batchId, itemCode: reserved.itemCode, itemName: reserved.itemName, quantity, fee: withdrawFee, status: 'completed' };
  }

  async cancel(steamId, listingId, admin = false) {
    const owner = admin ? null : steam(steamId), target = id(listingId, '挂单编号');
    return this.db.transaction(async (tx) => {
      const listing = rows(await tx.query('SELECT id,inventory_id AS inventoryId,seller_steam_id AS sellerSteamId,remaining_quantity AS remainingQuantity,status FROM cloud_market_listings WHERE id=? FOR UPDATE', [target]))[0];
      if (!listing || (!admin && listing.sellerSteamId !== owner)) throw new ServiceError('挂单不存在', 404, 'NOT_FOUND');
      if (listing.status !== 'active') throw new ServiceError('挂单状态不可撤销', 409, 'INVALID_STATE');
      await tx.query("UPDATE cloud_market_listings SET status='cancelled' WHERE id=?", [target]);
      await tx.query('UPDATE cloud_inventory_batches SET reserved_quantity=0 WHERE id=?', [listing.inventoryId]);
      return { id: target, status: 'cancelled' };
    });
  }

  async buy(steamId, listingId, input, requestKey) {
    const buyer = steam(steamId), target = id(listingId, '挂单编号'), quantity = 1, key = text(requestKey, 'Idempotency-Key', 100);
    const existing = rows(await this.db.query('SELECT id,listing_id AS listingId,buyer_steam_id AS buyerSteamId,quantity FROM cloud_market_trades WHERE request_key=?', [key]))[0];
    if (existing) {
      if (existing.buyerSteamId !== buyer || Number(existing.listingId) !== target || Number(existing.quantity) !== quantity) throw new ServiceError('Idempotency-Key 已被其他请求使用', 409, 'IDEMPOTENCY_CONFLICT');
      return { ...existing, idempotent: true };
    }
    const settings = await this.settings();
    if (!settings.marketEnabled) throw new ServiceError('交易中心未开放', 409, 'MARKET_DISABLED');
    try {
      return await this.db.transaction(async (tx) => {
        const listing = rows(await tx.query('SELECT id,inventory_id AS inventoryId,seller_steam_id AS sellerSteamId,item_code AS itemCode,item_name AS itemName,remaining_quantity AS remainingQuantity,unit_price AS unitPrice,fee_bps AS feeBps,minimum_fee AS minimumFee,status FROM cloud_market_listings WHERE id=? FOR UPDATE', [target]))[0];
        if (!listing || listing.status !== 'active') throw new ServiceError('挂单不存在或已结束', 404, 'NOT_FOUND');
        if (listing.sellerSteamId === buyer) throw new ServiceError('不能购买自己的挂单', 409, 'SELF_TRADE');
        if (Number(listing.remainingQuantity) < 1) throw new ServiceError('可售数量不足', 409, 'INSUFFICIENT_LISTING');
        await tx.query('INSERT INTO \`商城用户\` (\`SteamID\`,\`商城币余额\`) VALUES (?,0),(?,0) ON DUPLICATE KEY UPDATE \`SteamID\`=VALUES(\`SteamID\`)', [buyer, listing.sellerSteamId]);
        const accounts = rows(await tx.query('SELECT \`SteamID\` AS steamId,\`商城币余额\` AS balance FROM \`商城用户\` WHERE \`SteamID\` IN (?,?) FOR UPDATE', [buyer, listing.sellerSteamId]));
        const buyerAccount = accounts.find((item) => item.steamId === buyer), sellerAccount = accounts.find((item) => item.steamId === listing.sellerSteamId);
        const gross = Number(listing.unitPrice) * quantity;
        if (!Number.isSafeInteger(gross)) throw new ServiceError('交易金额超出安全范围');
        const fee = marketFee(gross, listing.feeBps, listing.minimumFee), sellerNet = gross - fee;
        if (gross <= fee) throw new ServiceError('成交总价必须大于手续费', 409, 'PRICE_NOT_GREATER_THAN_FEE');
        if (Number(buyerAccount.balance) < gross) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
        const buyerAfter = Number(buyerAccount.balance) - gross, sellerAfter = Number(sellerAccount.balance) + sellerNet;
        const result = await tx.query('INSERT INTO cloud_market_trades (request_key,listing_id,seller_steam_id,buyer_steam_id,item_code,item_name,quantity,unit_price,gross_amount,fee,seller_net,buyer_balance_after,seller_balance_after) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)', [key,target,listing.sellerSteamId,buyer,listing.itemCode,listing.itemName,quantity,listing.unitPrice,gross,fee,sellerNet,buyerAfter,sellerAfter]);
        await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [buyerAfter,buyer]);
        await tx.query('UPDATE \`商城用户\` SET \`商城币余额\`=? WHERE \`SteamID\`=?', [sellerAfter,listing.sellerSteamId]);
        await tx.query("UPDATE cloud_market_listings SET remaining_quantity=0,status='sold' WHERE id=?", [target]);
        await tx.query("UPDATE cloud_inventory_batches SET steam_id=?,reserved_quantity=0,status='active' WHERE id=?", [buyer,listing.inventoryId]);
        await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'cloud_market_buy','cloud_trade_buy',?,?),(?,?,?,'cloud_market_sell','cloud_trade_sell',?,?)",[buyer,-gross,buyerAfter,String(result.insertId),`购买 ${listing.itemName} × ${quantity}`,listing.sellerSteamId,sellerNet,sellerAfter,String(result.insertId),`出售 ${listing.itemName} × ${quantity}`]);
        return { id:Number(result.insertId), listingId:target, quantity, grossAmount:gross, fee, sellerNet, buyerBalanceAfter:buyerAfter, idempotent:false };
      });
    } catch (error) {
      if (!duplicate(error)) throw error;
      const trade = rows(await this.db.query('SELECT id,listing_id AS listingId,quantity,gross_amount AS grossAmount,fee,seller_net AS sellerNet,buyer_balance_after AS buyerBalanceAfter FROM cloud_market_trades WHERE request_key=?',[key]))[0];
      if (!trade) throw error;
      return { ...trade, idempotent:true };
    }
  }

  async trades(steamId = null, limit = 100) {
    const safe = Math.min(Math.max(Number(limit)||100,1),500), where = steamId ? ' WHERE t.buyer_steam_id=? OR t.seller_steam_id=?' : '', params = steamId ? [steam(steamId),steamId] : [];
    return rows(await this.db.query(`SELECT t.id,t.listing_id AS listingId,t.seller_steam_id AS sellerSteamId,COALESCE(NULLIF(sa.\`游戏名称\`,''),NULLIF(sa.\`登录账号\`,''),t.seller_steam_id) AS sellerName,t.buyer_steam_id AS buyerSteamId,COALESCE(NULLIF(ba.\`游戏名称\`,''),NULLIF(ba.\`登录账号\`,''),t.buyer_steam_id) AS buyerName,t.item_code AS itemCode,t.item_name AS itemName,t.quantity,t.unit_price AS unitPrice,t.gross_amount AS grossAmount,t.fee,t.seller_net AS sellerNet,t.created_at AS createdAt FROM cloud_market_trades t LEFT JOIN \`商城用户\` sa ON sa.\`SteamID\`=t.seller_steam_id LEFT JOIN \`商城用户\` ba ON ba.\`SteamID\`=t.buyer_steam_id${where} ORDER BY t.id DESC LIMIT ${safe}`,params));
  }

  async listingLogs(limit = 300) {
    const safe = Math.min(Math.max(Number(limit)||300,1),500);
    return rows(await this.db.query(`SELECT l.id,l.inventory_id AS inventoryId,l.seller_steam_id AS sellerSteamId,COALESCE(NULLIF(a.\`游戏名称\`,''),NULLIF(a.\`登录账号\`,''),l.seller_steam_id) AS sellerName,l.item_code AS itemCode,l.item_name AS itemName,l.quantity,l.unit_price AS unitPrice,l.status,l.created_at AS createdAt FROM cloud_market_listings l LEFT JOIN \`商城用户\` a ON a.\`SteamID\`=l.seller_steam_id ORDER BY l.id DESC LIMIT ${safe}`));
  }

  async adminOverview(query = {}) {
    const steamId = String(query.steamId || '').trim();
    const search = String(query.search || '').trim().slice(0,255);
    const searchWhere = search ? " AND (b.item_name LIKE ? OR b.item_code LIKE ? OR b.steam_id LIKE ? OR EXISTS (SELECT 1 FROM \`商城用户\` a WHERE a.\`SteamID\`=b.steam_id AND (a.\`游戏名称\` LIKE ? OR a.\`登录账号\` LIKE ?)) OR EXISTS (SELECT 1 FROM products p WHERE (p.item_id=b.item_code OR p.item_id=REGEXP_REPLACE(b.item_code,'_ES$','')) AND p.name LIKE ?))" : '';
    const params = search ? Array(6).fill('%'+search+'%') : [];
    const inventorySql = [
      "SELECT b.id,b.steam_id AS steamId,b.source_item_id AS sourceItemId,b.item_code AS itemCode,(SELECT CASE WHEN COUNT(*)=0 THEN NULL WHEN SUM(l.status='active' AND l.remaining_quantity>0)>0 THEN 'active' WHEN SUM(l.status='sold')>0 THEN 'sold' ELSE 'cancelled' END FROM cloud_market_listings l WHERE l.inventory_id=b.id) AS tradeStatus,",
      "COALESCE((SELECT p.name FROM products p WHERE (p.item_id=b.item_code OR p.item_id=REGEXP_REPLACE(b.item_code,'_ES$','')) AND p.name<>'' ORDER BY p.enabled DESC,p.id DESC LIMIT 1),b.item_name) AS itemName,",
      "(SELECT p.image_path FROM products p WHERE (p.item_id=b.item_code OR p.item_id=REGEXP_REPLACE(b.item_code,'_ES$','')) AND p.image_path IS NOT NULL AND p.image_path<>'' ORDER BY p.enabled DESC,p.id DESC LIMIT 1) AS imagePath,",
      "b.item_health AS itemHealth,b.item_uses AS itemUses,b.item_max_uses AS itemMaxUses,b.item_dirtiness AS itemDirtiness,",
      "COALESCE(NULLIF(a.\`游戏名称\`,''),NULLIF(a.\`登录账号\`,''),b.steam_id) AS playerName,",
      "b.quantity,b.reserved_quantity AS reservedQuantity,b.status,b.created_at AS createdAt,b.updated_at AS updatedAt",
      "FROM cloud_inventory_batches b LEFT JOIN \`商城用户\` a ON a.\`SteamID\`=b.steam_id WHERE 1=1", searchWhere,
      "ORDER BY b.id DESC LIMIT 200"
    ].filter(Boolean).join(' ');
    const inventory = steamId ? await this.inventory(steamId) : rows(await this.db.query(inventorySql,params)).map(inventoryRow);
    const stats = rows(await this.db.query("SELECT (SELECT COUNT(DISTINCT steam_id) FROM cloud_inventory_batches WHERE status<>'empty') AS warehouses,(SELECT COUNT(*) FROM cloud_inventory_batches WHERE status<>'empty') AS inventory,(SELECT COUNT(*) FROM cloud_market_listings WHERE status='active') AS listings,(SELECT COALESCE(SUM(remaining_quantity),0) FROM cloud_market_listings WHERE status='active') AS marketOrders,(SELECT COUNT(*) FROM cloud_market_trades) AS trades"))[0] || {};
    return { settings:await this.settings(), stats:Object.fromEntries(Object.entries(stats).map(([key,value])=>[key,Number(value)])), inventory, listings:await this.market({limit:200}), listingLogs:await this.listingLogs(300), trades:await this.trades(null,300) };
  }
