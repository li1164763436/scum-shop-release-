export async function startApplication({ root, port, host, appVersion, releaseRevision, store, logger, licenseStore, runtime, onLicenseInvalid }) {
  const config = await store.read();
  const db = await createDatabase(config.mysql);
  try {
    await ensureSchema(db);
    await importReleaseProductCatalog(db, root, appVersion, logger);
    await importLegacyGifts(db, config.starterGifts, logger);
  } catch (error) { await db.close(); throw error; }
  const auth = new AuthService(db, { challengeSecret: process.env.AUTH_CHALLENGE_SECRET });
  const redeemCodes = new RedeemCodeService(db);
  const rewards = new RewardService(db);
  const gifts = new GiftService(db);
  const activities = new ActivityService(db, gifts);
  const lottery = new LotteryService(db);
  const stockMarket = new StockMarketService(db, { store });
  let cached = null;
  let signature = '';
  const clients = async () => {
    const current = await store.read();
    const nextSignature = JSON.stringify({ gsm3: current.gsm3, ggcon: current.ggcon, reconnect: current.reconnect, instanceId: current.fulfillment.instanceId });
    if (!cached || signature !== nextSignature) {
      cached?.ggcon.close();
      const gsm3 = new Gsm3Client(current.gsm3, current.reconnect);
      cached = { gsm3, ggcon: new GgconClient(current.ggcon, current.reconnect, { gsm3, instanceId: current.fulfillment.instanceId, logger }) };
      signature = nextSignature;
    }
    return { config: current, ...cached };
  };
  const storefrontActivity = new StorefrontActivityGate({ activeWindowMs: 600000 });
  const maintenanceService = new MaintenanceService({ db, store });
  const worker = new FulfillmentWorker({ db, store, clients, logger, maintenanceService });
  const announcementWorker = new AnnouncementWorker({ db, store, clients, logger });
  const monitorWorker = new ServerMonitorWorker({ db, store, clients, logger, rewardService: rewards, fulfillmentWorkerStatus: () => worker.status(), activityGate: storefrontActivity });
  const monitorService = new MonitorService({ db, store });
  const maintenanceWorker = new MaintenanceWorker({ db, store, service: maintenanceService, clients, logger });
  const stockMarketWorker = new StockMarketWorker({ db, store, logger });
  const playerAdminCapabilities = new PlayerAdminCapabilityService({ db, clients });
  const playerAdmin = new PlayerAdminService({ db, clients, capabilityService: playerAdminCapabilities });
  const temporaryBanWorker = new TemporaryBanWorker({ db, playerAdminService: playerAdmin, capabilityService: playerAdminCapabilities, logger });
  const scumLogWorker = new ScumLogWorker({ db, store, logger });
  const scumCategoryLogWorker = new ScumCategoryLogWorker({ db, store, logger });
  const killRanking = new KillRankingService({ db });
  const cloudWarehouse = new CloudWarehouseService(db, { clients, logger });
  const chatGiftClaims = new ChatGiftClaimService({ db, gifts, cloudWarehouse });
  const chatAutoReplies = new ChatAutoReplyService({ db, store, clients, logger });
  const chatLogWorker = new ChatLogWorker({ db, store, claimService: chatGiftClaims, replyService: chatAutoReplies, logger });
  const vehicleSyncService = new VehicleSyncService({ db, reader: new ScumLockedVehicleReader({ root }), clients, logger });
  const vehicleSyncWorker = new VehicleSyncWorker({ service: vehicleSyncService, activityGate: storefrontActivity, logger });
  const vehicleTeleportVerificationWorker = new VehicleTeleportVerificationWorker({ service: new VehicleTeleportVerificationService({ db, clients, logger }), logger });
  const teleportSnapshotStore = new TeleportEntitySnapshotStore({ db });
  const scumTeleportEntityReader = new ScumTeleportEntityReader({ root });
  const teleportSnapshotWorker = new TeleportEntitySnapshotWorker({ store: teleportSnapshotStore, playerProvider: new TeleportPlayerLocationProvider({ clients, reader: scumTeleportEntityReader, logger }), flagProvider: new TeleportFlagLocationProvider({ clients, reader: scumTeleportEntityReader, logger }), activityGate: storefrontActivity, playerIntervalMs: 15000, flagIntervalMs: 60000, logger });
  let teleportMapProfile;
  const teleportMapProfileFile = path.join(root, 'data', 'teleport-map-calibration.json');
  if (fs.existsSync(teleportMapProfileFile)) {
    try {
      const candidate = JSON.parse(fs.readFileSync(teleportMapProfileFile, 'utf8').replace(/^\uFEFF/, ''));
      new TeleportMapService({ db, profile: candidate });
      teleportMapProfile = candidate;
    } catch (error) { logger.error('传送地图校准文件无效，继续使用未验证初始范围', { component: 'teleport-map', errorCode: error?.code || error?.name || 'CALIBRATION_FILE_INVALID' }); }
  }
  const domainTunnel = new DomainTunnelService({ root, localPort: port, licenseStore, logger });
  runtime.publicAccess = () => {
    const state = domainTunnel.currentDomainStatus();
    if (state.connectionState !== 'ready' || state.tunnelStatus !== 'healthy') return { url: null, kind: null };
    if (state.customDomain?.state === 'active') return { url: `https://${state.customDomain.domain}`, kind: 'custom-domain' };
    if (state.managedDomain?.enabled) return { url: `https://${state.managedDomain.domain}`, kind: 'managed-domain' };
    return { url: null, kind: null };
  };
  const rconPluginSyncController = new AbortController();
  const app = createApp({
    root, appVersion, releaseRevision, store, licenseStore, logger, db, auth, gifts, redeemCodes, rewards, activities, lottery, stockMarket, cloudWarehouse, killRanking, chatGiftClaims, chatAutoReplies, playerAdminCapabilities, playerAdmin, clients, announcementWorker, monitorService, maintenanceService, maintenanceWorker, teleportMapProfile, teleportSnapshotStore, storefrontActivity, secureCookies: process.env.COOKIE_SECURE === 'true', rconPluginAutoResume: true, rconPluginSyncSignal: rconPluginSyncController.signal,
    verifyAdminAccess: async () => {
      const identity = await assertStartupAllowed({ store: licenseStore });
      return assertInitialSuperAdminBinding(db, identity, { allowLegacy: false });
    },
    workerStatus: () => worker.status(), monitorStatus: () => monitorWorker.status(), maintenanceStatus: () => maintenanceWorker.status(), stockMarketStatus: () => stockMarketWorker.status(), temporaryBanStatus: () => temporaryBanWorker.status(), scumLogStatus: () => scumLogWorker.status(), scumCategoryLogStatus: () => scumCategoryLogWorker.status(), chatLogStatus: () => chatLogWorker.status(), vehicleSyncStatus: () => vehicleSyncWorker.status(), domainAccessStatus: () => domainTunnel.domainStatus(), onConfigSaved: async () => { cached?.ggcon.close(); cached = null; signature = ''; await worker.reconfigure(); await announcementWorker.reconfigure(); await monitorWorker.reconfigure(); await maintenanceWorker.reconfigure(); await stockMarketWorker.reconfigure(); await temporaryBanWorker.reconfigure(); await scumLogWorker.reconfigure(); await scumCategoryLogWorker.reconfigure(); await chatLogWorker.reconfigure(); }
  });
  const server = await new Promise((resolve, reject) => {
    const listening = app.listen(0, '127.0.0.1', () => { console.log('SCUM RCON 控制台服务已启动，正在建立公网访问通道。'); resolve(listening); });
    listening.once('error', reject);
  });
  domainTunnel.start();
  try { await worker.start(); await announcementWorker.start(); }
  catch (error) { await domainTunnel.stop(); await worker.stopAndDrain(); await announcementWorker.stopAndDrain(); await new Promise(resolve => server.close(resolve)); await db.close(); throw error; }
  const backgroundWorkerNames = ['monitor', 'maintenance', 'stock-market', 'temporary-ban', 'scum-log', 'scum-category-log', 'chat-log', 'vehicle-sync', 'vehicle-teleport-verification', 'teleport-snapshot'];
  const backgroundStarts = await Promise.allSettled([
    monitorWorker.start(), maintenanceWorker.start(), stockMarketWorker.start(), temporaryBanWorker.start(), scumLogWorker.start(), scumCategoryLogWorker.start(), chatLogWorker.start(), vehicleSyncWorker.start(), vehicleTeleportVerificationWorker.start(), teleportSnapshotWorker.start()
  ]);
  const degradedWorkers = [];
  for (let index = 0; index < backgroundStarts.length; index += 1) {
    const result = backgroundStarts[index];
    if (result.status !== 'rejected') continue;
    degradedWorkers.push(backgroundWorkerNames[index]);
    logger.error('后台 Worker 启动失败', { component: backgroundWorkerNames[index], errorCode: result.reason?.code || result.reason?.name || 'WORKER_START_FAILED' });
  }
  runtime.attach(server.address().port, degradedWorkers);

  const licenseRuntime = new LicenseRuntime({
    store: licenseStore,
    onInvalid: async (error) => {
      console.error(formatLicenseStartupError(error));
      await shutdown(1, false);
      runtime.fail(error);
      await onLicenseInvalid();
    }
  });
  licenseRuntime.start();

  let shuttingDown = false;
  async function shutdown(exitCode = 0, terminate = true) {
    runtime.detach();
    if (shuttingDown) return;
    shuttingDown = true;
    licenseRuntime.stop();
    rconPluginSyncController.abort();
    await domainTunnel.stop();
    await maintenanceWorker.stopAndDrain();
    await stockMarketWorker.stopAndDrain();
    await temporaryBanWorker.stopAndDrain();
    await scumLogWorker.stopAndDrain();
    await scumCategoryLogWorker.stopAndDrain();
    await chatLogWorker.stopAndDrain();
    await vehicleSyncWorker.stopAndDrain();
    await vehicleTeleportVerificationWorker.stopAndDrain();
    await teleportSnapshotWorker.stopAndDrain();
    await worker.stopAndDrain();
    await announcementWorker.stopAndDrain();
    await monitorWorker.stopAndDrain();
    cached?.ggcon.close();
    await new Promise((resolve) => server.close(resolve));
    if (terminate) await db.close();

  }
  return { stop: () => shutdown(0, false), close: () => shutdown(0, true) };
}
