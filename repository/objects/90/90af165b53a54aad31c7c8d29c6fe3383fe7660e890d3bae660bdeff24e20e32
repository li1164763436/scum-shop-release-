<div class="modal-backdrop insurance-modal-backdrop" id="insurancePolicyDetailModal" hidden>
  <section class="modal insurance-modal insurance-policy-detail-modal" role="dialog" aria-modal="true" aria-labelledby="insurancePolicyDetailTitle">
    <button class="modal-close" type="button" data-modal-close aria-label="关闭">×</button>
    <div class="insurance-modal-heading">
      <span>生效保单详情</span>
      <h3 id="insurancePolicyDetailTitle">保险详情</h3>
      <p id="insurancePolicyDetailSummary"></p>
    </div>
    <div class="insurance-detail-grid" id="insurancePolicyDetailGrid"></div>
    <div class="modal-actions insurance-modal-actions">
      <button class="button primary" type="button" data-modal-close>关闭</button>
    </div>
  </section>
</div>

<div class="modal-backdrop insurance-modal-backdrop" id="insuranceVehicleDetailModal" hidden>
  <section class="modal insurance-modal insurance-vehicle-detail-modal" role="dialog" aria-modal="true" aria-labelledby="insuranceVehicleDetailTitle">
    <button class="modal-close" type="button" data-modal-close aria-label="关闭">×</button>
    <div class="insurance-detail-layout">
      <div class="insurance-detail-media">
        <div class="insurance-modal-heading">
          <span>载具详情</span>
          <h3 id="insuranceVehicleDetailTitle">载具明细</h3>
          <p id="insuranceVehicleDetailSummary"></p>
        </div>
        <div class="insurance-detail-image" id="insuranceVehicleDetailImage"></div>
      </div>
      <div class="insurance-detail-selector">
        <div class="insurance-detail-intro">
          <span>选择索赔载具</span>
          <strong>选择索赔载具</strong>
          <p>点击下方载具卡片，选择需要查看和申请索赔的载具。</p>
        </div>
        <div class="insurance-vehicle-choice-list" id="insuranceVehicleDetailChoices" role="listbox" aria-label="选择索赔载具"></div>
      </div>
      <div class="insurance-detail-panel">
        <div class="insurance-detail-intro">
          <span>载具信息</span>
          <strong>载具明细</strong>
        </div>
        <div class="insurance-detail-grid" id="insuranceVehicleDetailGrid"></div>
      </div>
    </div>
    <p class="insurance-claim-warning">索赔将先永久移除游戏内旧载具，确认移除后再发放同型号新载具，此操作不可撤销。</p>
    <div class="modal-actions insurance-modal-actions">
      <button class="button ghost" type="button" data-modal-close>关闭</button>
      <button class="button primary" id="insuranceVehicleClaimConfirm" type="button" data-insurance-claim>立即索赔</button>
    </div>
  </section>
</div>

<div class="modal-backdrop insurance-modal-backdrop" id="insuranceStrategyDetailModal" hidden>
  <section class="modal insurance-modal insurance-strategy-detail-modal" role="dialog" aria-modal="true" aria-labelledby="insuranceStrategyDetailTitle">
    <button class="modal-close" type="button" data-modal-close aria-label="关闭">×</button>
    <div class="insurance-strategy-detail-hero">
      <div class="insurance-strategy-detail-image" id="insuranceStrategyDetailImage"></div>
      <div class="insurance-modal-heading">
        <span>可用保单</span>
        <h3 id="insuranceStrategyDetailTitle">可购买保单</h3>
        <p id="insuranceStrategyDetailSummary"></p>
      </div>
    </div>
    <div class="insurance-strategy-detail-list" id="insuranceStrategyDetailList" role="radiogroup" aria-label="选择可购买保单"></div>
    <div class="modal-actions insurance-modal-actions insurance-strategy-detail-actions">
      <button class="button ghost" type="button" data-modal-close>关闭</button>
      <button class="button primary" id="insuranceStrategyPurchaseSelected" type="button" disabled>购买</button>
    </div>
  </section>
</div>

<div class="modal-backdrop insurance-modal-backdrop" id="insurancePurchaseModal" hidden>
  <section class="modal insurance-modal insurance-purchase-modal" role="dialog" aria-modal="true" aria-labelledby="insurancePurchaseTitle">
    <button class="modal-close" type="button" data-modal-close aria-label="关闭">×</button>
    <div class="insurance-modal-heading">
      <span>购买确认</span>
      <h3 id="insurancePurchaseTitle">确认购买保险</h3>
      <p id="insurancePurchaseDescription"></p>
    </div>
    <div class="insurance-purchase-summary" id="insurancePurchaseSummary"></div>
    <div class="modal-actions insurance-modal-actions">
      <button class="button ghost" type="button" data-modal-close>取消</button>
      <button class="button primary" id="insurancePurchaseConfirm" type="button">确认购买</button>
    </div>
  </section>
</div>
