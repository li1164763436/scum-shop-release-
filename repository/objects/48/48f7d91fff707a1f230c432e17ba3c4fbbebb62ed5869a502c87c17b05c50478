:root{--admin-deep:#17271f;--admin-green:#284638;--admin-gold:#c59a39;--admin-paper:#fff;--admin-soft:#f5f7f5;--admin-line:#dce3dd;--admin-text:#26382f;--admin-muted:#78857d;--admin-shadow:0 8px 24px rgba(35,54,44,.07)}
.page.active{display:block}
.page>.page-toolbar{min-height:88px;margin:0 0 16px;padding:21px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;border:1px solid #294036;border-radius:10px;background:linear-gradient(120deg,var(--admin-deep),#21382c);box-shadow:0 12px 30px rgba(18,39,29,.12)}
.page>.page-toolbar h2{margin:2px 0 3px;color:#fff;font-size:23px;line-height:1.2}.page>.page-toolbar p{margin:0;color:#b9c9bf;font-size:12px;line-height:1.5}.page>.page-toolbar .section-kicker,.page>.page-toolbar .breadcrumb-inline{display:block;margin:0 0 5px;color:#dfbd69;font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
.page>.page-toolbar .toolbar-actions,.page>.page-toolbar .warehouse-toolbar-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}.page>.page-toolbar .btn.secondary{border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.08);color:#edf4ef}.page>.page-toolbar .btn.secondary:hover{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.44)}.page>.page-toolbar .btn.primary{border-color:#dbb958;background:var(--admin-gold);color:#17251e}
.page>.card,.page>form.card,.page>section.card{margin-bottom:16px;border:1px solid var(--admin-line);border-radius:10px;background:var(--admin-paper);box-shadow:var(--admin-shadow)}
.page .card>.card-head,.page .form-card>.card-head{min-height:72px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--admin-line);background:linear-gradient(180deg,#fff,#fafbf9)}
.page .card-head h3{margin:0;color:var(--admin-text);font-size:16px;line-height:1.3}.page .card-head p{margin:4px 0 0;color:var(--admin-muted);font-size:11px;line-height:1.5}.page .card-head>strong{color:#9a741e;font-size:12px}
.page .form-grid{gap:12px}.page .form-card>.form-grid,.page .form-card>form>.form-grid{padding:18px 20px}.page label{color:#58665e;font-size:11px;font-weight:600}.page input:not([type=checkbox]):not([type=radio]),.page select,.page textarea{border:1px solid #d1d9d3;border-radius:6px;background:#fbfcfb;color:#26382f;outline:0;transition:border-color .15s,box-shadow .15s}.page input:not([type=checkbox]):not([type=radio]):focus,.page select:focus,.page textarea:focus{border-color:#83a28f;box-shadow:0 0 0 3px rgba(78,127,96,.1)}
.page .form-actions{padding:13px 20px;display:flex;align-items:center;justify-content:flex-end;gap:8px;border-top:1px solid var(--admin-line);background:#fafbfa}.page .form-actions .save-note{margin-right:auto;color:#839087;font-size:10px}
.page .product-tools,.page .filter-row,.page .account-filter-bar,.page .log-toolbar,.page .stock-toolbar{padding:13px 18px;gap:9px;border-bottom:1px solid var(--admin-line);background:#f7f9f7}.page .search-box{border:1px solid #d3dbd5;border-radius:6px;background:#fff}.page .result-count{color:#68776e;font-size:10px;font-weight:700}
.page .table-wrap{margin:0;overflow:auto}.page table{width:100%;border-collapse:separate;border-spacing:0}.page table th{padding:11px 10px;border-bottom:1px solid #d9e0da;background:#f0f4f1;color:#53645a;font-size:10px;font-weight:800;white-space:nowrap}.page table td{padding:11px 10px;border-bottom:1px solid #edf0ed;color:#34473d;font-size:11px;vertical-align:middle}.page table tbody tr:nth-child(even){background:#fbfcfb}.page table tbody tr:hover{background:#f3f7f4}.page table tbody tr:last-child td{border-bottom:0}
.page .badge,.page .status,.page .status-pill{border-radius:999px;font-weight:700}.page .row-btn{border-radius:5px}.page .row-btn:not(.danger){border-color:#c9d7ce;background:#f2f7f3;color:#3b6650}.page .row-btn.danger{border-color:#e4c4be;background:#fff4f1;color:#a64a3b}
.page .table-pagination{padding:12px 18px;display:flex;align-items:center;justify-content:flex-end;gap:10px;border-top:1px solid var(--admin-line);background:#fafbfa;color:#6f7c74;font-size:11px}.page .table-pagination button{min-width:76px;min-height:32px;padding:5px 11px;border:1px solid #ced6d0;border-radius:6px;background:#fff;color:#3f6752;cursor:pointer}.page .table-pagination button:disabled{color:#a8b2ac;background:#f0f3f1;cursor:not-allowed}.page .table-pagination span{min-width:120px;text-align:center}
.btn{border-radius:6px;font-weight:700}.btn.primary{border-color:#2e5943;background:#2e5943;color:#fff}.btn.primary:hover{background:#244b37}.btn.secondary{border-color:#cfd8d2;background:#fff;color:#52665b}.btn.secondary:hover{border-color:#9eafa4;background:#f7faf8}.btn.danger{border-color:#d9aaa1;background:#fff1ee;color:#a94434}
.modal-backdrop{background:rgba(20,34,27,.48);backdrop-filter:blur(3px)}.modal{border-color:#cad4cd;background:#fff;box-shadow:-18px 0 50px rgba(22,42,31,.22)}.modal-backdrop.centered-modal .modal{border-radius:10px;box-shadow:0 18px 55px rgba(22,42,31,.24)}.modal-head{min-height:72px;padding:16px 19px;color:#fff;background:linear-gradient(120deg,var(--admin-deep),#294637);border-bottom:3px solid var(--admin-gold)}.modal-head h2{color:#fff;font-size:18px}.modal-head p{color:#b9c9bf}.modal-head .icon-btn{color:#fff;background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.25)}.modal-body{padding:18px;gap:13px}.modal-body label{color:#58665e;font-size:11px;font-weight:600}.modal-body input:not([type=checkbox]):not([type=radio]),.modal-body select,.modal-body textarea{border:1px solid #d1d9d3;border-radius:6px;background:#fbfcfb}.modal-actions{padding:13px 18px;border-top:1px solid var(--admin-line);background:#f6f8f6}.modal-section{border:1px solid var(--admin-line);border-left:3px solid #47725a;border-radius:8px;background:#f8faf8}
.empty,.empty-row,.warehouse-inventory-empty,.stock-record-empty{color:#7d8a82}.loading{color:#65786c}
@media(max-width:900px){.page>.page-toolbar{align-items:flex-start;flex-direction:column}.page>.page-toolbar .toolbar-actions,.page>.page-toolbar .warehouse-toolbar-actions{width:100%;justify-content:flex-start}.page .card>.card-head{align-items:flex-start}.modal-section-grid{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.page>.page-toolbar{padding:18px}.page>.page-toolbar h2{font-size:20px}.page .card>.card-head,.page .form-card>.card-head{padding:14px 16px}.page .form-card>.form-grid,.page .form-card>form>.form-grid{padding:14px}.modal-section-grid{grid-template-columns:1fr}.modal-section-grid .full{grid-column:auto}.page .table-pagination{justify-content:center;flex-wrap:wrap}}
