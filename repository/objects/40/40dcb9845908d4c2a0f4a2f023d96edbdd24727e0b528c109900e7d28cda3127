  async saveProduct(input, id = null) {
    const name = String(input.name || '').trim();
    if (!name || name.length > 100) throw new ServiceError('商品名称长度必须为 1-100');
    const price = nonNegativeInt(input.price, '商品价格');
    const parentCategory = optionalText(input.parentCategory, '父级分类', 100);
    const category = optionalText(input.category, '分类', 100);
    const currencyType = normalizeCurrencyType(input.currencyType);
    const minMemberLevel = nonNegativeInt(input.minMemberLevel ?? 0, '会员限制等级');
    const maxUses = input.maxUses === null || input.maxUses === undefined || input.maxUses === '' ? null : positiveInt(input.maxUses, '最大使用次数', 1000000);
    const imagePath = normalizeImagePath(input.imagePath);
    const codes = normalizeFulfillmentCodes(input.fulfillmentCodes ?? input.codes ?? input.itemId).map((code) => {
      if (parentCategory !== 'NPC' || category !== '动物') return code;
      if (/^#spawnitem\s+/i.test(code)) return code.replace(/^#spawnitem\s+/i, '#spawnanimal ');
      if (/^#spawnanimal\s+/i.test(code)) return code.replace(/^#spawnanimal\s+/i, '#spawnanimal ');
      return code;
    });
    const fulfillmentCodes = codes.join(',');
    const itemId = parseProductCode(codes[0], { allowVehicle: true }).itemId;
    const enabled = input.enabled === undefined ? true : Boolean(input.enabled);
    if (id === null) {
      let sku = String(input.sku || '').trim();
      if (sku && !SKU_PATTERN.test(sku)) throw new ServiceError('SKU 格式无效');
      for (let attempt = 0; attempt < 5; attempt += 1) {
        if (!sku) sku = generatedSku();
        try {
          const result = await this.db.query('INSERT INTO products (sku, name, price, item_id, grant_amount, parent_category, category_name, currency_type, min_member_level, max_uses, image_path, fulfillment_codes, enabled) VALUES (?, ?, ?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?)', [sku, name, price, itemId, parentCategory || null, category || null, currencyType, minMemberLevel, maxUses, imagePath || null, fulfillmentCodes, enabled]);
          return { id: result.insertId, sku, name, price, itemId, grantAmount: 1, parentCategory, category, currencyType, minMemberLevel, maxUses, imagePath, fulfillmentCodes, codes, enabled };
        } catch (error) {
          if (input.sku || !isDuplicateKey(error) || attempt === 4) throw error;
          sku = '';
        }
      }
    }
    const productId = positiveInt(id, '商品 ID');
    const existing = await this.db.query('SELECT sku, grant_amount AS grantAmount FROM products WHERE id = ?', [productId]);
    if (!existing[0]) throw new ServiceError('商品不存在', 404, 'NOT_FOUND');
    const sku = String(input.sku ?? existing[0].sku).trim();
    if (!SKU_PATTERN.test(sku)) throw new ServiceError('SKU 格式无效');
    const grantAmount = positiveInt(existing[0].grantAmount, '发放数量', 100000);
    const result = await this.db.query('UPDATE products SET sku = ?, name = ?, price = ?, item_id = ?, parent_category = ?, category_name = ?, currency_type = ?, min_member_level = ?, max_uses = ?, image_path = ?, fulfillment_codes = ?, enabled = ? WHERE id = ?', [sku, name, price, itemId, parentCategory || null, category || null, currencyType, minMemberLevel, maxUses, imagePath || null, fulfillmentCodes, enabled, productId]);
    if (!result.affectedRows) throw new ServiceError('商品不存在', 404, 'NOT_FOUND');
    return { id: productId, sku, name, price, itemId, grantAmount, parentCategory, category, currencyType, minMemberLevel, maxUses, imagePath, fulfillmentCodes, codes, enabled };
  }

