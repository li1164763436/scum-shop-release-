  async listGiftClaimLogs(limit = 300) {
    const safeLimit = positiveInt(limit, '条数', 500);
    const claims = await this.db.query(`SELECT c.id AS claimId,c.steam_id AS steamId,c.price_paid AS pricePaid,c.created_at AS claimedAt,g.id AS giftId,g.name AS giftName,g.gift_type AS giftType,o.id AS orderId,o.created_at AS orderCreatedAt,o.status,u.\`游戏名称\` AS characterName,u.\`登录账号\` AS shopUsername FROM gift_claims c JOIN gift_packages g ON g.id=c.gift_id LEFT JOIN orders o ON o.id=c.order_id LEFT JOIN \`商城用户\` u ON u.\`SteamID\`=c.steam_id ORDER BY c.id DESC LIMIT ${safeLimit}`);
    const orderIds = [...new Set(claims.map((claim) => Number(claim.orderId)).filter(Boolean))];
    if (!orderIds.length) return claims.map((claim) => ({ ...claim, commandRaw: '暂无游戏执行命令' }));
    const placeholders = orderIds.map(() => '?').join(',');
    const tasks = await this.db.query(`SELECT task.order_id AS orderId,task.order_item_id AS orderItemId,task.code_index AS codeIndex,task.steam_id AS steamId,task.task_type AS taskType,task.payload_json AS payloadJson,task.item_id AS itemId,task.amount,task.status,task.last_error AS lastError FROM fulfillment_tasks task JOIN (SELECT order_item_id,code_index,MAX(generation) AS generation FROM fulfillment_tasks WHERE order_id IN (${placeholders}) GROUP BY order_item_id,code_index) latest ON latest.order_item_id=task.order_item_id AND latest.code_index=task.code_index AND latest.generation=task.generation ORDER BY task.order_id,task.order_item_id,task.code_index`, orderIds);
    const commands = new Map();
    const failures = new Map();
    for (const task of tasks) {
      const key = Number(task.orderId);
      const list = commands.get(key) || [];
      list.push(...taskCommands(task));
      commands.set(key, list);
      if (['failed','manual_review'].includes(task.status)) { const notes = failures.get(key) || []; notes.push({ text: fulfillmentFailureText(task.lastError, task.status), source: task.lastError || (task.status === 'manual_review' ? 'manual_review' : 'failed') }); failures.set(key, notes); }
    }
    return claims.map((claim) => { const details = failures.get(Number(claim.orderId)) || (claim.status === 'failed' ? [{ text: '礼包发放任务执行失败，请检查游戏连接和商品命令配置', source: '订单状态为 failed，任务未记录具体错误' }] : []); return { ...claim, commandRaw: (commands.get(Number(claim.orderId)) || ['暂无游戏执行命令']).join('\n'), failureNote: [...new Set(details.map((item) => item.text))].join('；') || null, failureSource: [...new Set(details.map((item) => item.source))].join('；') || null }; });
  }

  async getOrder(id, steamId = null) {
    const orderId = positiveInt(id, '订单 ID');
    const params = [orderId];
    let where = 'id = ?';
    if (steamId !== null) {
      if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
      where += ' AND steam_id = ?';
      params.push(String(steamId));
    }
    const orders = await this.db.query(`SELECT id, order_no AS orderNo, source, external_order_id AS externalOrderId, steam_id AS steamId, total_amount AS totalAmount, status, created_at AS createdAt, updated_at AS updatedAt FROM orders WHERE ${where}`, params);
    if (!orders[0]) throw new ServiceError('订单不存在', 404, 'NOT_FOUND');
    const publicView = steamId !== null;
    const items = await this.db.query(`SELECT id, sku, name, unit_price AS unitPrice, quantity, parent_category AS parentCategory, category_name AS category, currency_type AS currencyType, min_member_level AS minMemberLevel, image_path AS imagePath${publicView ? '' : ', item_id AS itemId, grant_amount AS grantAmount, fulfillment_codes_snapshot AS fulfillmentCodesSnapshot'} FROM order_items WHERE order_id = ? ORDER BY id`, [orderId]);
    if (publicView) return { ...orders[0], items };
    const tasks = await this.db.query('SELECT id, order_item_id AS orderItemId, code_index AS codeIndex, generation, replacement_of_task_id AS replacementOfTaskId, created_by_user_id AS createdByUserId, replacement_reason AS replacementReason, request_key AS requestKey, steam_id AS steamId, item_id AS itemId, amount, status, attempts, next_attempt_at AS nextAttemptAt, last_error AS lastError, delivery_token AS deliveryToken, created_at AS createdAt, updated_at AS updatedAt FROM fulfillment_tasks WHERE order_id = ? ORDER BY order_item_id, code_index, generation', [orderId]);
    return { ...orders[0], items, tasks };
  }

