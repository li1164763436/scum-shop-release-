  async purchaseMembership(steamId, levelValue, requestKey) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const targetLevel = positiveInt(levelValue, '会员等级', 100);
    const key = String(requestKey || '').trim();
    if (!key || key.length > 100) throw new ServiceError('Idempotency-Key 长度必须为 1-100');
    return this.db.transaction(async (tx) => {
      const repeated = await tx.query('SELECT id,steam_id AS steamId,new_level AS memberLevel,price,gift_tokens AS giftTokens,expires_at AS memberExpiresAt,balance_after AS balanceAfter FROM membership_purchases WHERE request_key=? FOR UPDATE', [key]);
      if (repeated[0]) {
        if (String(repeated[0].steamId) !== String(steamId) || Number(repeated[0].memberLevel) !== targetLevel) throw new ServiceError('Idempotency-Key 已被其他会员购买请求使用', 409, 'IDEMPOTENCY_CONFLICT');
        return { ...repeated[0], idempotent: true };
      }
      const policy = (await tx.query('SELECT * FROM membership_policy WHERE id=1 FOR UPDATE'))[0] || {};
      const target = (await tx.query('SELECT level,title,opening_amount AS openingAmount,period_days AS periodDays,gift_tokens AS giftTokens FROM membership_strategies WHERE enabled=1 AND level=? FOR UPDATE', [targetLevel]))[0];
      if (!target) throw new ServiceError('会员等级当前不可购买', 404, 'NOT_FOUND');
      const user = (await tx.query("SELECT `商城用户编号` AS id,`会员等级` AS memberLevel,`会员到期时间` AS memberExpiresAt,`商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? AND `账户状态`='active' FOR UPDATE", [String(steamId)]))[0];
      if (!user) throw new ServiceError('商城用户不存在或已停用', 403, 'SHOP_USER_UNAVAILABLE');
      const account = user;
      const now = this.clock(), oldLevel = Number(user.memberLevel || 0);
      const active = oldLevel > 0 && (!user.memberExpiresAt || new Date(user.memberExpiresAt).getTime() > now);
      let purchaseType = 'open', price = Number(target.openingAmount), giftTokens = Number(target.giftTokens || 0), base = new Date(now);
      if (!active) {
        if (!policy.open_enabled) throw new ServiceError('会员开通当前已关闭', 409, 'MEMBERSHIP_OPEN_DISABLED');
      } else if (oldLevel === targetLevel) {
        if (!policy.renewal_enabled) throw new ServiceError('同等级续费当前已关闭', 409, 'MEMBERSHIP_RENEW_DISABLED');
        purchaseType = 'renew';
        base = user.memberExpiresAt ? new Date(Math.max(now, new Date(user.memberExpiresAt).getTime())) : new Date(now);
        if (policy.renewal_price_strategy === 'discount') price = Math.round(price * Number(policy.renewal_discount) / 100);
        else if (policy.renewal_price_strategy === 'fixed') price = Number(policy.renewal_fixed_price || 0);
        giftTokens = policy.renewal_gift_enabled ? Number(target.giftTokens || 0) : 0;
      } else if (targetLevel > oldLevel) {
        if (policy.upgrade_strategy !== 'allow') throw new ServiceError('高级会员升级当前已关闭', 409, 'MEMBERSHIP_UPGRADE_DISABLED');
        purchaseType = 'upgrade';
        const current = (await tx.query('SELECT opening_amount AS openingAmount FROM membership_strategies WHERE level=?', [oldLevel]))[0];
        price = Math.max(0, Number(target.openingAmount) - Number(current?.openingAmount || 0));
        giftTokens = policy.upgrade_gift_enabled ? Number(policy.upgrade_gift_amount || 0) : 0;
        base = policy.upgrade_expiry_strategy === 'extend' && user.memberExpiresAt ? new Date(Math.max(now, new Date(user.memberExpiresAt).getTime())) : new Date(now);
      } else {
        if (policy.lower_level_purchase !== 'allow') throw new ServiceError('禁止购买低等级会员', 409, 'LOWER_LEVEL_FORBIDDEN');
        purchaseType = 'lower';
      }
      const expiresAt = new Date(base.getTime() + Number(target.periodDays) * 86400000);
      const balance = Number(account.balance);
      if (balance < price) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
      const after = balance - price + giftTokens;
      await tx.query('UPDATE `商城用户` SET `会员等级`=?,`会员到期时间`=?,`商城币余额`=? WHERE `商城用户编号`=?', [targetLevel, expiresAt, after, user.id]);
      const inserted = await tx.query('INSERT INTO membership_purchases (request_key,steam_id,old_level,new_level,purchase_type,price,gift_tokens,expires_at,balance_after) VALUES (?,?,?,?,?,?,?,?,?)', [key, String(steamId), oldLevel, targetLevel, purchaseType, price, giftTokens, expiresAt, after]);
      await tx.query('INSERT INTO membership_change_logs (steam_id,old_level,new_level,old_expires_at,new_expires_at,reason,operator) VALUES (?,?,?,?,?,?,?)', [String(steamId), oldLevel, targetLevel, user.memberExpiresAt || null, expiresAt, '会员' + purchaseType, 'shop']);
      await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'membership_purchase','membership_purchase',?,?)", [String(steamId), -price + giftTokens, after, String(inserted.insertId), target.title + ' ' + purchaseType]);
      return { id: inserted.insertId, memberLevel: targetLevel, memberExpiresAt: expiresAt, price, giftTokens, balanceAfter: after, purchaseType, idempotent: false };
    });
  }

