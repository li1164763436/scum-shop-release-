  async listLotteryFulfillmentLogs({ page = 1, limit = 50 } = {}) {
    const safePage = positiveInt(page, '页码');
    const safeLimit = Math.min(positiveInt(limit, '条数', 1000000), 100);
    const offset = (safePage - 1) * safeLimit;
    if (!Number.isSafeInteger(offset)) throw new ServiceError('页码过大');
    const totals = await this.db.query('SELECT COUNT(*) AS total FROM lottery_fulfillment_logs');
    const items = await this.db.query(`SELECT l.id, l.lottery_batch_id AS lotteryBatchId, l.lottery_draw_id AS lotteryDrawId, l.order_id AS orderId, o.order_no AS orderNo, l.fulfillment_task_id AS fulfillmentTaskId, l.steam_id AS steamId, l.pool_id AS poolId, l.pool_name_snapshot AS poolName, l.reward_type AS rewardType, l.reward_name_snapshot AS rewardName, l.task_type AS taskType, l.status, l.error_summary AS errorSummary, l.created_at AS createdAt, l.updated_at AS updatedAt FROM lottery_fulfillment_logs l JOIN orders o ON o.id=l.order_id ORDER BY l.id DESC LIMIT ${safeLimit} OFFSET ${offset}`);
    return { page: safePage, limit: safeLimit, total: Number(totals[0]?.total || 0), items };
  }
}

export function verifyCallback({ rawBody, timestamp, signature, sharedSecret, now = Date.now(), toleranceMs = 300000 }) {
  if (!sharedSecret) throw new ServiceError('回调密钥未配置', 503, 'NOT_CONFIGURED');
  const timestampText = String(timestamp || '');
  if (!/^\d{10,13}$/.test(timestampText)) throw new ServiceError('timestamp 无效', 401, 'INVALID_SIGNATURE');
  const milliseconds = timestampText.length === 10 ? Number(timestampText) * 1000 : Number(timestampText);
  if (Math.abs(now - milliseconds) > toleranceMs) throw new ServiceError('回调已过期', 401, 'EXPIRED_CALLBACK');
  const supplied = String(signature || '').replace(/^sha256=/i, '').toLowerCase();
  if (!/^[a-f0-9]{64}$/.test(supplied)) throw new ServiceError('signature 无效', 401, 'INVALID_SIGNATURE');
  const body = Buffer.isBuffer(rawBody) ? rawBody : Buffer.from(rawBody || '');
  const expected = crypto.createHmac('sha256', sharedSecret).update(timestampText).update('.').update(body).digest('hex');
  if (!crypto.timingSafeEqual(Buffer.from(supplied, 'hex'), Buffer.from(expected, 'hex'))) throw new ServiceError('签名校验失败', 401, 'INVALID_SIGNATURE');
  return true;
}












