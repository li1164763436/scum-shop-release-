  async createReplacementTask(id, { requestKey, userId, reason, confirmUnknownDeliveryRisk = false }) {
    const taskId = positiveInt(id, '任务 ID');
    const adminId = positiveInt(userId, '管理员用户 ID');
    const key = String(requestKey || '').trim();
    const safeReason = String(reason || '').trim();
    if (!key || key.length > 100) throw new ServiceError('Idempotency-Key 长度必须为 1-100');
    if (safeReason.length > 500) throw new ServiceError('补单原因不能超过 500 字符');
    try {
      return await this.db.transaction(async (tx) => {
      const existing = await tx.query('SELECT id, order_id AS orderId, order_item_id AS orderItemId, code_index AS codeIndex, generation, replacement_of_task_id AS replacementOfTaskId, created_by_user_id AS createdByUserId, replacement_reason AS replacementReason, request_key AS requestKey, steam_id AS steamId, task_type AS taskType, payload_json AS payloadJson, coin_amount AS coinAmount, item_id AS itemId, amount, status, attempts, created_at AS createdAt, updated_at AS updatedAt FROM fulfillment_tasks WHERE request_key = ? FOR UPDATE', [key]);
      if (existing[0]) return { ...existing[0], idempotent: true };
      const rows = await tx.query('SELECT id, order_id AS orderId, order_item_id AS orderItemId, code_index AS codeIndex, generation, steam_id AS steamId, task_type AS taskType, payload_json AS payloadJson, coin_amount AS coinAmount, item_id AS itemId, amount, status FROM fulfillment_tasks WHERE id = ? FOR UPDATE', [taskId]);
      const task = rows[0];
      if (!task) throw new ServiceError('任务不存在', 404, 'NOT_FOUND');
      const latest = await tx.query('SELECT id, generation FROM fulfillment_tasks WHERE order_item_id = ? AND code_index = ? ORDER BY generation DESC LIMIT 1 FOR UPDATE', [task.orderItemId, task.codeIndex]);
      if (Number(latest[0].id) !== taskId) throw new ServiceError('只允许基于最新一代任务创建补单', 409, 'NOT_LATEST_GENERATION');
      if (['pending', 'processing', 'dispatching', 'waiting_instance', 'waiting_offline', 'retry'].includes(task.status)) throw new ServiceError('任务仍在队列或处理中，不能创建补单', 409, 'TASK_ACTIVE');
      if (task.status === 'failed') throw new ServiceError('失败任务请使用原任务重试功能', 409, 'USE_RETRY');
      if (task.status === 'manual_review' && confirmUnknownDeliveryRisk !== true) throw new ServiceError('发货结果未知，必须显式确认重复发货风险', 409, 'CONFIRM_UNKNOWN_DELIVERY_RISK');
      if (task.status === 'completed' && !safeReason) throw new ServiceError('已完成任务补偿发货必须填写原因');
      if (!['manual_review', 'completed'].includes(task.status)) throw new ServiceError('当前任务状态不可创建补单', 409, 'NOT_REPLACEABLE');
      const generation = Number(task.generation) + 1;
      const inserted = await tx.query("INSERT INTO fulfillment_tasks (order_id, order_item_id, code_index, generation, replacement_of_task_id, created_by_user_id, replacement_reason, request_key, steam_id, task_type, payload_json, coin_amount, item_id, amount, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending')", [task.orderId, task.orderItemId, task.codeIndex, generation, task.id, adminId, safeReason || null, key, task.steamId, task.taskType, task.payloadJson, task.coinAmount, task.itemId, task.amount]);
      await recomputeOrderStatus(tx, task.orderId);
      return { id: inserted.insertId, orderId: task.orderId, orderItemId: task.orderItemId, codeIndex: task.codeIndex, generation, replacementOfTaskId: task.id, createdByUserId: adminId, replacementReason: safeReason || null, requestKey: key, steamId: task.steamId, itemId: task.itemId, amount: task.amount, status: 'pending', attempts: 0, idempotent: false };
      });
    } catch (error) {
      if (!isDuplicateKey(error)) throw error;
      const existing = await this.db.query('SELECT id, order_id AS orderId, order_item_id AS orderItemId, code_index AS codeIndex, generation, replacement_of_task_id AS replacementOfTaskId, created_by_user_id AS createdByUserId, replacement_reason AS replacementReason, request_key AS requestKey, steam_id AS steamId, item_id AS itemId, amount, status, attempts, created_at AS createdAt, updated_at AS updatedAt FROM fulfillment_tasks WHERE request_key = ?', [key]);
      if (!existing[0]) throw error;
      return { ...existing[0], idempotent: true };
    }
  }

  async retryTask(id) {
    const taskId = positiveInt(id, '任务 ID');
    return this.db.transaction(async (tx) => {
      const rows = await tx.query('SELECT order_id AS orderId, status FROM fulfillment_tasks WHERE id = ? FOR UPDATE', [taskId]);
      if (!rows[0] || rows[0].status === 'manual_review' || !['failed', 'retry', 'waiting_instance', 'waiting_offline'].includes(rows[0].status)) throw new ServiceError('任务不存在或当前状态不可重试', 409, 'NOT_RETRYABLE');
      await tx.query("UPDATE fulfillment_tasks SET status = 'retry', next_attempt_at = CURRENT_TIMESTAMP(3), last_error = NULL, locked_at = NULL WHERE id = ?", [taskId]);
      await tx.query("UPDATE lottery_fulfillment_logs SET status='retry', error_summary=NULL WHERE fulfillment_task_id=?", [taskId]);
      await recomputeOrderStatus(tx, rows[0].orderId);
    });
  }

