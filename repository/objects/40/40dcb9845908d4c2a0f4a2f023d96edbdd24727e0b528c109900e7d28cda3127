    const next = (await this.db.query('SELECT level,title,upgrade_spend AS upgradeSpend FROM membership_strategies WHERE enabled=1 AND level>? ORDER BY level LIMIT 1', [currentLevel]))[0] || null;
    return { steamId: String(steamId), username: users[0].username, currentLevel, memberExpiresAt: users[0].memberExpiresAt || null, totalSpent, nextLevel: next ? Number(next.level) : null, nextTitle: next?.title || null, nextUpgradeSpend: next ? Number(next.upgradeSpend) : null, remainingSpend: next ? Math.max(0, Number(next.upgradeSpend) - totalSpent) : 0, eligible: Boolean(next) && totalSpent >= Number(next.upgradeSpend) };
  }

