  async listMemberships({ page = 1, limit = 15, search = '', level = '', status = '' } = {}) {
    const safePage = membershipPage(page);
    const safeLimit = Number(limit);
    if (!Number.isInteger(safeLimit) || safeLimit !== 15) throw new ServiceError('会员列表每页固定为 15 条', 400, 'INVALID_PAGINATION');
    const steamId = String(search || '').trim();
    if (steamId && !/^\d{1,17}$/.test(steamId)) throw new ServiceError('SteamID 搜索格式无效', 400, 'INVALID_INPUT');
    const where = ['u.`SteamID` IS NOT NULL'];
    const params = [];
    if (steamId) { where.push('u.`SteamID` LIKE ?'); params.push(`%${steamId}%`); }
    if (level !== '' && level !== undefined) { const safeLevel = nonNegativeInt(level, '会员等级'); where.push('u.`会员等级`=?'); params.push(safeLevel); }
    const safeStatus = String(status || '');
    if (safeStatus === 'active') where.push('u.`会员等级`>0 AND (u.`会员到期时间` IS NULL OR u.`会员到期时间`>CURRENT_TIMESTAMP(3))');
    else if (safeStatus === 'permanent') where.push('u.`会员等级`>0 AND u.`会员到期时间` IS NULL');
    else if (safeStatus === 'expiring') where.push('u.`会员等级`>0 AND u.`会员到期时间`>CURRENT_TIMESTAMP(3) AND u.`会员到期时间`<=DATE_ADD(CURRENT_TIMESTAMP(3), INTERVAL 7 DAY)');
    else if (safeStatus === 'expired') where.push('u.`会员等级`>0 AND u.`会员到期时间`<=CURRENT_TIMESTAMP(3)');
    else if (safeStatus === 'none') where.push('u.`会员等级`=0');
    else if (safeStatus) throw new ServiceError('会员状态筛选无效', 400, 'INVALID_INPUT');
    const clause = `WHERE ${where.join(' AND ')}`;
    const [countRows, stats] = await Promise.all([
      this.db.query(`SELECT COUNT(*) AS count FROM \`商城用户\` u ${clause}`, params),
      this.membershipStats()
    ]);
    const items = await this.db.query(`SELECT u.\`商城用户编号\` AS userId,u.\`登录账号\` AS username,u.\`SteamID\` AS steamId,u.\`会员等级\` AS memberLevel,u.\`会员到期时间\` AS memberExpiresAt,CASE WHEN u.\`会员等级\`>0 AND (u.\`会员到期时间\` IS NULL OR u.\`会员到期时间\`>CURRENT_TIMESTAMP(3)) THEN u.\`会员等级\` ELSE 0 END AS effectiveMemberLevel,CASE WHEN u.\`会员等级\`=0 THEN 'none' WHEN u.\`会员到期时间\` IS NULL THEN 'permanent' WHEN u.\`会员到期时间\`>CURRENT_TIMESTAMP(3) THEN 'active' ELSE 'expired' END AS memberStatus,u.\`商城币余额\` AS balance,u.\`最后登录时间\` AS lastLoginAt,latest.character_name AS characterName,latest.steam_name AS steamName FROM \`商城用户\` u LEFT JOIN online_player_snapshots latest ON latest.sample_id=(SELECT p.sample_id FROM online_player_snapshots p WHERE p.steam_id=u.\`SteamID\` ORDER BY p.observed_at DESC,p.sample_id DESC LIMIT 1) AND latest.steam_id=u.\`SteamID\` ${clause} ORDER BY u.\`会员等级\`>0 DESC,u.\`会员到期时间\` IS NULL DESC,u.\`会员到期时间\` DESC,u.\`商城用户编号\` DESC LIMIT 15 OFFSET ${(safePage - 1) * 15}`, params);
    return { items, page: safePage, limit: 15, total: Number(countRows[0]?.count || 0), totalMembers: stats.total, activeMembers: stats.active, expiringSoon: stats.expiringSoon };
  }

