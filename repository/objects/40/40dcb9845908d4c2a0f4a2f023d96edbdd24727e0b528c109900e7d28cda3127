  async claimGift(steamId, gift) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const normalizedGift = normalizeGift(gift);
    if (!normalizedGift.enabled) throw new ServiceError('礼包当前未开放', 409, 'GIFT_DISABLED');
    const normalized = normalizeItems(normalizedGift.items);
    const external = giftExternalOrderId(normalizedGift.id, steamId);
    const existing = await this.findExternalOrder('starter_gift', external);
    if (existing) return { id: existing.id, orderNo: existing.orderNo, status: existing.status, idempotent: true };
    try {
      return await this.db.transaction(async (tx) => {
        await tx.query('INSERT INTO `商城用户` (`SteamID`,`商城币余额`) VALUES (?,0) ON DUPLICATE KEY UPDATE `SteamID`=VALUES(`SteamID`)', [String(steamId)]);
        const placeholders = normalized.map(() => '?').join(',');
        const products = await tx.query(`SELECT id, sku, name, item_id, grant_amount, parent_category, category_name, currency_type, min_member_level, image_path, fulfillment_codes FROM products WHERE enabled = 1 AND sku IN (${placeholders}) FOR UPDATE`, normalized.map((item) => item.sku));
        if (products.length !== normalized.length) throw new ServiceError('礼包包含不存在或已下架的商品', 409, 'PRODUCT_UNAVAILABLE');
        const bySku = new Map(products.map((product) => [product.sku, product]));
        const number = orderNo();
        const hash = requestHash(steamId, normalized);
        const order = await tx.query("INSERT INTO orders (order_no, source, external_order_id, request_hash, steam_id, total_amount, status) VALUES (?, 'starter_gift', ?, ?, ?, 0, 'pending')", [number, external, hash, String(steamId)]);
        for (const item of normalized) {
          const product = bySku.get(item.sku);
          const codes = productCodes(product);
          const snapshot = codes.join(',');
          const detail = await tx.query('INSERT INTO order_items (order_id, product_id, sku, name, unit_price, quantity, item_id, grant_amount, parent_category, category_name, currency_type, min_member_level, image_path, fulfillment_codes_snapshot) VALUES (?, ?, ?, ?, 0, ?, ?, ?, ?, ?, ?, ?, ?, ?)', [order.insertId, product.id, product.sku, product.name, item.quantity, product.item_id, product.grant_amount, product.parent_category || null, product.category_name || null, product.currency_type || 'coin', product.min_member_level || 0, product.image_path || null, snapshot]);
          const deliveries = codes.flatMap((code) => {
            const delivery = productDelivery(code, product.grant_amount * item.quantity);
            return splitItemDelivery(delivery);
          });
          for (const [codeIndex, delivery] of deliveries.entries()) {
            await tx.query("INSERT INTO fulfillment_tasks (order_id, order_item_id, code_index, steam_id, item_id, amount, payload_json, status) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending')", [order.insertId, detail.insertId, codeIndex, String(steamId), delivery.itemId, delivery.amount, delivery.payload ? JSON.stringify(delivery.payload) : null]);
          }
        }
        return { id: order.insertId, orderNo: number, status: 'pending', totalAmount: 0, idempotent: false };
      });
    } catch (error) {
      if (!isDuplicateKey(error)) throw error;
      const claimed = await this.findExternalOrder('starter_gift', external);
      if (!claimed) throw error;
      return { id: claimed.id, orderNo: claimed.orderNo, status: claimed.status, idempotent: true };
    }
  }

