import crypto from 'node:crypto';
import { lotteryRewardDisplay } from './lottery-reward-display.js';
import { buildItemCommand, isSteamId64 } from './command-policy.js';
import { parseGiftCode, renderGiftRconCommand } from './gift-code-policy.js';

const SKU_PATTERN = /^[A-Za-z0-9_.-]{1,64}$/;
export const ITEM_PATTERN = /^[A-Za-z0-9_]{1,80}$/;
const CURRENCY_TYPES = new Set(['coin', '商城币', 'money', 'gold']);
const IMAGE_UPLOAD_PATTERN = /^\/uploads\/(?:images|products)(?:\/[\p{L}\p{N}_ ()&-]{1,100})*\/[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$/u;
const MAX_CODES = 50;
const MAX_CODES_LENGTH = 4096;

export class ServiceError extends Error {
  constructor(message, status = 400, code = 'BAD_REQUEST') {
    super(message);
    this.status = status;
    this.code = code;
  }
}

function taskCommands(task) {
  let payload = task.payloadJson;
  if (typeof payload === 'string') { try { payload = JSON.parse(payload); } catch { payload = null; } }
  const actionType = payload?.actionType;
  if (actionType === 'warehouse') return ['无游戏命令：奖励存入云储仓库'];
  if (actionType === 'shop_coin') return ['无游戏命令：商城币直接入账'];
  if (['spawn_vehicle','spawn_animal','spawn_zombie','spawn_armed_npc'].includes(actionType)) {
    const names = { spawn_vehicle: 'SpawnVehicle', spawn_animal: 'SpawnAnimal', spawn_zombie: 'SpawnZombie', spawn_armed_npc: 'SpawnArmedNPC' };
    if (actionType === 'spawn_zombie') return [`SpawnZombieForPlayer ${task.steamId} ${payload.itemId} ${payload.quantity} CONFIRM`];
    if (actionType === 'spawn_animal') return [`SpawnAnimalForPlayer ${task.steamId} ${payload.itemId} ${payload.quantity} CONFIRM`];
    return [`#${names[actionType]} ${payload.itemId} ${payload.quantity} Location ${task.steamId}`];
  }
  const total = Number(payload?.quantity || task.amount || 0);
  return Array.from({ length: Math.ceil(total / 10) }, (_, index) => {
    const amount = Math.min(10, total - index * 10);
    if (payload) return renderGiftRconCommand({ taskType: 'spawn_item', payload: { ...payload, quantity: amount } }, task.steamId);
    return buildItemCommand({ steamId: task.steamId, itemId: task.itemId, amount }, { allowedMessageLength: 500, allowedItems: [{ id: task.itemId, name: task.itemId, maxAmount: 10 }] });
  });
}
function fulfillmentFailureText(value, status) {
  const source = String(value || '').trim();
  if (/玩家当前离线|waiting_offline/i.test(source)) return '玩家不在线，发放任务等待玩家上线';
  if (/ECONNREFUSED|connect.*refused/i.test(source)) return 'RCON连接被拒绝，请检查游戏服务和插件状态';
  if (/timeout|timed out|超时/i.test(source)) return 'RCON连接或游戏命令执行超时';
  if (/unknown command|not supported|不支持.*命令/i.test(source)) return '游戏端插件不支持该发放命令';
  if (/未返回明确成功|明确成功结果/i.test(source)) return '游戏命令已发送，但未返回明确成功结果';
  if (/参数无效|invalid/i.test(source)) return '商品发放参数无效，请检查商品命令配置';
  if (/人工核验|manual_review/i.test(source) || status === 'manual_review') return '任务已进入发货阶段，结果需要人工核验';
  return '礼包发放任务执行失败，请检查游戏连接和商品命令配置';
}

function positiveInt(value, name, max = 1000000) {
  const number = Number(value);
  if (!Number.isSafeInteger(number) || number < 1 || number > max) throw new ServiceError(`${name}必须是 1-${max} 的整数`);
  return number;
}

function nonNegativeInt(value, name) {
  const number = Number(value);
  if (!Number.isSafeInteger(number) || number < 0) throw new ServiceError(`${name}必须是非负整数`);
  return number;
}

function membershipPage(value) {
  const page = Number(value ?? 1);
  if (!Number.isInteger(page) || page < 1) throw new ServiceError('页码必须是正整数', 400, 'INVALID_PAGINATION');
  return page;
}

function membershipInput(input, cancel = false) {
  const keys = Object.keys(input || {});
  const allowed = cancel ? ['reason'] : ['level', 'expiresAt', 'reason'];
  if (keys.some((key) => !allowed.includes(key))) throw new ServiceError('会员操作包含不允许的字段', 400, 'INVALID_INPUT');
  const reason = String(input?.reason || '').trim();
  if (!reason || reason.length > 500) throw new ServiceError('操作原因须为 1-500 个字符', 400, 'INVALID_INPUT');
  if (cancel) return { level: 0, expiresAt: null, reason };
  const level = Number(input?.level);
  if (!Number.isInteger(level) || level < 1 || level > 100) throw new ServiceError('会员等级须为 1-100 的整数', 400, 'INVALID_INPUT');
  let expiresAt = null;
  if (input?.expiresAt !== null && input?.expiresAt !== undefined && input.expiresAt !== '') {
    expiresAt = new Date(input.expiresAt);
    if (Number.isNaN(expiresAt.getTime())) throw new ServiceError('会员到期时间格式无效', 400, 'INVALID_INPUT');
  }
  return { level, expiresAt, reason };
}

function percentValue(value, name) {
  const number = Number(value ?? 100);
  if (!Number.isFinite(number) || number < 0 || number > 100) throw new ServiceError(`${name}必须是 0-100 的数字`, 400, 'INVALID_INPUT');
  return Number(number.toFixed(2));
}

function membershipStrategyInput(input) {
  const level = Number(input?.level);
  if (!Number.isInteger(level) || level < 0 || level > 100) throw new ServiceError('会员等级须为 0-100 的整数', 400, 'INVALID_INPUT');
  const title = String(input?.title || '').trim();
  if (!title || title.length > 100) throw new ServiceError('会员称号长度必须为 1-100', 400, 'INVALID_INPUT');
  const extraHint = String(input?.extraHint || '').trim();
  if (extraHint.length > 500) throw new ServiceError('额外提示不能超过 500 字符', 400, 'INVALID_INPUT');
  return {
    level,
    title,
    openingAmount: nonNegativeInt(input?.openingAmount ?? 0, '开通金额'),
    periodDays: positiveInt(input?.periodDays ?? 30, '开通周期', 36500),
    giftTokens: nonNegativeInt(input?.giftTokens ?? 0, '赠送代币'),
    upgradeSpend: nonNegativeInt(input?.upgradeSpend ?? 0, '升级所需消费'),
    teleportDiscount: percentValue(input?.teleportDiscount, '传送折扣'),
    onlineBonus: percentValue(input?.onlineBonus, '在线加成', 1000),
    shoppingDiscount: percentValue(input?.shoppingDiscount, '购物折扣'),
    giftDiscount: percentValue(input?.giftDiscount, '礼包折扣'),
    rechargeBonus: percentValue(input?.rechargeBonus, '充值加成'),
    dailyTeleports: nonNegativeInt(input?.dailyTeleports ?? 0, '每日传送次数'),
    checkinBonus: nonNegativeInt(input?.checkinBonus ?? 0, '签到额外赠送商城币'),
    extraHint,
    enabled: input?.enabled === undefined ? true : Boolean(input.enabled)
  };
}

function membershipPolicyInput(input = {}) {
  const renewalPriceStrategy = String(input.renewalPriceStrategy || 'original');
  const upgradeStrategy = String(input.upgradeStrategy || 'allow');
  const upgradeExpiryStrategy = String(input.upgradeExpiryStrategy || 'extend');
  const lowerLevelPurchase = String(input.lowerLevelPurchase || 'forbid');
  if (!['original','discount','fixed'].includes(renewalPriceStrategy)) throw new ServiceError('续费价格策略无效', 400, 'INVALID_INPUT');
  if (!['allow','forbid'].includes(upgradeStrategy)) throw new ServiceError('高级会员升级策略无效', 400, 'INVALID_INPUT');
  if (!['extend','reset'].includes(upgradeExpiryStrategy)) throw new ServiceError('升级到期策略无效', 400, 'INVALID_INPUT');
  if (!['allow','forbid'].includes(lowerLevelPurchase)) throw new ServiceError('低等级购买策略无效', 400, 'INVALID_INPUT');
  const openEnabled = Boolean(input.openEnabled), consumptionUpgradeEnabled = Boolean(input.consumptionUpgradeEnabled);
  if (openEnabled === consumptionUpgradeEnabled) throw new ServiceError('开通制和消费制必须且只能启用一项', 400, 'INVALID_MEMBERSHIP_MODE');
  return {
    openEnabled, consumptionUpgradeEnabled, renewalEnabled: Boolean(input.renewalEnabled),
    renewalPriceStrategy, renewalGiftEnabled: Boolean(input.renewalGiftEnabled), renewalDiscount: percentValue(input.renewalDiscount, '续费折扣'),
    renewalFixedPrice: nonNegativeInt(input.renewalFixedPrice || 0, '续费固定价'), upgradeStrategy, upgradeExpiryStrategy,
    upgradeGiftEnabled: Boolean(input.upgradeGiftEnabled), upgradeGiftAmount: nonNegativeInt(input.upgradeGiftAmount || 0, '升级赠送代币'), lowerLevelPurchase
  };
}

function optionalText(value, name, max) {
  const text = String(value || '').trim();
  if (text.length > max) throw new ServiceError(`${name}不能超过 ${max} 字符`);
  return text;
}

function normalizeCurrencyType(value) {
  const currencyType = String(value || 'coin').trim();
  if (!CURRENCY_TYPES.has(currencyType)) throw new ServiceError('货币类型仅支持商城币、美金、金条');
  return currencyType;
}

export function normalizeImagePath(value) {
  const imagePath = String(value || '').trim();
  if (imagePath.length > 500) throw new ServiceError('图片路径不能超过 500 字符');
  if (!imagePath) return '';
  if (IMAGE_UPLOAD_PATTERN.test(imagePath)) return imagePath;
  try {
    const url = new URL(imagePath);
    if ((url.protocol === 'http:' || url.protocol === 'https:') && url.href.length <= 500) return imagePath;
  } catch {}
  throw new ServiceError('图片路径仅支持本地上传路径或 http/https URL');
}

export function normalizeFulfillmentCodes(value) {
  const raw = Array.isArray(value) ? value.map((item) => String(item)).join('\n') : String(value || '');
  if (raw.length > MAX_CODES_LENGTH) throw new ServiceError(`发货代码总长不能超过 ${MAX_CODES_LENGTH} 字符`);
  const entries = Array.isArray(value) ? value : raw.split(/[\r\n,]+/);
  const codes = [];
  for (const entry of entries) {
    const text = String(entry || '').trim();
    if (!text) continue;
    parseProductCode(text, { allowVehicle: true });
    const code = /^#(?:spawnitem|spawnvehicle|spawnanimal|spawnzombie|spawnarmednpc)\s+/i.test(text)
      ? text
      : `#spawnitem ${text}`;
    codes.push(code);
  }
  if (!codes.length) throw new ServiceError('至少需要一条发货代码');
  if (codes.length > MAX_CODES) throw new ServiceError(`发货代码最多 ${MAX_CODES} 条`);
  if (codes.join(',').length > MAX_CODES_LENGTH) throw new ServiceError(`发货代码总长不能超过 ${MAX_CODES_LENGTH} 字符`);
  return codes;
}

export function parseProductCode(value, { allowVehicle = true } = {}) {
  const text = String(value || '').trim();
  if (/^#spawnanimal\b/i.test(text)) {
    const match = text.match(/^#spawnanimal\s+([A-Za-z0-9_]{1,80})(?:\s+([1-9]\d*))?$/i);
    if (!match) throw new ServiceError('动物代码格式无效，仅支持 #spawnanimal <动物代码> [数量]');
    return { itemId: match[1], quantity: Number(match[2] || 1), arguments: [], actionType: 'spawn_animal' };
  }
  if (/^#spawnzombie\b/i.test(text)) {
    const match = text.match(/^#spawnzombie\s+([A-Za-z0-9_]{1,80})(?:\s+([1-9]\d*))?$/i);
    if (!match) throw new ServiceError('木偶代码格式无效，仅支持 #SpawnZombie <木偶代码> [数量]');
    return { itemId: match[1], quantity: Number(match[2] || 1), arguments: [], actionType: 'spawn_zombie' };
  }
  if (/^#spawnarmednpc\b/i.test(text)) {
    const match = text.match(/^#spawnarmednpc\s+([A-Za-z0-9_]{1,80})$/i);
    if (!match) throw new ServiceError('武装 NPC 代码格式无效，仅支持 #SpawnArmedNPC <NPC代码>');
    return { itemId: match[1], quantity: 1, arguments: [], actionType: 'spawn_armed_npc' };
  }
  if (/^#spawnvehicle\b/i.test(text)) {
    const match = text.match(/^#spawnvehicle\s+([A-Za-z0-9_]{1,80})$/i);
    if (!match) throw new ServiceError('车辆代码格式无效，仅支持 #SpawnVehicle 车辆代码');
    if (!allowVehicle) throw new ServiceError('当前 RCON 插件未支持车辆发货，暂不允许购买或兑换', 409, 'VEHICLE_DELIVERY_UNAVAILABLE');
    return { itemId: match[1], quantity: 1, arguments: [], actionType: 'spawn_vehicle' };
  }
  const code = String(value || '').trim().replace(/^#spawnitem\s+/i, '');
  const tokens = code.split(/\s+/);
  if (tokens.length === 1 || !/^\d+$/.test(tokens[1])) tokens.splice(1, 0, '1');
  try {
    return parseGiftCode(`#spawnitem ${tokens.join(' ')}`).payload;
  } catch (error) {
    throw new ServiceError(error.message);
  }
}

function productCodes(product) {
  return normalizeFulfillmentCodes(product.fulfillment_codes || product.item_id);
}

export function productDelivery(code, multiplier) {
  const payload = parseProductCode(code);
  const quantity = payload.quantity * multiplier;
  if (payload.actionType === 'spawn_armed_npc') {
    positiveInt(quantity, '武装 NPC 数量', 100);
    return { payload: { actionType: 'spawn_armed_npc', itemId: payload.itemId, quantity: 1 }, itemId: payload.itemId, amount: quantity };
  }
  if (payload.actionType === 'spawn_vehicle') {
    positiveInt(quantity, '车辆数量', 100);
    return { payload: { actionType: 'spawn_vehicle', itemId: payload.itemId, quantity: 1 }, itemId: payload.itemId, amount: quantity };
  }
  if (payload.actionType === 'spawn_animal') {
    positiveInt(quantity, '动物数量', 100);
    return { payload: { actionType: 'spawn_animal', itemId: payload.itemId, quantity }, itemId: payload.itemId, amount: quantity };
  }
  if (payload.actionType === 'spawn_zombie') {
    positiveInt(quantity, '木偶数量', 100);
    return { payload: { actionType: 'spawn_zombie', itemId: payload.itemId, quantity }, itemId: payload.itemId, amount: quantity };
  }
  try {
    const delivery = parseGiftCode(`#spawnitem ${payload.itemId} ${quantity} ${payload.arguments.join(' ')}`).payload;
    return { payload: delivery.arguments.length ? delivery : null, itemId: delivery.itemId, amount: delivery.quantity };
  } catch (error) {
    throw new ServiceError(error.message);
  }
}

export function splitItemDelivery(delivery) {
  if (['spawn_vehicle', 'spawn_armed_npc'].includes(delivery.payload?.actionType)) return Array.from({ length: delivery.amount }, () => ({ ...delivery, amount: 1 }));
  const chunks = [];
  for (let remaining = delivery.amount; remaining > 0; remaining -= 10) {
    const amount = Math.min(10, remaining);
    chunks.push({ ...delivery, amount, payload: delivery.payload ? { ...delivery.payload, quantity: amount } : null });
  }
  return chunks;
}

function generatedSku() {
  return `PRD${Date.now().toString(36).toUpperCase()}${crypto.randomBytes(5).toString('hex').toUpperCase()}`;
}

export function normalizeItems(items) {
  if (!Array.isArray(items) || items.length < 1 || items.length > 50) throw new ServiceError('订单商品必须为 1-50 项');
  const merged = new Map();
  for (const item of items) {
    const sku = String(item?.sku || '').trim();
    if (!SKU_PATTERN.test(sku)) throw new ServiceError('SKU 格式无效');
    const quantity = positiveInt(item?.quantity, '商品数量', 1000);
    const total = (merged.get(sku) || 0) + quantity;
    if (total > 1000) throw new ServiceError('同一 SKU 合并后的商品数量不能超过 1000');
    merged.set(sku, total);
  }
  return [...merged].map(([sku, quantity]) => ({ sku, quantity })).sort((a, b) => a.sku.localeCompare(b.sku));
}

function giftExternalOrderId(giftId, steamId) {
  return giftId === 'default' ? String(steamId) : `${giftId}:${steamId}`;
}

function normalizeGift(gift) {
  const id = String(gift?.id || '').trim();
  if (!SKU_PATTERN.test(id)) throw new ServiceError('礼包 ID 格式无效');
  return { ...gift, id, name: String(gift?.name || '').trim(), category: String(gift?.category || '').trim() };
}

function requestHash(steamId, items) {
  return crypto.createHash('sha256').update(JSON.stringify({ steamId: String(steamId), items })).digest('hex');
}

function orderNo() {
  return `ORD${Date.now()}${crypto.randomBytes(5).toString('hex').toUpperCase()}`;
}

function isDuplicateKey(error) {
  return error?.code === 'ER_DUP_ENTRY' || error?.errno === 1062;
}

function exchangeResult(row, idempotent = false) {
  return {
    id: Number(row.id),
    direction: row.direction,
    inputAmount: Number(row.inputAmount),
    outputAmount: Number(row.outputAmount),
    rate: Number(row.rateSnapshot),
    coinDelta: Number(row.coinDelta),
    goldDelta: Number(row.goldDelta),
    status: row.status,
    balance: row.balance === undefined ? undefined : Number(row.balance),
    rconResponse: row.rconResponse || null,
    errorMessage: row.errorMessage || null,
    idempotent
  };
}

function assertSameExchange(row, steamId, value) {
  if (String(row.steamId) !== String(steamId)
    || row.direction !== value.direction
    || Number(row.inputAmount) !== value.inputAmount) {
    throw new ServiceError('重复幂等键的兑换内容不一致', 409, 'IDEMPOTENCY_CONFLICT');
  }
  return exchangeResult(row, true);
}

function exchangeText(value) {
  if (value === null || value === undefined) return null;
  const text = typeof value === 'string' ? value : JSON.stringify(value);
  return String(text).slice(0, 500);
}

function assertExchangeRconResult(result) {
  const status = String(result?.status ?? result?.data?.status ?? '').toLowerCase();
  const uncertain = result?.uncertainDelivery === true || result?.data?.uncertainDelivery === true || ['uncertain', 'uncertain_delivery'].includes(status);
  const failed = result?.success === false || result?.data?.success === false || ['failed', 'failure', 'error'].includes(status);
  if (!uncertain && !failed) return;
  const error = new Error(exchangeText(result?.response ?? result?.data?.response ?? result) || (uncertain ? 'RCON 投递结果不确定' : 'RCON 命令执行失败'));
  error.uncertainDelivery = uncertain;
  throw error;
}

function assertSameRequest(order, hash) {
  if (!order.requestHash || order.requestHash !== hash) throw new ServiceError('重复 orderId 的订单载荷不一致', 409, 'IDEMPOTENCY_CONFLICT');
  return { id: order.id, orderNo: order.orderNo, status: order.status, idempotent: true };
}

export async function recomputeOrderStatus(tx, orderId) {
  const order = (await tx.query('SELECT id,status,source,steam_id AS steamId FROM orders WHERE id = ? FOR UPDATE', [orderId]))[0];
  const rows = await tx.query("SELECT task.status, COUNT(*) AS count FROM fulfillment_tasks task JOIN (SELECT order_item_id, code_index, MAX(generation) AS generation FROM fulfillment_tasks WHERE order_id = ? GROUP BY order_item_id, code_index) latest ON latest.order_item_id = task.order_item_id AND latest.code_index = task.code_index AND latest.generation = task.generation WHERE task.order_id = ? GROUP BY task.status", [orderId, orderId]);
  const counts = new Map(rows.map((row) => [row.status, Number(row.count)]));
  const total = [...counts.values()].reduce((sum, count) => sum + count, 0);
  let status = 'pending';
  if (total > 0 && (counts.get('completed') || 0) === total) status = 'completed';
  else if (counts.has('manual_review')) status = 'manual_review';
  else if (counts.has('failed')) status = 'failed';
  else if (counts.has('processing') || counts.has('dispatching')) status = 'processing';
  await tx.query('UPDATE orders SET status = ? WHERE id = ?', [status, orderId]);
  if (status === 'completed' && order?.status !== 'completed' && order.steamId && ['shop','gift'].includes(order.source)) {
    const policy = (await tx.query('SELECT consumption_upgrade_enabled AS enabled,upgrade_gift_enabled AS giftEnabled,upgrade_gift_amount AS giftAmount FROM membership_policy WHERE id=1'))[0];
    if (policy?.enabled) {
      const spent = Number((await tx.query("SELECT COALESCE(SUM(total_amount),0) AS total FROM orders WHERE steam_id=? AND status='completed' AND source IN ('shop','gift')", [order.steamId]))[0]?.total || 0);
      const target = (await tx.query('SELECT level FROM membership_strategies WHERE enabled=1 AND level>0 AND upgrade_spend<=? ORDER BY level DESC LIMIT 1', [spent]))[0];
      const user = (await tx.query('SELECT `商城用户编号` AS id,`会员等级` AS memberLevel,`会员到期时间` AS memberExpiresAt FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [order.steamId]))[0];
      if (target && user && Number(target.level) > Number(user.memberLevel || 0)) {
        const gift = policy.giftEnabled ? Number(policy.giftAmount || 0) : 0;
        await tx.query('UPDATE `商城用户` SET `会员等级`=?,`会员到期时间`=NULL,`商城币余额`=`商城币余额`+? WHERE `商城用户编号`=?', [target.level, gift, user.id]);
        await tx.query('INSERT INTO membership_change_logs (steam_id,old_level,new_level,old_expires_at,new_expires_at,reason,operator) VALUES (?,?,?,?,NULL,?,?)', [order.steamId, Number(user.memberLevel || 0), target.level, user.memberExpiresAt || null, '累计消费自动升级', 'system']);
        if (gift > 0) {
          const balance = Number((await tx.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=?', [order.steamId]))[0].balance);
          await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'membership_upgrade_gift','order',?,'消费升级赠送')", [order.steamId, gift, balance, String(orderId)]);
        }
      }
    }
  }
  return status;
}

export function calculatePresence(events, online, now = Date.now()) {
  const nowMs = Number(now);
  let sessionStartedAt = null;
  let totalOnlineSeconds = 0;
  for (const event of events) {
    const observedMs = new Date(event.observedAt).getTime();
    if (!Number.isFinite(observedMs) || observedMs > nowMs) continue;
    if (event.eventType === 'online') {
      if (sessionStartedAt === null) sessionStartedAt = observedMs;
    } else if (event.eventType === 'offline' && sessionStartedAt !== null) {
      totalOnlineSeconds += Math.max(0, Math.floor((observedMs - sessionStartedAt) / 1000));
      sessionStartedAt = null;
    }
  }
  const currentSessionSeconds = online && sessionStartedAt !== null ? Math.max(0, Math.floor((nowMs - sessionStartedAt) / 1000)) : null;
  if (currentSessionSeconds !== null) totalOnlineSeconds += currentSessionSeconds;
  return { currentSessionStartedAt: online && sessionStartedAt !== null ? new Date(sessionStartedAt).toISOString() : null, currentSessionSeconds, totalOnlineSeconds };
}

export class CommerceService {
  constructor(db, clock = () => Date.now()) {
    this.db = db;
    this.clock = clock;
  }

  async dashboard() {
    const [accounts, products, orders, tasks] = await Promise.all([
      this.db.query("SELECT COUNT(`SteamID`) AS count,COALESCE(SUM(`商城币余额`),0) AS total_balance,COUNT(DISTINCT CASE WHEN `SteamID` IS NOT NULL AND `账户状态`='active' THEN `SteamID` END) AS registered_count FROM `商城用户`"),
      this.db.query('SELECT COUNT(*) AS count, SUM(enabled = 1) AS enabled_count FROM products'),
      this.db.query("SELECT COUNT(*) AS count, SUM(status = 'completed') AS completed_count FROM orders"),
