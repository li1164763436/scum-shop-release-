  async membershipConsumption(steamId) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效', 400, 'INVALID_INPUT');
    const users = await this.db.query("SELECT `登录账号` AS username,CASE WHEN `会员等级`>0 AND (`会员到期时间` IS NULL OR `会员到期时间`>CURRENT_TIMESTAMP(3)) THEN `会员等级` ELSE 0 END AS memberLevel,`会员到期时间` AS memberExpiresAt FROM `商城用户` WHERE `SteamID`=? AND `账户状态`='active'", [String(steamId)]);
