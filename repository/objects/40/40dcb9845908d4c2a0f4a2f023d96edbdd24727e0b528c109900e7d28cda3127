  async reorderProductParentCategories(input) {
    const ids = Array.isArray(input.ids) ? input.ids.map((id) => positiveInt(id, '主分类 ID')) : [];
    if (!ids.length || new Set(ids).size !== ids.length) throw new ServiceError('主分类顺序无效');
    const rows = await this.db.query('SELECT id FROM product_parent_categories ORDER BY sort_order,id');
    const existing = rows.map((row) => Number(row.id));
    if (ids.length !== existing.length || ids.some((id) => !existing.includes(id))) throw new ServiceError('主分类顺序不完整');
    const cases = ids.map(() => 'WHEN ? THEN ?').join(' ');
    const params = ids.flatMap((id, index) => [id, index]);
    await this.db.query(`UPDATE product_parent_categories SET sort_order=CASE id ${cases} END WHERE id IN (${ids.map(() => '?').join(',')})`, [...params, ...ids]);
