  async adjustBalance(steamId, amount, note = '') {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const delta = Number(amount);
    if (!Number.isSafeInteger(delta) || delta === 0) throw new ServiceError('调整金额必须是非零整数');
    const safeNote = String(note || '').trim();
    if (safeNote.length > 255) throw new ServiceError('备注不能超过 255 字符');
    return this.db.transaction(async (tx) => {
      await tx.query('INSERT INTO `商城用户` (`SteamID`,`商城币余额`) VALUES (?,0) ON DUPLICATE KEY UPDATE `SteamID`=VALUES(`SteamID`)', [String(steamId)]);
      const rows = await tx.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [String(steamId)]);
      const balance = Number(rows[0].balance) + delta;
      if (balance < 0) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
      await tx.query('UPDATE `商城用户` SET `商城币余额`=? WHERE `SteamID`=?', [balance, String(steamId)]);
      await tx.query("INSERT INTO coin_ledger (steam_id, amount, balance_after, type, note) VALUES (?, ?, ?, 'admin_adjustment', ?)", [String(steamId), delta, balance, safeNote || null]);
      return { steamId: String(steamId), balance };
    });
  }

  async exchangeCurrency(steamId, input, rconClient, exchangeConfig = {}) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    if (!exchangeConfig.enabled) throw new ServiceError('账户兑换功能当前未启用', 403, 'EXCHANGE_DISABLED');
    if (!rconClient?.command) throw new ServiceError('游戏服 RCON 当前不可用', 503, 'RCON_UNAVAILABLE');

    const id = String(steamId);
    const requestKey = String(input?.requestKey || '').trim();
    if (!requestKey || requestKey.length > 100) throw new ServiceError('Idempotency-Key 长度必须为 1-100 个字符', 400, 'INVALID_IDEMPOTENCY_KEY');
    const direction = String(input?.direction || '').trim();
    if (!['coin_to_gold', 'gold_to_coin'].includes(direction)) throw new ServiceError('兑换方向无效', 400, 'INVALID_EXCHANGE_DIRECTION');
    const maxAmount = positiveInt(exchangeConfig.maxAmount, '单次兑换上限', 1000000000);
    const inputAmount = positiveInt(input?.amount, '兑换数量', maxAmount);
    const rate = Number(direction === 'coin_to_gold' ? exchangeConfig.coinToGoldRate : exchangeConfig.goldToCoinRate);
    if (!Number.isFinite(rate) || rate <= 0 || rate > 1000000) throw new ServiceError('兑换比例配置无效', 500, 'INVALID_EXCHANGE_CONFIG');
    const outputAmount = Math.floor(inputAmount * rate);
    if (!Number.isSafeInteger(outputAmount) || outputAmount < 1) throw new ServiceError('按当前比例计算的兑换结果不足 1 或数值过大', 400, 'INVALID_EXCHANGE_AMOUNT');

    const value = {
      direction,
      inputAmount,
      outputAmount,
      rate: Number(rate.toFixed(8)),
      coinDelta: direction === 'coin_to_gold' ? -inputAmount : outputAmount,
      goldDelta: direction === 'coin_to_gold' ? outputAmount : -inputAmount
    };
    const command = `#ChangeCurrencyBalance Gold ${value.goldDelta} ${id}`;

    const existingRows = await this.db.query('SELECT id,steam_id AS steamId,direction,input_amount AS inputAmount,output_amount AS outputAmount,rate_snapshot AS rateSnapshot,coin_delta AS coinDelta,gold_delta AS goldDelta,status,rcon_response AS rconResponse,error_message AS errorMessage FROM account_exchanges WHERE request_key=?', [requestKey]);
    if (existingRows[0]) return assertSameExchange(existingRows[0], id, value);

    let prepared;
    try {
      prepared = await this.db.transaction(async (tx) => {
        await tx.query('INSERT INTO `商城用户` (`SteamID`,`商城币余额`) VALUES (?,0) ON DUPLICATE KEY UPDATE `SteamID`=VALUES(`SteamID`)', [id]);
        const accountRows = await tx.query('SELECT `商城币余额` AS balance,`游戏金条` AS gameGold,`最后游戏在线时间` AS lastGameSeenAt FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [id]);
        const account = accountRows[0];
        const onlineRows = await tx.query("SELECT p.steam_id AS steamId FROM online_player_snapshots p INNER JOIN server_monitor_samples s ON s.id=p.sample_id WHERE p.steam_id=? AND s.status='ok' AND s.player_query_ok=1 AND s.id=(SELECT MAX(id) FROM server_monitor_samples WHERE status='ok' AND player_query_ok=1) LIMIT 1", [id]);
        if (!onlineRows[0]) throw new ServiceError('游戏角色必须在线才能兑换，请先进入游戏并等待在线状态同步', 409, 'PLAYER_OFFLINE');
        const duplicateRows = await tx.query('SELECT id,steam_id AS steamId,direction,input_amount AS inputAmount,output_amount AS outputAmount,rate_snapshot AS rateSnapshot,coin_delta AS coinDelta,gold_delta AS goldDelta,status,rcon_response AS rconResponse,error_message AS errorMessage FROM account_exchanges WHERE request_key=? FOR UPDATE', [requestKey]);
        if (duplicateRows[0]) return { existing: assertSameExchange(duplicateRows[0], id, value) };

        const balance = Number(account.balance);
        if (direction === 'coin_to_gold' && balance < inputAmount) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
        if (direction === 'gold_to_coin') {
          if (account.gameGold === null || account.gameGold === undefined) throw new ServiceError('尚未获取游戏金条余额，请进入游戏并等待资产同步', 409, 'GAME_GOLD_UNAVAILABLE');
          const reservedRows = await tx.query("SELECT COALESCE(SUM(input_amount),0) AS amount FROM account_exchanges WHERE steam_id=? AND direction='gold_to_coin' AND status IN ('executing','succeeded','uncertain') AND (completed_at IS NULL OR completed_at>?)", [id, account.lastGameSeenAt || new Date(0)]);
          const availableGold = Math.floor(Number(account.gameGold) - Number(reservedRows[0]?.amount || 0));
          if (availableGold < inputAmount) throw new ServiceError('游戏金条余额不足或已有兑换等待同步', 409, 'INSUFFICIENT_GAME_GOLD');
        }

        const result = await tx.query("INSERT INTO account_exchanges (steam_id,request_key,direction,input_amount,output_amount,rate_snapshot,coin_delta,gold_delta,status,rcon_command) VALUES (?,?,?,?,?,?,?,?, 'executing',?)", [id, requestKey, direction, inputAmount, outputAmount, value.rate, value.coinDelta, value.goldDelta, command]);
        const balanceAfterReserve = direction === 'coin_to_gold' ? balance - inputAmount : balance;
        if (direction === 'coin_to_gold') await tx.query('UPDATE `商城用户` SET `商城币余额`=? WHERE `SteamID`=?', [balanceAfterReserve, id]);
        return { exchangeId: result.insertId, balance: balanceAfterReserve };
      });
    } catch (error) {
      if (!isDuplicateKey(error)) throw error;
      const rows = await this.db.query('SELECT id,steam_id AS steamId,direction,input_amount AS inputAmount,output_amount AS outputAmount,rate_snapshot AS rateSnapshot,coin_delta AS coinDelta,gold_delta AS goldDelta,status,rcon_response AS rconResponse,error_message AS errorMessage FROM account_exchanges WHERE request_key=?', [requestKey]);
      if (!rows[0]) throw error;
      return assertSameExchange(rows[0], id, value);
    }

    if (prepared.existing) return prepared.existing;

    let response;
    try {
      const result = await rconClient.command(command, { retry: false });
      assertExchangeRconResult(result);
      response = exchangeText(result?.response ?? result);
    } catch (error) {
      const uncertain = error?.uncertainDelivery === true;
      const message = exchangeText(error?.message || 'RCON 命令执行失败');
      const failed = await this.db.transaction(async (tx) => {
        const exchangeRows = await tx.query('SELECT status FROM account_exchanges WHERE id=? FOR UPDATE', [prepared.exchangeId]);
        if (exchangeRows[0]?.status !== 'executing') return null;
        const accountRows = await tx.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [id]);
        let balance = Number(accountRows[0].balance);
        if (!uncertain && direction === 'coin_to_gold') {
          balance += inputAmount;
          await tx.query('UPDATE `商城用户` SET `商城币余额`=? WHERE `SteamID`=?', [balance, id]);
        }
        const status = uncertain ? 'uncertain' : 'failed';
        await tx.query('UPDATE account_exchanges SET status=?,error_message=?,completed_at=CURRENT_TIMESTAMP(3) WHERE id=?', [status, message, prepared.exchangeId]);
        return { ...value, id: prepared.exchangeId, status, balance, errorMessage: message };
      });
      if (uncertain) return exchangeResult(failed);
      throw new ServiceError(`游戏服兑换失败：${message}`, 502, 'RCON_EXCHANGE_FAILED');
    }

    return this.db.transaction(async (tx) => {
      const exchangeRows = await tx.query('SELECT status FROM account_exchanges WHERE id=? FOR UPDATE', [prepared.exchangeId]);
      const accountRows = await tx.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [id]);
      let balance = Number(accountRows[0].balance);
      if (exchangeRows[0]?.status !== 'executing') {
        const rows = await tx.query('SELECT id,steam_id AS steamId,direction,input_amount AS inputAmount,output_amount AS outputAmount,rate_snapshot AS rateSnapshot,coin_delta AS coinDelta,gold_delta AS goldDelta,status,rcon_response AS rconResponse,error_message AS errorMessage FROM account_exchanges WHERE id=?', [prepared.exchangeId]);
        return exchangeResult({ ...rows[0], balance }, true);
      }
      if (direction === 'gold_to_coin') {
        balance += outputAmount;
        if (!Number.isSafeInteger(balance)) throw new ServiceError('商城币余额超出安全范围', 500, 'BALANCE_OVERFLOW');
        await tx.query('UPDATE `商城用户` SET `商城币余额`=? WHERE `SteamID`=?', [balance, id]);
      }
      await tx.query("INSERT INTO coin_ledger (steam_id,amount,balance_after,type,reference_type,reference_id,note) VALUES (?,?,?,'account_exchange',?,?,?)", [id, value.coinDelta, balance, direction, String(prepared.exchangeId), direction === 'coin_to_gold' ? '商城币兑换金条' : '金条兑换商城币']);
      await tx.query("UPDATE account_exchanges SET status='succeeded',rcon_response=?,completed_at=CURRENT_TIMESTAMP(3) WHERE id=?", [response, prepared.exchangeId]);
      return exchangeResult({ ...value, id: prepared.exchangeId, status: 'succeeded', balance, rconResponse: response });
    });
  }

  async adjustGameGold(steamId, amount, rconClient) {
    const id = String(steamId || '').trim();
    if (!isSteamId64(id)) throw new ServiceError('SteamID 格式无效');
    const players = await rconClient.players();
    if (!players.some((player) => String(player.steamId) === id)) throw new ServiceError('玩家当前不在线，无法调整金条', 409, 'PLAYER_OFFLINE');
    const command = `#ChangeCurrencyBalance Gold ${amount} ${id}`;
    const result = await rconClient.command(command, { retry: false });
    return { steamId: id, amount, command, response: exchangeText(result?.response ?? result) };
  }

