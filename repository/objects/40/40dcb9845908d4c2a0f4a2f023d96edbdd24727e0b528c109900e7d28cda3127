  async createManualFulfillment({ steamId, code }, userId = null) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const parsed = parseGiftCode(code);
    const requestKey = crypto.createHash('sha256').update(`${steamId}:${parsed.displayCode}`).digest('hex');
    return this.db.transaction(async (tx) => {
      await tx.query('INSERT INTO `商城用户` (`SteamID`,`商城币余额`) VALUES (?,0) ON DUPLICATE KEY UPDATE `SteamID`=VALUES(`SteamID`)', [String(steamId)]);
      const number = orderNo();
      const order = await tx.query("INSERT INTO orders (order_no, source, request_hash, steam_id, total_amount, status) VALUES (?, 'manual_fulfillment', ?, ?, 0, 'pending')", [number, requestKey, String(steamId)]);
      const payload = parsed.actionType === 'spawn_item' ? parsed.payload : null;
      const detail = await tx.query('INSERT INTO order_items (order_id, sku, name, unit_price, quantity, item_id, grant_amount, fulfillment_codes_snapshot) VALUES (?, ?, ?, 0, 1, ?, ?, ?)', [order.insertId, 'manual_fulfillment', '管理员手动发货', payload?.itemId || null, payload?.quantity || null, parsed.displayCode]);
      const task = await tx.query('INSERT INTO fulfillment_tasks (order_id, order_item_id, steam_id, task_type, payload_json, coin_amount, item_id, amount, created_by_user_id, request_key, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, \'pending\')', [order.insertId, detail.insertId, String(steamId), parsed.actionType, payload ? JSON.stringify(payload) : null, parsed.actionType === 'shop_coin' ? parsed.payload.amount : null, payload?.itemId || null, payload?.quantity || null, userId || null, requestKey]);
      return { id: task.insertId, orderId: order.insertId, orderNo: number, status: 'pending' };
    });
  }

  async createOrder({ steamId, items, source = 'manual', externalOrderId = null }) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const normalized = normalizeItems(items);
    const external = externalOrderId === null ? null : String(externalOrderId).trim();
    if (external !== null && (!external || external.length > 100)) throw new ServiceError('外部订单号格式无效');
    const hash = requestHash(steamId, normalized);
    if (external) {
      const existing = await this.findExternalOrder(source, external);
      if (existing) return assertSameRequest(existing, hash);
    }
    try {
      return await this.db.transaction(async (tx) => {
        await tx.query('INSERT INTO `商城用户` (`SteamID`,`商城币余额`) VALUES (?,0) ON DUPLICATE KEY UPDATE `SteamID`=VALUES(`SteamID`)', [String(steamId)]);
        const placeholders = normalized.map(() => '?').join(',');
        const products = await tx.query(`SELECT id, sku, name, price, item_id, grant_amount, parent_category, category_name, currency_type, min_member_level, image_path, fulfillment_codes FROM products WHERE enabled = 1 AND sku IN (${placeholders}) FOR UPDATE`, normalized.map((item) => item.sku));
        if (products.length !== normalized.length) throw new ServiceError('订单包含不存在或已下架的商品', 409, 'PRODUCT_UNAVAILABLE');
        let memberStrategy = null;
        if (source === 'shop') {
          const users = await tx.query("SELECT CASE WHEN `会员等级`>0 AND (`会员到期时间` IS NULL OR `会员到期时间`>CURRENT_TIMESTAMP(3)) THEN `会员等级` ELSE 0 END AS memberLevel FROM `商城用户` WHERE `SteamID`=? AND `用户角色` IN ('user','admin','super_admin') AND `账户状态`='active' FOR UPDATE", [String(steamId)]);
          if (!users[0]) throw new ServiceError('商城用户不存在或已停用', 403, 'SHOP_USER_UNAVAILABLE');
          const memberLevel = Number(users[0].memberLevel) || 0;
          memberStrategy = (await tx.query('SELECT shopping_discount AS shoppingDiscount FROM membership_strategies WHERE level=? AND enabled=1', [memberLevel]))[0] || { shoppingDiscount: 100 };
          const restricted = products.find((product) => memberLevel < Number(product.min_member_level || 0));
          if (restricted) throw new ServiceError(`会员等级不足，商品“${restricted.name}”要求会员等级 ${restricted.min_member_level}`, 403, 'MEMBER_LEVEL_REQUIRED');
        }
        if (products.some((product) => !['coin', '商城币'].includes(product.currency_type || 'coin'))) throw new ServiceError('美金、金条商品尚未接入游戏资产结算，不能使用商城币购买', 409, 'CURRENCY_PAYMENT_UNAVAILABLE');
        const bySku = new Map(products.map((product) => [product.sku, product]));
        const discount = Number(memberStrategy?.shoppingDiscount ?? 100);
        const unitPriceFor = (product) => source === 'shop' ? Math.round(Number(product.price) * discount / 100) : Number(product.price);
        const total = normalized.reduce((sum, item) => sum + unitPriceFor(bySku.get(item.sku)) * item.quantity, 0);
        if (!Number.isSafeInteger(total)) throw new ServiceError('订单金额超出安全范围');
        const account = await tx.query('SELECT `商城币余额` AS balance FROM `商城用户` WHERE `SteamID`=? FOR UPDATE', [String(steamId)]);
        const balance = Number(account[0].balance);
        if (balance < total) throw new ServiceError('商城币余额不足', 409, 'INSUFFICIENT_BALANCE');
        const number = orderNo();
        const order = await tx.query("INSERT INTO orders (order_no, source, external_order_id, request_hash, steam_id, total_amount, status) VALUES (?, ?, ?, ?, ?, ?, 'pending')", [number, source, external, hash, String(steamId), total]);
        for (const item of normalized) {
          const product = bySku.get(item.sku);
          const codes = productCodes(product);
          const snapshot = codes.join(',');
          const detail = await tx.query('INSERT INTO order_items (order_id, product_id, sku, name, unit_price, quantity, item_id, grant_amount, parent_category, category_name, currency_type, min_member_level, image_path, fulfillment_codes_snapshot) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)', [order.insertId, product.id, product.sku, product.name, unitPriceFor(product), item.quantity, product.item_id, product.grant_amount, product.parent_category || null, product.category_name || null, product.currency_type || 'coin', product.min_member_level || 0, product.image_path || null, snapshot]);
          const deliveries = codes.flatMap((code) => {
            const delivery = productDelivery(code, product.grant_amount * item.quantity);
            return splitItemDelivery(delivery);
          });
          for (const [codeIndex, delivery] of deliveries.entries()) {
            await tx.query("INSERT INTO fulfillment_tasks (order_id, order_item_id, code_index, steam_id, item_id, amount, payload_json, status) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending')", [order.insertId, detail.insertId, codeIndex, String(steamId), delivery.itemId, delivery.amount, delivery.payload ? JSON.stringify(delivery.payload) : null]);
          }
        }
        const after = balance - total;
        await tx.query('UPDATE `商城用户` SET `商城币余额`=? WHERE `SteamID`=?', [after, String(steamId)]);
        await tx.query("INSERT INTO coin_ledger (steam_id, amount, balance_after, type, reference_type, reference_id, note) VALUES (?, ?, ?, 'order_purchase', 'order', ?, ?)", [String(steamId), -total, after, String(order.insertId), `订单 ${number}`]);
        return { id: order.insertId, orderNo: number, status: 'pending', totalAmount: total, balanceAfter: after, idempotent: false };
      });
    } catch (error) {
      if (!external || !isDuplicateKey(error)) throw error;
      const existing = await this.findExternalOrder(source, external);
      if (!existing) throw error;
      return assertSameRequest(existing, hash);
    }
  }

  async getGift(steamId, gift) {
    if (!isSteamId64(steamId)) throw new ServiceError('SteamID 格式无效');
    const normalizedGift = normalizeGift(gift);
    const external = giftExternalOrderId(normalizedGift.id, steamId);
    const [existing, products] = await Promise.all([
      this.findExternalOrder('starter_gift', external),
      normalizedGift.items?.length
        ? this.db.query(`SELECT sku, name, image_path AS imagePath FROM products WHERE sku IN (${normalizedGift.items.map(() => '?').join(',')})`, normalizedGift.items.map((item) => item.sku))
        : []
    ]);
    const bySku = new Map(products.map((product) => [product.sku, product]));
    const items = (normalizedGift.items || []).map((item) => ({ ...item, name: bySku.get(item.sku)?.name || item.sku, imagePath: bySku.get(item.sku)?.imagePath || '' }));
    return { id: normalizedGift.id, name: normalizedGift.name, category: normalizedGift.category, enabled: Boolean(normalizedGift.enabled), items, claimed: Boolean(existing), order: existing ? { id: existing.id, orderNo: existing.orderNo, status: existing.status } : null };
  }

  async listGifts(steamId, gifts) {
    const enabled = (Array.isArray(gifts) ? gifts : []).filter((gift) => gift.enabled);
    return Promise.all(enabled.map((gift) => this.getGift(steamId, gift)));
  }

