  async listShopOrderLogs(limit = 300) {
    const safeLimit = positiveInt(limit, '条数', 500);
    const orders = await this.db.query(`SELECT oi.id AS orderItemId,o.id AS orderId,o.order_no AS orderNo,o.created_at AS createdAt,oi.name AS itemName,COALESCE(NULLIF(u.\`游戏名称\`,''),NULLIF(u.\`登录账号\`,''),o.steam_id) AS playerName,o.steam_id AS steamId,(oi.unit_price*oi.quantity) AS amount,o.status FROM orders o JOIN order_items oi ON oi.order_id=o.id LEFT JOIN \`商城用户\` u ON u.\`SteamID\`=o.steam_id WHERE o.source='shop' ORDER BY o.id DESC,oi.id LIMIT ${safeLimit}`);
    if (!orders.length) return [];
    const ids = orders.map((order) => Number(order.orderItemId));
    const placeholders = ids.map(() => '?').join(',');
    const tasks = await this.db.query(`SELECT task.order_item_id AS orderItemId,task.code_index AS codeIndex,task.steam_id AS steamId,task.task_type AS taskType,task.payload_json AS payloadJson,task.item_id AS itemId,task.amount FROM fulfillment_tasks task JOIN (SELECT order_item_id,code_index,MAX(generation) AS generation FROM fulfillment_tasks WHERE order_item_id IN (${placeholders}) GROUP BY order_item_id,code_index) latest ON latest.order_item_id=task.order_item_id AND latest.code_index=task.code_index AND latest.generation=task.generation ORDER BY task.order_item_id,task.code_index`, ids);
    const commands = new Map();
    for (const task of tasks) {
      const key = Number(task.orderItemId);
      const list = commands.get(key) || [];
      list.push(...taskCommands(task));
      commands.set(key, list);
    }
    return orders.map((order) => ({ ...order, commandRaw: (commands.get(Number(order.orderItemId)) || ['暂无游戏执行命令']).join('\n') }));
  }

