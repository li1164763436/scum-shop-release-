#page-activities-lottery .lottery-pool-list {
  display: grid;
  gap: 0;
  background: #fff;
}

#page-activities-lottery .lottery-pool-item {
  min-height: 88px;
  padding: 12px 18px;
  grid-template-columns: 76px minmax(0, 1fr) auto;
  gap: 15px;
  border: 0;
  border-bottom: 1px solid #edf0ed;
  border-radius: 0;
  background: #fff;
  box-shadow: none;
  transform: none;
}

#page-activities-lottery .lottery-pool-item:last-child { border-bottom: 0; }
#page-activities-lottery .lottery-pool-item:hover { background: #f3f7f4; box-shadow: none; transform: none; }
#page-activities-lottery .lottery-pool-item.selected {
  border-color: transparent;
  background: linear-gradient(90deg, #edf5f0, #fff 36%);
  box-shadow: inset 3px 0 #47725a;
}

