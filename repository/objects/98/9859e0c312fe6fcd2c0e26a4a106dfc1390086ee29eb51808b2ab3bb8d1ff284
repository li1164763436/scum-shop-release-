#page-activities-lottery .lottery-pool-title strong { color: var(--admin-text); font-size: 13px; }
#page-activities-lottery .lottery-pool-price b { color: var(--admin-text); }
#page-activities-lottery .lottery-pool-meta small { color: var(--admin-muted); font-size: 10px; }
#page-activities-lottery .lottery-status.enabled { color: #2f6b4e; background: #eaf4ed; }
