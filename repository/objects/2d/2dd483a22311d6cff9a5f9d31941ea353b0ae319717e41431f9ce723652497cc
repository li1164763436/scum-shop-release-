#page-config #rconPluginPanel .plugin-toolbar span { min-width: 0; color: #647186; font-family: Consolas, "Microsoft YaHei UI", sans-serif; font-size: 11px; }
#page-config #rconPluginPanel .plugin-toolbar b { min-width: 0; max-width: 100%; justify-self: start; padding: 4px 8px; overflow-wrap: anywhere; color: #276047; border: 1px solid #bdd8c9; border-radius: 5px; background: #edf7f1; font-size: 11px; line-height: 1.6; }
#page-config #rconPluginPanel .plugin-toolbar b[data-status='pending'],
