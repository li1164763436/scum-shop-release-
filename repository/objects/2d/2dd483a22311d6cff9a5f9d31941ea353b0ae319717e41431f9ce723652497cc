#page-config #rconPluginPanel .plugin-file:last-child { border-bottom: 0; }
#page-config #rconPluginPanel .plugin-file strong { font-size: 12px; }
#page-config #rconPluginPanel .plugin-file small { overflow-wrap: anywhere; font-size: 10px; }
#page-config .rcon-plugin-checksums { grid-column: 1 / -1; min-width: 0; }
