#page-config .rcon-plugin-backup-note { margin: 0; padding: 10px 16px; border-top: 1px solid #e3e8ef; color: #708077; background: #f6faf7; font-size: 11px; line-height: 1.6; }
#page-config #rconPluginPanel .form-actions { align-items: stretch; flex-direction: column; gap: 10px; }
