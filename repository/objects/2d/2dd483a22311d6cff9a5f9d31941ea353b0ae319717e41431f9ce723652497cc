#page-config #rconPluginPanel .plugin-toolbar b[data-status='failed'] { color: #ad3947; border-color: #edc3ca; background: #fff0f2; }
#page-config #rconPluginPanel .plugin-files { grid-template-columns: 1fr; gap: 0; padding: 0 16px; }
