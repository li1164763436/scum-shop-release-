const SHOP_IDLE_LOGOUT_MS = 10 * 60 * 1000;
const SHOP_ACTIVITY_HEARTBEAT_MS = 60 * 1000;
let lastShopActivityAt = Date.now();
let lastShopActivityHeartbeatAt = 0;
let idleLogoutInFlight = false;
const markShopActivity = () => {
  lastShopActivityAt = Date.now();
  if (!state.user || lastShopActivityAt - lastShopActivityHeartbeatAt < SHOP_ACTIVITY_HEARTBEAT_MS) return;
  lastShopActivityHeartbeatAt = lastShopActivityAt;
  void fetch('/api/shop/activity', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(() => {});
};
['pointerdown', 'keydown', 'touchstart', 'scroll', 'input'].forEach((eventName) => document.addEventListener(eventName, markShopActivity, { passive: true }));
window.setInterval(async () => {
  if (!state.user || idleLogoutInFlight || Date.now() - lastShopActivityAt < SHOP_IDLE_LOGOUT_MS) return;
  idleLogoutInFlight = true;
  try { await logout({ automatic: true }); }
  finally { lastShopActivityAt = Date.now(); idleLogoutInFlight = false; }
}, 10000);

$('#logoutButton').addEventListener('click', logout);
