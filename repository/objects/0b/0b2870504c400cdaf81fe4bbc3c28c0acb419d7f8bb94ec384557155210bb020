(async function init() {
  const initialRoute = location.hash.slice(1) || 'store';
  showRoute(initialRoute, false, { pending: true });
  const pageMount = document.getElementById('shopPageMount');
  if (pageMount) pageMount.hidden = false;
  const configRequest = (async () => {
    try {
      const config = await api('/api/shop/config');
      const image = config?.website?.backgroundImage;
      if (image) document.body.style.setProperty('--site-background-image', `url("${image.replace(/"/g, '%22')}")`);
      state.characterGrowthConfig = { ...state.characterGrowthConfig, ...(config?.characterGrowth || {}) };
      renderCharacterPurchase();
    } catch {}
  })();
  await Promise.all([configRequest, loadMe(), loadProducts()]);
  showRoute(location.hash.slice(1) || 'store', false);
})();
