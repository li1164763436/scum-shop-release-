$('#confirmCloudWithdraw').addEventListener('click', async (event) => {
  const modal = $('#cloudWithdrawModal');
  const inventoryId = modal.dataset.inventoryId;
  if (!inventoryId) return;
  await withBusy(event.currentTarget, async () => {
    try {
      await api(`/api/shop/cloud-inventory/${inventoryId}/withdraw`, { method:'POST', body:JSON.stringify({quantity:1}) });
      closeModal(modal);
      toast('物品已在游戏内生成');
      await Promise.all([loadCloudWarehouse(),loadAccount()]);
    } catch (error) { toast(error.message,'error'); }
  });
});
