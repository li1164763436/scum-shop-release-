export function isValidDatabaseName(value) { return typeof value === 'string' && DATABASE_NAME_PATTERN.test(value); }
export function normalizeCountdownMarks(value) {
  const items = Array.isArray(value) ? value : [30, 15, 10, 5, 1];
  return [...new Set(items.map(Number))].sort((a, b) => b - a);
}
export const normalizeCountdownMinutes = normalizeCountdownMarks;
function normalizeGgcon(config) {
  if (!config) return { ...sourceDefaults };
  if (config.mode === 'http-legacy') return { apiKey: '', apiKeyMode: 'x-api-key', timeoutMs: 5000, ...config };
  if (config.mode === 'scum-shop-pipe') return { mode: 'scum-shop-pipe', endpointFile: 'runtime/bridge/endpoint.json', timeoutMs: 5000, ...config };
  if (config.baseUrl && !config.mode) return { mode: 'http-legacy', apiKey: '', apiKeyMode: 'x-api-key', timeoutMs: 5000, ...config };
  const normalized = { ...sourceDefaults, ...config, mode: 'source-tcp', port: 28015 };
  if (normalized.host === '0.0.0.0' || normalized.host === '::') normalized.host = '127.0.0.1';
  return normalized;
}

